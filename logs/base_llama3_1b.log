\')\n"""\ndef removezero_ip(ip):\n    return ip.lstrip(\'0\')', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['216.08.094.196']], 'plus_fail_tests': [['0.0.0.0']]}], 'Mbpp/594': [{'task_id': 'Mbpp/594', 'solution': '"""\nWrite a function to find the difference of the first even and first odd number of a given list.\nassert diff_even_odd([1,3,5,7,4,1,6,8])==3\n"""\ndef diff_even_odd(lst):\n    return lst[1] - lst[0]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, 5, 7, 4, 1, 6, 8]]], 'plus_fail_tests': [[[7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8]]]}], 'Mbpp/596': [{'task_id': 'Mbpp/596', 'solution': '"""\nWrite a function to find the size in bytes of the given tuple.\nassert tuple_size(("A", 1, "B", 2, "C", 3) ) == sys.getsizeof(("A", 1, "B", 2, "C", 3))\n"""\ndef tuple_size(t):\n    return sys.getsizeof(t)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['A', 1, 'B', 2, 'C', 3]]], 'plus_fail_tests': [[[[1, 'Raju'], [2, 'Nikhil'], [3, 'Deepanshu']]]]}], 'Mbpp/597': [{'task_id': 'Mbpp/597', 'solution': '"""\nWrite a function to find kth element from the given two sorted arrays.\nassert find_kth([2, 3, 6, 7, 9], [1, 4, 8, 10], 5) == 6\n"""\ndef find_kth(arr1, arr2, k):\n    return arr1[k-1]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 3, 6, 7, 9], [1, 4, 8, 10], 5]], 'plus_fail_tests': [[[], [1, 2, 3], 2]]}], 'Mbpp/598': [{'task_id': 'Mbpp/598', 'solution': '"""\nWrite a function to check whether the given number is armstrong or not.\nassert armstrong_number(153)==True\n"""\ndef armstrong_number(n):\n    return n == sum(int(digit)**len(str(n)) for digit in str(n))', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/599': [{'task_id': 'Mbpp/599', 'solution': '"""\nWrite a function to find sum and average of first n natural numbers.\nassert sum_average(10)==(55, 5.5)\n"""\ndef sum_average(n):\n    return 