([5, 4, 7, 2, 1]) == 4\n"""\ndef find_even_pair(nums):\n    count = 0\n    for i in range(len(nums)):\n        for j in range(i + 1, len(nums)):\n            if (nums[i] ^ nums[j]) % 2 == 0:\n                count += 1\n    return count', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/167': [{'task_id': 'Mbpp/167', 'solution': '"""\nWrite a python function to find the smallest power of 2 greater than or equal to n.\nassert next_power_of_2(0) == 1\n"""\ndef next_power_of_2(n):\n    if n == 0:\n        return 1\n    i = 1\n    while i < n:\n        i *= 2\n    return i', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/168': [{'task_id': 'Mbpp/168', 'solution': '"""\nWrite a function to count the number of occurrences of a number in a given list.\nassert frequency([1,2,3], 4) == 0\n"""\ndef frequency(lst, num):\n    return lst.count(num)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/170': [{'task_id': 'Mbpp/170', 'solution': '"""\nWrite a function to find the sum of numbers in a list within a range specified by two indices.\nassert sum_range_list([2,1,5,6,8,3,4,9,10,11,8,12], 8, 10) == 29\n"""\ndef sum_range_list(lst, start, end):\n    return sum(lst[start:end+1])', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/171': [{'task_id': 'Mbpp/171', 'solution': '"""\nWrite a function to find the perimeter of a regular pentagon from the length of its sides.\nassert perimeter_pentagon(5) == 25\n"""\ndef perimeter_pentagon(n):\n    return n * 5', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/172': [{'task_id': 'Mbpp/172', 'solution': '"""\nWrite a function to count the number of occurence of the string \'std\' in a given string.\nassert count_occurance("letstdlenstdporstd") == 3\n"""\ndef count_occurance(s):\n    return s.count(\'std\')', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/222': [{'task_id': 'Mbpp/222', 'solution': '"""\nWrite a function to check if all the elements in tuple have same data type or not.\nassert check_type((5, 6, 7, 3, 5, 6) ) == True\n"""\ndef check_type(tup):\n    return all(isinstance(x, type(tup[0]))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/223': [{'task_id': 'Mbpp/223', 'solution': '"""\nWrite a function that takes in a sorted array, its length (n), and an element and returns whether the element is the majority element in the given sorted array. (The majority element is the element that occurs more than n/2 times.)\nassert is_majority([1, 2, 3, 3, 3, 3, 10], 7, 3) == True\n"""\ndef is_majority(arr, n, target):\n    count = 0\n    for num in arr:\n        if arr.count(num) > n / 2:\n            count += 1\n    return count > n / 2', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[[True], 1, 2]]}], 'Mbpp/224': [{'task_id': 'Mbpp/224', 'solution': '"""\nWrite a python function to count the number of set bits (binary digits with value 1) in a given number.\nassert count_Set_Bits(2) == 1\n"""\ndef count_Set_Bits(n):\n    return bin(n).count(\'1\')', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/226': [{'task_id': 'Mbpp/226', 'solution': '"""\nWrite a python function to remove the characters which have odd index values of a given string.\nassert odd_values_string(\'abcdef\') == \'ace\'\n"""\ndef odd_values_string(s):\n    return s.replace(\'a\', \'\', 1)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['abcdef']], 'plus_fail_tests': [['abcdefghijklmnopqrstuvwxyz']]}], 'Mbpp/227': [{'task_id': 'Mbpp/227', 'solution': '"""\nWrite a function to find minimum of three numbers.\nassert min_of_three(10,20,0)==0\n"""\ndef min_of_three(a, b, c):\n    return min(a, b, c)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/230': [{'task_id': 'Mbpp/230', 'solution': '"""\nWrite a function that takes in a string and character, replaces blank spaces in the string with the character, and returns the string.\nassert replace_blank("hello people",\'@\')==("hello@people")\n"""\ndef replace_blank(s, char):\n    return s.replace(\' \', char)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/232': [{'task_id': 'Mbpp/232', 'solution': '"""\nWrite a function that takes in a list and an integer n and returns a list containing the n largest items from the list.\nassert set(larg_nnum([10, 20, 50, 70, 90, 20, 50, 40, 60, 80, 100],2))==set([100,90])\n"""\ndef largest_n(nums, n):\n    return sorted(nums, reverse=True)[:n]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/233': [{'task_id': 'Mbpp/233', 'solution': '"""\nWrite a function to find the lateral surface area of a cylinder.\nassert math.isclose(lateralsuface_cylinder(10,5), 314.15000000000003, rel_tol=0.001)\n"""\ndef lateral_surface_cylinder(r, h):\n    import math\n    return 2 * math.pi * r * h', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/234': [{'task_id': 'Mbpp/234', 'solution': '"""\nWrite a function to find the volume of a cube given its side length.\nassert volume_cube(3)==27\n"""\ndef volume_cube(side_length):\n    return side_length ** 3', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/235': [{'task_id': 'Mbpp/235', 'solution': '"""\nWrite a python function to set all even bits of a given number.\nassert even_bit_set_number(10) == 10\n"""\ndef even_bit_set_number(n):\n    return bin(n & 0xAAAAAAAA)[2:].zfill(8)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[10]], 'pl