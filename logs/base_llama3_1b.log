            return False\n    return True\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/32': [{'task_id': 'HumanEval/32', 'solution': 'import math\n\n\ndef poly(xs: list, x: float):\n    """\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    """\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    """ xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    """\ndef find_zero(xs: list):\n    if len(xs) % 2 == 0:\n        return round(sum([coeff / math.pow(x, i) for i, coeff in enumerate(xs) if coeff != 0]), 2)\n    else:\n        return round(math.pow(sum([coeff / math.pow(x, i) for i, coeff in enumerate(xs) if coeff != 0]), 2), 2)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[-10, -2]]], 'plus_fail_tests': [[[5, 10, -3, 1]]]}], 'HumanEval/33': [{'task_id': 'HumanEval/33', 'solution': '\n\ndef sort_third(l: list):\n    """This function takes a list l and returns a list l\' such that\n    l\' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    """\ndef sort_third(l: list) -> list:\n    return [x for i, x in enumerate(l) if i % 3 != 0] + [x for x in l if i % 3 == 0]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3]]], 'plus_fail_tests': [[[9, 12, 15, 6, 3, 8, 10, 23, 7]]]}], 'HumanEval/34': [{'task_id': 'HumanEval/34', 'solution': '\n\ndef unique(l: list):\n    """Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    """\ndef unique(l: list) -> list:\n    return sorted(set(l))', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/35': [{'task_id': 'HumanEval/35', 'solution': '\n\ndef max_element(l: list):\n    """Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    """\ndef max_element(l):\n    return max(l)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/36': [{'task_id': 'HumanEval/36', 'solution': '\n\ndef fizz_buzz(n: int):\n    """Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    """\ndef fizz_buzz(n: int) -> int:\n    count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            count += 1\n    return count\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[50]], 'plus_fail_tests': [[20]]}], 'HumanEval/37': [{'task_id': 'HumanEval/37', 'solution': '\n\ndef sort_even(l: list):\n    """This function takes a list l and returns a list l\' such that\n    l\' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    """\ndef sort_even(l):\n    even = [x for x in l if x % 2 == 0]\n    odd = [x for x in l if x % 2 != 0]\n    return even + odd', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3]]], 'plus_fail_tests': [[[1, 0, 3, 6, 5]]]}], 'HumanEval/38': [{'task_id': 'HumanEval/38', 'solution': '\n\ndef encode_cyclic(s: str):\n    """\n    returns encoded string by cycling groups of three characters.\n    """\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return "".join(groups)\n\n\ndef decode_cyclic(s: str):\n    """\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    """\ndef decode_cyclic(s: str):\n    return "".join([s[i:i+3] for i in range(0, len(s), 3)])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['uzfplzjfzcltmdly']], 'plus_fail_tests': [['abcdefghijk']]}], 'HumanEval/39': [{'task_id': 'HumanEval/39', 'solution': '\n\ndef prime_fib(n: int):\n    """\n    prime_fib returns n-th number that is a Fibonacci number and it\'s also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    """\ndef prime_fib(n: int) -> int:\n    fib_sequence = [2, 3]\n    while len(fib_sequence) < n:\n        fib_sequence.append(fib_sequence[-1] + fib_sequence[-2])\n    for num in fib_sequence:\n        if num > 1 and all(num % i != 0 for i in range(2, int(num ** 0.5) + 1)):\n            return num\n    return None\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[11]]}], 'HumanEval/40': [{'task_id': 'HumanEval/40', 'solution': '\n\ndef triples_sum_to_zero(l: list):\n    """\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    """\ndef triples_sum_to_zero(l):\n    seen = set()\n    for num in l:\n        if num in seen:\n            return True\n        seen.add(num)\n        if sum(l) == 0:\n            return True\n    return False', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 4, -5, 3, 9, 7]]], 'plus_fail_tests': [[[1, 2, -3, -4, 5, 6]]]}], 'HumanEval/41': [{'task_id': 'HumanEval/41', 'solution': '\n\ndef car_race_collision(n: int):\n    """\n    Imagine a road that\'s a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that\'s moving left to right hits a car that\'s moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    """\ndef car_race_collision(n: int) -> int:\n    collisions = 0\n    for i in range(n):\n        for j in range(n):\n            if i != j and (i + 1) % 2 == j % 2:\n                collisions += 1\n    return collisions\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[5]]}], 'HumanEval/42': [{'task_id': 'HumanEval/42', 'solution': '\n\ndef incr_list(l: list):\n    """Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    """\ndef incr_list(l):\n    return [x + 1 for x in l]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/43': [{'task_id': 'HumanEval/43', 'solution': 'def pairs_sum_to_zero(l):\n    seen = set()\n    for num in l:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, -2, 1]]], 'plus_fail_tests': [[[0, 1, -1]]]}], 'HumanEval/44': [{'task_id': 'HumanEval/44', 'solution': '\n\ndef change_base(x: int, base: int):\n    """Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    \'22\'\n    >>> change_base(8, 2)\n    \'1000\'\n    >>> change_base(7, 2)\n    \'111\'\n    """\ndef change_base(x: int, base: int) -> str:\n    if x == 0:\n        return \'0\'\n    result = \'\'\n    while x:\n        result = str(x % base) + result\n        x //= base\n    return result\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/45': [{'task_id': 'HumanEval/45', 'solution': 'def triangle_area(a, h):\n    return 0.5 * a * h', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/46': [{'task_id': 'HumanEval/46', 'solution': '\n\ndef fib4(n: int):\n    """The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that\'s defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    """\ndef fib4(n: int) -> int:\n    if n <= 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    else:\n        fib4_prev = 0\n       