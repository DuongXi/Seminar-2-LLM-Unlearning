ail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3]]], 'plus_fail_tests': [[[1, 0, 3, 6, 5]]]}], 'HumanEval/38': [{'task_id': 'HumanEval/38', 'solution': '\n\ndef encode_cyclic(s: str):\n    """\n    returns encoded string by cycling groups of three characters.\n    """\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return "".join(groups)\n\n\ndef decode_cyclic(s: str):\n    """\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    """\ndef decode_cyclic(s: str):\n    return "".join([s[i:i+3] for i in range(0, len(s), 3)])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['uzfplzjfzcltmdly']], 'plus_fail_tests': [['abcdefghijk']]}], 'HumanEval/39': [{'task_id': 'HumanEval/39', 'solution': '\n\ndef prime_fib(n: int):\n    """\n    prime_fib returns n-th number that is a Fibonacci number and it\'s also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    """\ndef prime_fib(n: int) -> int:\n    fib_sequence = [2, 3]\n    while len(fib_sequence) < n:\n        fib_sequence.append(fib_sequence[-1] + fib_sequence[-2])\n    for num in fib_sequence:\n        if num > 1 and all(num % i != 0 for i in range(2, int(num ** 0.5) + 1)):\n            return num\n    return None\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[11]]}], 'HumanEval/40': [{'task_id': 'HumanEval/40', 'solution': '\n\ndef triples_sum_to_zero(l: list):\n    """\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    """\ndef triples_sum_to_zero(l):\n    seen = set()\n    for num in l:\n        if num in seen:\n            return True\n        seen.add(num)\n        if sum(l) == 0:\n            return True\n    return False', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 4, -5, 3, 9, 7]]], 'plus_fail_tests': [[[1, 2, -3, -4, 5, 6]]]}], 'HumanEval/41': [{'task_id': 'HumanEval/41', 'solution': '\n\ndef car_race_collision(n: int):\n    """\n    Imagine a road that\'s a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that\'s moving left to right hits a car that\'s moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    """\ndef car_race_collision(n: int) -> int:\n    collisions = 0\n    for i in range(n):\n        for j in range(n):\n            if i != j and (i + 1) % 2 == j % 2:\n                collisions += 1\n    return collisions\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[5]]}], 'HumanEval/42': [{'task_id': 'HumanEval/42', 'solution': '\n\ndef incr_list(l: list):\n    """Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    """\ndef incr_list(l):\n    return [x + 1 for x in l]', 'base_