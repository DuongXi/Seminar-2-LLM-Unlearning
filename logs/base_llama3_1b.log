n result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/759': [{'task_id': 'Mbpp/759', 'solution': '"""\nWrite a function to check whether a given string is a decimal number with a precision of 2.\nassert is_decimal(\'123.11\')==True\n"""\ndef is_decimal(s):\n    try:\n        float(s)\n        return True\n    except ValueError:\n        return False', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['3.124587']], 'plus_fail_tests': [['123.1111']]}], 'Mbpp/760': [{'task_id': 'Mbpp/760', 'solution': '"""\nWrite a python function to check whether a list of numbers contains only one distinct element or not.\nassert unique_Element([1,1,1]) == True\n"""\ndef unique_Element(lst):\n    return len(lst) == 1', 'base_status': 'fail', 'plus_status': 'pass', 'base_fail_tests': [[[1, 1, 1]]], 'plus_fail_tests': []}], 'Mbpp/762': [{'task_id': 'Mbpp/762', 'solution': '"""\nWrite a function to check whether the given month number contains 30 days or not. Months are given as number from 1 to 12.\nassert check_monthnumber_number(6)==True\n"""\ndef check_monthnumber_number(month):\n    return month in [1, 2, 3, 4, 5, 6]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[1]]}], 'Mbpp/763': [{'task_id': 'Mbpp/763', 'solution': '"""\nWrite a python function to find the minimum difference between any two elements in a given array. \nassert find_min_diff((1,5,3,19,18,25),6) == 1\n"""\ndef find_min_diff(arr):\n    arr.sort()\n    return arr[-1] - arr[0]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 5, 3, 19, 18, 25], 6]], 'plus_fail_tests': [[[15, 12, 20, 30, 8, 4, 19, 37, 22, 28, 11, 25], 12]]}], 'Mbpp/764': [{'task_id': 'Mbpp/764', 'solution': '"""\nWrite a python function to count number of digits in a given string.\nassert number_ctr(\'program2bedone\') == 1\n"""\ndef number_ctr(s):\n    return s.count(\'2\')', 'base_status': 'fail', 'plus_stat