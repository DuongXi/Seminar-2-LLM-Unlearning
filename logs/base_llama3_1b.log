list(lst):\n    result = [[]]\n    for elem in lst:\n        result += [curr + [elem] for curr in result]\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['orange', 'red', 'green', 'blue']]], 'plus_fail_tests': [[['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']]]}], 'Mbpp/463': [{'task_id': 'Mbpp/463', 'solution': '"""\nWrite a function to find the maximum product subarray of the given array.\nassert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112\n"""\ndef max_subarray_product(nums):\n    max_product = float(\'-inf\')\n    current_product = 1\n    for num in nums:\n        current_product *= num\n        max_product = max(max_product, current_product)\n        if current_product < 0:\n            current_product = 1\n    return max_product', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, -2, -3, 0, 7, -8, -2]]], 'plus_fail_tests': [[[-2, 4, -6, 8, 10, -12, 14, -16]]]}], 'Mbpp/465': [{'task_id': 'Mbpp/465', 'solution': '"""\nWrite a function to drop empty items from a given dictionary.\nassert drop_empty({\'c1\': \'Red\', \'c2\': \'Green\', \'c3\':None})=={\'c1\': \'Red\', \'c2\': \'Green\'}\n"""\ndef drop_empty(d):\n    return {k: v for k, v in d.items() if v is not None}', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/468': [{'task_id': 'Mbpp/468', 'solution': '"""\nWrite a function to find the maximum product formed by multiplying numbers of an increasing subsequence of that array.\nassert max_product([3, 100, 4, 5, 150, 6]) == 3000\n"""\ndef max_product(nums):\n    stack = []\n    product = 1\n    for num in nums:\n        while stack and stack[-1] < num:\n            product *= stack.pop()\n        stack.append(num)\n        product *= num\n    while stack:\n        product /= stack.pop()\n    return product', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[3, 100, 4, 5, 150, 6]]], 'plus_fail_tests': [[[-3, -100, -4,