us_status': 'fail', 'base_fail_tests': [['python programming, python language', 'python']], 'plus_fail_tests': [['UPmVaKepPO', 'UPmVaKepPO']]}], 'Mbpp/775': [{'task_id': 'Mbpp/775', 'solution': '"""\nWrite a python function to check whether every odd index contains odd numbers of a given list.\nassert odd_position([2,1,4,3,6,7,6,3]) == True\n"""\ndef odd_position(lst):\n    return all(i % 2 != 0 for i in range(len(lst)))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 1, 4, 3, 6, 7, 6, 3]]], 'plus_fail_tests': [[[2, 5, 4, 3, 6, 7, 8, 9]]]}], 'Mbpp/777': [{'task_id': 'Mbpp/777', 'solution': '"""\nWrite a python function to find the sum of non-repeated elements in a given list.\nassert find_sum([1,2,3,1,1,4,5,6]) == 21\n"""\ndef find_sum(lst):\n    return sum(set(lst) - set([x for x in lst if lst.count(x) == 1])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/778': [{'task_id': 'Mbpp/778', 'solution': '"""\nWrite a function to pack consecutive duplicates of a given list elements into sublists.\nassert pack_consecutive_duplicates([0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4])==[[0, 0], [1], [2], [3], [4, 4], [5], [6, 6, 6], [7], [8], [9], [4, 4]]\n"""\ndef pack_consecutive_duplicates(lst):\n    result = []\n    current = []\n    for i in lst:\n        if i in current:\n            current.append(i)\n        else:\n            if current:\n                result.append(current)\n                current = []\n            result.append(i)\n    if current:\n        result.append(current)\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4]]], 'plus_fail_tests': [[[2, 5, 3, 1, 1, 0, 4, 4, 2, 3, 3]]]}], 'Mbpp/780': [{'task_id': 'Mbpp/780', 'solution': '"""\nWrite a function to find the combinations of sums with tuples in the given tuple list. \nassert find_combinations([(2, 4), (6, 7), (5, 1), (6, 10)]) == [(8, 11), (7, 5), (8, 14), (11, 8), (12, 17), (11, 11)]\n"""\ndef find_combinations(tuples):\n    def backtrack(start, path, total):\n        if len(path) == len(tuples):\n            result.append(path)\n            return\n        for i in range(start, len(tuples)):\n            total += tuples[i][0]\n            backtrack(i + 1, path + [tuples[i]], total)\n            total -= tuples[i][0]\n    \n    result = []\n    backtrack(0, [], 0)\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[1, 2, 3], [3, 4, 5]]]], 'plus_fail_tests': [[[[100, 200], [300, 400], [500, 600], [700, 800]]]]}], 'Mbpp/781': [{'task_id': 'Mbpp/781', 'solution': '"""\nWrite a python function to check whether the count of divisors is even. \nassert count_divisors(10)\n"""\ndef count_divisors(n):\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[10]], 'plus_fail_tests': [[1]]}], 'Mbpp/782': [{'task_id': 'Mbpp/782', 'solution': '"""\nWrite a python function to find the sum of all odd length subarrays. \nassert odd_length_sum([1,2,4]) == 14\n"""\ndef odd_length_sum(arr):\n    return sum(i for i in range(len(arr) for j in range(i+1, len(arr)+1) if arr[j] % 2 != 0)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/784': [{'task_id': 'Mbpp/784', 'solution': '"""\nWrite a function to find the product of first even and odd number of a given list.\nassert mul_even_odd([1,3,5,7,4,1,6,8])==4\n"""\ndef mul_even_odd(lst):\n    return sum(i % 2 == 0 for i in lst) * sum(i % 2 != 0 for i in lst)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, 5, 7, 4, 1, 6, 8]]], 'plus_fail_tests': [[[-10, -5, 0, 5, 10]]]}], 'Mbpp/785': [{'task_id': 'Mbpp/785', 'solution': '"""\nWrite a function to convert tuple string to integer tuple.\nassert tuple_str_int("(7, 8, 9)") == (7, 8, 9)\n"""\ndef tuple_str_int(s):\n    return tuple(map(int, s.split(\',\'))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/786': [{'task_id': 'Mbpp/786', 'solution': '"""\nWrite a function to locate the right insertion point for a specified value in sorted order.\nassert right_insertion([1,2,4,5],6)==4\n"""\ndef right_insertion(sorted_list, target):\n    left, right = 0, len(sorted_list) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if sorted_list[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return left', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[[50.64327388212607, -72.16612625583227, 95.25630303581863, -75.73998556144497, 11.857449640680656, -90.20293226837086, -12.02758648076636, -35.964731488229475], False]]}], 'Mbpp/787': [{'task_id': 'Mbpp/787', 'solution': '"""\nWrite a function that matches a string that has an a followed by three \'b\'.\nassert not text_match_three("ac")\n"""\ndef text_match_three(text):\n    return text.endswith(\'b\') and text.startswith(\'a\') and len(text) == 3', 'base_status': 'fail', 'plus_status': 'pass', 'base_fail_tests': [['abbbba']], 'plus_fail_tests': []}], 'Mbpp/788': [{'task_id': 'Mbpp/788', 'solution': '"""\nWrite a function to create a new tuple from the given string and list.\nassert new_tuple(["WEB", "is"], "best") == (\'WEB\', \'is\', \'best\')\n"""\ndef new_tuple(s, lst):\n    return tuple(s + lst)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['WEB', 'is'], 'best']], 'plus_fail_tests': [[[], '']]}], 'Mbpp/790': [{'task_id': 'Mbpp/790', 'solution': '"""\nWrite a python function to check whether every even index contains even numbers of a given list.\nassert even_position([3,2,1]) == False\n"""\ndef even_position(lst):\n    return all(i % 2 == 0 for i in range(len(lst)) if i % 2 == 0)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[3, 2, 1]]], 'plus_fail_tests': [[[2, 1, 4, 2, 6, 1, 8, 2, 10, 1, 12]]]}], 'Mbpp/791': [{'task_id': 'Mbpp/791', 'solution': '"""\nWrite a function to remove tuples from the given tuple.\nassert remove_nested((1, 5, 7, (4, 6), 10)) == (1, 5, 7, 10)\n"""\ndef remove_nested(tup):\n    return tuple(i for i in tup if not isinstance(i, tuple))', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/792': [{'task_id': 'Mbpp/792', 'solution': '"""\nWrite a python function to count the number of lists in a given number of lists.\nassert count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]]) == 4\n"""\ndef count_list(n):\n    return len(n)', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[[2, 3, [4, [5, [6, [7, [8, 9]]]]]]]]}], 'Mbpp/793': [{'task_id': 'Mbpp/793', 'solution': '"""\nWrite a python function to find the last position of an element in a sorted array.\nassert last([1,2,3],1) == 0\n"""\ndef last(arr, target):\n    left, right = 0, len(arr) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/794': [{'task_id': 'Mbpp/794', 'solution': '"""\nWrite a function that matches a string that has an \'a\' followed by anything, ending in \'b\'.\nassert text_starta_endb("aabbbb")\n"""\ndef text_starta_endb(text):\n    return text[-1]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['aabAbbbc']], 'plus_fail_tests': [['']]}], 'Mbpp/796': [{'task_id': 'Mbpp/796', 'solution': '"""\nWrite function to find the sum of all items in the given dictionary.\nassert return_sum({\'a\': 100, \'b\':200, \'c\':300}) == 600\n"""\ndef return_sum(d):\n    return sum(d.values())', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/797': [{'task_id': 'Mbpp/797', 'solution': '"""\nWrite a python function to find the sum of all odd natural numbers within the range l and r.\nassert sum_in_range(2,5) == 8\n"""\ndef sum_in_range(l, r):\n    return sum(i for i in range(l, r+1) if i % 2 != 0)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/798': [{'task_id': 'Mbpp/798', 'solution': '"""\nWrite a python function to find the sum of an array.\nassert _sum([1, 2, 3]) == 6\n"""\ndef _sum(arr):\n    return sum(arr)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/799': [{'task_id': 'Mbpp/799', 'solution': '"""\nWrite a function to that rotate left bits by d bits a given number. We assume that the number is 32 bit.\nassert left_rotate(16,2) == 64\n"""\ndef left_rotate(n, d):\n    return ((n << d) | (n >> (32 - d))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/800': [{'task_id': 'Mbpp/800', 'solution': '"""\nWrite a function to remove all whitespaces from a string.\nassert remove_all_spaces(\'python  program\')==(\'pythonprogram\')\n"""\ndef remove_all_spaces(s):\n    return s.replace(\' \', \'\')', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/801': [{'task_id': 'Mbpp/801', 'solution': '"""\nWrite a python function to count the number of equal numbers from three given integers.\nassert test_three_equal(1,1,1) == 3\n"""\ndef test_three_equal(a, b, c):\n    return a + b + c', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[-1, -2, -3]], 'plus_fail_tests': [[1, 2, 3]]}], 'Mbpp/803': [{'task_id': 'Mbpp/803', 'solution': '"""\nWrite a function to check whether the given number is a perfect square or not. \nassert not is_perfect_square(10)\n"""\ndef is_perfect_square(n):\n    i = 1\n    while i * i <= n:\n        if i * i == n:\n            return True\n        i += 1\n    return False', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[9223372036854775807]]}], 'Mbpp/804': [{'task_id': 'Mbpp/804', 'solution': '"""\nWrite a function to check whether the product of numbers in a list is even or not.\nassert is_product_even([1,2,3])\n"""\ndef is_product_even(numbers):\n    product = 1\n    for num in numbers:\n        product *= num\n    return product % 2 == 0', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/805': [{'task_id': 'Mbpp/805', 'solution': '"""\nWrite a function that returns the list in a list of lists whose sum of elements is the highest.\nassert max_sum_list([[1,2,3], [4,5,6], [10,11,12], [7,8,9]])==[10, 11, 12]\n"""\ndef max_sum_list(lst):\n    return [max(sublist) for sublist in lst for sublist in lst if sum(sublist) == max(sublist)]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[1, 2, 3], [4, 5, 6], [10, 11, 12], [7, 8, 9]]]], 'plus_fail_tests': [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]]]]}], 'Mbpp/806': [{'task_id': 'Mbpp/806', 'solution': '"""\nWrite a function to find maximum run of uppercase characters in the given string.\nassert max_run_uppercase(\'GeMKSForGERksISBESt\') == 5\n"""\ndef max_run_uppercase(s):\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if char.isupper():\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n    return max_run', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['Aaa']]}], 'Mbpp/807': [{'task_id': 'Mbpp/807', 'solution': '"""\nWrite a python function to find the first odd number in a given list of numbers.\nassert first_odd([1,3,5]) == 1\n"""\ndef first_odd(numbers):\n    for num in numbers:\n        if num % 2 != 0:\n            return num', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/808': [{'task_id': 'Mbpp/808', 'solution': '"""\nWrite a function to check if the given tuples contain the k or not.\nassert check_K((10, 4, 5, 6, 8), 6) == True\n"""\ndef check_K(tup, k):\n    return len(set(tup) <= k)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[10, 4, 5, 6, 8], 6]], 'plus_fail_tests': [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], [4, 5, 6]]]}], 'Mbpp/809': [{'task_id': 'Mbpp/809', 'solution': '"""\nWrite a function to check if each element of second tuple is smaller than its corresponding element in the first tuple.\nassert check_smaller((1, 2, 3), (2, 3, 4)) == False\n"""\ndef check_smaller(t1, t2):\n    for i in range(len(t1)):\n        if t1[i] > t2[i]:\n            return False\n    return True', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3], [2, 3, 4]]], 'plus_fail_tests': [[[3, 7, 11, 15, 19], [2, 6, 10, 14, 18]]]}]}}


