n to find the sum of fourth power of first n odd natural numbers.\nassert odd_num_sum(2) == 82\n"""\ndef odd_num_sum(n):\n    return sum(i**4 for i in range(1, n+1, 2))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[2]]}], 'Mbpp/771': [{'task_id': 'Mbpp/771', 'solution': '"""\nWrite a function to check if the given expression is balanced or not. \nassert check_expression("{()}[{}]") == True\n"""\ndef check_expression(expression):\n    stack = []\n    bracket_map = {\')\': \'(\', \'}\': \'{\', \']\': \'[\'}\n    for char in expression:\n        if char in bracket_map.values():\n            stack.append(char)\n        elif char in bracket_map.keys():\n            if not stack or stack.pop() != bracket_map[char]:\n                return False\n    return not stack', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['']]}], 'Mbpp/772': [{'task_id': 'Mbpp/772', 'solution': '"""\nWrite a function to remove all the words with k length in the given string.\nassert remove_length(\'The person is most value tet\', 3) == \'person is most value\'\n"""\ndef remove_length(s, k):\n    words = s.split()\n    return \' \'.join([word for word in words if len(word) < k])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['The person is most value tet', 3]], 'plus_fail_tests': [['This is a very long and complex sentence that contains words of different lengths such as abracadabra, internationalization, and antidisestablishmentarianism.', 10]]}], 'Mbpp/773': [{'task_id': 'Mbpp/773', 'solution': '"""\nWrite a function to find the occurrence and position of the substrings within a string. Return None if there is no match.\nassert occurance_substring(\'python programming, python language\',\'python\')==(\'python\', 0, 6)\n"""\ndef occurance_substring(main_string, sub_string):\n    return sub_string, main_string.find(sub_string), main_string.find(sub_string, 0)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['python programming, python language', 'python']], 'plus_fail_tests': [['UPmVaKepPO', 'UPmVaKepPO']]}], 'Mbpp/775': [{'task_id': 'Mbpp/775', 'solution': '"""\nWrite a python function to check whether every odd index contains odd numbers of a given list.\nassert odd_position([2,1,4,3,6,7,6,3]) == True\n"""\ndef odd_position(lst):\n    return all(i % 2 != 0 for i in range(len(lst)))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 1, 4, 3, 6, 7, 6, 3]]], 'plus_fail_tests': [[[2, 5, 4, 3, 6, 7, 8, 9]]]}], 'Mbpp/777': [{'task_id': 'Mbpp/777', 'solution': '"""\nWrite a python function to find the sum of non-repeated elements in a given list.\nassert find_sum([1,2,3,1,1,4,5,6]) == 21\n"""\ndef find_sum(lst):\n    return sum(set(lst) - set([x for x in lst if lst.count(x) == 1])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/778': [{'task_id': 'Mbpp/778', 'solution': '"""\nWrite a function to pack consecutive duplicates of a given list elements into sublists.\nassert pack_consecutive_duplicates([0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4])==[[0, 0], [1], [2], [3], [4, 4], [5], [6, 6, 6], [7], [8], [9], [4, 4]]\n"""\ndef pack_consecutive_duplicates(lst):\n    result = []\n    current = []\n    for i in lst:\n        if i in current:\n            current.append(i)\n        else:\n            if current:\n                result.append(current)\n                current = []\n            result.append(i)\n    if current:\n        result.append(current)\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[0, 0, 1, 2, 3, 4, 4, 5, 6, 6, 6, 7, 8, 9, 4, 4]]], 'plus_fail_tests': [[[2, 5, 3, 1, 1, 0, 4, 4, 2, 3, 3]]]}], 'Mbpp/780': [{'task_id': 'Mbpp/780', 'solution': '"""\nWrite a function to find the combinations of sums with tuples in the given tuple list. \nassert find_combinations([(2, 4), (6, 7), (5, 1), (6, 10)]) == [(8, 11), (7, 5), (8, 14), (11, 8), (12, 17), (11, 11)]\n"""\ndef find_combinations(tuples):\n    def backtrack(start, path, total):\n        if len(path) == len(tuples):\n            result.append(path)\n            return\n        for i in range(start, len(tuples)):\n            total += tuples[i][0]\n            backtrack(i + 1, path + [tuples[i]], total)\n            total -= tuples[i][0]\n    \n    result = []\n    backtrack(0, [], 0)\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[1, 2, 3], [3, 4, 5]]]], 'plus_fail_tests': [[[[100, 200], [300, 400], [500, 600], [700, 800]]]]}], 'Mbpp/781': [{'task_id': 'Mbpp/781', 'solution': '"""\nWrite a python function to check whether the count of divisors is even. \nassert count_divisors(10)\n"""\ndef count_divisors(n):\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[10]], 'plus_fail_tests': [[1]]}], 'Mbpp/782': [{'task_id': 'Mbpp/782', 'solution': '"""\nWrite a python function to find the sum of all odd length subarrays. \nassert odd_length_sum([1,2,4]) == 14\n"""\ndef odd_length_sum(arr):\n    return sum(i for i in range(len(arr) for j in range(i+1, len(arr)+1) if arr[j] % 2 != 0)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/784': [{'task_id': 'Mbpp/784', 'solution': '"""\nWrite a function to find the product of first even and odd number of a given list.\nassert mul_even_odd([1,3,5,7,4,1,6,8])==4\n"""\ndef mul_even_odd(lst):\n    return sum(i % 2 == 0 for i in lst) * sum(i % 2 != 0 for i in lst)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, 5, 7, 4, 1, 6, 8]]], 'plus_fail_tests': [[[-10, -5, 0, 5, 10]]]}], 'Mbpp/785': [{'task_id': 'Mbpp/785', 'solution': '"""\nWrite a function to convert tuple string to integer tuple.\nassert tuple_str_int("(7, 8, 9)") == (7, 8, 9)\