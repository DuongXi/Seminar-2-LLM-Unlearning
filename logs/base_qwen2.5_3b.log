atrix in ascending order according to the sum of its rows.\nassert sort_matrix([[1, 2, 3], [2, 4, 5], [1, 1, 1]])==[[1, 1, 1], [1, 2, 3], [2, 4, 5]]\n"""\ndef sort_matrix(matrix):\n    return sorted(matrix, key=sum)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/14': [{'task_id': 'Mbpp/14', 'solution': '"""\nWrite a python function to find the volume of a triangular prism.\nassert find_Volume(10,8,6) == 240\n"""\ndef find_Volume(base, height, length):\n    return (base * height * length) / 2\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/16': [{'task_id': 'Mbpp/16', 'solution': '"""\nWrite a function to that returns true if the input string contains sequences of lowercase letters joined with an underscore and false otherwise.\nassert text_lowercase_underscore("aab_cbbbc")==(True)\n"""\ndef text_lowercase_underscore(text):\n    return text.replace("_", "").islower()\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['_abc']]}], 'Mbpp/17': [{'task_id': 'Mbpp/17', 'solution': '"""\nWrite a function that returns the perimeter of a square given its side length as input.\nassert square_perimeter(10)==40\n"""\ndef square_perimeter(side_length):\n    return 4 * side_length\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/18': [{'task_id': 'Mbpp/18', 'solution': '"""\nWrite a function to remove characters from the first string which are present in the second string.\nassert remove_dirty_chars("probasscurve", "pros") == \'bacuve\'\n"""\ndef remove_dirty_chars(string1, string2):\n    return \'\'.join([char for char in string1 if char not in string2])\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/19': [{'task_id': 'Mbpp/19', 'solution': '"""\nWrite a function to find whether a given array of integers contains any