ue\n"""\ndef is_Monotonic(arr):\n    return all(arr[i] <= arr[i+1] for i in range(len(arr)-1)) or all(arr[i] >= arr[i+1] for i in range(len(arr)-1))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/69': [{'task_id': 'Mbpp/69', 'solution': '"""\nWrite a function to check whether a list contains the given sublist or not.\nassert is_sublist([2,4,3,5,7],[3,7])==False\n"""\ndef is_sublist(main_list, sub_list):\n    return sub_list in main_list\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 4, 3, 5, 7], [4, 3]]], 'plus_fail_tests': [[[], []]]}], 'Mbpp/70': [{'task_id': 'Mbpp/70', 'solution': '"""\nWrite a function to find whether all the given tuples have equal length or not.\nassert get_equal([(11, 22, 33), (44, 55, 66)]) == True\n"""\ndef get_equal(tuples):\n    return all(len(t) == len(tuples[0]) for t in tuples)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/71': [{'task_id': 'Mbpp/71', 'solution': '"""\nWrite a function to sort a list of elements.\nassert comb_sort([5, 15, 37, 25, 79]) == [5, 15, 25, 37, 79]\n"""\ndef comb_sort(lst):\n    gap = len(lst)\n    shrink_factor = 1.3\n    is_sorted = False\n\n    while not is_sorted:\n        gap = int(gap / shrink_factor)\n        if gap <= 1:\n            gap = 1\n            is_sorted = True\n\n        for i in range(len(lst) - gap):\n            if lst[i] > lst[i + gap]:\n                lst[i], lst[i + gap] = lst[i + gap], lst[i]\n                is_sorted = False\n\n    return lst\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/72': [{'task_id': 'Mbpp/72', 'solution': '"""\nWrite a python function to check whether the given number can be represented as the difference of two squares or not.\nassert dif_Square(5) == True\n"""\ndef dif_Square(n):\n    # Check if n is even\n    if n % 2 == 0:\n        return True\n    else:\n   