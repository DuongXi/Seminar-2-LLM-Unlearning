nction to find the sum of the product of consecutive binomial co-efficients.\nassert sum_Of_product(3) == 15\n"""\ndef sum_Of_product(n):\n    product = 1\n    for i in range(1, n+1):\n        product *= (n-i+1) / i\n    return int(product)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[3]], 'plus_fail_tests': [[10]]}], 'Mbpp/593': [{'task_id': 'Mbpp/593', 'solution': '"""\nWrite a function to remove leading zeroes from an ip address.\nassert removezero_ip("216.08.094.196")==(\'216.8.94.196\')\n"""\ndef removezero_ip(ip):\n    return \'.\'.join([str(int(part)) for part in ip.split(\'.\')])\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['0.0.0.0']]}], 'Mbpp/594': [{'task_id': 'Mbpp/594', 'solution': '"""\nWrite a function to find the difference of the first even and first odd number of a given list.\nassert diff_even_odd([1,3,5,7,4,1,6,8])==3\n"""\ndef diff_even_odd(lst):\n    even = None\n    odd = None\n    for num in lst:\n        if num % 2 == 0 and even is None:\n            even = num\n        elif num % 2 != 0 and odd is None:\n            odd = num\n        if even is not None and odd is not None:\n            break\n    return even - odd\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/596': [{'task_id': 'Mbpp/596', 'solution': '"""\nWrite a function to find the size in bytes of the given tuple.\nassert tuple_size(("A", 1, "B", 2, "C", 3) ) == sys.getsizeof(("A", 1, "B", 2, "C", 3))\n"""\nimport sys\n\ndef tuple_size(t):\n    return sys.getsizeof(t)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/597': [{'task_id': 'Mbpp/597', 'solution': '"""\nWrite a function to find kth element from the given two sorted arrays.\nassert find_kth([2, 3, 6, 7, 9], [1, 4, 8, 10], 5) == 6\n"""\ndef find_kth(arr1, arr2, k):\n    i = j = 0\n    while i < len(arr1) and j < len(arr2):\n        if arr1[i] < arr2[j]:\n            i += 1\n        else:\n            j += 1\n        if i + j == k:\n            return arr1[i] if i < len(arr1) else arr2[j]\n    if i == len(arr1):\n        return arr2[k - i]\n    return arr1[k - j]\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 3, 6, 7, 9], [1, 4, 8, 10], 5]], 'plus_fail_tests': [[[1, 2, 3], [], 1]]}], 'Mbpp/598': [{'task_id': 'Mbpp/598', 'solution': '"""\nWrite a function to check whether the given number is armstrong or not.\nassert armstrong_number(153)==True\n"""\ndef armstrong_number(num):\n    # Convert the number to a string to easily iterate over its digits\n    num_str = str(num)\n    \n    # Calculate the sum of the cubes of the digits\n    sum_of_cubes = sum(int(digit) ** 3 for digit in num_str)\n    \n    # Check if the sum of cubes is equal to the original number\n    return sum_of_cubes == num\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[3]]}], 'Mbpp/599': [{'task_id': 'Mbpp/599', 'solution': '"""\nWrite a function to find sum and average of first n natural numbers.\nassert sum_average(10)==(55, 5.5)\n"""\ndef sum_average(n):\n    sum = 0\n    for i in range(1, n+1):\n        sum += i\n    average = sum / n\n    return sum, average\n', 'base_status': 'pass', 'plus_status': 'timeout', 'base_fail_tests': [], 'plus_fail_tests': [[57]]}], 'Mbpp/600': [{'task_id': 'Mbpp/600', 'solution': '"""\nWrite a python function to check whether the given number is even or not.\nassert is_Even(1) == False\n"""\ndef is_Even(n):\n    return n % 2 == 0\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/602': [{'task_id': 'Mbpp/602', 'solution': '"""\nWrite a python function to find the first repeated character in a given string.\nassert first_repeated_char("abcabc") == "a"\n"""\ndef first_repeated_char(s):\n    seen = set()\n    for char in s:\n        if char in seen:\n            return char\n    