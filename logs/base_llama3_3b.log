ry(8) == \'1000\'\n"""\ndef decimal_to_binary(n):\n    return bin(n)[2:]', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[-5]]}], 'Mbpp/100': [{'task_id': 'Mbpp/100', 'solution': '"""\nWrite a function to find the next smallest palindrome of a specified integer, returned as an integer.\nassert next_smallest_palindrome(99)==101\n"""\ndef next_smallest_palindrome(n):\n    def is_palindrome(x):\n        return str(x) == str(x)[::-1]\n\n    n += 1\n    while not is_palindrome(n):\n        n += 1\n    return n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/101': [{'task_id': 'Mbpp/101', 'solution': '"""\nWrite a function to find the kth element in the given array using 1-based indexing.\nassert kth_element([12,3,5,7,19], 2) == 3\n"""\ndef kth_element(arr, k):\n    return arr[k-1]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/102': [{'task_id': 'Mbpp/102', 'solution': '"""\nWrite a function to convert a snake case string to camel case string.\nassert snake_to_camel(\'python_program\')==\'PythonProgram\'\n"""\ndef snake_to_camel(s):\n    words = s.split(\'_\')\n    return words[0] + \'\'.join(word.capitalize() for word in words[1:])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['python_program']], 'plus_fail_tests': [['___python_program']]}], 'Mbpp/103': [{'task_id': 'Mbpp/103', 'solution': '"""\nWrite a function to find the Eulerian number a(n, m).\nassert eulerian_num(3, 1) == 4\n"""\ndef eulerian_num(n, m):\n    if n == m:\n        return 1\n    else:\n        return (m * eulerian_num(n - 1, m - 1) + eulerian_num(n - 1, m))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[3, 1]], 'plus_fail_tests': [[0, 0]]}], 'Mbpp/104': [{'task_id': 'Mbpp/104', 'solution': '"""\nWrite a function to sort each sublist of strings in a given list of lists.\nassert sort_sublists((["green", "orang