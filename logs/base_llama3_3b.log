ue\', \'White\', \'Black\'])==[\'deR\', \'neerG\', \'eulB\', \'etihW\', \'kcalB\']\n"""\ndef reverse_string_list(lst):\n    return [s[::-1] for s in lst]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/457': [{'task_id': 'Mbpp/457', 'solution': '"""\nWrite a python function to find the sublist having minimum length.\nassert Find_Min([[1],[1,2],[1,2,3]]) == [1]\n"""\ndef Find_Min(lst):\n    return min(lst, key=len)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/458': [{'task_id': 'Mbpp/458', 'solution': '"""\nWrite a function to find the area of a rectangle.\nassert rectangle_area(10,20)==200\n"""\ndef rectangle_area(length, width):\n    return length * width', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/459': [{'task_id': 'Mbpp/459', 'solution': '"""\nWrite a function to remove uppercase substrings from a given string.\nassert remove_uppercase(\'cAstyoUrFavoRitETVshoWs\') == \'cstyoravoitshos\'\n"""\ndef remove_uppercase(s):\n    return \'\'.join(c for c in s if not c.isupper())', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['ThiS%^%!s&a(mY)TesTStR%i*ng']]}], 'Mbpp/460': [{'task_id': 'Mbpp/460', 'solution': '"""\nWrite a python function to get the first element of each sublist.\nassert Extract([[1, 2], [3, 4, 5], [6, 7, 8, 9]]) == [1, 3, 6]\n"""\ndef Extract(lst):\n    return [sublist[0] for sublist in lst]\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/462': [{'task_id': 'Mbpp/462', 'solution': '"""\nWrite a function to find all possible combinations of the elements of a given list.\nassert combinations_list([\'orange\', \'red\', \'green\', \'blue\'])==[[], [\'orange\'], [\'red\'], [\'red\', \'orange\'], [\'green\'], [\'green\', \'orange\'], [\'green\', \'red\'], [\'green\', \'red\', \'orange\'], [\'blue\'], [\'blue\', \'orange\'], [\'blue\', \'red\'], [\'blue\', \'red\', \'orange\'], [\'blue\', \'green\'], [\'blue\', \'green\', \'orange\'], [\'blue\', \'green\', \'red\'], [\'blue\', \'green\', \'red\', \'orange\']]\n"""\ndef combinations_list(lst):\n    def backtrack(start, path):\n        if len(path) == len(lst):\n            result.append(path)\n            return\n        for i in range(start, len(lst)):\n            backtrack(i + 1, path + [lst[i]])\n\n    result = []\n    backtrack(0, [])\n    return result', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['orange', 'red', 'green', 'blue']]], 'plus_fail_tests': [[['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']]]}], 'Mbpp/463': [{'task_id': 'Mbpp/463', 'solution': '"""\nWrite a function to find the maximum product subarray of the given array.\nassert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112\n"""\ndef max_subarray_product(nums):\n    if not nums:\n        return 0\n    max_product = min_product = result = nums[0]\n    for i in range(1, len(nums)):\n        if nums[i] < 0:\n            max_product, min_product = min_product, max_product\n        max_product = max(nums[i], max_product * nums[i])\n        min_product = min(nums[i], min_product * nums[i])\n        result = max(result, max_product)\n    return result', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/465': [{'task_id': 'Mbpp/465', 'solution': '"""\nWrite a function to drop empty items from a given dictionary.\nassert drop_empty({\'c1\': \'Red\', \'c2\': \'Green\', \'c3\':None})=={\'c1\': \'Red\', \'c2\': \'Green\'}\n"""\ndef drop_empty(d):\n    return {k:v for k,v in d.items() if v}', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[{'a': {'b': None, 'c': 'Yellow'}, 'd': {}, 'e': {'f': None, 'g': 'Blue'}}]]}], 'Mbpp/468': [{'task_id': 'Mbpp/468', 'solution': '"""\nWrite a function to find the maximum product formed by 