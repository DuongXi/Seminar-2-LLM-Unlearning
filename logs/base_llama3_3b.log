stance(element, list):\n            result.extend(flatten_list(element))\n        else:\n            result.append(element)\n    return result', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/299': [{'task_id': 'Mbpp/299', 'solution': '"""\nWrite a function to calculate the maximum aggregate from the list of tuples.\nassert max_aggregate([(\'Juan Whelan\',90),(\'Sabah Colley\',88),(\'Peter Nichols\',7),(\'Juan Whelan\',122),(\'Sabah Colley\',84)])==(\'Juan Whelan\', 212)\n"""\ndef max_aggregate(lst):\n    return max(lst, key=lambda x: sum(x[1]))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[['Juan Whelan', 90], ['Sabah Colley', 88], ['Peter Nichols', 7], ['Juan Whelan', 122], ['Sabah Colley', 84]]]], 'plus_fail_tests': [[[['Alice', 80], ['Bob', 90], ['Charlie', 70], ['Alice', 60], ['Bob', 50], ['Charlie', 40]]]]}], 'Mbpp/300': [{'task_id': 'Mbpp/300', 'solution': '"""\nWrite a function to find the count of all binary sequences of length 2n such that sum of first n bits is same as sum of last n bits.\nassert math.isclose(count_binary_seq(1), 2.0, rel_tol=0.001)\n"""\ndef count_binary_seq(n):\n    def count(x):\n        return bin(x).count(\'1\')\n    return sum(count(i) for i in range(2**n) if count(i) == count(i >> n))\n\ndef math(isclose, a, b, rel_tol):\n    return abs(a - b) <= rel_tol * max(abs(a), abs(b))\n\ndef count_binary_seq(n):\n    def count(x):\n        return bin(x).count(\'1\')\n    return sum(count(i) for i in range(2**n) if count(i) == count(i >> n))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[1]], 'plus_fail_tests': [[4]]}], 'Mbpp/301': [{'task_id': 'Mbpp/301', 'solution': '"""\nWrite a function to find the depth of a dictionary.\nassert dict_depth({\'a\':1, \'b\': {\'c\': {\'d\': {}}}})==4\n"""\ndef dict_depth(d, depth=1):\n    if not isinstance(d, dict):\n        return depth\n    max_depth = depth\n    for v in d.values():\n        if isinstance(v, dict):\n            max_depth = max(max_depth, dict_depth(v, depth + 1))\n    return max_depth', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/305': [{'task_id': 'Mbpp/305', 'solution': '"""\nWrite a function to return two words from a list of words starting with letter \'p\'.\nassert start_withp(["Python PHP", "Java JavaScript", "c c++"])==(\'Python\', \'PHP\')\n"""\ndef start_withp(words):\n    return tuple(word for word in words if word.startswith(\'p\'))', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['Python PHP', 'Java JavaScript', 'c c++']]], 'plus_fail_tests': [[['Python Programming', 'Java Programming', 'Perl Programming', 'Ruby Programming', 'PHP Programming', 'C Programming']]]}], 'Mbpp/306': [{'task_id': 'Mbpp/306', 'solution': '"""\nWrite a function to find the maximum sum of increasing subsequence from prefix until ith index and also including a given kth element which is after i, i.e., k > i .\nassert max_sum_increasing_subseq([1, 101, 2, 3, 100, 4, 5 ], 7, 4, 6) == 11\n"""\ndef max_sum_increasing_subseq(arr, i, k, n):\n    dp = [[0] * (n+1) for _ in range(n+1)]\n    for j in range(1, n+1):\n        for last in range(1, n+1):\n            if arr[j-1] > arr[last-1]:\n                dp[j][last] = max(dp[j-1][last], dp[j][last-1] + arr[j-1])\n            else:\n                dp[j][last] = dp[j][last-1]\n    return dp[i][k]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 101, 2, 3, 100, 4, 5], 7, 4, 6]], 'plus_fail_tests': [[[5, 2, 4, 1, 3, 6], 6, 1, 3]]}], 'Mbpp/308': [{'task_id': 'Mbpp/308', 'solution': '"""\nWrite a function to find the specified number of largest products from two given lists, selecting one factor from each list.\nassert large_product([1, 2, 3, 4, 5, 6],[3, 6, 8, 9, 10, 6],3)==[60, 54, 50]\n"""\ndef large_product(list1, list2, n):\n    return sorted([a * b for a, b in zip(sorted(list1, reverse=True)[:n], sorted(list2, reverse=True)[:n]])', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/309': [{'task_id': 'Mbpp/309', 'solution': '"""\nWrite a python function to find the maximum of two numbers.\nassert maximum(5,10) == 10\n"""\ndef maximum(a, b):\n    return max(a, b)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/310': [{'task_id': 'Mbpp/310', 'solution': '"""\nWrite a function to convert a given string to a tuple of characters.\nassert string_to_tuple("python 3.0")==(\'p\', \'y\', \'t\', \'h\', \'o\', \'n\', \'3\', \'.\', \'0\')\n"""\ndef string_to_tuple(s):\n    return tuple(s)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['python 3.0']], 'plus_fail_tests': [['hello   world']]}], 'Mbpp/311': [{'task_id': 'Mbpp/311', 'solution': '"""\nWrite a python function to set the left most unset bit.\nassert set_left_most_unset_bit(10) == 14\n"""\ndef set_left_most_unset_bit(n):\n    return n | (n & -n)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[10]], 'plus_fail_tests': [[125]]}], 'Mbpp/312': [{'task_id': 'Mbpp/312', 'solution': '"""\nWrite a function to find the volume of a cone.\nassert math.isclose(volume_cone(5,12), 314.15926535897927, rel_tol=0.001)\n"""\nimport math\n\ndef volume_cone(r, h):\n    return (1.0/3) * math.pi * r**2 * h', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/388': [{'task_id': 'Mbpp/388', 'solution': '"""\nWrite a python function to find the highest power of 2 that is less than or equal to n.\nassert highest_Power_of_2(10) == 8\n"""\ndef highest_Power_of_2(n):\n    power = 1\n    while power <= n:\n        power *= 2\n    return power // 2', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/389': [{'task_id': 'Mbpp/389', 'solution': '"""\nWrite a function to find the n\'th lucas number.\nassert find_lucas(9) == 76\n"""\ndef find_lucas(n):\n    if n <= 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/390': [{'task_id': 'Mbpp/390', 'solution': '"""\nWrite a function to apply a given format string to all of the elements in a list.\nassert add_string([1,2,3,4],\'temp{0}\')==[\'temp1\', \'temp2\', \'temp3\', \'temp4\']\n"""\ndef add_string(lst, format_str):\n    return [format_str.format(i) for i in lst]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/391': [{'task_id': 'Mbpp/391', 'solution': '"""\nWrite a function to convert more than one list to nested dictionary.\nassert convert_list_dictionary(["S001", "S002", "S003", "S004"],["Adina Park", "Leyton Marsh", "Duncan Boyle", "Saim Richards"] ,[85, 98, 89, 92])==[{\'S001\': {\'Adina Park\': 85}}, {\'S002\': {\'Leyton Marsh\': 98}}, {\'S003\': {\'Duncan Boyle\': 89}}, {\'S004\': {\'Saim Richards\': 92}}]\n"""\ndef convert_list_dictionary(keys, values, scores):\n    return [{key: {value: score} for key, value, score in zip(keys, values, scores)}]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['S001', 'S002', 'S003', 'S004'], ['Adina Park', 'Leyton Marsh', 'Duncan Boyle', 'Saim Richards'], [85, 98, 89, 92]]], 'plus_fail_tests': [[['abc', 'def', 'ghi', 'jkl'], ['python', 'program', 'language', 'programs'], [{'1': 'a', '2': 'b'}, {'3': 'c'}, 4, ['x', 'y', 'z']]]]}], 'Mbpp/392': [{'task_id': 'Mbpp/392', 'solution': '"""\nWrite a function to find the maximum sum possible by using the given equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\nassert get_max_sum(60) == 106\n"""\ndef get_max_sum(n):\n    memo = {}\n    def f(x):\n        if x in memo: return memo[x]\n        if x == 1: return x\n        max_sum = 0\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                max_sum = max(max_sum, f(x // i) + f(i) + f(x // i) + f(i))\n        memo[x] = max_sum\n        return max_sum\n    return f(n)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[60]], 'plus_fail_tests': [[100]]}], 'Mbpp/394': [{'task_id': 'Mbpp/394', 'solution': '"""\nWrite a function to check if given tuple contains no duplicates.\nassert check_distinct((1, 4, 5, 6, 1, 4)) == False\n"""\ndef check_distinct(t):\n    return len(t) == len(set(t))', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/395': [{'task_id': 'Mbpp/395', 'solution': '"""\nWrite a python function to find the first non-repeated character in a given string.\nassert first_non_repeating_character("abcabc") == None\n"""\ndef first_non_repeating_character(s):\n    char_count = {}\n    for char in s:\n        if char in char_count:\n            char_count[char] += 1\n        else:\n            char_count[char] = 1\n    for char in s:\n        if char_count[char] == 1:\n            return char\n    return None', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/397': [{'task_id': 'Mbpp/397', 'solution': '"""\nWrite a function to find the median of three numbers.\nassert median_numbers(25,55,65)==55.0\n"""\ndef median_numbers(a, b, c):\n    return sorted([a, b, c])[1]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/398': [{'task_id': 'Mbpp/398', 'solution': '"""\nWrite a function to compute the sum of digits of each number of a given list.\nassert sum_of_digits([10,2,56])==14\n"""\ndef sum_of_digits(numbers):\n    return sum(sum(int(digit) for digit in str(n)) for n in numbers)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[10, 20, 4, 5, 'b', 70, 'a']]]], 'plus_fail_tests': [[[-10, 15, 0, -5, 2]]]}], 'Mbpp/404': [{'task_id': 'Mbpp/404', 'solution': '"""\nWrite a python function to find the minimum of two numbers.\nassert minimum(1,2) == 1\n"""\ndef minimum(a, b):\n    return min(a, b)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/405': [{'task_id': 'Mbpp/405', 'solution': '"""\nWrite a function to check whether an element exists within a tuple.\nassert check_tuplex(("w", 3, "r", "e", "s", "o", "u", "r", "c", "e"),\'r\')==True\n"""\ndef check_tuplex(tuplex, element):\n    return element in tuplex', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/406': [{'task_id': 'Mbpp/406', 'solution': '"""\nWrite a python function to find whether the parity of a given number is odd.\nassert find_Parity(12) == False\n"""\ndef find_Parity(n):\n    return n % 2 == 0', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[12]], 'plus_fail_tests': [[0]]}], 'Mbpp/409': [{'task_id': 'Mbpp/409', 'solution': '"""\nWrite a function to find the minimum product from the pairs of tuples within a given list.\nassert min_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)] )==8\n"""\ndef min_product_tuple(lst):\n    return min(t[0]*t[1] for t in lst)', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/410': [{'task_id': 'Mbpp/410', 'solution': '"""\nWrite a function to find the minimum value in a given heterogeneous list.\nassert min_val([\'Python\', 3, 2, 4, 5, \'version\'])==2\n"""\ndef min_val(lst):\n    return min(lst)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['Python', 3, 2, 4, 5, 'version']]], 'plus_fail_tests': [[['Python', 10, 5, 2.5, 2.5, 'version']]]}], 'Mbpp/412': [{'task_id': 'Mbpp/412', 'solution': '"""\nWrite a python function to remove odd numbers from a given list.\nassert remove_odd([1,2,3]) == [2]\n"""\ndef remove_odd(lst):\n    return [i for i in lst if i % 2 == 0]', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/413': [{'task_id': 'Mbpp/413', 'solution': '"""\nWrite a function to extract the nth element from a given list of tuples.\nassert extract_nth_element([(\'Greyson Fulton\', 98, 99), (\'Brady Kent\', 97, 96), (\'Wyatt Knott\', 91, 94), (\'Beau Turnbull\', 94, 98)] ,0)==[\'Greyson Fulton\', \'Brady Kent\', \'Wyatt Knott\', \'Beau Turnbull\']\n"""\ndef extract_nth_element(lst, n):\n    return [t[0] for t in lst]', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[['Greyson Fulton', 98, 99], ['Brady Kent', 97, 96], ['Wyatt Knott', 91, 94], ['Beau Turnbull', 94, 98]], 2]], 'plus_fail_tests': [[[['John Doe', 78, 90, 82], ['Jane Smith', 92, 87, 84], ['Mark Johnson', 79, 85, 91], ['Emily Brown', 88, 91, 89]], 1]]}], 'Mbpp/414': [{'task_id': 'Mbpp/414', 'solution': '"""\nWrite a python function to check whether any value in a sequence exists in a sequence or not.\nassert overlapping([1,2,3,4,5],[6,7,8,9]) == False\n"""\ndef overlapping(seq1, seq2):\n    return len(set(seq1) & set(seq2)) > 0\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/415': [{'task_id': 'Mbpp/415', 'solution': '"""\nWrite a python function to find a pair with highest product from a given array of integers.\nassert max_Product([1,2,3,4,7,0,8,4]) == (7,8)\n"""\ndef max_Product(nums):\n    max1 = max2 = float(\'-inf\')\n    min1 = min2 = float(\'inf\')\n    result = float(\'-inf\')\n    for num in nums:\n        if num < min1:\n            min1, min2 = num, min1\n        elif num < min2:\n            min2 = num\n        if num > max1:\n            max1, max2 = num, max1\n        elif num > max2:\n            max2 = num\n        if num * max1 > result:\n            result = num * max1\n    return (max1, max2) if result != float(\'-inf\') else (max1, max1)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3, 4, 7, 0, 8, 4]]], 'plus_fail_tests': [[[-2, -1, 0, 1, 2, 3, 4, 5,