ther the count of divisors is even. \nassert count_divisors(10)\n"""\ndef count_divisors(n):\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count % 2 == 0\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[987654321]]}], 'Mbpp/782': [{'task_id': 'Mbpp/782', 'solution': '"""\nWrite a python function to find the sum of all odd length subarrays. \nassert odd_length_sum([1,2,4]) == 14\n"""\ndef odd_length_sum(arr):\n    return sum(sum(arr[i:i+2] for i in range(len(arr)-1) if len(arr[i:i+2]) % 2 != 0)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/784': [{'task_id': 'Mbpp/784', 'solution': '"""\nWrite a function to find the product of first even and odd number of a given list.\nassert mul_even_odd([1,3,5,7,4,1,6,8])==4\n"""\ndef mul_even_odd(lst):\n    even = 1\n    odd = 1\n    for num in lst:\n        if num % 2 == 0:\n            even *= num\n        else:\n            odd *= num\n    return even * odd', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, 5, 7, 4, 1, 6, 8]]], 'plus_fail_tests': [[[-10, -5, 0, 5, 10]]]}], 'Mbpp/785': [{'task_id': 'Mbpp/785', 'solution': '"""\nWrite a function to convert tuple string to integer tuple.\nassert tuple_str_int("(7, 8, 9)") == (7, 8, 9)\n"""\ndef tuple_str_int(s):\n    return tuple(map(int, s.strip(\'()\').split(\',\')))', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/786': [{'task_id': 'Mbpp/786', 'solution': '"""\nWrite a function to locate the right insertion point for a specified value in sorted order.\nassert right_insertion([1,2,4,5],6)==4\n"""\ndef right_insertion(lst, value):\n    left, right = 0, len(lst) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if lst[mid] < value:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return left