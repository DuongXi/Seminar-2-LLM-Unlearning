ck("himenss","simen") => True\n\n    """\ndef cycpattern_check(a, b):\n    for i in range(len(b)):\n        if b in a:\n            return True\n        a = a[1:] + a[0]\n    return False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['efef', 'fee']], 'plus_fail_tests': [['banana', 'nab']]}], 'HumanEval/155': [{'task_id': 'HumanEval/155', 'solution': 'def even_odd_count(num):\n    even = sum(1 for digit in str(abs(num)) if int(digit) % 2 == 0)\n    odd = len(str(abs(num))) - even\n    return (even, odd)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/156': [{'task_id': 'HumanEval/156', 'solution': 'def int_to_mini_roman(number):\n    val = [\n        1000, 900, 500, 400,\n        100, 90, 50, 40,\n        10, 9, 5, 4,\n        1\n        ]\n    syb = [\n        "m", "cm", "d", "cd",\n        "c", "xc", "l", "xl",\n        "x", "ix", "v", "iv",\n        "i"\n        ]\n    roman_num = \'\'\n    i = 0\n    while  number > 0:\n        for _ in range(number // val[i]):\n            roman_num += syb[i]\n            number -= val[i]\n        i += 1\n    return roman_num.lower()\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/157': [{'task_id': 'HumanEval/157', 'solution': 'def right_angle_triangle(a, b, c):\n    return a**2 + b**2 == c**2 or a**2 + c**2 == b**2 or b**2 + c**2 == a**2\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/158': [{'task_id': 'HumanEval/158', 'solution': 'def find_max(words):\n    def unique_chars(word):\n        return len(set(word))\n\n    max_len = max(unique_chars(word) for word in words)\n    return next(word for word in words if unique_chars(word) == max_len)', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['name', 'enam', 'game']]], 'plus_fail_tests': [[['xyz', 'pqr']]]}], 'HumanEval/159': [{'task_id': 'HumanEval/159', 'solution': 'def eat(number, need, remaining):\n    total = number + need\n    return [total, max(0, remaining - total)]\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[5, 6, 10]], 'plus_fail_tests': [[10, 0, 10]]}], 'HumanEval/160': [{'task_id': 'HumanEval/160', 'solution': "def do_algebra(operator, operand):\n    result = operand[0]\n    for i in range(1, len(operand)):\n        if operator[i-1] == '+':\n            result += operand[i]\n        elif operator[i-1] == '-':\n            result -= operand[i]\n        elif operator[i-1] == '*':\n            result *= operand[i]\n        elif operator[i-1] == '//':\n            result //= operand[i]\n        elif operator[i-1] == '**':\n            result **= operand[i]\n    return result\n", 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['+', '*', '-'], [2, 3, 4, 5]]], 'plus_fail_tests': [[['+', '-', '*', '//'], [5, 2, 3, 4, 7]]]}], 'HumanEval/161': [{'task_id': 'HumanEval/161', 'solution': "def solve(s):\n    return ''.join(c.upper() if c.isalpha() else c.lower() if c.isdigit() else c for c in s)\n", 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['AsDf']], 'plus_fail_tests': [['ABCDEFG']]}], 'HumanEval/162': [{'task_id': 'HumanEval/162', 'solution': 'import hashlib\n\ndef string_to_md5(text):\n    if not text:\n        return None\n    return hashlib.md5(text.encode()).hexdigest()\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/163': [{'task_id': 'HumanEval/163', 'solution': 'def generate_integers(a, b):\n    return sorted(set(str(i) for i in range(a, b+1) if i % 2 == 0))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2, 10]], 'plus_fail_tests': [[6, 12]]}]}}
