']], 'plus_fail_tests': [['abcdefghijk']]}], 'HumanEval/39': [{'task_id': 'HumanEval/39', 'solution': 'def prime_fib(n: int):\n    def is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    a, b = 0, 1\n    while True:\n        a, b = b, a + b\n        if is_prime(b):\n            return b\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[11]]}], 'HumanEval/40': [{'task_id': 'HumanEval/40', 'solution': 'def triples_sum_to_zero(l: list):\n    seen = set()\n    for num in l:\n        if -num in seen:\n            return True\n        seen.add(num)\n    return False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 3, 5, -1]]], 'plus_fail_tests': [[[1, 1, -2, -2]]]}], 'HumanEval/41': [{'task_id': 'HumanEval/41', 'solution': 'def car_race_collision(n: int):\n    return n * (n - 1) // 2\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[5]]}], 'HumanEval/42': [{'task_id': 'HumanEval/42', 'solution': 'def incr_list(l: list):\n    return [x + 1 for x in l]\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/43': [{'task_id': 'HumanEval/43', 'solution': 'def pairs_sum_to_zero(l):\n    seen = set()\n    for num in l:\n        if -num in seen:\n            return True\n        seen.add(num)\n    return False\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/44': [{'task_id': 'HumanEval/44', 'solution': 'def change_base(x: int, base: int):\n    convertString = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"\n    if x < base:\n        return convertString[x]\n    else:\n        return change_base(x // base, base) + convertString[x % base]\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests'