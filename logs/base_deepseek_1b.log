\n"""\ndef text_match_wordz(text):\n    return \'z\' in text\n\nprint(text_match_wordz("pythonz."))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/455': [{'task_id': 'Mbpp/455', 'solution': '"""\nWrite a function to check whether the given month number contains 31 days or not.\nassert check_monthnumb_number(5)==True\n"""\ndef check_monthnumb_number(month_number):\n    if month_number in [1, 3, 5, 7, 8, 10, 12]:\n        return True\n    else:\n        return False\n\n# Test cases\nprint(check_monthnumb_number(5))  # Expected output: True\nprint(check_monthnumb_number(10))  # Expected output: False\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/456': [{'task_id': 'Mbpp/456', 'solution': '"""\nWrite a function to reverse each string in a given list of string values.\nassert reverse_string_list([\'Red\', \'Green\', \'Blue\', \'White\', \'Black\'])==[\'deR\', \'neerG\', \'eulB\', \'etihW\', \'kcalB\']\n"""\ndef reverse_string_list(str_list):\n    return [s[::-1] for s in str_list]\n\n# Testing the function\nassert reverse_string_list([\'Red\', \'Green\', \'Blue\', \'White\', \'Black\'])==[\'deR\', \'neerG\', \'eulB\', \'etihW\', \'kcalB\']\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/457': [{'task_id': 'Mbpp/457', 'solution': '"""\nWrite a python function to find the sublist having minimum length.\nassert Find_Min([[1],[1,2],[1,2,3]]) == [1]\n"""\ndef Find_Min(lst):\n    min_length = len(lst[0])\n    min_sublist = lst[0]\n    for sublist in lst:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n    return min_sublist\n\nprint(Find_Min([[1],[1,2],[1,2,3]]))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/458': [{'task_id': 'Mbpp/458', 'solution': '"""\nWrite a function to find the area of a rectangle.\nassert rectangle_area(10,20)==200\n"""\ndef rectangle_area(length, width):\n    return length * width\n\n# Test cases\nassert rectangle_area(10, 20) == 200\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/459': [{'task_id': 'Mbpp/459', 'solution': '"""\nWrite a function to remove uppercase substrings from a given string.\nassert remove_uppercase(\'cAstyoUrFavoRitETVshoWs\') == \'cstyoravoitshos\'\n"""\ndef remove_uppercase(s):\n    return \'\'.join([i for i in s if not i.isupper()])\n\nprint(remove_uppercase(\'cAstyoUrFavoRitETVshoWs\'))\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['ThiS%^%!s&a(mY)TesTStR%i*ng']]}], 'Mbpp/460': [{'task_id': 'Mbpp/460', 'solution': '"""\nWrite a python function to get the first element of each sublist.\nassert Extract([[1, 2], [3, 4, 5], [6, 7, 8, 9]]) == [1, 3, 6]\n"""\ndef Extract(lst):\n    return [lst[0][0] if lst else [] for lst in lst]\n\nprint(Extract([[1, 2], [3, 4, 5], [6, 7, 8, 9]]))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/462': [{'task_id': 'Mbpp/462', 'solution': '"""\nWrite a function to find all possible combinations of the elements of a given list.\nassert combinations_list([\'orange\', \'red\', \'green\', \'blue\'])==[[], [\'orange\'], [\'red\'], [\'red\', \'orange\'], [\'green\'], [\'green\', \'orange\'], [\'green\', \'red\'], [\'green\', \'red\', \'orange\'], [\'blue\'], [\'blue\', \'orange\'], [\'blue\', \'red\'], [\'blue\', \'red\', \'orange\'], [\'blue\', \'green\'], [\'blue\', \'green\', \'orange\'], [\'blue\', \'green\', \'red\'], [\'blue\', \'green\', \'red\', \'orange\']]\n"""\ndef combinations_list(lst):\n    if not lst:\n        return [[]]\n    else:\n        result = []\n        for combination in combinations_list(lst[1:]):\n            result.append(combination)\n            result.append([lst[0]] + combination)\n        return result\n\nprint(combinations_list([\'orange\', \'red\', \'green\', \'blue\']))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[['orange', 'red', 'green', 'blue']]], 'plus_fail_tests': [[['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']]]}], 'Mbpp/463': [{'task_id': 'Mbpp/463', 'solution': '"""\nWrite a function to find the maximum product subarray of the given array.\nassert max_subarray_product([1, -2, -3, 0, 7, -8, -2]) == 112\n"""\ndef max_subarray_product(arr):\n    if len(arr) == 0:\n        return 0\n\n    max_product = arr[0]\n    min_product = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        if arr[i] < 0:\n            max_product, min_product = min_product, max_product\n\n        max_product = max(arr[i], max_product * arr[i])\n        min_product = min(arr[i], min_product * arr[i])\n\n        result = max(result, max_product)\n\n    return result\n\nprint(max_subarray_product([1, -2, -3, 0, 7, -8, -2]))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/465': [{'task_id': 'Mbpp/465', 'solution': '"""\nWrite a function to drop empty items from a given dictionary.\nassert drop_empty({\'c1\': \'Red\', \'c2\': \'Green\', \'c3\':None})=={\'c1\': \'Red\', \'c2\': \'Green\'}\n"""\ndef drop_empty(dictionary):\n    return {key: value for key, value in dictionary.items() if value}\n\n# Testing the function\nassert drop_empty({\'c1\': \'Red\', \'c2\': \'Green\', \'c3\':None})=={\'c1\': \'Red\', \'c2\': \'Green\'}\n', 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [[{'a': {'b': None, 'c': 'Yellow'}, 'd': {}, 'e': {'f': None, 'g': 'Blue'}}]]}], 'Mbpp/468': [{'task_id': 'Mbpp/468', 'solution': '"""\nWrite a function to find the maximum product formed by multiplying numbers of an increasing subsequence of that array.\nassert max_product([3, 100, 4, 5, 150, 6]) == 3000\n"""\ndef max_product(arr):\n    n = len(arr)\n    max_d = [0]*n\n    min_d = [0]*n\n    max_d[0] = min_d[0] = arr[0]\n    for i in range(1, n):\n        if arr[i] > 0:\n            max_d[i] = max(arr[i], max_d[i-1]*arr[i])\n            min_d[i] = min(arr[i], min_d[i-1]*arr[i])\n        else:\n            max_d[i] = max(arr[i], min_d[i-1]*arr[i])\n            min_d[i] = min(arr[i], max_d[i-1]*arr[i])\n    return max(max_d)\n\nprint(max_product([3, 100, 4, 5, 150, 6]))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[3, 100, 4, 5, 150, 6]]], 'plus_fail_tests': [[[-3, -100, -4, -5, -150, -6]]]}], 'Mbpp/470': [{'task_id': 'Mbpp/470', 'solution': '"""\nWrite a function to find the pairwise addition of the neighboring elements of the given tuple.\nassert add_pairwise((1, 5, 7, 8, 10)) == (6, 12, 15, 18)\n"""\ndef add_pairwise(tup):\n    return tuple(a + b for a, b in zip(tup, tup[1:]))\n\nprint(add_pairwise((1, 5, 7, 8, 10)))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/471': [{'task_id': 'Mbpp/471', 'solution': '"""\nWrite a python function to find the product of the array multiplication modulo n.\nassert find_remainder([ 100, 10, 5, 25, 35, 14 ],11) ==9\n"""\ndef find_remainder(arr, n):\n    product = 1\n    for i in arr:\n        product = (product * i) % n\n    return product\n\nprint(find_remainder([100, 10, 5, 25, 35, 14], 11))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/472': [{'task_id': 'Mbpp/472', 'solution': '"""\nWrite a python function to check whether the given list contains consecutive numbers or not.\nassert check_Consecutive([1,2,3,4,5]) == True\n"""\ndef check_Consecutive(lst):\n    if len(lst) == 0:\n        return False\n    else:\n        return all(lst[i] - lst[i-1] == 1 for i in range(1, len(lst)))\n\n# Test cases\nprint(check_Consecutive([1,2,3,4,5])) # True\nprint(check_Consecutive([1,2,4,5])) # False\nprint(check_Consecutive([2,4,6,8])) # True\nprint(check_Co