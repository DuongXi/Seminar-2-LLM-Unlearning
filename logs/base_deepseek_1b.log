) <= 100\n        2. 1 <= k <= len(arr)\n    """\n    return sum(i for i in arr[:k] if 100 > i >= 10)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, -2, -3, 41, 57, 76, 87, 88, 99], 3]], 'plus_fail_tests': [[[-4, 5, 67, 34, 56, 12, 89, 23, 45], 7]]}], 'HumanEval/123': [{'task_id': 'HumanEval/123', 'solution': 'def get_odd_collatz(n):\n    def collatz(n):\n        sequence = [n]\n        while n != 1:\n            if n % 2 == 0:\n                n = n // 2\n            else:\n                n = 3 * n + 1\n            sequence.append(n)\n        return sequence\n\n    sequence = collatz(n)\n    return sorted([num for num in sequence if num % 2 != 0])\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/124': [{'task_id': 'HumanEval/124', 'solution': "def valid_date(date):\n    if not date or len(date.split('-')) != 3:\n        return False\n    month, day, year = map(int, date.split('-'))\n    if month < 1 or month > 12 or day < 1:\n        return False\n    if month in [1, 3, 5, 7, 8, 10, 12] and day > 31:\n        return False\n    if month in [4, 6, 9, 11] and day > 30:\n        return False\n    if month == 2 and day > 29:\n        return False\n    return True\n", 'base_status': 'pass', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': [['06-04-202']]}], 'HumanEval/125': [{'task_id': 'HumanEval/125', 'solution': "def split_words(txt):\n    if ' ' in txt:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return sum(1 for c in txt if c.islower() and (ord(c) - ord('a')) % 2 == 1)\n", 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/126': [{'task_id': 'HumanEval/126', 'solution': 'def is_sorted(lst):\n    if len(lst) == len(set(lst)):\n        return all(lst[i] <= lst[i + 1] for i in range(len(lst) - 1))\n    else:\n        return False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 2, 3, 3, 4]]], 'plus_fail_tests': [[[1, 1, 2, 2, 3, 3, 4]]]}], 'HumanEval/127': [{'task_id': 'HumanEval/127', 'solution': 'def intersection(interval1, interval2):\n    def is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    start = max(interval1[0], interval2[0])\n    end = min(interval1[1], interval2[1])\n\n    if start > end:\n        return "NO"\n\n    if is_prime(end - start + 1):\n        return "YES"\n    else:\n        return "NO"\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[-1, 1], [0, 4]]], 'plus_fail_tests': [[[10, 20], [15, 25]]]}], 'HumanEval/128': [{'task_id': 'HumanEval/128', 'solution': 'def prod_signs(arr):\n    if not arr:\n        return None\n    product = 1\n    for num in arr:\n        product *= num\n    return abs(product) * sum(abs(x) for x in arr)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 2, -4]]], 'plus_fail_tests': [[[-1, -2, -2, -4]]]}], 'HumanEval/129': [{'task_id': 'HumanEval/129', 'solution': 'def minPath(grid, k):\n    N = len(grid)\n    visited = [[False] * N for _ in range(N)]\n    path = []\n\n    def dfs(i, j, k):\n        if k == 0:\n            path.append(grid[i][j])\n            return\n        visited[i][j] = True\n        for x, y in [(i - 1, j), (i + 1, j), (i, j - 1), (i, j + 1)]:\n            if 0 <= x < N and 0 <= y < N and not visited[x][y]:\n                dfs(x, y, k - 1)\n        visited[i][j] = False\n        path.append(grid[i][j])\n\n    for i in range(N):\n        for j in range(N):\n            dfs(i, j, k)\n\n    path.sort()\n    return path[:k]\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3]], 'plus_fail_tests': [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 9]]}], 'HumanEval/130': [{'task_id': 'HumanEval/130', 'solution': 'def tri(n):\n    def tri_recursive(n):\n        if n == 0:\n            return 3\n        elif n == 1:\n            return 1\n        elif n % 2 == 0:\n            return 1 + n / 2\n        else:\n            return tri_recursive(n - 1) + tri_recursive(n - 2) + tri_recursive(n + 1)\n\n    result = []\n    for i in range(n + 1):\n        result.append(tri_recursive(i))\n\n    return result\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[3]], 'plus_fail_tests': [[2]]}], 'HumanEval/131': [{'task_id': 'HumanEval/131', 'solution': 'def digits(n):\n    product = 1\n    for digit in str(n):\n        if int(digit) % 2 != 0:\n            product *= int(digit)\n    return product\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2468]], 'plus_fail_tests': [[246]]}], 'HumanEval/132': [{'task_id': 'HumanEval/132', 'solution': "def is_nested(string):\n    stack = []\n    for char in string:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if not stack or stack[-1] != '[':\n                return False\n            else:\n                stack.pop()\n    return not stack\n\nprint(is_nested('[[]]'))\nprint(is_nested('[]]]]]]][[[[[]'))\nprint(is_nested('[][]'))\nprint(is_nested('[]'))\nprint(is_nested('[[][]]'))\nprint(is_nested('[[]][['))\n", 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['[][]']], 'plus_fail_tests': [['[[]]]']]}], 'HumanEval/133': [{'task_id': 'HumanEval/133', 'solution': 'def sum_squares(lst):\n    return sum(int(round(i))**2 for i in lst)\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1.4, 4.2, 0]]], 'plus_fail_tests': [[[0, 3.3, 7.7, -2.2]]]}], 'HumanEval/134': [{'task_id': 'HumanEval/134', 'solution': 'def check_if_last_char_is_a_letter(txt):\n    if len(txt) == 0:\n        return False\n    else:\n        return txt[-1].isalpha() and not txt[-1].isalnum()\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['apple pi e']], 'plus_fail_tests': [['Pumpkin pi e']]}], 'HumanEval/135': [{'task_id': 'HumanEval/135', 'solution': 'def can_arrange(arr):\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            return i-1\n    return -1\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 4, 3, 5]]], 'plus_fail_tests': [[[5, 4, 3, 2, 1]]]}], 'HumanEval/136': [{'task_id': 'HumanEval/136', 'solution': 'def largest_smallest_integers(lst):\n    neg_list = [i for i in lst if i < 0]\n    pos_list = [i for i in lst if i > 0]\n    return (max(neg_list) if neg_list else None, min(pos_list) if pos_list else None)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/137': [{'task_id': 'HumanEval/137', 'solution': 'def compare_one(a, b):\n    """\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) ➞ 2.5\n    compare_one(1, "2,3") ➞ "2,3"\n    compare_one("5,1", "6") ➞ "6"\n    compare_one("1", 1) ➞ None\n    """\n\n    if isinstance(a, str) and isinstance(b, str):\n        try:\n            a = float(a.replace(\',\', \'.\'))\n            b = float(b.replace(\',\', \'.\'))\n        except ValueError:\n            return None\n\n    if isinstance(a, str):\n        a = float(a.replace(\',\', \'.\'))\n    if isinstance(b, str):\n        b = float(b.replace(\',\', \'.\'))\n\n    return max(a, b) if a != b else None\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[1, '2,3']], 'plus_fail_tests': [['-4,1', '-4.0']]}], 'HumanEval/138': [{'task_id': 'HumanEval/138', 'solution': 'def is_equal_to_sum_even(n):\n    if n % 2 != 0:\n        return False\n    else:\n        for i in range(1, n):\n            if n - i == 2 * i:\n                return True\n    return False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[6]], 'plus_fail_tests': [[20]]}], 'HumanEval/139': [{'task_id': 'HumanEval/139', 'solution': 'def special_factorial(n):\n    """The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    """\n    def factorial(n):\n        if n == 0:\n            return 1\n        else:\n            return n * factorial(n-1)\n\n    result = 1\n    for i in range(1, n+1):\n        result *= factorial(i)\n\n    return result\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/140': [{'task_id': 'HumanEval/140', 'solution': 'def fix_spaces(text):\n    return text.replace(" ", "_").replace("    ", "-").replace("  ", "-")\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['Exa   mple']], 'plus_fail_tests': [['Hello,   world!']]}], 'HumanEval/141': [{'task_id': 'HumanEval/141', 'solution': "def file_name_check(file_name):\n    import re\n    pattern = re.compile(r'^[a-zA-Z][a-zA-Z0-9]{0,2}\\.[a-zA-Z]{3}$')\n    if pattern.match(file_name):\n        return 'Yes'\n    else:\n        return 'No'\n", 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['example.txt']], 'plus_fail_tests': [['hello world.exe']]}], 'HumanEval/142': [{'task_id': 'HumanEval/142', 'solution': 'def sum_squares(lst):\n    return sum(x**3 if i % 3 == 0 else x**2 for i, x in enumerate(lst))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 2, 3]]], 'plus_fail_tests': [[[2, 4, 6, 8, 10, 12]]]}], 'HumanEval/143': [{'task_id': 'HumanEval/143', 'solution': 'def words_in_sentence(sentence):\n    def is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_words = [word for word in words if is_prime(len(word))]\n    return " ".join(prime_words)\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'HumanEval/144': [{'task_id': 'HumanEval/144', 'solution': 'def simplify(x, n):\n    """Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify("1/5", "5/1") = True\n    simplify("1/6", "2/1") = False\n    simplify("7/10", "10/2") = False\n    """\n\n    # Split the fractions into numerators and denominators\n    x_num, x_den = map(int, x.split(\'/\'))\n    n_num, n_den = map(int, n.split(\'/\'))\n\n    # Calculate the product of the numerators and denominators\n    product_num = x_num * n_num\n\n    # Check if the product is a whole number\n    if product_num % n_den == 0:\n        return True\n    else:\n        return False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [['1/6', '2/1']], 'plus_fail_tests': [['12/9', '12/9']]}], 'HumanEval/145': [{'task_id': 'HumanEval/145', 'solution': 'def order_by_points(nums):\n    return sorted(nums, key=lambda x: (sum(int(digit) for digit in str(abs(x))), nums.index(x)))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[1, 11, -1, -11, -12]]], 'plus_fail_tests': [[[-5, -12, 9, 15]]]}], 'HumanEval/146': [{'task_id': 'HumanEval/146', 'solution': "def specialFilter(nums):\n    count = 0\n    for num in nums:\n        if num > 1