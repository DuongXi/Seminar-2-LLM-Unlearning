odall(384))  # False\nprint(is_woodall(999))  # True\nprint(is_woodall(123))  # False\nprint(is_woodall(888))  # True\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[383]], 'plus_fail_tests': [[True]]}], 'Mbpp/56': [{'task_id': 'Mbpp/56', 'solution': '"""\nWrite a python function to check if a given number is one less than twice its reverse.\nassert check(70) == False\n"""\ndef check(n):\n    # Convert the number to a string to easily reverse it\n    str_n = str(n)\n    \n    # Reverse the string\n    reversed_str = str_n[::-1]\n    \n    # Convert the reversed string back to an integer\n    reversed_int = int(reversed_str)\n    \n    # Check if the reversed integer is one less than twice its original value\n    if reversed_int == 2 * n - 1:\n        return True\n    else:\n        return False\n\n# Test cases\nprint(check(70))  # False\nprint(check(121))  # True\nprint(check(88))  # True\nprint(check(99))  # False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[73]], 'plus_fail_tests': [[73]]}], 'Mbpp/57': [{'task_id': 'Mbpp/57', 'solution': '"""\nWrite a python function to find the largest number that can be formed with the given list of digits.\nassert find_Max_Num([1,2,3]) == 321\n"""\ndef find_Max_Num(lst):\n    return int(\'\'.join(map(str, sorted(lst, reverse=True))))\n\n# Test cases\nassert find_Max_Num([1,2,3]) == 321\nassert find_Max_Num([9,8,7,6,5,4,3,2,1]) == 97654321\nassert find_Max_Num([1,1,1,1,1,1,1,1,1]) == 111111111\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/58': [{'task_id': 'Mbpp/58', 'solution': '"""\nWrite a python function to check whether the given two integers have opposite sign or not.\nassert opposite_Signs(1,-2) == True\n"""\ndef opposite_Signs(num1, num2):\n    return num1 * num2 < 0\n\n# Test cases\nprint(opposite_Signs(1, -2))  # True\nprint(opposite_Signs(-3, 4))  # True\nprint(opposite_Signs(0, 0))  # False\nprint(opposite_Signs(-7, 7))  # False\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/59': [{'task_id': 'Mbpp/59', 'solution': '"""\nWrite a function to find the nth octagonal number.\nassert is_octagonal(5) == 65\n"""\ndef is_octagonal(n):\n    return n * (7 * n - 5) // 2\n\n# Test cases\nprint(is_octagonal(1))  # 1\nprint(is_octagonal(2))  # 28\nprint(is_octagonal(3))  # 129\nprint(is_octagonal(4))  # 512\nprint(is_octagonal(5))  # 65\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[5]], 'plus_fail_tests': [[100]]}], 'Mbpp/61': [{'task_id': 'Mbpp/61', 'solution': '"""\nWrite a python function to count the number of substrings with the sum of digits equal to their length.\nassert count_Substrings(\'112112\') == 6\n"""\ndef count_Substrings(s):\n    count = 0\n    for i in range(len(s)):\n        for j in range(i+1, len(s)+1):\n            substring = s[i:j]\n            if sum(int(digit) for digit in substring) == len(substring):\n                count += 1\n    return count\n\nprint(count_Substrings(\'112112\'))\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/62': [{'task_id': 'Mbpp/62', 'solution': '"""\nWrite a python function to find smallest number in a list.\nassert smallest_num([10, 20, 1, 45, 99]) == 1\n"""\ndef smallest_num(lst):\n    return min(lst)\n\n# Test cases\nassert smallest_num([10, 20, 1, 45, 99]) == 1\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/63': [{'task_id': 'Mbpp/63', 'solution': '"""\nWrite a function to find the maximum difference between available pairs in the given tuple list.\nassert max_difference([(3, 5), (1, 7), (10, 3), (1, 2)]) == 7\n"""\ndef max_difference(tuples):\n    if not tuples:\n        return None\n    min_val = tuples[0][0]\n    max_diff = tuples[0][1] - tuples[0][0]\n    for i in range(1, len(tuples)):\n        if tuples[i][1] - tuples[i][0] > max_diff:\n            max_diff = tuples[i][1] - tuples[i][0]\n        if tuples[i][0] < min_val:\n            min_val = tuples[i][0]\n    return max_diff\n\nprint(max_difference([(3, 5), (1, 7), (10, 3), (1, 2)]))\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[[3, 5], [1, 7], [10, 3], [1, 2]]]], 'plus_fail_tests': [[[[1000000, 999999], [10000000, 9999999], [100000000, 99999999], [1000000000, 999999999]]]]}], 'Mbpp/64': [{'task_id': 'Mbpp/64', 'solution': '"""\nWrite a function to sort a list of tuples using the second value of each tuple.\nassert subject_marks([(\'English\', 88), (\'Science\', 90), (\'Maths\', 97), (\'Social sciences\', 82)])==[(\'Social sciences\', 82), (\'English\', 88), (\'Science\', 90), (\'Maths\', 97)]\n"""\ndef subject_marks(marks):\n    return sorted(marks, key=lambda x: x[1])\n\n# Testing the function\nassert subject_marks([(\'English\', 88), (\'Science\', 90), (\'Maths\', 97), (\'Social sciences\', 82)])==[(\'Social sciences\', 82), (\'English\', 88), (\'Science\', 90), (\'Maths\', 97)]\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/65': [{'task_id': 'Mbpp/65', 'solution': '"""\nWrite a function to flatten a list and sum all of its elements.\nassert recursive_list_sum(([1, 2, [3,4],[5,6]]))==21\n"""\ndef recursive_list_sum(lst):\n    sum = 0\n    for i in lst:\n        if type(i) == list:\n            sum += recursive_list_sum(i)\n        else:\n            sum += i\n    return sum\n\nprint(recursive_list_sum([1, 2, [3,4],[5,6]])) # Output: 21\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/66': [{'task_id': 'Mbpp/66', 'solution': '"""\nWrite a python function to count the number of positive numbers in a list.\nassert pos_count([1,-2,3,-4]) == 2\n"""\ndef pos_count(lst):\n    count = 0\n    for num in lst:\n        if num > 0:\n            count += 1\n    return count\n\n# Test cases\nassert pos_count([1,-2,3,-4]) == 2\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/67': [{'task_id': 'Mbpp/67', 'solution': '"""\nWrite a function to find the number of ways to partition a set of Bell numbers.\nassert bell_number(2)==2\n"""\ndef bell_number(n):\n    # Initialize the 2D array with all elements as 0\n    bell = [[0 for _ in range(n+1)] for _ in range(n+1)]\n\n    # Set the first row and first column as 1\n    for i in range(n+1):\n        bell[i][0] = 1\n        bell[i][i] = 1\n\n    # Fill the rest of the table\n    for i in range(1, n+1):\n        for j in range(1, i+1):\n            bell[i][j] = bell[i-1][j-1] + bell[i][j-1]\n\n    # Return the last element of the last row\n    return bell[n][0]\n\n# Test cases\nprint(bell_number(2))  # Output: 2\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[2]], 'plus_fail_tests': [[100]]}], 'Mbpp/68': [{'task_id': 'Mbpp/68', 'solution': '"""\nWrite a python function to check whether the given array is monotonic or not.\nassert is_Monotonic([6, 5, 4, 4]) == True\n"""\ndef is_Monotonic(A):\n    return all(A[i] <= A[i + 1] for i in range(len(A) - 1)) or all(A[i] >= A[i + 1] for i in range(len(A) - 1))\n\n# Test cases\nprint(is_Monotonic([6, 5, 4, 4]))  # True\nprint(is_Monotonic([1, 2, 3, 4]))  # True\nprint(is_Monotonic([4, 4, 3, 2]))  # False\nprint(is_Monotonic([1, 1, 1, 1]))  # True\nprint(is_Monotonic([1, 2, 3, 1]))  # False\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/69': [{'task_id': 'Mbpp/69', 'solution': '"""\nWrite a function to check whether a list contains the given sublist or not.\nassert is_sublist([2,4,3,5,7],[3,7])==False\n"""\ndef is_sublist(superlist, sublist):\n    return sublist in superlist\n\n# Testing the function\nassert is_sublist([2,4,3,5,7],[3,7])==False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[[2, 4, 3, 5, 7], [4, 3]]], 'plus_fail_tests': [[[], []]]}], 'Mbpp/70': [{'task_id': 'Mbpp/70', 'solution': '"""\nWrite a function to find whether all the given tuples have equal length or not.\nassert get_equal([(11, 22, 33), (44, 55, 66)]) == True\n"""\ndef get_equal(tuples):\n    # Check if all tuples have the same length\n    return all(len(t) == len(tuples[0]) for t in tuples)\n\n# Test cases\nprint(get_equal([(11, 22, 33), (44, 55, 66)]))  # Should print: True\nprint(get_equal([(11, 22), (44, 55, 66)]))  # Should print: False\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/71': [{'task_id': 'Mbpp/71', 'solution': '"""\nWrite a function to sort a list of elements.\nassert comb_sort([5, 15, 37, 25, 79]) == [5, 15, 25, 37, 79]\n"""\ndef comb_sort(lst):\n    n = len(lst)\n    gap = n\n    swapped = True\n    while gap > 1 or swapped == True:\n        gap = gap // 2\n        swapped = False\n        i = 0\n        while i < n - gap:\n            if lst[i] > lst[i + gap]:\n                lst[i], lst[i + gap] = lst[i + gap], lst[i]\n                swapped = True\n            i += 1\n    return lst\n\n# Test cases\nassert comb_sort([5, 15, 37, 25, 79]) == [5, 15, 25, 37, 79]\n', 'base_status': 'pass', 'plus_status': 'pass', 'base_fail_tests': [], 'plus_fail_tests': []}], 'Mbpp/72': [{'task_id': 'Mbpp/72', 'solution': '"""\nWrite a python function to check whether the given number can be represented as the difference of two squares or not.\nassert dif_Square(5) == True\n"""\ndef dif_Square(n):\n    if n < 0:\n        return False\n    i = 0\n    while i*i <= n:\n        j = int((n - i*i)**0.5)\n        if i*i + j*j == n:\n            return True\n        i += 1\n    return False\n\n# Test cases\nprint(dif_Square(5))  # True\nprint(dif_Square(17))  # False\nprint(dif_Square(1))  # True\nprint(dif_Square(25))  # True\nprint(dif_Square(121))  # True\nprint(dif_Square(100))  # False\n', 'base_status': 'fail', 'plus_status': 'fail', 'base_fail_tests': [[10]], 'plus_f