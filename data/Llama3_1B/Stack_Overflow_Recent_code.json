"None\ndef relay_nested_list(input_list):\n    # Initialize an empty list to store the relayed nested list\n    relayed_list = []\n    \n    # Iterate over the input list and its indices\n    for i, inner_list in enumerate(input_list):\n        # Initialize a variable to store the sum of the current inner list\n        total = 0\n        \n        # Iterate over the current inner list\n        for item in inner_list:\n            # Add the item to the total\n            total += item\n            \n            # Append the total and the item to the relayed list\n            relayed_list.append([total, item])\n        \n        # Append the current inner list to the relayed list\n        relayed_list.append(inner_list)\n    \n    # Return the relayed list\n    return relayed_list\n\nmy_list = [[3, 4, -1], [0, 1], [-2], [7, 5, 8]]\nprint(relay_nested_list(my_list))  # Output: [[3, 4, -1], [0, 1, 6], [-2, 7], [7, 5, 8, 5]]"
