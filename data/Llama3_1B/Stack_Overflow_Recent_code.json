"```python\nimport re\n\ndef split_string_by_char(string, char):\n    \"\"\"\n    Splits a string by a specified character without ignoring trailing characters.\n\n    Args:\n        string (str): The input string to be split.\n        char (str): The character to split by.\n\n    Returns:\n        list: A list of substrings split by the specified character.\n    \"\"\"\n    # Use re.split to split the string by the specified character\n    # The re.escape function is used to escape special characters in the character\n    # The r'\\b' is a word boundary to ensure we're splitting at the correct position\n    # The re.DOTALL flag is used to make the dot special character match any character, including a newline\n    return re.split(r'\\b' + re.escape(char) + r'\\b', string, flags=re.DOTALL)\n\n# Test cases\nstring1 = \"apple,banana,orange,\"\nstring2 = \"apple,banana,orange,pear\"\nstring3 = \",\"\nstring4 = \"|apple|banana|orange|\"\nstring5 = \"xapplexbananaxorangex\"\n\nprint(split_string_by_char(string1, ','))\nprint(split_string_by_char(string2, ','))\nprint(split_string_by_char(string3,,))\nprint(split_string_by_char(string4,,))\nprint(split_string_by_char(string5, ''))\n```"
