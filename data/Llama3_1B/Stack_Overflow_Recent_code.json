"```python\nimport socket\n\ndef forward_wss_to_ws(server_name, ws_port, ws_host):\n    # Create a socket object\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    \n    # Connect to the websocket server\n    s.connect((ws_host, ws_port))\n    \n    # Send the websocket URL to the server\n    s.sendall(f\"wss://{server_name}/{ws_port}\".encode())\n    \n    # Receive the response from the server\n    response = s.recv(1024).decode()\n    \n    # Close the socket\n    s.close()\n\n# Test the function\nserver_name = \"sub.domain.com\"\nws_port = 6001\nws_host = \"localhost\"\nforward_wss_to_ws(server_name, ws_port, ws_host)\n```"
