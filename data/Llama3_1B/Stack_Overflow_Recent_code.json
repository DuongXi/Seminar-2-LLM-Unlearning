"def min_operations_to_zero(nums):\n    n = len(nums)\n    dp = [[float('inf')] * 2 for _ in range(n + 1)]\n    dp[0][0] = 0\n\n    for i in range(1, n + 1):\n        min_val = float('inf')\n        for j in range(i):\n            min_val = min(min_val, nums[j])\n\n        for j in range(i):\n            dp[i][0] = min(dp[i][0], dp[i - j][1] + min_val)\n\n        for j in range(i):\n            dp[i][1] = min(dp[i][1], dp[i - j][0] + min_val)\n\n    return dp[n][1]\n\n# Test cases\nnums1 = [2, 3, 4, 5, 1, 2, 3, 1, 2, 3]\nnums2 = [10, 2, 3, 4, 5, 1, 2, 3]\n\nprint(min_operations_to_zero(nums1))  # Output: 8\nprint(min_operations_to_zero(nums2))  # Output: 9"
