"```python\nimport pandas as pd\n\ndef flatten_nested_dataframes(nested_df, prefix=''):\n    flat_df = pd.DataFrame()\n    for col, values in nested_df.items():\n        if isinstance(values, pd.DataFrame):\n            nested_df[col] = flatten_nested_dataframes(values, prefix + col + '_')\n        else:\n            flat_df[prefix + col] = values\n    return flat_df\n\ndef merge_nested_dataframes(sampledata, desired_df):\n    # Flatten nested dataframes\n    nested_sampledata = flatten_nested_dataframes(sampledata)\n    \n    # Merge with desired dataframes\n    desired_data = nested_sampledata.copy()\n    desired_data = rbindlist(list(desired_data), list(sampledata))\n    \n    return desired_data\n\n# Reproduce sample data\nsampledatain1 = pd.DataFrame({\n    'in_1': [1, 2, 3, 4, 5],\n    'in_2': ['A', 'B', 'C', 'D', 'E']\n})\n\nsampledatain2 = pd.DataFrame({\n    'in_1': [6, 7, 8, 9, 10],\n    'in_2': ['F', 'G', 'H', 'I', 'J']\n})\n\nsampledatain3 = pd.DataFrame({\n    'in_1': [99, 98, 97, 96, 95],\n    'in_2': ['Z', 'Y', 'X', 'W', 'V']\n})\n\nsampledata = pd.DataFrame({\n    'row': [1, 2, 3],\n    'colmerge1': ['MA', 'MB', 'MC'],\n    'colmerge2': [-99, -98, -97]\n})\n\ndesired_data = merge_nested_dataframes(sampledata, pd.DataFrame())\n\nprint(desired_data)\n```"
"```python\nimport pandas as pd\n\n# Sample dataframes\nexpr = pd.DataFrame({\n    'gene': [1, 2, 2, 0, 0],\n    'sample1': [1, 2, 2, 0, 0],\n    'sample2': [5, 2, 4, 4, 0],\n    'sample3': [1, 2, 1, 0, 1],\n    'sample4': [6, 5, 6, 6, 7],\n    'sample5': [0, 0, 0, 1, 1]\n})\n\nmeta = pd.DataFrame({\n    'sample': ['sample1', 'sample2', 'sample3', 'sample4', 'sample5'],\n    'treatment': ['control', 'control', 'treatment1', 'treatment2', 'treatment2']\n})\n\n# Group by gene and calculate mean for each treatment\ngrouped_expr = expr.groupby('gene').mean().reset_index()\n\n# Merge grouped expr with meta\nresult = pd.merge(grouped_expr, meta, on=['gene', 'treatment'], suffixes=('_expr', '_meta'))\n\n# Rename columns\nresult = result.rename(columns={'sample_expr': 'mean', 'sample_meta': 'mean'})\n\n# Print result\nprint(result)\n```"
