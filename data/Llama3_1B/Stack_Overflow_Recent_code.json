"```python\ndef find_second_max(lst):\n    \"\"\"\n    Find the second maximum value in a list.\n\n    Args:\n    lst (list): A list of integers.\n\n    Returns:\n    int: The second maximum value in the list. If the list has less than two unique values, returns None.\n    \"\"\"\n    # Check if the list has less than two unique values\n    if len(set(lst)) < 2:\n        return None\n\n    # Initialize max and second max values\n    max_val = second_max_val = float('-inf')\n\n    # Iterate through the list to find max and second max values\n    for num in lst:\n        if num > max_val:\n            second_max_val = max_val\n            max_val = num\n        elif num > second_max_val and num != max_val:\n            second_max_val = num\n\n    # Return the second max value\n    return second_max_val\n\n# Test the function\narr = map(int, input().split())\nlista = list(arr)\nprint(find_second_max(lista))\n```"
