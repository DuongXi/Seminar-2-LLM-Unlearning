"def find_least_change(original, reordered):\n    # Create a dictionary to store the indices of items in reordered\n    reordered_dict = {item: index for index, item in enumerate(reordered)}\n\n    # Initialize an empty list to store the least change items\n    least_change_items = []\n\n    # Iterate over the original items\n    for item in original:\n        # If the item is not in reordered, it needs to be extracted\n        if item not in reordered_dict:\n            # Append the item to the least change items list\n            least_change_items.append(item)\n        else:\n            # If the item is in reordered, it can be inserted at the current index\n            least_change_items.append(reordered_dict[item])\n\n    # Return the least change items as a list\n    return least_change_items\n\noriginal = [\"life\", \"is\", \"trying\", \"things\", \"to\", \"see\", \"if\", \"they\", \"work\"]\nreordered = [\"life\", \"they\", \"is\", \"trying\", \"to\", \"things\", \"work\", \"see\", \"if\"]\nextracts = find_least_change(original, reordered)\nprint(extracts)  # Output: ['things', 'they', 'work']\n\noriginal = [\"life\", \"is\", \"trying\", \"to\", \"see\", \"if\", \"they\", \"work\"]\nreordered = [\"life\", \"they\", \"is\", \"trying\", \"to\", \"things\", \"work\", \"see\", \"if\"]\nextracts = find_least_change(original, reordered)\nprint(extracts)  # Output: ['life', 'they', 'is', 'trying', 'to', 'things', 'work', 'see', 'if']"
"def max_profit(n, prices, k):\n    # Initialize dp table to store maximum profit for each day\n    dp = [[0 for _ in range(k + 1)] for _ in range(n + 1)]\n    \n    # Iterate through each day\n    for i in range(1, n + 1):\n        # Iterate through each possible number of stocks\n        for j in range(1, min(i, k) + 1):\n            # Update dp table with maximum profit for current day\n            dp[i][j] = max(dp[i - 1][j], dp[i - 1][j - 1] - prices[i - 1])\n    \n    # Calculate maximum net profit after n days\n    return dp[n][k]\n\n# Example usage\nn = 10\nprices = [7, 1, 5, 3, 6, 4]\nk = 2\nprint(max_profit(n, prices, k))  # Output: 7"
