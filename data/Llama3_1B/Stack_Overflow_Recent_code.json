"Here is the Python code to achieve the desired functionality:\n```python\nfrom flask import Flask, request, jsonify\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///database.db'\ndb = SQLAlchemy(app)\n\nclass Action(db.Model):\n    id = db.Column(db.Integer, primary_key=True)\n    uuid = db.Column(db.String(36), unique=True, nullable=False)\n\n    def __repr__(self):\n        return f\"Action('{self.uuid}')\"\n\nclass Page:\n    def __init__(self, id, uuid):\n        self.id = id\n        self.uuid = uuid\n\nclass Component:\n    def __init__(self, id, page):\n        self.id = id\n        self.page = page\n\n    def get_page(self):\n        return self.page\n\nclass PageServer:\n    def __init__(self, page):\n        self.page = page\n        self.actions = {}\n\n    def add_action(self, action_id, action):\n        self.actions[action_id] = action\n\n    def get_action(self, action_id):\n        return self.actions.get(action_id)\n\nclass PageServerController:\n    def __init__(self):\n        self.pages = {}\n        self.actions = {}\n\n    def add_page(self, page):\n        self.pages[page.id] = page\n\n    def get_action(self, action_id):\n        return self.actions.get(action_id)\n\n    def delete_page(self, page_id):\n        if page_id in self.pages:\n            del self.pages[page_id]\n\ndef create_action():\n    return Action(uuid.uuid4(), uuid.uuid4())\n\ndef create_page():\n    return Page(id=uuid.uuid4(), uuid=uuid.uuid4())\n\ndef create_component(page):\n    return Component(id=uuid.uuid4(), page=page)\n\ndef create_controller():\n    return PageServerController()\n\ndef get_action_from_controller(action_id):\n    return create_controller().get_action(action_id)\n\ndef delete_action_from_controller(action_id):\n    create_controller().delete_page(action_id)\n\ndef add_action_to_controller(action_id, action):\n    create_controller().add_action(action_id, action)\n\n# Example usage\ncontroller = create_controller()\n\naction = create_action()\npage = create_page()\n\ncontroller.add_action(create_action().id, action)\ncontroller.add_action(create_action().id, action)\n\ncomponent = create_component(page)\ncontroller.add_action(create_action().id, action)\n\ncontroller.delete_action_from_controller(action.id)\n\npage_server = PageServerController()\npage_server.add_page(page)\naction_server = PageServerController()\naction_server.add_action(create_action().id, action)\n\n# Simulate form submission\nfrom flask import request\nfrom flask import jsonify\nfrom flask_sqlalchemy import SQLAlchemy\n\ndb.create_all()\ndb.session.commit()\n\naction = create_action()\naction_server.get_action(action.id).submit_form(request.form)\n\n# Simulate delete button click\naction_server.delete_action_from_controller(action.id)\ndb.session.commit()\n\n# Get the updated page\npage_server.get_action(action.id).get_page()\n```\nThis code defines a Flask application, a database schema, and a controller to manage actions and pages. The `Component` class represents a SvelteKit component, and the `PageServer` class represents a SvelteKit page with a corresponding endpoint. The `PageServerController` class manages the actions and pages.\n\nThe code also defines a `create_action` and `create_page` function to create new actions and pages, and a `create_controller` function to create a new controller.\n\nThe example usage demonstrates how to create an action, page, and component, and add and delete actions from the controller. The form submission and delete button click are simulated using Flask's request object.\n\nNote that this is just a basic example, and you may need to modify it to fit your specific use case."
