"```python\ndef replace_chars(vector):\n    \"\"\"\n    Replaces characters in a string one at a time, generating new strings for each replacement.\n    \n    Parameters:\n    vector (list): A list of strings\n    \n    Returns:\n    list: A list of strings where each string is a new string generated by replacing characters\n    \"\"\"\n    result = []\n    \n    for s in vector:\n        new_s = \"\"\n        for char in s:\n            if char == 'Y':\n                new_s += 'pY'\n            elif char == 'S':\n                new_s += 'pS'\n            elif char == 'T':\n                new_s += 'pT'\n            else:\n                new_s += char\n        \n        result.append(new_s)\n    \n    return result\n\n# Example usage:\nvector = [\"YSAHEEHHYDK\", \"HEHISSDYAGK\", \"TFAHTESHISK\", \"ISLGEHEGGGK\", \n          \"LSSGYDGTSYK\", \"FGTGTYAGGEK\", \"VGASTGYSGLK\", \"TASGVGGFSTK\", \n          \"SYASDFGSSAK\", \"LYSYYSSTESK\"]\nprint(replace_chars(vector))\n```"
