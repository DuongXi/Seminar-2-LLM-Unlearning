"None\nYou can pass a double value to your C mock function with cmocka's will_return() method by assigning the desired value to a mock float object. Here's an example:\n\n```c\ndouble __wrap_other_func(double param) {\n  // verify that the expected value was passed in to the mock\n  check_expected(param);\n  // assign the return value\n  double value = mock_float; \n  // will_return_float() can deal with real numbers (doubles and floats)\n  fprintf(stderr, &quot;%lf\\n&quot;, value); // this will print the real number value now\n  return value;\n}\n\nstatic void test_this_func(void **state) {\n  (void) state;\n  // make sure the argument passed to the mock is correct\n  expect_value(__wrap_other_func, param, 1.0);\n  // tell the mock what to return\n  will_return_float(__wrap_other_func, 42.99);\n  // call this_func normally. The mock for other_func will get called\n  int result = this_func(12.34); // this_func() will call other_func()\n  ...\n  assert(result == 0); \n  // the assert is now passing because the double 42.99 remains a double\n}\n```"
"To use CUDA with TensorFlow, you need to ensure that the following conditions are met:\n\n1.  You have a compatible NVIDIA GPU (in this case, the GeForce RTX 3050).\n2.  Your operating system is Linux (x86_64, Ubuntu 22.04).\n3.  You are using the latest version of TensorFlow Nightly (2.12.0-dev20230203).\n4.  You have the CUDA 12.0 drivers installed on your machine.\n\nHere's a modified version of your code with the necessary checks and modifications to enable CUDA 12.0 with TensorFlow Nightly:\n\n```python\nimport os\nimport subprocess\n\n# CUDA driver version\ncuda_driver_version = 525.85.12\n\n# CUDA version\ncuda_version = 12.0\n\n# CUDNN version\ncudnn_version = 8.5.0\n\n# Check CUDA driver version\nprint(f\"Checking CUDA driver version: {cuda_driver_version}\")\ntry:\n    subprocess.check_output([\"nvcc\", \"--version\"])\nexcept subprocess.CalledProcessError as e:\n    print(f\"Error: Could not find CUDA drivers on your machine, GPU will not be used.\")\n    exit()\n\n# Check CUDA version\nprint(f\"Checking CUDA version: {cuda_version}\")\ntry:\n    subprocess.check_output([\"nvcc\", \"--version\"])\nexcept subprocess.CalledProcessError as e:\n    print(f\"Error: Could not find CUDA drivers on your machine, GPU will not be used.\")\n    exit()\n\n# Check if CUDA is installed\nprint(f\"Checking if CUDA is installed: {os.path.exists('/usr/local/cuda-12.0/bin')}\")\nif not os.path.exists('/usr/local/cuda-12.0/bin'):\n    print(\"Error: CUDA is not installed. Please install the latest CUDA 12.0 drivers.\")\n    exit()\n\n# Add CUDA/bin PATH\nprint(f\"Adding CUDA/bin PATH: {os.environ['CUDA_VISIBLE_DEVICES']}\")\n\n# Custom function to check if CUDA is correctly installed\ndef check_cuda():\n    lib_cuda = \"libcudart.so.12\"\n    libcuda = \"/usr/local/cuda-12.0/lib/libcudart.so.12\"\n    libcuda_path = \"/usr/local/cuda-12.0/lib/libcudart.so.12\"\n\n    print(f\"Checking if CUDA is installed: {lib_cuda} == {libcuda_path}\")\n\n    if os.path.exists(lib_cuda):\n        print(f\"Error: Could not find {lib_cuda}. Please ensure that CUDA is installed and the correct path is set.\")\n        exit()\n\n# Custom function to check if CUDNN is correctly installed\ndef check_cudnn():\n    libcudnn_cnn_train = \"libcudnn_cnn_train.so.8\"\n    libcudnn_cnn_infer = \"libcudnn_cnn_infer.so.8\"\n    libcudnn_adv_train = \"libcudnn_adv_train.so.8\"\n    libcudnn = \"libcudnn.so.8\"\n    libcudnn_ops_train = \"libcudnn_ops_train.so.8\"\n    libcudnn_adv_infer = \"libcudnn_adv_infer.so.8\"\n    libcudnn_ops_infer = \"libcudnn_ops_infer.so.8\"\n\n    print(f\"Checking if CUDNN is installed: {libcudnn_cnn_train} == {libcudnn_adv_train} == {libcudnn} == {libcudnn_ops_train} == {libcudnn_adv_infer} == {libcudnn_ops_infer}\")\n\n    if os.path.exists(libcuda):\n        print(f\"Error: Could not find {libcudnn_cnn_train}. Please ensure that CUDNN is installed and the correct path is set.\")\n        exit()\n\n    if os.path.exists(libcuda_path):\n        print(f\"Error: Could not find {libcudnn_cnn_infer}. Please ensure that CUDNN is installed and the correct path is set.\")\n        exit()\n\n# Check if GPU is readable for the venv\nprint(f\"Checking if GPU is readable for the venv: {os.environ['CUDA_VISIBLE_DEVICES']}\")\n\n# Custom function to check if CUDA is correctly installed\ndef check_cuda_version():\n    print(f\"Checking CUDA version: {cuda_version}\")\n\n    try:\n        subprocess.check_output([\"nvcc\", \"--version\"])\n    except subprocess.CalledProcessError as e:\n        print(f\"Error: Could not find CUDA drivers on your machine, GPU will not be used.\")\n        exit()\n\n# Custom function to check if CUDNN is correctly installed\ndef check_cudnn_version():\n    print(f\"Checking CUDNN version: {cudnn_version}\")\n\n    try:\n        subprocess.check_output([\"nvcc\", \"--version\"])\n    except subprocess.CalledProcessError as e:\n        print(f\"Error: Could not find CUDA drivers on your machine, GPU will not be used.\")\n        exit()\n\n# Check if TensorFlow Nightly is installed\nprint(f\"Checking if TensorFlow Nightly is installed: {os.path.exists('tf-nightly-2.12.0-dev20230203.tar.gz')}\")\n\n# Check if the connection with the CUDA libraries is correct\nprint(f\"Checking if the connection with the CUDA libraries is correct: {os.environ['LD_LIBRARY_PATH']}\")\n\n# Check if the GPU is readable for the venv\ncheck_cuda()\n\ncheck_cudnn()\n\ncheck_cuda_version()\n\ncheck_cudnn_version()\n\n# Run a checking script on torch\nimport torch\n\nprint(f\"Available cuda = {torch.cuda.is_available()}\")\nprint(f\"GPUs availables = {torch.cuda.device_count()}\")\nprint(f\"Current device = {torch.cuda.current_device()}\")\nprint(f\"Current Device location = {torch.cuda.device(0)}\")\nprint(f\"Name of the device = {torch.cuda.get_device_name(0)}\")\n\nif torch.cuda.is_available():\n    print(\"Error: Could not find CUDA drivers on your machine, GPU will not be used.\")\n    exit()\n```\n\nPlease note that you need to have the latest version of TensorFlow Nightly (2.12.0-dev20230203) installed on your machine. Also, ensure that the CUDA 12.0 drivers are installed on your machine. If you encounter any issues, try to find the CUDA 12.0 installation instructions on the official NVIDIA website."
