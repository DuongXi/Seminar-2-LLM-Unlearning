"import { NextResponse } from 'next/server'\nimport type { NextRequest } from 'next/server'\nimport { verifyAccessToken, verifyRefreshToken } from './utils/checkAuth';\nimport jwt_decode from \"jwt-decode\";\nimport { refreshAccessToken } from './utils/refreshToken';\n\ninterface JwtPayload {\n  email: string\n  sub: number\n  iat: number\n  exp: number\n}\n\nexport async function middleware(req: NextRequest) {\n    const accessToken = req.cookies.get('accessToken')?.value;\n    const refreshToken = req.cookies.get('refreshToken')?.value;\n    \n    if(accessToken && refreshToken){\n        const jwtPayload: JwtPayload = jwt_decode(accessToken);\n\n        const validToken = \n            accessToken &amp;&amp; \n            (await verifyAccessToken(accessToken).catch((err) =&gt; {\n            console.log(err); \n        }));\n  \n        if(req.nextUrl.pathname.startsWith('/login') &amp;&amp; !validToken){\n            return \n        }\n  \n        if((req.url.includes('/login') || req.url.includes('/register')) &amp;&amp; validToken){\n            return NextResponse.redirect(new URL('/login', req.url));\n        }\n  \n        if(!validToken){\n            try {\n                const validRefreshToken = \n                    refreshToken &amp;&amp; \n                    (await verifyRefreshToken(refreshToken).catch((err) =&gt; {\n                    console.log(err); \n                }));\n                if(validRefreshToken){\n                    const newAccessToken = await refreshAccessToken(refreshToken, jwtPayload?.sub);\n                    console.log('GENERATED NEW ACCESS TOKEN', newAccessToken);\n                    // here I want to set accesToken cookie to newAccessToken\n                } else {\n                    console.log('Refresh token expired');\n                    throw new Error('Refresh token expired')\n                }\n            } catch (error) {\n                console.log('cookies should be deleted');\n                return NextResponse.redirect(new URL('/login', req.url));\n            }\n        }\n        console.log('TOKEN VALID', accessToken);\n    } else {\n        if(req.nextUrl.pathname.startsWith('/login')){\n            return \n        } else {\n            return NextResponse.redirect(new URL('/login', req.url));\n        }      \n    }\n}\n\n// See \"Matching Paths\" below to learn more\nexport const config = {\n  matcher: ['/', '/login', '/register', '/jobs/:path*', '/profile'],\n}"
"```python\nimport os\nimport secrets\nfrom flask import Flask, request, redirect, url_for\nfrom flask_session import Session\nfrom flask_cors import CORS\nfrom flask_jwt_extended import JWTManager, jwt_required, create_access_token, get_jwt_identity\n\napp = Flask(__name__)\napp.config['SESSION_PERMANENT'] = False\napp.config['SESSION_TYPE'] = 'filesystem'\napp.config['JWT_SECRET_KEY'] = os.environ.get('JWT_SECRET_KEY', 'super-secret')\napp.config['JWT_ACCESS_TOKEN_EXPIRES'] = 60  # 1 hour\nSession(app)\nCORS(app)\njwt = JWTManager(app)\n\n# Keycloak configuration\nkeycloak_url = os.environ.get('KEYCLOAK_URL', 'http://localhost:8080')\nkeycloak_port = int(os.environ.get('KEYCLOAK_PORT', '8080'))\nkeycloak_idp = os.environ.get('KEYCLOAK_IDP', 'https://idp.example.com')\nkeycloak realms = os.environ.get('KEYCLOAKREALMS', 'default')\nkeycloak_client_id = os.environ.get('KEYCLOAK_CLIENT_ID', 'your_client_id')\nkeycloak_client_secret = os.environ.get('KEYCLOAK_CLIENT_SECRET', 'your_client_secret')\n\n# Backend server configuration\napi1 = 'api1'\napi2 = 'api2'\n\n# Keycloak settings\nkeycloak_grant_type = 'authorization_code'\nkeycloakredirect_uri = url_for('auth_code', _external=True)\n\n# Secret key for session store\nsession_secret = 'my-secret-key'\n\ndef create_access_token(identity):\n    \"\"\"Generate a JWT access token.\"\"\"\n    return create_access_token(identity=identity, expires_days=1)\n\n@app.route('/auth/code', methods=['GET'])\ndef auth_code():\n    \"\"\"Handle authorization code flow.\"\"\"\n    # Generate a random secret key for the session store\n    session_key = secrets.token_urlsafe(32)\n\n    # Create a session object\n    session = {\n        'session_key': session_key,\n        'user_id': get_jwt_identity()\n    }\n\n    # Redirect to Keycloak for authorization code flow\n    return redirect(f'{keycloak_url}{keycloakredirect_uri}?client_id={keycloak_client_id}&redirect_uri={keycloakredirect_uri}&response_type=code&scope=openid&state={session[\"session_key\"]}')\n\n@app.route('/auth/token', methods=['POST'])\ndef auth_token():\n    \"\"\"Handle authorization code flow to obtain an access token.\"\"\"\n    # Get the authorization code from the request\n    auth_code = request.json.get('auth_code')\n\n    # Check if the authorization code is valid\n    if auth_code:\n        # Generate a secret key for the session store\n        session_key = secrets.token_urlsafe(32)\n\n        # Create a session object\n        session = {\n            'session_key': session_key,\n            'user_id': get_jwt_identity()\n        }\n\n        # Create a JWT access token\n        access_token = create_access_token(identity=session['user_id'], expires_days=1)\n\n        # Return the JWT access token\n        return jsonify(access_token=access_token)\n\n    # Return an error if the authorization code is invalid\n    return jsonify(error='Invalid authorization code')\n\n@app.route('/protocol/openid-connect/token', methods=['GET'])\ndef protocol_openid_connect_token():\n    \"\"\"Handle the /protocol/openid-connect/token API.\"\"\"\n    # Get the JWT access token from the session\n    access_token = request.headers.get('Authorization')\n\n    # Return the JWT access token\n    return jsonify(access_token=access_token)\n\nif __name__ == '__main__':\n    # Start the Keycloak server\n    keycloak = KeycloakClient(keycloak_url, keycloak_port, keycloak_idp, keycloak_realms, keycloak_client_id, keycloak_client_secret)\n\n    # Start the backend servers\n    app.run(host='0.0.0.0', port=8080, debug=True)\n\n    # Start the Keycloak server\n    keycloak.start()\n```\n\nThis code creates a Flask application with a Keycloak server, two backend servers, and a session store. It handles the authorization code flow, obtains an access token, and returns it to the frontend. The session store is used to store the user's identity and the JWT access token.\n\nNote that you need to replace the placeholders with your actual Keycloak server and backend server configurations."
