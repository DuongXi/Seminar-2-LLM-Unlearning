"None\n```python\nimport os\n\ndef create_temp_file(prefix, suffix=None):\n    \"\"\"\n    Creates an empty file in the default temporary-file directory, \n    using the given prefix and suffix to generate its name.\n    \n    Parameters:\n    prefix (str): The prefix string to be used in generating the file's name. \n                   Must be at least three characters long.\n    suffix (str, optional): The suffix string to be used in generating the file's name. \n                           Defaults to None, in which case the suffix '.tmp' will be used.\n    \n    Returns:\n    str: An abstract pathname denoting a newly-created empty file.\n    \n    Raises:\n    ValueError: If the prefix argument contains fewer than three characters.\n    \"\"\"\n    if len(prefix) < 3:\n        raise ValueError(\"Prefix string must be at least three characters long\")\n    \n    return os.path.join(os.tmpdir(), f\"{prefix}{suffix or '.'.tmp}\")\n```"
"```cpp\n#include <iostream>\n#include <fstream>\n#include <sstream>\n#include <vector>\n\ntemplate <typename NumberType = double>\nclass A\n{\npublic:\n    void read(std::ifstream fileIn)\n    {\n        std::string line, word;\n        unsigned int row = 0;\n        while (std::getline(fileIn, line))\n        {\n            std::istringstream lineStream(line);\n            unsigned int col = 0;\n            while (std::getline(lineStream, word, ','))\n            {\n                NumberType value;\n                std::istringstream wordStream(word);\n                if (std::getline(wordStream, value, '.'))\n                    value = std::stod(value);\n                matrix_[row][col] = value;\n                col++;\n            }\n            row++;\n        }\n    }\n\nprivate:\n    std::vector<std::vector<NumberType>> matrix_;\n};\n\nint main()\n{\n    A<double> a;\n    a.read(std::ifstream(\"input.csv\"));\n\n    return 0;\n}\n```"
