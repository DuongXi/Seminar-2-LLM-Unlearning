"import re\nimport collections\nimport os\n\ndef sort_imports(import_list):\n    # Extract module names from import statements\n    module_names = [re.search(r'import\\s+([\\w\\.]+)', import_statement).group(1) for import_statement in import_list]\n    \n    # Remove duplicates and sort the list\n    sorted_module_names = sorted(set(module_names))\n    \n    # Create a dictionary to store the sorted import statements\n    sorted_imports = {}\n    \n    # Iterate over the sorted module names and add the import statements to the dictionary\n    for module_name in sorted_module_names:\n        sorted_imports[module_name] = [import_statement for import_statement in import_list if re.search(r'import\\s+([\\w\\.]+)', import_statement).group(1) == module_name]\n    \n    # Join the sorted import statements into a single string\n    sorted_imports_str = '\\n'.join('  '.join(sorted_imports[module_name]) for module_name in sorted_module_names)\n    \n    return sorted_imports_str\n\n# Example usage:\nimport_list = \"\"\"\nimport os\nimport sys\nimport re\nimport collections\n\"\"\"\nsorted_imports = sort_imports(import_list)\nprint(sorted_imports)"
