"import lazy_import\nimport functools\nimport importlib.util\nimport importlib.machinery\nimport io\nimport os\n\ndef lazy_import_module(module_name):\n    spec = importlib.util.spec_from_file_location(module_name, f\"{module_name}.py\")\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\ndef lazy_import_module_file(file_path):\n    with io.open(file_path, encoding=\"utf-8\") as f:\n        spec = importlib.util.spec_from_file_location(\"module\", f.read())\n        module = importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(module)\n        return module\n\ndef lazy_import_module_from_path(path):\n    spec = importlib.util.spec_from_file_location(\"module\", path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\ndef lazy_import_module_from_file(file_path):\n    return lazy_import_module_file(file_path)"
