"import ast\nimport os\n\ndef extract_imported_modules(source_file):\n    try:\n        tree = ast.parse(source_file)\n        imported_modules = []\n        for node in ast.walk(tree):\n            if isinstance(node, ast.Import):\n                for alias in node.names:\n                    imported_modules.append({\n                        'module_name': alias.name,\n                        'path': os.path.join(os.path.dirname(source_file), alias.name)\n                    })\n            elif isinstance(node, ast.ImportFrom):\n                imported_modules.append({\n                    'module_name': node.module,\n                    'path': os.path.join(os.path.dirname(source_file), node.module)\n                })\n        return imported_modules\n    except Exception as e:\n        print(f\"Error parsing source file: {e}\")\n        return []\n\nsource_file = \"path_to_your_source_file.py\"\nimported_modules = extract_imported_modules(source_file)\nfor module in imported_modules:\n    print(f\"Module: {module['module_name']}, Path: {module['path']}\")\n"
