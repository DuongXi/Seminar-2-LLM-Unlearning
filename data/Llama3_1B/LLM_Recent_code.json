"```python\nfrom PIL import Image, ImageFilter\n\ndef blend_images(background, foreground, mode):\n    # Open the background and foreground images\n    background = Image.open(background)\n    foreground = Image.open(foreground)\n\n    # Ensure the images are the same size\n    foreground = foreground.resize(background.size)\n\n    # Apply the specified blending mode\n    if mode == 'multiply':\n        # Multiply the colors of the two images together\n        blended_image = background.copy()\n        for x in range(background.size[0]):\n            for y in range(background.size[1]):\n                pixel = background.getpixel((x, y))\n                foreground.getpixel((x, y)) = (pixel[0] * foreground[0][0] + pixel[1] * foreground[1][0] + pixel[2] * foreground[2][0], \n                                        pixel[0] * foreground[0][1] + pixel[1] * foreground[1][1] + pixel[2] * foreground[2][1], \n                                        pixel[0] * foreground[0][2] + pixel[1] * foreground[1][2] + pixel[2] * foreground[2][2])\n        blended_image = blended_image.convert('RGB')\n    elif mode == 'add':\n        # Add the colors of the two images together\n        blended_image = background.copy()\n        for x in range(background.size[0]):\n            for y in range(background.size[1]):\n                pixel = background.getpixel((x, y))\n                foreground.getpixel((x, y)) = (pixel[0] + foreground[0][0], pixel[1] + foreground[1][0], pixel[2] + foreground[2][0])\n        blended_image = blended_image.convert('RGB')\n    elif mode == 'overlay':\n        # Overlay the foreground image on top of the background image\n        blended_image = Image.new('RGB', background.size)\n        for x in range(background.size[0]):\n            for y in range(background.size[1]):\n                foreground.getpixel((x, y)) = (background.getpixel((x, y))[0], background.getpixel((x, y))[1], background.getpixel((x, y))[2])\n        blended_image = blended_image.convert('RGB')\n    elif mode == 'screen':\n        # Combine the foreground image with the background image using the screen blending formula\n        blended_image = Image.new('RGB', background.size)\n        for x in range(background.size[0]):\n            for y in range(background.size[1]):\n                foreground.getpixel((x, y)) = (int((1 - foreground[0][0] + foreground[1][0]) / 2), \n                                            int((1 - foreground[0][1] + foreground[1][1]) / 2), \n                                            int((1 - foreground[0][2] + foreground[1][2]) / 2))\n        blended_image = blended_image.convert('RGB')\n    else:\n        # If the mode is not recognized, raise an error\n        raise ValueError(\"Invalid blending mode\")\n\n    return blended_image\n\n# Load the images\nbackground = 'background.png'\nforeground = 'foreground.png'\n\n# Blend the images\nblended_image = blend_images(background, foreground, 'multiply')\n\n# Save the blended image\nblended_image.save('blended_image.png')\n```"
