"```python\nimport json\n\ndef exchange_data(method='json'):\n    \"\"\"\n    This function exchanges data between Python and JavaScript using the specified method.\n    \n    Args:\n        method (str, optional): The method to use for data exchange. Defaults to 'json'.\n    \n    Returns:\n        None\n    \"\"\"\n\n    # Define a dictionary to store data\n    data = {'name': 'John', 'age': 30, 'city': 'New York'}\n\n    # Use the specified method to exchange data\n    if method == 'json':\n        # Convert the dictionary to a JSON string\n        json_data = json.dumps(data)\n        \n        # Send the JSON string to JavaScript using a POST request\n        import requests\n        response = requests.post('https://example.com/data', data=json_data)\n        \n    elif method == 'message_passing':\n        # Use a message passing mechanism to exchange data\n        print(\"Sending data to JavaScript...\")\n        \n        # Simulate sending data to JavaScript\n        print(\"Data sent to JavaScript:\", data)\n\n# Call the function to exchange data\nexchange_data('json')\n```"
