"```python\nimport asyncio\nfrom cachetools import TTLCache\n\nasync def async_function_with_timeout(timeout: int = 5):\n    \"\"\"\n    An asynchronous function that simulates a time-consuming task.\n    \n    Args:\n    timeout (int, optional): The timeout in seconds. Defaults to 5.\n    \n    Returns:\n    result: The result of the asynchronous function.\n    \"\"\"\n    await asyncio.sleep(timeout)\n    return \"Task completed\"\n\nasync def main():\n    \"\"\"\n    The main function that creates a cache object and uses it to cache the result of the asynchronous function.\n    \"\"\"\n    # Create a cache object using cachetools.TTLCache\n    cache = TTLCache(maxsize=100, ttl=60)  # Max size of 100 and TTL of 1 minute\n    \n    # Use the cache object to cache the result of the asynchronous function\n    cached_result = await asyncio.to_thread(async_function_with_timeout)\n    \n    # Print the cached result\n    print(f\"Cached result: {cached_result}\")\n\n# Run the main function\nasyncio.run(main())\n```"
