"```python\nimport ast\nimport typing\n\ndef evaluate(expression: str, typ: typing.Optional[typing.Type] = None) -> typing.Any:\n    \"\"\"\n    Evaluates an expression using a custom grammar.\n    \n    Args:\n    expression (str): The expression to be evaluated.\n    typ (typing.Optional[typing.Type], optional): The type hint for the result. Defaults to None.\n    \n    Returns:\n    typing.Any: The result of the evaluation.\n    \"\"\"\n\n    # Define a custom grammar for matching arbitrary Python objects\n    grammar = r\"(?P<identifier>\\w+|\\$[\\w_]+)\\s*(\\*|[^\\s\\)]+)\"\n    \n    # Create a lexer from the custom grammar\n    lexer = ast.lexer.make_lexer(grammar)\n    \n    # Parse the expression using the lexer\n    parser = ast.parser.parse_string(expression, lexer)\n    \n    # Evaluate the parsed tree using the eval function\n    # If a type hint is provided, convert the result to the specified type\n    return ast.util.ast2code(parser) if typ is None else ast.util.ast2code(parser, typ)\n\n# Example usage:\n# Evaluate a simple expression\nprint(evaluate(\"1 + 2\"))  # Output: 3\n\n# Evaluate a more complex expression with a type hint\nprint(evaluate(\"x + 2\", int))  # Output: 3\n```"
"```python\nfrom packaging import version\n\nclass SemanticVersioning:\n    def __init__(self, version_string):\n        \"\"\"\n        Initialize the SemanticVersioning class with a version string.\n\n        Args:\n            version_string (str): The version string to parse.\n        \"\"\"\n        self.version_string = version_string\n\n    def get_major_version(self):\n        \"\"\"\n        Get the major version of the version string.\n\n        Returns:\n            int: The major version.\n        \"\"\"\n        return int(self.version_string.split('.')[0])\n\n    def get_minor_version(self):\n        \"\"\"\n        Get the minor version of the version string.\n\n        Returns:\n            int: The minor version.\n        \"\"\"\n        return int(self.version_string.split('.')[1])\n\n    def get_micro_version(self):\n        \"\"\"\n        Get the micro version of the version string.\n\n        Returns:\n            str: The micro version.\n        \"\"\"\n        return self.version_string.split('.')[2]\n\n    def get_patch_version(self):\n        \"\"\"\n        Get the patch version of the version string.\n\n        Returns:\n            str: The patch version.\n        \"\"\"\n        return self.version_string.split('.')[3]\n\n    def is_valid(self):\n        \"\"\"\n        Check if the version is valid.\n\n        Returns:\n            bool: True if the version is valid, False otherwise.\n        \"\"\"\n        return version.parse(self.version_string).version_info[0] > 0\n\n    def update_major(self, new_major_version):\n        \"\"\"\n        Update the major version of the version string.\n\n        Args:\n            new_major_version (int): The new major version.\n        \"\"\"\n        self.version_string = f\"{self.get_minor_version().spaced} {self.get_micro_version().spaced} {new_major_version} {self.get_patch_version().spaced}\"\n        self.version_string = version.parse(self.version_string).version_info[0].version_string\n\n    def update_minor(self, new_minor_version):\n        \"\"\"\n        Update the minor version of the version string.\n\n        Args:\n            new_minor_version (int): The new minor version.\n        \"\"\"\n        self.version_string = f\"{self.get_major_version().spaced} {self.get_minor_version().spaced} {new_minor_version} {self.get_patch_version().spaced}\"\n        self.version_string = version.parse(self.version_string).version_info[0].version_string\n\n    def update_micro(self, new_micro_version):\n        \"\"\"\n        Update the micro version of the version string.\n\n        Args:\n            new_micro_version (str): The new micro version.\n        \"\"\"\n        self.version_string = f\"{self.get_major_version().spaced} {self.get_minor_version().spaced} {new_micro_version}\"\n        self.version_string = version.parse(self.version_string).version_info[0].version_string\n\n    def update_patch(self, new_patch_version):\n        \"\"\"\n        Update the patch version of the version string.\n\n        Args:\n            new_patch_version (str): The new patch version.\n        \"\"\"\n        self.version_string = f\"{self.get_major_version().spaced} {self.get_minor_version().spaced} {self.get_micro_version().spaced} {new_patch_version}\"\n        self.version_string = version.parse(self.version_string).version_info[0].version_string\n\ndef main():\n    # Example usage\n    version_string = \"1.2.3\"\n    semantic_version = SemanticVersioning(version_string)\n    print(semantic_version.get_major_version())  # Output: 1\n    print(semantic_version.get_minor_version())  # Output: 2\n    print(semantic_version.get_micro_version())  # Output: 3\n    print(semantic_version.get_patch_version())  # Output: None\n\n    # Update the major version\n    semantic_version.update_major(2)\n    print(semantic_version.get_major_version())  # Output: 2\n    print(semantic_version.get_minor_version())  # Output: 2\n    print(semantic_version.get_micro_version())  # Output: 3\n    print(semantic_version.get_patch_version())  # Output: None\n\n    # Update the minor version\n    semantic_version.update_minor(3)\n    print(semantic_version.get_major_version())  # Output: 2\n    print(semantic_version.get_minor_version())  # Output: 3\n    print(semantic_version.get_micro_version())  # Output: 3\n    print(semantic_version.get_patch_version())  # Output: None\n\n    # Update the patch version\n    semantic_version.update_patch(\"1.2.3.4\")\n    print(semantic_version.get_major_version())  # Output: 2\n    print(semantic_version.get_minor_version())  # Output: 3\n    print(semantic_version.get_micro_version())  # Output: 3\n    print(semantic_version.get_patch_version())  # Output: 1.2.3.4\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\n# Import the pytest framework\nimport pytest\n\n# Define a function to run database migrations using alembic\ndef run_migrations():\n    # Import the alembic command\n    from alembic import command\n\n    # Create a new command object\n    cmd = command()\n\n    # Run the migrations using the command\n    cmd.run_sql('migrate')\n\n# Define a test function to test the run_migrations function\ndef test_run_migrations():\n    # Run the test by calling the run_migrations function\n    run_migrations()\n\n# Run the tests using pytest\ndef run_tests():\n    # Import the pytest module\n    import pytest\n\n    # Define a test function to test the run_migrations function\n    def test_run_migrations():\n        # Run the test by calling the run_migrations function\n        run_migrations()\n\n    # Run the tests using pytest\n    pytest.main([__file__])\n\n# Run the tests\nrun_tests()\n```"
