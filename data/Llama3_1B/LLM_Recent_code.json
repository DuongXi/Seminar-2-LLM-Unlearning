"```python\nimport os\nimport csv\nimport json\n\ndef extract_data(directory):\n    # Initialize an empty list to store the extracted data\n    data = []\n\n    # Iterate over each file in the directory\n    for filename in os.listdir(directory):\n        # Check if the file is a JSON file\n        if filename.endswith(\".json\"):\n            # Open the JSON file and load its contents\n            with open(os.path.join(directory, filename), 'r') as file:\n                data.append(json.load(file))\n\n    # Initialize an empty list to store the CSV data\n    csv_data = []\n\n    # Iterate over each file in the directory\n    for data_point in data:\n        # Iterate over each field in the data point\n        for field in data_point:\n            # Check if the field is a string (i.e., it's a field name)\n            if isinstance(field, str):\n                # Append a row to the CSV data with the field name and the value\n                csv_data.append([field, str(data_point[field])])\n\n    # Write the CSV data to a new file\n    with open('extracted_data.csv', 'w', newline='') as file:\n        writer = csv.writer(file)\n        writer.writerows(csv_data)\n\n# Specify the directory containing the JSON files\ndirectory = '/path/to/json/files'\n\n# Call the function to extract the data\nextract_data(directory)\n```"
