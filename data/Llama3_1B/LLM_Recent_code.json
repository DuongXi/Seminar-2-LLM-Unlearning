"```python\nimport asyncio\nimport logging\nfrom typing import Callable, Any\n\n# Create a logger\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\n# Define an observable type\nclass Observable:\n    def __init__(self, func: Callable[[Any], Any]):\n        \"\"\"\n        Initialize an observable.\n\n        Args:\n        func (Callable[[Any], Any]): The function to be executed when the observable is emitted.\n        \"\"\"\n        self.func = func\n        self.subscribers = []\n\n    def subscribe(self, subscriber: Callable[[Any], None]):\n        \"\"\"\n        Subscribe to the observable.\n\n        Args:\n        subscriber (Callable[[Any], None]): The function to be called when the observable is emitted.\n        \"\"\"\n        self.subscribers.append(subscriber)\n\n    def unsubscribe(self, subscriber: Callable[[Any], None]):\n        \"\"\"\n        Unsubscribe from the observable.\n\n        Args:\n        subscriber (Callable[[Any], None]): The function to be removed from the subscribers list.\n        \"\"\"\n        self.subscribers.remove(subscriber)\n\n    def emit(self, value: Any):\n        \"\"\"\n        Emit a value to the observable.\n\n        Args:\n        value (Any): The value to be emitted.\n        \"\"\"\n        # Execute the function and pass the value to it\n        result = self.func(value)\n        # Subscribe to the observable with the result\n        for subscriber in self.subscribers:\n            subscriber(result)\n\n# Define a function to be executed when the observable is emitted\nasync def on_next(value: Any):\n    \"\"\"\n    Execute a function when the observable is emitted.\n\n    Args:\n    value (Any): The value to be emitted.\n    \"\"\"\n    logger.info(f\"Received value: {value}\")\n\n# Define an observable that emits values\nobservable = Observable(on_next)\n\n# Subscribe to the observable\nasync def main():\n    # Subscribe to the observable with the on_next function\n    await observable.subscribe(on_next)\n    # Emit some values\n    await asyncio.sleep(1)\n    await observable.emit(\"Hello, World!\")\n\nasyncio.run(main())\n```"
"```python\n# Import the necessary libraries\nfrom flask import Flask, request, jsonify\nfrom googleapiclient.discovery import build\n\n# Set up the Google Analytics API\nanalytics_v3 = build('analytics', 'v3', developerKey='YOUR_API_KEY')\n\n# Create a new Flask application instance\napp = Flask(__name__)\n\n# Define a route to handle page views\n@app.route('/pageviews', methods=['GET'])\ndef handle_pageviews():\n    # Get the current date and time\n    current_datetime = request.headers.get('X-Date')\n    \n    # Get the number of page views\n    page_views = analytics_v3.realtimeReports().get(\n        'projects',\n        'YOUR_PROJECT_ID',\n        'stats',\n        'ga:pageviews'\n    ).execute()\n    \n    # Return the page views\n    return jsonify({\n        'page_views': page_views['total']\n    })\n\n# Define a route to handle events\n@app.route('/events', methods=['POST'])\ndef handle_events():\n    # Get the event data from the request body\n    event_data = request.get_json()\n    \n    # Get the user demographics\n    user_demographics = analytics_v3.realtimeReports().get(\n        'projects',\n        'YOUR_PROJECT_ID',\n        'stats',\n        'ga:users'\n    ).execute()\n    \n    # Return the event data and user demographics\n    return jsonify({\n        'event_data': event_data,\n        'user_demographics': user_demographics\n    })\n\n# Define a route to handle user demographics\n@app.route('/demographics', methods=['GET'])\ndef handle_demographics():\n    # Get the user demographics\n    user_demographics = analytics_v3.realtimeReports().get(\n        'projects',\n        'YOUR_PROJECT_ID',\n        'stats',\n        'ga:users'\n    ).execute()\n    \n    # Return the user demographics\n    return jsonify({\n        'user_demographics': user_demographics\n    })\n\nif __name__ == '__main__':\n    # Run the Flask application\n    app.run(debug=True)\n```"
