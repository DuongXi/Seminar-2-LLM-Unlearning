"```python\nimport time\nimport os\nfrom progress.bar import ProgressBar\nfrom datetime import datetime, timedelta\n\ndef custom_animation(count):\n    \"\"\"Custom animation function that counts down from 100 to 1\"\"\"\n    while count:\n        mins, secs = divmod(count, 60)\n        hours, mins = divmod(mins, 60)\n        print(f\"[{hours:02d}:{mins:02d}:{secs:02d}]\", end='\\r')\n        time.sleep(0.1)\n        count -= 1\n    print('\\r[Finished!]', end='')\n\ndef progress_bar():\n    \"\"\"Create a progress bar with real-time throughput, ETA, and animations\"\"\"\n    # Initialize the progress bar\n    pb = ProgressBar(range(101), f'Progress: {datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")}')\n    \n    # Custom animation function\n    custom_animation(100)\n    \n    # Calculate the ETA\n    eta = timedelta(seconds=5)\n    \n    # Update the progress bar with ETA\n    pb.update(5)\n    \n    # Update the ETA and animation\n    pbETA = eta\n    pbETA.update(5)\n    pbETAETA = eta\n    \n    # Print the progress bar and ETA\n    print(f'Time left: {eta.strftime(\"%Y-%m-%d %H:%M:%S\")}')\n    print(f'ETA: {etaETA.strftime(\"%Y-%m-%d %H:%M:%S\")}')\n    \n    # Update the progress bar with ETA\n    pb.update(5)\n    \n    # Wait for the user to press Enter before closing the progress bar\n    input('Press Enter to close the progress bar...')\n\n# Call the progress bar function\nprogress_bar()\n```"
"```python\n# Import necessary modules\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom torch.utils.data import Dataset, DataLoader\nfrom torch import nn\nfrom torch.optim import Adam\nfrom torch.nn import functional as fnn\nfrom torch.optim.lr_scheduler import ReduceLROnPlateau\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import GridSearchCV\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix\nimport torch.nn.functional as F\n\n# Define a custom dataset class\nclass CustomDataset(Dataset):\n    def __init__(self, data, labels):\n        self.data = data\n        self.labels = labels\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, idx):\n        return self.data[idx], self.labels[idx]\n\n# Load data\ndata = pd.read_csv('data.csv')\n\n# Split data into training and testing sets\ntrain_data, test_data, train_labels, test_labels = train_test_split(data, data['target'], test_size=0.2, random_state=42)\n\n# Define a custom dataset class for PyTorch\nclass CustomDatasetPyTorch(Dataset):\n    def __init__(self, data, labels):\n        self.data = data\n        self.labels = labels\n\n    def __len__(self):\n        return len(self.data)\n\n    def __getitem__(self, idx):\n        return self.data[idx], self.labels[idx]\n\n# Create a custom dataset instance\ntrain_dataset = CustomDatasetPyTorch(train_data, train_labels)\ntest_dataset = CustomDatasetPyTorch(test_data, test_labels)\n\n# Define a custom PyTorch model\nclass CustomModel(nn.Module):\n    def __init__(self):\n        super(CustomModel, self).__init__()\n        self.fc1 = nn.Linear(10, 128)  # input layer (10) -> hidden layer (128)\n        self.fc2 = nn.Linear(128, 10)  # hidden layer (128) -> output layer (10)\n\n    def forward(self, x):\n        x = F.relu(self.fc1(x))  # activation function for hidden layer\n        x = self.fc2(x)\n        return x\n\n# Initialize the model, optimizer, and loss function\nmodel = CustomModel()\noptimizer = Adam(model.parameters(), lr=0.001)\ncriterion = nn.CrossEntropyLoss()\n\n# Define a custom training loop\ndef train(model, data, labels, optimizer, criterion, epochs):\n    for epoch in range(epochs):\n        optimizer.zero_grad()\n        outputs = model(data)\n        loss = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        if epoch % 10 == 0:\n            print(f'Epoch {epoch+1}, Loss: {loss.item()}')\n\n# Define a custom evaluation loop\ndef evaluate(model, data, labels):\n    outputs = model(data)\n    _, predicted = torch.max(outputs, 1)\n    accuracy = accuracy_score(labels, predicted)\n    print(f'Accuracy: {accuracy:.2f}')\n\n# Train the model\ntrain(model, train_dataset, train_labels, optimizer, criterion, 10)\nevaluate(model, test_dataset, test_labels)\n```"
"```python\nimport pyparsing as pp\n\n# Define a parser for C-family source files\nc_file_parser = pp.Word(pp.alphanums + '_')\nc_type_parser = pp.Word(pp.alphanums + '_')\nc_identifier_parser = pp.Word(pp.alphanums + '_')\n\n# Define a parser for C-family source files (continued)\nc_identifier = c_identifier_parser + pp.alphanums + '_'\n\n# Define a parser for function declarations\nfunc_declaration = c_file_parser + c_type_parser + c_identifier + pp.alphanums + '_'\n\n# Define a parser for variable declarations\nvar_declaration = c_file_parser + c_type_parser + c_identifier + pp.alphanums + '_'\n\n# Define a parser for variable assignments\nvar_assignment = c_file_parser + c_type_parser + c_identifier + '='\n\n# Define a parser for expressions\nexpr = pp.Literal('int') + pp.Literal(' ' + c_file_parser) + pp.Literal('int') + pp.Literal(' ' + c_file_parser) + pp.Literal('int')\n\n# Define a parser for statements\nstatement = func_declaration | var_declaration | var_assignment | expr\n\n# Define a parser for the main function\nmain_statement = pp.Literal('int main') + pp.Literal(' ' + c_file_parser) + pp.Literal('int') + pp.Literal(' ' + c_file_parser) + pp.Literal('int')\n\n# Define an XML parser to represent the AST\nxml_parser = pp.PythonNodeVisitor()\n\n# Parse a C-family source file and generate an XML representation of the AST\ndef parse_c_file(file_path):\n    with open(file_path, 'r') as file:\n        code = file.read()\n        tree = xml_parser.parseString(code)\n        return tree\n\n# Example usage:\nfile_path = 'example.c'\ntree = parse_c_file(file_path)\n\n# Print the XML representation of the AST\nprint(tree.toprettyxml())\n```"
"```python\nimport grpc\nfrom protostub import protobuf\n\n# Define a simple message\nclass Person(protobuf.Message):\n    \"\"\"Person message\"\"\"\n    _fields_ = [\n        # Nested message\n        'name',\n        'age',\n        # Extension\n        'addressstreet',\n        'addresscity',\n        # Syntax-defined enum\n        'status',\n    ]\n\n    def __init__(self, **kwargs):\n        # Initialize the message\n        super().__init__(**kwargs)\n\n# Create a stub for the Person service\nstub = grpc.insecure_channel('localhost:50051')  # Replace with your server address\n\n# Define a function to serialize the Person message\ndef serialize_person(person):\n    \"\"\"Serialize a Person message to a protobuf message\"\"\"\n    return stub.encode(Person(**person))\n\n# Define a function to deserialize the Person message\ndef deserialize_person(serialized_message):\n    \"\"\"Deserialize a protobuf message to a Person object\"\"\"\n    return protobuf.Message.from_bytes(serialized_message)\n\n# Example usage:\nperson = Person(name='John Doe', age=30)\nserialized_message = serialize_person(person)\nprint(f\"Serialized message: {serialized_message}\")\n\ndeserialized_person = deserialize_person(serialized_message)\nprint(f\"Deserialized person: {deserialized_person}\")\n```"
"```python\nimport xml.etree.ElementTree as ET\nimport json\n\nclass SPDXParser:\n    def __init__(self, file_path):\n        self.file_path = file_path\n\n    def parse_spdx_file(self):\n        tree = ET.parse(self.file_path)\n        root = tree.getroot()\n\n        licenses = []\n        copyrights = []\n        packages = []\n\n        for element in root.findall('.//License'):\n            licenses.append(element.get('License'))\n\n        for element in root.findall('.//Copyright'):\n            copyrights.append(element.text)\n\n        for element in root.findall('.//Package'):\n            packages.append(element.get('Name'))\n\n        return licenses, copyrights, packages\n\n    def transform_spdx_data(self, licenses, copyrights, packages):\n        transformed_data = {\n            'licenses': licenses,\n            'copyrights': copyrights,\n            'packages': packages\n        }\n\n        return transformed_data\n\n    def manipulate_spdx_data(self, licenses, copyrights, packages, new_license, new_copyright):\n        transformed_data = {\n            'licenses': licenses,\n            'copyrights': copyrights,\n            'packages': packages\n        }\n\n        transformed_data['licenses'].append(new_license)\n        transformed_data['copyrights'].append(new_copyright)\n\n        return transformed_data\n\n# Example usage\nparser = SPDXParser('spdx_file.xml')\nlicenses, copyrights, packages = parser.parse_spdx_file()\n\ntransformed_data = parser.transform_spdx_data(licenses, copyrights, packages)\nprint(json.dumps(transformed_data, indent=4))\n\nnew_license = 'MIT'\nnew_copyright = '2022'\ntransformed_data = parser.manipulate_spdx_data(licenses, copyrights, packages, new_license, new_copyright)\nprint(json.dumps(transformed_data, indent=4))\n```"
