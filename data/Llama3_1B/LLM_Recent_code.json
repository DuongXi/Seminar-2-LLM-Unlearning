"```python\nimport yaml\n\nclass NestedYAMLConstructor(yaml.Constructors.SingleFileInstantiator):\n    def _construct_yaml_node(self, node, parent, parent_type, parent_key, parent_value):\n        if isinstance(parent_value, dict):\n            for key, value in parent_value.items():\n                if isinstance(value, dict):\n                    self._construct_yaml_node(value, node, type(value), key, value)\n                else:\n                    node.append(value)\n        elif isinstance(parent_value, list):\n            for value in parent_value:\n                if isinstance(value, dict):\n                    self._construct_yaml_node(value, node, type(value), key, value)\n                else:\n                    node.append(value)\n        else:\n            node.append(parent_value)\n```"
"```python\nimport os\nimport shutil\nfrom packaging import version\nfrom pydantic import BaseModel\n\nclass PDMBuildBackend(BaseModel):\n    build_name = \"pdm\"\n    package_name = \"pdm\"\n    python_version = \"3.9\"\n\ndef get_dependencies():\n    return {\n        \"numpy\": \"1.23.5\",\n        \"pandas\": \"1.3.5\",\n        \"scipy\": \"1.8.2\",\n        \"matplotlib\": \"3.5.1\",\n        \"seaborn\": \"0.11.0\",\n        \"plotly\": \"5.1.1\"\n    }\n\ndef install_dependencies():\n    for package, version in get_dependencies().items():\n        shutil.copy(package, package_name)\n        os.system(f\"pip install --upgrade {package} --force-reinstall\")\n\ndef create_env():\n    if os.path.exists(os.path.join(package_name, \"env\")):\n        shutil.rmtree(os.path.join(package_name, \"env\"))\n    os.system(f\"python -m venv env\")\n    os.system(f\"source env/bin/activate\")\n    os.system(\"pip install -r requirements.txt\")\n\ndef create_executable():\n    create_env()\n    os.system(f\"python {package_name}/bin/pdm\")\n    return os.path.join(package_name, \"bin\", \"pdm\")\n\nclass PDMBuildBackendConfig(PDMBuildBackend):\n    build_name = \"pdm\"\n    package_name = \"pdm\"\n    python_version = \"3.9\"\n    dependencies = {\n        \"numpy\": \"1.23.5\",\n        \"pandas\": \"1.3.5\",\n        \"scipy\": \"1.8.2\",\n        \"matplotlib\": \"3.5.1\",\n        \"seaborn\": \"0.11.0\",\n        \"plotly\": \"5.1.1\"\n    }\n    env = {\"PYTHONPATH\": os.path.join(package_name, \"env\", \"bin\"), \"PATH\": os.path.join(package_name, \"env\", \"bin\", \"bin\")}\n    dependencies_dir = os.path.join(package_name, \"requirements.txt\")\n    env_file = os.path.join(package_name, \"env\", \"env.ini\")\n\ndef main():\n    config = PDMBuildBackendConfig()\n    config.dependencies = get_dependencies()\n    config.create_executable()\n    print(f\"Build backend created: {config.build_name}\")\n    print(f\"Executable path: {config.create_executable()}\")\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\n# Import the Gurobi optimization library\nfrom gurobipy import Model, Lin, NonZeroRow\n\n# Define the number of variables and constraints\nn_vars = 3\nn_cons = 2\n\n# Create a new linear programming model\nmodel = Model(\"Simplex Method Example\")\n\n# Define the objective function (maximize)\nmodel objective = Lin('x1', 'x2', 'x3', nonneg=True)\n\n# Define the constraints\nmodel con1 = NonZeroRow('x1', 'x2')\nmodel con2 = NonZeroRow('x2', 'x3')\nmodel con3 = NonZeroRow('x3', 'x1')\n\n# Add the constraints\nmodel con1.add(Lin('x1', 2))\nmodel con2.add(Lin('x2', 1))\nmodel con3.add(Lin('x3', -1))\n\n# Solve the linear programming problem using the simplex method\nmodel.solve()\n\n# Print the solution\nprint(\"x1 =\", model.x[0])\nprint(\"x2 =\", model.x[1])\nprint(\"x3 =\", model.x[2])\n```"
"```python\nimport paramiko\n\nclass PowerShellShell:\n    def __init__(self, host, username, password, port=22, key_file='client_key.pem', cert_file='server_cert.pem'):\n        self.host = host\n        self.username = username\n        self.password = password\n        self.port = port\n        self.key_file = key_file\n        self.cert_file = cert_file\n\n    def connect(self):\n        try:\n            ssh = paramiko.SSHClient()\n            ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())\n            ssh.connect(self.host, username=self.username, password=self.password, port=self.port)\n            return ssh\n        except Exception as e:\n            print(f\"Error connecting to {self.host}: {e}\")\n            return None\n\n    def execute_command(self, command):\n        try:\n            ssh = self.connect()\n            if ssh is None:\n                return\n            stdin, stdout, stderr = ssh.exec_command(command)\n            output = stdout.read().decode()\n            error = stderr.read().decode()\n            if error:\n                print(f\"Error: {error}\")\n            else:\n                print(f\"Output: {output}\")\n            return stdout.read().decode()\n        except Exception as e:\n            print(f\"Error executing command: {e}\")\n            return None\n\n    def close(self):\n        if self.connect():\n            ssh.close()\n            return\n\n# Example usage\nif __name__ == \"__main__\":\n    host = \"your_host_name\"\n    username = \"your_username\"\n    password = \"your_password\"\n\n    shell = PowerShellShell(host, username, password)\n    command = \"Get-Process -Name PowerShell\"\n    output = shell.execute_command(command)\n    if output:\n        print(output)\n    shell.close()\n```\n\nThis code defines a `PowerShellShell` class that allows you to connect to a remote Windows machine using the PowerShell Remoting Protocol and WinRM, execute PowerShell commands, and retrieve output. The example usage demonstrates how to create a `PowerShellShell` object, execute a command, and close the connection."
"```python\n# Import required libraries\nimport boto3\nimport opentelemetry\n\n# Create an OpenTelemetry client\nopentelemetry_client = opentelemetry.client.OpenTelemetryClient(\n    creator=\"your_name\",  # Replace with your name\n    service=\"your_service\",  # Replace with your service name\n)\n\n# Initialize AWS services\ns3 = boto3.client(\"s3\")\nmetrics = boto3.client(\"metrics\")\n\n# Define a function to instrument AWS services with OpenTelemetry\ndef instrument_with_opentelemetry(func):\n    \"\"\"\n    Instrument a function with OpenTelemetry.\n\n    Args:\n    func (function): The function to instrument.\n\n    Returns:\n    function: The instrumented function.\n    \"\"\"\n    def instrumented_func(*args, **kwargs):\n        # Create a tracing context\n        tracing_context = opentelemetry_client.create_tracer(\"your_service\")\n        \n        # Start a new span\n        with tracing_context.start_span(\"instrumentation\"):\n            # Call the original function\n            result = func(*args, **kwargs)\n        \n        # Mark the span as completed\n        tracing_context.set_status(opentelemetry.client.TracingStatus.SUCCEEDED)\n        \n        # Return the result\n        return result\n    \n    # Return the instrumented function\n    return instrumented_func\n\n# Example usage\n@instrument_with_opentelemetry\ndef upload_file(file_path, bucket_name, object_key):\n    \"\"\"\n    Upload a file to S3.\n\n    Args:\n    file_path (str): The path to the file.\n    bucket_name (str): The name of the S3 bucket.\n    object_key (str): The key of the object in the bucket.\n    \"\"\"\n    # Upload the file to S3\n    s3.upload_file(file_path, bucket_name, object_key)\n\n# Instrument the upload_file function\nupload_file(None, \"your_bucket_name\", \"your_object_key\")\n```"
"```python\n# Import necessary modules\nimport logging\nimport prometheus_client\nfrom opencensus import metrics\nfrom opencensus.trace import Configuration\nfrom opencensus.trace import Tags\nfrom opencensus.trace import CollectorRegistry\n\n# Configure tracing and metrics\nlogging.basicConfig(level=logging.INFO)\nconfiguration = Configuration(\n    tags={\n        'my-project': Tags.Name('my-project')\n    },\n    metrics.exporters=[\n        prometheus_client.Counter(\n            'db_connection_count', 'Number of database connections'\n        ),\n        prometheus_client.Gauge(\n            'db_memory_usage', 'Memory usage of the database'\n        )\n    ],\n    sampling_rate=1.0,\n    record_batch_size=100\n)\n\n# Instrument a PostgreSQL database connection using OpenCensus\ncollector = CollectorRegistry()\ncollector.register(\n    'pg_database_connection',\n    metrics.Counter(\n        'pg_database_connection_count', 'Number of database connections'\n    ),\n    tags={\n        'database': 'postgresql'\n    }\n)\n\n# Start the OpenCensus collector\nconfiguration.start()\n```"
"```python\nimport boto3\n\nclass Boto3Interface:\n    def __init__(self, region_name):\n        self.region_name = region_name\n        self.client = boto3.client('lambda', region_name=self.region_name)\n\n    def create_function(self, code, handler):\n        \"\"\"\n        Creates a new Lambda function.\n\n        Args:\n            code (str): The code for the function.\n            handler (str): The handler function name.\n\n        Returns:\n            dict: The response from the Lambda service.\n        \"\"\"\n        response = self.client.create_function(\n            FunctionName='my_function',\n            Runtime='python3.8',\n            Handler=handler,\n            Code={'ZipFile': b'\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x10\\x11\\x12\\x13\\x14\\x15\\x16'}\n        )\n        return response\n\n    def update_function(self, function_name, code, handler):\n        \"\"\"\n        Updates an existing Lambda function.\n\n        Args:\n            function_name (str): The name of the function to update.\n            code (str): The updated code for the function.\n            handler (str): The updated handler function name.\n\n        Returns:\n            dict: The response from the Lambda service.\n        \"\"\"\n        response = self.client.update_function(\n            FunctionName=function_name,\n            Code={'ZipFile': b'\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x10\\x11\\x12\\x13\\x14\\x15\\x16'},\n            Handler=handler\n        )\n        return response\n\n    def delete_function(self, function_name):\n        \"\"\"\n        Deletes an existing Lambda function.\n\n        Args:\n            function_name (str): The name of the function to delete.\n\n        Returns:\n            dict: The response from the Lambda service.\n        \"\"\"\n        response = self.client.delete_function(\n            FunctionName=function_name\n        )\n        return response\n\n    def get_function(self, function_name):\n        \"\"\"\n        Retrieves information about a Lambda function.\n\n        Args:\n            function_name (str): The name of the function to retrieve information about.\n\n        Returns:\n            dict: The response from the Lambda service.\n        \"\"\"\n        response = self.client.get_function(\n            FunctionName=function_name\n        )\n        return response\n\n# Usage example\nif __name__ == '__main__':\n    interface = Boto3Interface('us-west-2')\n    code = 's3://my-bucket/lambda-function-code.zip'\n    handler = 'my-function.handler'\n\n    response = interface.create_function(code, handler)\n    print(f\"Created function {response['FunctionName']}\")\n\n    updated_code = 's3://my-bucket/updated-lambda-function-code.zip'\n    updated_handler = 'my-function-2.handler'\n\n    response = interface.update_function('my-function', updated_code, updated_handler)\n    print(f\"Updated function {response['FunctionName']}\")\n\n    interface.delete_function('my-function')\n    response = interface.get_function('my-function')\n    print(f\"Deleted function {response['FunctionName']}\")\n```"
"```python\nimport jupyter\n\nclass NotebookCache:\n    \"\"\"\n    A simple cache implementation using a dictionary.\n    \n    The cache stores Jupyter notebooks and provides methods to add, get, and remove notebooks.\n    \"\"\"\n    \n    def __init__(self):\n        # Initialize an empty dictionary to store notebooks\n        self.notebooks = {}\n\n    def add_notebook(self, notebook_id, notebook):\n        \"\"\"\n        Add a Jupyter notebook to the cache.\n\n        Args:\n            notebook_id (str): Unique identifier for the notebook.\n            notebook (Jupyter Notebook): The Jupyter notebook to add.\n        \"\"\"\n        # Add the notebook to the dictionary\n        self.notebooks[notebook_id] = notebook\n\n    def get_notebook(self, notebook_id):\n        \"\"\"\n        Get a Jupyter notebook from the cache.\n\n        Args:\n            notebook_id (str): Unique identifier for the notebook.\n\n        Returns:\n            Jupyter Notebook: The notebook associated with the given ID, or None if not found.\n        \"\"\"\n        # Return the notebook from the dictionary if it exists, otherwise return None\n        return self.notebooks.get(notebook_id)\n\n    def remove_notebook(self, notebook_id):\n        \"\"\"\n        Remove a Jupyter notebook from the cache.\n\n        Args:\n            notebook_id (str): Unique identifier for the notebook.\n        \"\"\"\n        # Remove the notebook from the dictionary if it exists\n        if notebook_id in self.notebooks:\n            del self.notebooks[notebook_id]\n```"
"```python\n# utility_module.py\n\ndef filter_data(data, predicate):\n    \"\"\"Returns a new iterable that includes only the elements for which the predicate function returns True\"\"\"\n    for item in data:\n        if predicate(item):\n            yield item\n\ndef map_data(data, func):\n    \"\"\"Returns a new iterable that includes the results of applying the function to each item in the input data\"\"\"\n    for item in data:\n        yield func(item)\n\ndef reduce_data(data, func):\n    \"\"\"Returns the result of applying the function to the first two items in the input data, then to the third, and so on, until the input data is exhausted\"\"\"\n    if len(data) == 0:\n        return None\n    accumulator = data[0]\n    for item in data[1:]:\n        accumulator = func(accumulator, item)\n    return accumulator\n\ndef square_numbers(numbers):\n    \"\"\"Returns an iterable that includes the squares of each number in the input iterable\"\"\"\n    for number in numbers:\n        yield number ** 2\n\ndef sum_numbers(numbers):\n    \"\"\"Returns the sum of each number in the input iterable\"\"\"\n    for number in numbers:\n        yield number\n\ndef product_of_numbers(numbers):\n    \"\"\"Returns the product of each number in the input iterable\"\"\"\n    for number in numbers:\n        yield number\n```\n\nYou can use these functions as follows:\n\n```python\n# Example usage\nif __name__ == \"__main__\":\n    numbers = [1, 2, 3, 4, 5]\n    \n    # Filter even numbers\n    even_numbers = filter_data(numbers, lambda x: x % 2 == 0)\n    print(list(even_numbers))  # Output: [2, 4]\n    \n    # Map square numbers\n    squared_numbers = map_data(numbers, lambda x: x ** 2)\n    print(list(squared_numbers))  # Output: [1, 4, 9, 16, 25]\n    \n    # Reduce sum\n    sum_result = reduce_data(numbers, sum)\n    print(sum_result)  # Output: 15\n    \n    # Product of numbers\n    product_result = product_of_numbers(numbers)\n    print(list(product_result))  # Output: 120\n```"
"```python\nimport pygments\nimport pygments.lexers\nimport pygments.formatters\n\n# Define styles for highlighting code\nstyles = {\n    'accessible': {\n        'name': 'accessible',\n        'language': 'python',\n        'color_scheme': 'monochrome',\n        'font_family': 'monospace',\n        'fg_color': '#333333',\n        'bg_color': '#ffffff'\n    },\n    'contrast': {\n        'name': 'contrast',\n        'language': 'python',\n        'color_scheme': 'bright',\n        'font_family': 'monospace',\n        'fg_color': '#ffffff',\n        'bg_color': '#333333'\n    }\n}\n\n# Create a Pygments lexer for Python code\nlexer = pygments.lexers.PygmentsLexer(unicode=True)\n\n# Create a Pygments formatter for the accessible style\nformatter = pygments.formatters.HtmlFormatter(styles['accessible'])\n\n# Create a Pygments formatter for the contrast style\ncontrast_formatter = pygments.formatters.HtmlFormatter(styles['contrast'])\n\n# Create a collection of accessible and contrast styles\nstyles_collection = [formatter, contrast_formatter]\n```"
"```python\nimport subprocess\nimport os\nimport sys\n\ndef pubsub_wrapper(message, topic):\n    \"\"\"\n    Wrapper function for the PubSub framework on macOS.\n    \n    This function publishes a message to a specified topic on the local message broker.\n    \n    Args:\n        message (str): The message to be published.\n        topic (str): The topic to publish the message to.\n    \"\"\"\n    # Use the 'subprocess' module to run the 'pkill' command on macOS\n    # This command is used to kill all processes running on the local machine\n    # The '-x' option is used to specify that we want to kill all processes\n    # The 'pubsub' option is used to specify the PubSub framework\n    # The '-k' option is used to specify that we want to kill all processes in the 'pubsub' namespace\n    # The '-p' option is used to specify the process ID of the 'pubsub' process\n    # The '-e' option is used to specify the command to execute on the killed process\n    # The 'pubsub' command is used to kill the 'pubsub' process and then publish the message\n    command = f\"subprocess.run(['pkill', '-x', 'pubsub', '-k', '-p', str(sys.getpid()), '-e', f'echo \"{message}\" | pubsub', topic], shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\"\n    \n    # Use the 'subprocess' module to run the command\n    # The 'shell=True' option is used to allow the command to be executed through the shell\n    # The 'stdout=subprocess.PIPE' and 'stderr=subprocess.PIPE' options are used to capture the output and error messages\n    # The 'subprocess.run()' function returns a CompletedProcess object, which contains the return code and the output and error messages\n    # We use the 'stdout=subprocess.PIPE' option to capture the output of the command\n    # We use the 'stderr=subprocess.PIPE' option to capture the error messages of the command\n    # The 'shell=True' option is used to allow the command to be executed through the shell\n    result = subprocess.run(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n    \n    # Check if the command was successful\n    if result.returncode == 0:\n        # If the command was successful, return True\n        return True\n    else:\n        # If the command was not successful, return False\n        return False\n\n# Example usage:\nif __name__ == \"__main__\":\n    message = \"Hello, world!\"\n    topic = \"example-topic\"\n    published = pubsub_wrapper(message, topic)\n    print(f\"Message published: {message}\")\n    print(f\"Topic published: {topic}\")\n    if published:\n        print(\"Message published successfully.\")\n    else:\n        print(\"Failed to publish message.\")\n```"
"```python\nimport importlib.util\nfrom typing import List\n\ndef sort_imports(import_list: List[str]) -> List[str]:\n    \"\"\"\n    Sorts a list of import statements alphabetically based on the module name, \n    ignoring duplicate imports and avoiding collisions with other modules.\n    \n    Args:\n        import_list (List[str]): A list of import statements.\n    \n    Returns:\n        List[str]: The sorted list of import statements.\n    \"\"\"\n    \n    # Create a set to store unique module names\n    unique_modules = set()\n    \n    # Create a list to store sorted import statements\n    sorted_imports = []\n    \n    # Iterate over each import statement in the list\n    for import_statement in import_list:\n        # Extract the module name from the import statement\n        module_name = import_statement.split()[1]\n        \n        # Check if the module name is not already in the set of unique modules\n        if module_name not in unique_modules:\n            # Add the module name to the set of unique modules\n            unique_modules.add(module_name)\n            \n            # Add the import statement to the sorted list\n            sorted_imports.append(import_statement)\n    \n    # Sort the import statements based on the module name\n    sorted_imports.sort(key=lambda x: x.split()[1])\n    \n    # Return the sorted list of import statements\n    return sorted_imports\n\n# Example usage:\nimport_list = [\n    \"import math\",\n    \"import os\",\n    \"import sys\",\n    \"import math\",\n    \"import os\",\n    \"import sys\"\n]\nsorted_imports = sort_imports(import_list)\nprint(sorted_imports)\n```"
"```python\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch_geometric.nn import MessagePassing\nfrom torch_geometric.data import Data\n\nclass GraphNNGCN(nn.Module):\n    def __init__(self, input_dim, hidden_dim, output_dim):\n        super(GraphNNGCN, self).__init__()\n        self.conv1 = nn.Conv2d(input_dim, hidden_dim, kernel_size=3)\n        self.conv2 = nn.Conv2d(hidden_dim, hidden_dim, kernel_size=3)\n        self.fc1 = nn.Linear(hidden_dim, hidden_dim)\n        self.fc2 = nn.Linear(hidden_dim, output_dim)\n\n    def forward(self, data):\n        x, edge_index = data.x, data.edge_index\n\n        # Message passing for node feature aggregation\n        x = F.relu(self.conv1(x))\n        x = F.relu(self.conv2(x))\n\n        # Message passing for neighbor feature aggregation\n        x = x.view(-1, x.size(1), -1)\n        neighbor_x = F.relu(self.fc1(x))\n        neighbor_x = F.relu(self.fc2(neighbor_x))\n\n        # Reshape and pass to final output layer\n        x = x.view(-1, x.size(1), -1)\n        return F.softmax(torch.matmul(x, neighbor_x), dim=1)\n\n# Create a data class to represent the graph\nclass GraphData(Data):\n    def __init__(self, x, edge_index):\n        super(GraphData, self).__init__(x, edge_index)\n\n# Create a sample graph\ninput_dim = 10\nhidden_dim = 20\noutput_dim = 2\ngraph_data = GraphData(torch.randn(1, input_dim), torch.randint(0, 10, (1, 5)))\n\n# Create a graph neural network model\nmodel = GraphNNGCN(input_dim, hidden_dim, output_dim)\n\n# Compute the message passing for node feature aggregation and neighbor feature aggregation\nedge_index = graph_data.edge_index\nout = model(graph_data)\n```"
