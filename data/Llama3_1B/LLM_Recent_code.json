"```python\nimport requests\nimport json\n\ndef sign_request(url, aws_access_key_id, aws_secret_access_key, region_name):\n    \"\"\"\n    Signs an AWS API request using the SigV4 authentication method.\n\n    Args:\n        url (str): The URL of the API request.\n        aws_access_key_id (str): The AWS access key ID.\n        aws_secret_access_key (str): The AWS secret access key.\n        region_name (str): The name of the AWS region.\n\n    Returns:\n        str: The signed request URL.\n    \"\"\"\n    headers = {\n        \"x-amz-auth-type\": \"V4\",\n        \"x-amz-date\": \"20230224T110626Z\",\n        \"x-amz-signature\": \"aws4_request\",\n        \"Content-Type\": \"application/x-www-form-urlencoded\"\n    }\n\n    data = {\n        \"Action\": \"SignApiRequest\",\n        \"Version\": \"2012-10-17\",\n        \"AWSAccessKeyId\": aws_access_key_id,\n        \"SignatureVersion\": \"1\",\n        \"SigningMethod\": \"HmacSHA256\",\n        \"UserAgent\": \"Python/3.9.5 AWS SDK\",\n        \"Region\": region_name\n    }\n\n    response = requests.post(url, data=json.dumps(data), headers=headers)\n\n    return response.url\n\n# Example usage:\naws_access_key_id = \"YOUR_AWS_ACCESS_KEY_ID\"\naws_secret_access_key = \"YOUR_AWS_SECRET_ACCESS_KEY\"\nregion_name = \"YOUR_AWS_REGION_NAME\"\n\nsigned_request_url = sign_request(\"https://example.com/endpoint\", aws_access_key_id, aws_secret_access_key, region_name)\nprint(signed_request_url)\n```"
