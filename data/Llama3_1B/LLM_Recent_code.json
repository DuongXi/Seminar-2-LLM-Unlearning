"**Project Management System**\n==========================\n\nBelow is a comprehensive project management system in Python, including task tracking, team collaboration, and progress reporting.\n\n```python\nimport tkinter as tk\nfrom tkinter import ttk, messagebox\nimport sqlite3\nimport json\n\nclass ProjectManagementSystem:\n    def __init__(self, root):\n        self.root = root\n        self.root.title(\"Project Management System\")\n        self.conn = sqlite3.connect(\"projects.db\")\n        self.cursor = self.conn.cursor()\n        self.create_tables()\n\n        self.task_frame = ttk.Frame(self.root)\n        self.task_frame.pack(padx=10, pady=10)\n\n        self.team_frame = ttk.Frame(self.root)\n        self.team_frame.pack(padx=10, pady=10)\n\n        self.progress_frame = ttk.Frame(self.root)\n        self.progress_frame.pack(padx=10, pady=10)\n\n        self.tasks = []\n        self.tasks_dict = {}\n        self.team_members = {}\n        self.progress = {}\n\n        self.create_widgets()\n\n    def create_tables(self):\n        self.cursor.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS tasks (\n                id INTEGER PRIMARY KEY,\n                title TEXT NOT NULL,\n                description TEXT,\n                deadline DATE,\n                status TEXT DEFAULT 'Not Started'\n            )\n        \"\"\")\n        self.conn.commit()\n\n        self.cursor.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS team_members (\n                id INTEGER PRIMARY KEY,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL\n            )\n        \"\"\")\n        self.conn.commit()\n\n        self.cursor.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS progress (\n                id INTEGER PRIMARY KEY,\n                task_id INTEGER NOT NULL,\n                progress REAL NOT NULL,\n                FOREIGN KEY (task_id) REFERENCES tasks (id)\n            )\n        \"\"\")\n        self.conn.commit()\n\n    def create_widgets(self):\n        # Task frame\n        self.task_title = ttk.Label(self.task_frame, text=\"Task Title\")\n        self.task_title.pack()\n        self.task_description = ttk.Text(self.task_frame, height=5, width=30)\n        self.task_description.pack()\n\n        self.task_deadline = ttk.Label(self.task_frame, text=\"Task Deadline\")\n        self.task_deadline.pack()\n        self.task_deadline_entry = ttk.Entry(self.task_frame, width=30)\n        self.task_deadline_entry.pack()\n\n        self.task_status = ttk.Label(self.task_frame, text=\"Task Status\")\n        self.task_status.pack()\n        self.task_status.set(\"Not Started\")\n        self.task_status.set_button = ttk.Button(self.task_frame, text=\"Set Status\", command=self.set_task_status)\n        self.task_status.set_button.pack()\n\n        # Team frame\n        self.team_name = ttk.Label(self.team_frame, text=\"Team Name\")\n        self.team_name.pack()\n        self.team_email = ttk.Entry(self.team_frame, width=30)\n        self.team_email.pack()\n\n        self.team_member_button = ttk.Button(self.team_frame, text=\"Add Team Member\", command=self.add_team_member)\n        self.team_member_button.pack()\n\n        # Progress frame\n        self.progress_task_id = ttk.Label(self.progress_frame, text=\"Task ID\")\n        self.progress_task_id.pack()\n        self.progress_task_id_entry = ttk.Entry(self.progress_frame, width=30)\n        self.progress_task_id_entry.pack()\n\n        self.progress_progress = ttk.Label(self.progress_frame, text=\"Progress\")\n        self.progress_progress.pack()\n        self.progress_progress.set(\"0.0%\")\n\n        self.progress_button = ttk.Button(self.progress_frame, text=\"Set Progress\", command=self.set_progress)\n        self.progress_button.pack()\n\n        # Connect to database\n        self.conn.commit()\n\n    def set_task_status(self):\n        task_id = self.task_deadline_entry.get()\n        if task_id:\n            self.cursor.execute(\"SELECT status FROM tasks WHERE id=?\", (task_id,))\n            task_status = self.cursor.fetchone()\n            if task_status:\n                self.task_status.set(task_status[0])\n            else:\n                messagebox.showerror(\"Error\", \"Task not found\")\n\n    def add_team_member(self):\n        name = self.team_email.get()\n        if name:\n            self.cursor.execute(\"INSERT INTO team_members (name, email) VALUES (?, ?)\", (name, self.team_email.get()))\n            self.conn.commit()\n            messagebox.showinfo(\"Success\", \"Team member added successfully\")\n        else:\n            messagebox.showerror(\"Error\", \"Team member name is required\")\n\n    def set_progress(self):\n        task_id = self.progress_task_id_entry.get()\n        if task_id:\n            progress = float(self.progress_progress.get().replace(\"%\", \"\"))\n            if progress < 0 or progress > 100:\n                messagebox.showerror(\"Error\", \"Progress must be between 0 and 100\")\n            else:\n                self.progress[task_id] = progress\n                self.conn.commit()\n                messagebox.showinfo(\"Success\", \"Progress set successfully\")\n\n    def get_progress(self):\n        progress_dict = {}\n        for task_id, progress in self.progress.items():\n            progress_dict[task_id] = progress\n        return progress_dict\n\n# Create the main window\nroot = tk.Tk()\nproject_management_system = ProjectManagementSystem(root)\n\n# Run the application\nroot.mainloop()\n```\n\nThis project management system allows users to create tasks, add team members, set task status, and set progress. The tasks are stored in a SQLite database, and the team members and progress are also stored in the database. The system uses a simple text-based interface for user input and output."
"```python\nimport jsonpath\n\nclass JsonPathParser:\n    def __init__(self, json_str):\n        self.json_str = json_str\n\n    def parse(self):\n        try:\n            return jsonpath.parse(self.json_str)\n        except jsonpath.JsonPathError as e:\n            raise ValueError(\"Invalid JSONPath expression: {}\".format(e))\n\n    def evaluate(self, expression):\n        try:\n            return jsonpath.eval(self.json_str, expression)\n        except jsonpath.JsonPathError as e:\n            raise ValueError(\"Invalid JSONPath expression: {}\".format(e))\n\nclass Node:\n    def __init__(self, value):\n        self.value = value\n\n    def __repr__(self):\n        return str(self.value)\n\nclass AST:\n    def __init__(self):\n        self.nodes = {}\n\n    def add_node(self, node):\n        self.nodes[node.value] = node\n\n    def traverse(self, node, parent=None):\n        if parent:\n            for key, value in parent.items():\n                if isinstance(value, Node):\n                    yield from self.traverse(value, node)\n        else:\n            for key, value in node.items():\n                yield from self.traverse(value, node)\n\n    def to_dict(self):\n        return {key: value.value for key, value in self.nodes.items()}\n\ndef jsonpath_parser(json_str):\n    parser = JsonPathParser(json_str)\n    ast = AST()\n    ast.add_node(Node(parser.parse()))\n    return ast\n\ndef jsonpath_eval(ast, expression):\n    ast.add_node(Node(ast.to_dict()))\n    return ast.evaluate(expression)\n\n# Example usage\njson_str = '''\n{\n    \"name\": \"John\",\n    \"age\": 30,\n    \"address\": {\n        \"street\": \"123 Main St\",\n        \"city\": \"Anytown\",\n        \"state\": \"CA\",\n        \"zip\": \"12345\"\n    },\n    \"cars\": [\"Toyota\", \"Honda\", \"Ford\"]\n}\n'''\n\nparser = jsonpath_parser(json_str)\nast = jsonpath_parser.parse()\nexpression = \"address.city\"\nresult = jsonpath_eval(ast, expression)\nprint(result)\n```\n\nThis code defines a `JsonPathParser` class that parses a JSONPath expression and returns an abstract syntax tree (AST) representation of the parsed expression. The `evaluate` method evaluates the AST expression and returns the result.\n\nThe `Node` class represents a JSON value or a binary expression, and the `AST` class represents the AST of the parsed expression.\n\nThe `jsonpath_parser` function creates a `JsonPathParser` instance and calls the `parse` method to parse the input JSON string. It then creates an `AST` instance and adds nodes to it using the `to_dict` method to convert the parsed expression into a dictionary.\n\nThe `jsonpath_eval` function evaluates the AST expression using the `evaluate` method and returns the result. In the example usage, we create a JSON string, parse it using `jsonpath_parser`, and evaluate the expression \"address.city\" using `jsonpath_eval`."
