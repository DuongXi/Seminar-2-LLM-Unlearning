"```python\nimport os\nimport json\nfrom google.oauth2 import service_account\nfrom google.cloud import osconfig\n\ndef get_client():\n    \"\"\"\n    Returns a client object to interact with the Google Cloud OS Config API.\n    \"\"\"\n    credentials = service_account.Credentials.from_service_account_file(\n        'path_to_your_service_account_key.json'\n    )\n    client = osconfig.client('osconfig', credentials=credentials)\n    return client\n\ndef get_os_info(client):\n    \"\"\"\n    Retrieves information about the operating system and applications running on Google Cloud Platform.\n    \"\"\"\n    os_info = client.osconfig.get_os_config()\n    return os_info\n\ndef get_app_info(client):\n    \"\"\"\n    Retrieves information about the applications running on Google Cloud Platform.\n    \"\"\"\n    app_info = client.osconfig.get_app_config()\n    return app_info\n\ndef main():\n    client = get_client()\n    os_info = get_os_info(client)\n    app_info = get_app_info(client)\n    \n    # Print the retrieved information\n    print(\"Operating System Information:\")\n    print(json.dumps(os_info, indent=4))\n    print(\"\\nApplications Information:\")\n    print(json.dumps(app_info, indent=4))\n\nif __name__ == \"__main__\":\n    main()\n```"
