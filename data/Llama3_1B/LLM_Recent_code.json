"```python\nfrom dataclasses import dataclass\nfrom pydantic import BaseModel\n\n@dataclass\nclass User:\n    \"\"\"User model using Pydantic and Dataclass\"\"\"\n    id: int\n    name: str\n    email: str\n\n@dataclass\nclass Order:\n    \"\"\"Order model using Pydantic and Dataclass\"\"\"\n    id: int\n    user_id: int\n    order_date: str\n    total: float\n\n# Create mock data for User\nuser1 = User(id=1, name=\"John Doe\", email=\"john@example.com\")\nuser2 = User(id=2, name=\"Jane Doe\", email=\"jane@example.com\")\n\n# Create mock data for Order\norder1 = Order(id=1, user_id=1, order_date=\"2022-01-01\", total=100.0)\norder2 = Order(id=2, user_id=1, order_date=\"2022-01-02\", total=200.0)\n\n# Create a list of orders\norders = [order1, order2]\n\n# Print the User and Order data\nfor user in [user1, user2]:\n    print(f\"User ID: {user.id}, Name: {user.name}, Email: {user.email}\")\nfor order in orders:\n    print(f\"Order ID: {order.id}, User ID: {order.user_id}, Order Date: {order.order_date}, Total: {order.total}\")\n\n# Print the User and Order data with specific attributes\nfor user in [user1, user2]:\n    print(f\"User ID: {user.id}, Name: {user.name}, Email: {user.email}, Email Type: {user.email_type}\")\nfor order in orders:\n    print(f\"Order ID: {order.id}, User ID: {order.user_id}, Order Date: {order.order_date}, Total: {order.total}, Payment Method: {order.payment_method}\")\n```"
