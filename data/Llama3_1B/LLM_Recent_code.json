"```python\nimport logging\nimport json\n\n# Create a logger with the name 'my_app' and level DEBUG\nlogger = logging.getLogger('my_app')\nlogger.setLevel(logging.DEBUG)\n\n# Create a file handler to log messages to a file\nfile_handler = logging.FileHandler('my_app.log')\nfile_handler.setLevel(logging.DEBUG)\n\n# Create a formatter to format log messages\nformatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nfile_handler.setFormatter(formatter)\n\n# Add the file handler to the logger\nlogger.addHandler(file_handler)\n\n# Create a JSON formatter to log messages in a JSON format\njson_formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\njson_handler = logging.StreamHandler()\njson_handler.setFormatter(json_formatter)\n\n# Add the JSON handler to the logger\nlogger.addHandler(json_handler)\n\ndef log_message(message, level=logging.DEBUG):\n    \"\"\"\n    Log a message with the specified level.\n    \n    Args:\n        message (str): The message to log.\n        level (int, optional): The logging level. Defaults to DEBUG.\n    \"\"\"\n    logger.log(level, message)\n\ndef log_json_message(message, data=None, level=logging.DEBUG):\n    \"\"\"\n    Log a message in JSON format with the specified level.\n    \n    Args:\n        message (str): The message to log.\n        data (dict, optional): The data to log. Defaults to None.\n        level (int, optional): The logging level. Defaults to DEBUG.\n    \"\"\"\n    if data is not None:\n        json_message = json.dumps(data)\n        logger.log(level, json_message)\n    else:\n        logger.log(level, message)\n```"
"None\n\nYou can use the `packaging` library in Python to parse and manipulate version numbers. Here's an example of how you can use it:\n\n```python\nfrom packaging import version\n\ndef parse_version(version_str):\n    \"\"\"Parse a version string into a Version object.\"\"\"\n    return version.parse(version_str)\n\ndef compare_versions(version1, version2):\n    \"\"\"Compare two version numbers.\"\"\"\n    return version1 < version2\n\ndef upgrade_version(version_str):\n    \"\"\"Upgrade a version string to the latest version.\"\"\"\n    return version_str.replace('.', '_').replace('-', '_').replace('_', '.').replace('.', '')\n\ndef downgrade_version(version_str):\n    \"\"\"Downgrade a version string to a previous version.\"\"\"\n    return version_str.replace('.', '_').replace('-', '_').replace('_', '.').replace('.', '-')\n\ndef main():\n    # Parse a version string\n    version_str = '1.2.3'\n    version_obj = parse_version(version_str)\n\n    # Compare two version numbers\n    version1 = '1.2.3'\n    version2 = '1.2.4'\n    print(f\"{version1} is less than {version2} because {compare_versions(version1, version2)}\")\n\n    # Upgrade a version string\n    version_str = '1.2.3'\n    updated_version_str = upgrade_version(version_str)\n    print(f\"{version_str} has been upgraded to {updated_version_str}\")\n\n    # Downgrade a version string\n    version_str = '1.2.3'\n    updated_version_str = downgrade_version(version_str)\n    print(f\"{version_str} has been downgraded to {updated_version_str}\")\n\nif __name__ == \"__main__\":\n    main()\n```"
