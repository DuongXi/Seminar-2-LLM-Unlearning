"```python\n# Import the required modules\nimport flake8\nfrom flake8.core import Linter\nfrom flake8 import ExtraMessages\n\n# Define a custom Linter class that overrides the check_file method\nclass CustomLinter(Linter):\n    def check_file(self, filename, config):\n        # Initialize the linter with the configuration\n        self.config = config\n\n        # Override the check_file method to implement the desired linting functionality\n        # For this example, we'll just check for a specific type of error\n        if filename.endswith('.py'):\n            # Check for a specific type of error (e.g., unused import)\n            self.check_code(codehas=\"import os\\nimport sys\\nprint(os.getcwd())\", config=self.config)\n        else:\n            # If the file is not a Python file, skip it\n            return None\n\n# Register the custom linter with flake8 using the `flake8.extension` mechanism\nflake8.extension.register('custom', CustomLinter)\n```"
