"```python\nimport json\nfrom google.oauth2 import service_account\nfrom google.cloud import bigquery\n\n# Create credentials from service account key file\ncredentials = service_account.Credentials.from_service_account_file(\n    'path_to_service_account_key.json',\n    scopes=['https://www.googleapis.com/auth/bigquery']\n)\n\n# Create client object\nclient = bigquery.Client(credentials=credentials, project='your-project-id')\n\ndef list_datasets():\n    \"\"\"Lists all datasets in the project\"\"\"\n    datasets = client.list_datasets()\n    return json.dumps(datasets)\n\ndef create_dataset(dataset_name):\n    \"\"\"Creates a new dataset\"\"\"\n    response = client.create_dataset(dataset_name=dataset_name)\n    return response\n\ndef get_dataset(dataset_name):\n    \"\"\"Gets a dataset by name\"\"\"\n    dataset = client.get_dataset(dataset_name=dataset_name)\n    return dataset\n\ndef update_dataset(dataset_name, dataset):\n    \"\"\"Updates a dataset\"\"\"\n    dataset = client.update_dataset(dataset=dataset_name, dataset=dataset)\n    return dataset\n\ndef delete_dataset(dataset_name):\n    \"\"\"Deletes a dataset\"\"\"\n    response = client.delete_dataset(dataset_name=dataset_name)\n    return response\n\ndef list_tables(dataset_name):\n    \"\"\"Lists all tables in a dataset\"\"\"\n    tables = client.list_tables(dataset_name=dataset_name)\n    return json.dumps(tables)\n\ndef create_table(dataset_name, table_name):\n    \"\"\"Creates a new table in a dataset\"\"\"\n    table = client.create_table(dataset=dataset_name, table=table_name)\n    return table\n\ndef get_table(table_name):\n    \"\"\"Gets a table by name\"\"\"\n    table = client.get_table(table_name=table_name)\n    return table\n\ndef update_table(table_name, table):\n    \"\"\"Updates a table\"\"\"\n    table = client.update_table(table=table_name, table=table)\n    return table\n\ndef delete_table(table_name):\n    \"\"\"Deletes a table\"\"\"\n    response = client.delete_table(table_name=table_name)\n    return response\n\ndef list_queries(dataset_name):\n    \"\"\"Lists all queries in a dataset\"\"\"\n    queries = client.list_queries(dataset=dataset_name)\n    return json.dumps(queries)\n\ndef create_query(dataset_name, query):\n    \"\"\"Creates a new query\"\"\"\n    query = client.create_query(dataset=dataset_name, query=query)\n    return query\n\ndef get_query(query_id):\n    \"\"\"Gets a query by ID\"\"\"\n    query = client.get_query(query_id=query_id)\n    return query\n\ndef update_query(query_id, query):\n    \"\"\"Updates a query\"\"\"\n    query = client.update_query(query=query_id, query=query)\n    return query\n\ndef delete_query(query_id):\n    \"\"\"Deletes a query\"\"\"\n    response = client.delete_query(query_id=query_id)\n    return response\n\ndef list_results(dataset_name, query_id):\n    \"\"\"Lists all results of a query\"\"\"\n    results = client.list_results(dataset=dataset_name, query=query_id)\n    return json.dumps(results)\n\ndef execute_query(query_id, query):\n    \"\"\"Executes a query\"\"\"\n    query = client.execute_query(query_id=query_id, query=query)\n    return query\n```"
