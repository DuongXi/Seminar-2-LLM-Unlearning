"```python\nfrom bs4 import BeautifulSoup\n\ndef modify_html(html_doc, new_title, new_content):\n    # Parse the HTML document using BeautifulSoup\n    soup = BeautifulSoup(html_doc, 'html.parser')\n\n    # Find the title tag\n    title_tag = soup.find('title')\n    if title_tag:\n        # Update the title\n        title_tag.string = new_title\n\n    # Find all paragraphs\n    paragraphs = soup.find_all('p')\n\n    # Add new content to the paragraphs\n    for paragraph in paragraphs:\n        # Remove any existing content\n        paragraph.unwrap()\n        # Add new content\n        paragraph.string = new_content\n\n    # Find all links\n    links = soup.find_all('a')\n    # Add a new link\n    links.append(soup.new_tag('a', href='https://www.example.com', text='Example Website'))\n\n    # Find all images\n    images = soup.find_all('img')\n    # Add a new image\n    images.append(soup.new_tag('img', src='https://www.example.com/image.jpg', alt='Example Image'))\n\n    # Create a new HTML document\n    new_html_doc = soup.prettify()\n\n    return new_html_doc\n\n# Example usage\nhtml_doc = '<html><head><title>Old Title</title></head><body><h1>Old Content</h1><p>Old paragraph 1</p><p>Old paragraph 2</p><a href=\"https://www.example.com\">New Link</a><img src=\"https://www.example.com/image.jpg\" alt=\"Example Image\"></body></html>'\nnew_title = 'New Title'\nnew_content = 'New content for the new title'\n\nnew_html_doc = modify_html(html_doc, new_title, new_content)\nprint(new_html_doc)\n```"
"```python\nimport requests\n\ndef send_get_request(url):\n    \"\"\"\n    Sends an HTTP GET request to the specified URL and prints the response status code and contents.\n    \n    Args:\n        url (str): The URL to send the GET request to.\n    \"\"\"\n    try:\n        # Send the GET request using the requests library\n        response = requests.get(url)\n        \n        # Print the response status code\n        print(f\"Status Code: {response.status_code}\")\n        \n        # Print the response contents\n        print(response.text)\n    \n    except requests.exceptions.RequestException as e:\n        # Print any exceptions that occur during the request\n        print(f\"An error occurred: {e}\")\n\n# Example usage:\nurl = \"https://www.example.com\"\nsend_get_request(url)\n```"
"```python\nimport json\nfrom google.oauth2.credentials import Credentials\nfrom googleapiclient.discovery import build\nfrom google_auth_oauthlib.flow import InstalledAppFlow\nfrom google.auth.transport.requests import Request\nimport pickle\n\n# If modifying these scopes, delete the file token.pickle.\nSCOPES = ['https://www.googleapis.com/auth/salesforce.readonly']\n\nclass SalesforceAPI:\n    def __init__(self, instance_url, username, password):\n        \"\"\"\n        Initialize the Salesforce API wrapper class.\n\n        Args:\n        instance_url (str): The URL of the Salesforce instance.\n        username (str): The username to use for authentication.\n        password (str): The password to use for authentication.\n        \"\"\"\n        self.instance_url = instance_url\n        self.username = username\n        self.password = password\n\n        # Create credentials and load the credentials from a file.\n        self creds = None\n        if os.path.exists('token.pickle'):\n            with open('token.pickle', 'rb') as token:\n                self.creds = pickle.load(token)\n\n        # If there are no valid credentials, create a new set of credentials.\n        if self.creds is None or not self.creds.valid:\n            if self.creds and self.creds.expired and self.creds.refresh_token:\n                self.creds.refresh(Request())\n\n            else:\n                flow = InstalledAppFlow.from_client_secrets_file(\n                    'credentials.json', SCOPES)\n                self.creds = flow.run_local_server(port=0)\n\n        self.service = build('salesforce', 'v48', credentials=self.creds)\n\n    def login(self):\n        \"\"\"\n        Log in to the Salesforce API.\n\n        Returns:\n        A dictionary containing the access token.\n        \"\"\"\n        return self.service.auth.token.get()\n\n    def create_record(self, field_values):\n        \"\"\"\n        Create a new record in the Salesforce API.\n\n        Args:\n        field_values (dict): A dictionary of field values for the record.\n\n        Returns:\n        A dictionary containing the created record.\n        \"\"\"\n        response = self.service.salesforce.models.SalesforceRecord.new(\n            **field_values)\n        return response.execute()\n\n    def update_record(self, record_id, field_values):\n        \"\"\"\n        Update an existing record in the Salesforce API.\n\n        Args:\n        record_id (str): The ID of the record to update.\n        field_values (dict): A dictionary of field values for the record.\n\n        Returns:\n        A dictionary containing the updated record.\n        \"\"\"\n        response = self.service.salesforce.models.SalesforceRecord.new(\n            id=record_id, **field_values)\n        return response.execute()\n\n    def search_records(self, query, limit=100):\n        \"\"\"\n        Search for records in the Salesforce API.\n\n        Args:\n        query (str): The search query.\n        limit (int, optional): The maximum number of records to return. Defaults to 100.\n\n        Returns:\n        A list of dictionaries containing the search results.\n        \"\"\"\n        return self.service.salesforce.models.SalesforceQuery.new(\n            query=query, limit=limit).execute()\n```\n\n```python\nimport os\nimport json\nimport pickle\n\ndef load_token():\n    if os.path.exists('token.pickle'):\n        with open('token.pickle', 'rb') as token:\n            return pickle.load(token)\n    else:\n        return None\n\ndef create_credentials(instance_url, username, password):\n    return load_token()\n\ndef main():\n    instance_url = 'https://your-salesforce-instance.com'\n    username = 'your-username'\n    password = 'your-password'\n\n    credentials = create_credentials(instance_url, username, password)\n    if credentials is not None:\n        api = SalesforceAPI(instance_url, username, password)\n        print(api.login())\n        print(api.create_record({'Id': 'E000000001', 'Name': 'Test Record'}))\n        print(api.update_record('E000000001', {'Name': 'Updated Test Record'}))\n        print(api.search_records('SELECT Id, Name FROM Account WHERE Name = \"Test Account\"'))\n        api.service.close()\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nfrom apachedatasketches import Sketch\n\ndef estimate_unique_elements(dataset):\n    \"\"\"\n    Estimate the frequency of unique elements in a dataset using Apache DataSketches Library.\n    \n    Args:\n        dataset (list): A list of unique elements in the dataset.\n    \n    Returns:\n        None\n    \"\"\"\n    \n    # Create a Sketch object to estimate the frequency of unique elements\n    sketch = Sketch()\n    \n    # Estimate the frequency of unique elements\n    sketch.estimate_unique_elements(dataset)\n\n# Example usage:\ndataset = [1, 2, 3, 4, 2, 3, 1, 4, 5, 5, 6]\nestimate_unique_elements(dataset)\n```"
