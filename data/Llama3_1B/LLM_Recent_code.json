"```python\nimport numpy as np\nimport random\nfrom scipy.optimize import differential_evolution\n\ndef generate_random_function(x):\n    \"\"\"Generate a random function to be optimized.\"\"\"\n    return -(x[0]**2 + x[1]**2)  # Minimize the function\n\ndef initialize_particles(n_particles):\n    \"\"\"Initialize particles for the PSO algorithm.\"\"\"\n    particles = []\n    for _ in range(n_particles):\n        x = np.random.uniform(-10, 10, 2)\n        particles.append(x)\n    return particles\n\ndef fitness(particle):\n    \"\"\"Calculate the fitness of a particle.\"\"\"\n    return -particle[0]**2 - particle[1]**2  # Minimize the function\n\ndef update_velocity(particle, x, f):\n    \"\"\"Update the velocity of a particle.\"\"\"\n    mu = f * particle / np.linalg.norm(particle)**3\n    v = np.zeros(2)\n    v[0] = mu[0] * particle[0] - mu[1] * particle[1]\n    v[1] = mu[0] * particle[1] + mu[1] * particle[0]\n    return v\n\ndef update_position(particle, x, v):\n    \"\"\"Update the position of a particle.\"\"\"\n    pos = particle + v\n    return pos\n\ndef f(x):\n    \"\"\"Evaluate the fitness of a particle.\"\"\"\n    return -x[0]**2 - x[1]**2\n\ndef pso(n_particles, n_iterations, bounds):\n    \"\"\"Perform global optimization using the Fuzzy Self-Tuning PSO algorithm.\"\"\"\n    res = differential_evolution(f, bounds, args=(pso, None), x0=initialize_particles(n_particles))\n    return res.x\n\nres = pso(100, 1000, [-10, 10, -10, 10])\nprint(\"Optimal solution:\", res)\nprint(\"Fitness:\", -res[0]**2 - res[1]**2)\n```"
