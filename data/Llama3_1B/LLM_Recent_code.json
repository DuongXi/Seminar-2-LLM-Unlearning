"```python\nimport zipfile\n\ndef open_compressed_file(file_path):\n    \"\"\"\n    Opens a compressed file transparently using the zipfile module.\n\n    Args:\n        file_path (str): The path to the compressed file.\n\n    Returns:\n        list: A list of files in the compressed file.\n    \"\"\"\n    try:\n        # Create a zipfile object from the file\n        with zipfile.ZipFile(file_path) as zip_ref:\n            # Get the list of files in the zip_ref object\n            files = list(zip_ref.infolist())\n            return files\n    except FileNotFoundError:\n        print(f\"File not found: {file_path}\")\n        return None\n    except zipfile.BadZipFile:\n        print(f\"Invalid zip file: {file_path}\")\n        return None\n\n# Example usage\nfile_path = \"path_to_your_compressed_file.zip\"\nfiles = open_compressed_file(file_path)\nif files:\n    print(\"Files in the zip file:\")\n    for file in files:\n        print(file.filename)\n```"
