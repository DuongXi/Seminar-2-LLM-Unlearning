"```python\nimport threading\n\n# Plugin registry\nplugins = {}\n\n# Plugin hook list\nplugin_hooks = []\n\nclass Plugin:\n    def __init__(self, name):\n        self.name = name\n        self.hooks = []\n\n    def register_hook(self, hook):\n        self.hooks.append(hook)\n\n    def run(self):\n        for hook in self.hooks:\n            hook()\n\nclass PluginManager:\n    def __init__(self):\n        self.plugins = {}\n        self.lock = threading.Lock()\n\n    def register_plugin(self, name, plugin):\n        with self.lock:\n            self.plugins[name] = plugin\n\n    def call_plugins(self, name, *args, **kwargs):\n        with self.lock:\n            if name in self.plugins:\n                for hook in self.plugins[name].hooks:\n                    hook(*args, **kwargs)\n\ndef main():\n    manager = PluginManager()\n\n    def example_plugin1():\n        print(\"Example plugin 1 executed\")\n\n    def example_plugin2():\n        print(\"Example plugin 2 executed\")\n\n    manager.register_plugin(\"example_plugin1\", example_plugin1)\n    manager.register_plugin(\"example_plugin2\", example_plugin2)\n\n    def execute_plugins():\n        manager.call_plugins(\"example_plugin1\", \"arg1\", \"arg2\")\n        manager.call_plugins(\"example_plugin2\")\n\n    threading.Thread(target=execute_plugins).start()\n\nif __name__ == \"__main__\":\n    main()\n```"
