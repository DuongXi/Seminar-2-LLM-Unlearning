"```python\n# Import necessary libraries\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\n\n# Create a sample dataset\ndata = {'Country': ['USA', 'Canada', 'Mexico', 'UK', 'Germany'],\n        'Year': [2015, 2016, 2017, 2018, 2019],\n        'Sales': [100, 120, 130, 110, 140]}\ndf = pd.DataFrame(data)\n\n# Line Plot\nplt.figure(figsize=(10, 6))\nsns.lineplot(x='Year', y='Sales', data=df)\nplt.title('Sales Over Time')\nplt.xlabel('Year')\nplt.ylabel('Sales')\nplt.show()\n\n# Scatter Plot\nplt.figure(figsize=(8, 6))\nsns.scatterplot(x='Sales', y='Year', data=df)\nplt.title('Sales vs. Year')\nplt.xlabel('Sales')\nplt.ylabel('Year')\nplt.show()\n\n# Bar Chart\nplt.figure(figsize=(8, 6))\nsns.barplot(x='Country', y='Sales', data=df)\nplt.title('Sales by Country')\nplt.xlabel('Country')\nplt.ylabel('Sales')\nplt.show()\n\n# Histogram\nplt.figure(figsize=(10, 6))\nsns.histplot(df['Sales'], kde=True)\nplt.title('Histogram of Sales')\nplt.xlabel('Sales')\nplt.ylabel('Frequency')\nplt.show()\n\n# Box Plot\nplt.figure(figsize=(10, 6))\nsns.boxplot(x='Country', y='Sales', data=df)\nplt.title('Box Plot of Sales by Country')\nplt.xlabel('Country')\nplt.ylabel('Sales')\nplt.show()\n\n# Heatmap\nplt.figure(figsize=(10, 8))\nsns.heatmap(df[['Sales', 'Year']].corr(), annot=True, cmap='coolwarm')\nplt.title('Correlation Matrix')\nplt.show()\n```"
"```python\n# Import the necessary libraries\nimport requests\nimport base64\nfrom botocore.exceptions import NoCredentialsError\n\n# Set up AWS4 authentication\ndef set_aws4_auth(aws_access_key_id, aws_secret_access_key, region_name, service):\n    \"\"\"\n    Sets up AWS4 authentication using the provided credentials and region.\n\n    Args:\n        aws_access_key_id (str): Your AWS access key ID.\n        aws_secret_access_key (str): Your AWS secret access key.\n        region_name (str): The name of the region to use for authentication.\n        service (str): The AWS service to use for authentication.\n\n    Returns:\n        A dictionary containing the authentication details.\n    \"\"\"\n    # Create a dictionary to store the authentication details\n    auth_details = {}\n\n    # Set up the AWS4 signature\n    if service == 's3':\n        # For S3, we use the IAM user's AWS credentials\n        auth_details['aws4_request'] = {\n            'aws4_request': {\n                'method': 'GET',\n                'uri': '/',\n                'headers': {\n                    'X-Amz-Target': '2012-11-09 AWS services API version 2012-11-09',\n                    'X-Amz-User-Pattern': 'AWS'\n                }\n            },\n            'aws4-signature': {\n                'hash': 'sha1',\n                'algorithm': 'HMACSHA1',\n                'secret_access_key': base64.b64encode(aws_secret_access_key.encode('utf-8')).decode('utf-8')\n            }\n        }\n    elif service == 's3s3':\n        # For S3S3, we use the IAM user's AWS credentials\n        auth_details['aws4_request'] = {\n            'aws4_request': {\n                'method': 'GET',\n                'uri': '/',\n                'headers': {\n                    'X-Amz-Target': '2012-11-09 AWS services API version 2012-11-09',\n                    'X-Amz-User-Pattern': 'AWS'\n                }\n            },\n            'aws4-signature': {\n                'hash': 'sha1',\n                'algorithm': 'HMACSHA1',\n                'secret_access_key': base64.b64encode(aws_secret_access_key.encode('utf-8')).decode('utf-8')\n            }\n        }\n    else:\n        raise ValueError('Unsupported service')\n\n    # Return the authentication details\n    return auth_details\n\n# Example usage\naws_access_key_id = 'YOUR_AWS_ACCESS_KEY_ID'\naws_secret_access_key = 'YOUR_AWS_SECRET_ACCESS_KEY'\nregion_name = 'YOUR_REGION_NAME'\nservice = 's3'\n\nauth_details = set_aws4_auth(aws_access_key_id, aws_secret_access_key, region_name, service)\n\n# Use the authenticated requests\nresponse = requests.get('https://s3.amazonaws.com/', auth=auth_details['aws4_request']['aws4-signature'])\nprint(response.status_code)\n```"
"```python\nimport graphviz  # Import the Graphviz library\nfrom graphviz import Digraph  # Import the Digraph class\n\nclass Graph:\n    def __init__(self):\n        # Create an empty directed graph\n        self.graph = Digraph()\n\n    def add_node(self, name):\n        \"\"\"Add a node to the graph.\"\"\"\n        # Add a new node with the given name\n        self.graph.node(name, name)\n\n    def remove_node(self, name):\n        \"\"\"Remove a node from the graph.\"\"\"\n        # Remove the node with the given name\n        self.graph.remove_node(name)\n\n    def add_edge(self, from_node, to_node):\n        \"\"\"Add an edge between two nodes in the graph.\"\"\"\n        # Add an edge between the given nodes\n        self.graph.edge(from_node, to_node)\n\n    def export_to_dot(self, filename):\n        \"\"\"Export the graph to a dot file.\"\"\"\n        # Export the graph to a dot file\n        self.graph.render(filename, format=\"dot\")\n\n    def export_to_pdf(self, filename):\n        \"\"\"Export the graph to a PDF file.\"\"\"\n        # Export the graph to a PDF file\n        self.graph.render(filename, format=\"pdf\")\n\n    def export_to_png(self, filename):\n        \"\"\"Export the graph to a PNG file.\"\"\"\n        # Export the graph to a PNG file\n        self.graph.render(filename, format=\"png\")\n\n# Create a new graph\ngraph = Graph()\n\n# Add nodes\ngraph.add_node(\"A\")\ngraph.add_node(\"B\")\ngraph.add_node(\"C\")\n\n# Add edges\ngraph.add_edge(\"A\", \"B\")\ngraph.add_edge(\"B\", \"C\")\ngraph.add_edge(\"C\", \"A\")\n\n# Export to dot\ngraph.export_to_dot(\"graph.dot\")\n\n# Export to PDF\ngraph.export_to_pdf(\"graph.pdf\")\n\n# Export to PNG\ngraph.export_to_png(\"graph.png\")\n```\n\nThis code creates a `Graph` class that allows you to add nodes and edges, manipulate the graph, and export it to various formats. The `add_node`, `remove_node`, `add_edge`, `export_to_dot`, `export_to_pdf`, and `export_to_png` methods provide a way to interact with the graph."
