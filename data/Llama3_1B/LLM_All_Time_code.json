"```python\nimport json\nimport base64\nimport os\n\n# Google Sheets API credentials\nAPI_KEY = \"YOUR_API_KEY\"\nCREDENTIALS_FILE = \"credentials.json\"\n\ndef google_sheets_service():\n    \"\"\"Returns the Google Sheets service object\"\"\"\n    credentials = None\n    if os.path.exists(CREDENTIALS_FILE):\n        with open(CREDENTIALS_FILE, 'r') as f:\n            credentials = json.load(f)\n    if not credentials or not credentials['key']:\n        raise ValueError(\"No valid API key found in credentials file\")\n    return googleapiclient.discovery.build('sheets', 'v4', credentials=credentials)\n\ndef create_sheet(sheets_service, title, sheet_data):\n    \"\"\"Creates a new sheet with the given title and data\"\"\"\n    body = {\n        'properties': {\n            'title': title,\n            'sheetProperties': {\n                'format': {\n                    'type': 'FORMULA'\n                }\n            }\n        }\n    }\n    response = sheets_service.spreadsheets().values().update(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title,\n        valueInputOption='USER_ENTERED',\n        body=body).execute()\n    return response\n\ndef update_sheet(sheets_service, title, sheet_data):\n    \"\"\"Updates the data in the sheet with the given title\"\"\"\n    body = {\n        'values': sheet_data\n    }\n    response = sheets_service.spreadsheets().values().update(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title,\n        valueInputOption='USER_ENTERED',\n        body=body).execute()\n    return response\n\ndef delete_sheet(sheets_service, title):\n    \"\"\"Deletes the sheet with the given title\"\"\"\n    response = sheets_service.spreadsheets().deleteSheets(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title).execute()\n    return response\n\ndef rename_sheet(sheets_service, old_title, new_title):\n    \"\"\"Renames the sheet with the given old title to new_title\"\"\"\n    body = {\n        'properties': {\n            'title': new_title\n        }\n    }\n    response = sheets_service.spreadsheets().updateProperties(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=old_title,\n        valueInputOption='USER_ENTERED',\n        body=body).execute()\n    return response\n\ndef add_sheet(sheets_service, title):\n    \"\"\"Adds a new sheet with the given title\"\"\"\n    body = {\n        'properties': {\n            'title': title\n        }\n    }\n    response = sheets_service.spreadsheets().insert(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title,\n        properties=body).execute()\n    return response\n\ndef remove_sheet(sheets_service, title):\n    \"\"\"Deletes the sheet with the given title\"\"\"\n    response = sheets_service.spreadsheets().deleteSheet(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title).execute()\n    return response\n\ndef update_sheet_data(sheets_service, title, data):\n    \"\"\"Updates the data in the sheet with the given title\"\"\"\n    body = {\n        'values': data\n    }\n    response = sheets_service.spreadsheets().values().update(\n        spreadsheetId=os.environ['SPREADSHEET_ID'],\n        range=title,\n        valueInputOption='USER_ENTERED',\n        body=body).execute()\n    return response\n\n# Authenticate with Google Sheets API\nsheets_service = google_sheets_service()\nif not sheets_service:\n    print(\"Failed to authenticate with Google Sheets API\")\n    exit(1)\n\n# Load spreadsheet data\nspreadsheet_data = {}\n\n# Get the spreadsheet ID from the environment variable\nspreadsheet_id = os.environ['SPREADSHEET_ID']\n\n# Get the spreadsheet title from the environment variable\ntitle = os.environ['SPREADSHEET_TITLE']\n\n# Load the spreadsheet data from Google Sheets API\nsheets_service.spreadsheets().getSpreadsheets().execute(\n    spreadsheetId=spreadsheet_id).execute()\n    data = json.loads(response.json()['values'])\n    for row in data:\n        spreadsheet_data[row[0]] = row[1:]\n\n# Add a new sheet\nnew_title = \"New Sheet\"\nnew_data = [[\"Cell 1\", \"Cell 2\"], [\"Cell 3\", \"Cell 4\"]]\nresponse = create_sheet(sheets_service, new_title, new_data)\nif response.status_code != 200:\n    print(\"Failed to add new sheet\")\n    exit(1)\n\n# Update an existing sheet\nold_title = \"Old Sheet\"\nnew_data = [[\"Cell 1\", \"Cell 2\"], [\"Cell 3\", \"Cell 4\"]]\nresponse = update_sheet(sheets_service, old_title, new_data)\nif response.status_code != 200:\n    print(\"Failed to update sheet\")\n    exit(1)\n\n# Delete a sheet\ndelete_title = \"Old Sheet\"\nresponse = delete_sheet(sheets_service, delete_title)\nif response.status_code != 200:\n    print(\"Failed to delete sheet\")\n    exit(1)\n\n# Rename a sheet\nrename_title = \"New Sheet\"\nnew_title = \"New Title\"\nresponse = rename_sheet(sheets_service, rename_title, new_title)\nif response.status_code != 200:\n    print(\"Failed to rename sheet\")\n    exit(1)\n\n# Add a new sheet\nnew_title = \"New Sheet\"\nnew_data = [[\"Cell 1\", \"Cell 2\"], [\"Cell 3\", \"Cell 4\"]]\nresponse = create_sheet(sheets_service, new_title, new_data)\nif response.status_code != 200:\n    print(\"Failed to add new sheet\")\n    exit(1)\n\n# Update an existing sheet\nold_title = \"Old Sheet\"\nnew_data = [[\"Cell 1\", \"Cell 2\"], [\"Cell 3\", \"Cell 4\"]]\nresponse = update_sheet(sheets_service, old_title, new_data)\nif response.status_code != 200:\n    print(\"Failed to update sheet\")\n    exit(1)\n\n# Delete a sheet\ndelete_title = \"Old Sheet\"\nresponse = delete_sheet(sheets_service, delete_title)\nif response.status_code != 200:\n    print(\"Failed to delete sheet\")\n    exit(1)\n\n# Rename a sheet\nrename_title = \"New Sheet\"\nnew_title = \"New Title\"\nresponse = rename_sheet(sheets_service, rename_title, new_title)\nif response.status_code != 200:\n    print(\"Failed to rename sheet\")\n    exit(1)\n```\n\nPlease note that you need to replace `\"YOUR_API_KEY\"` and `\"YOUR_SPREADSHEET_ID\"` with your actual Google Sheets API key and spreadsheet ID. Also, make sure to update the `spreadsheet_title` environment variable with the desired title for your spreadsheet.\n\nThis code creates a new sheet, updates an existing sheet, deletes a sheet, renames a sheet, and adds a new sheet. It also updates an existing sheet and deletes a sheet, but does not rename a sheet."
"```python\nimport os\nfrom google.oauth2 import service_account\nfrom google.cloud import secretmanager\n\n# Set up the project ID and service account credentials\nproject_id = 'your-project-id'\nprivate_key_file = 'path/to/private/key.json'\nclient_email = 'your-email@example.com'\n\n# Create a client instance with the service account credentials\ncredentials = service_account.Credentials.from_service_account_file(\n    private_key_file,\n    scopes=['https://www.googleapis.com/auth/cloud-platform']\n)\n\n# Create a SecretManager client instance\nsecret_manager_client = secretmanager.SecretManagerServiceClient(credentials=credentials)\n\ndef create_secret(name, secret_data):\n    \"\"\"Create a new secret in SecretManager\"\"\"\n    # Create a new secret with the given name and secret data\n    secret = secret_manager_client.create_secret(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, name, name),\n        secret_data=secret_data\n    )\n    return secret\n\ndef read_secret(secret_name):\n    \"\"\"Read a secret from SecretManager\"\"\"\n    # Read a secret from SecretManager\n    secret = secret_manager_client.access_secret_version(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, secret_name)\n    )\n    return secret.data.decode('utf-8')\n\ndef update_secret(secret_name, secret_data):\n    \"\"\"Update a secret in SecretManager\"\"\"\n    # Update a secret in SecretManager\n    secret = secret_manager_client.update_secret(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, secret_name)\n    )\n    secret_data = secret.data.decode('utf-8')\n    secret_manager_client.update_secret_version(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, secret_name),\n        body=secret_data\n    )\n    return secret\n\ndef delete_secret(secret_name):\n    \"\"\"Delete a secret from SecretManager\"\"\"\n    # Delete a secret from SecretManager\n    secret = secret_manager_client.delete_secret(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, secret_name)\n    )\n    return secret\n\ndef list_secrets():\n    \"\"\"List all secrets in SecretManager\"\"\"\n    # List all secrets in SecretManager\n    secrets = secret_manager_client.list_secret_versions(\n        parent='projects/{}/secrets/{}/'.format(project_id, secret_name)\n    )\n    return secrets\n\ndef list_secret_versions(secret_name):\n    \"\"\"List all versions of a secret in SecretManager\"\"\"\n    # List all versions of a secret in SecretManager\n    versions = secret_manager_client.access_secret_version(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, secret_name)\n    )\n    return versions\n\ndef get_secret_version(secret_name, version):\n    \"\"\"Fetch a specific version of a secret in SecretManager\"\"\"\n    # Fetch a specific version of a secret in SecretManager\n    version = secret_manager_client.access_secret_version(\n        parent='projects/{}/secrets/{}/versions/{}/'.format(project_id, secret_name, version)\n    )\n    return version.data.decode('utf-8')\n```\n\nPlease note that you will need to replace `'your-project-id'`, `'your-email@example.com'`, and `'path/to/private/key.json'` with your actual project ID, email address, and private key file path, respectively. Also, make sure to enable the `Secrets` API in the Google Cloud Console and create credentials for your project."
"```python\nimport pika\n\n# Create a connection to the AMQP server\nconnection = pika.BlockingConnection(\n    pika.ConnectionParameters(\n        host='localhost',  # Replace with the host you want to connect to\n        port=5672,  # Replace with the port you want to connect to\n        virtual_host='',\n        credentials=None  # No credentials are required for the default RabbitMQ server\n    )\n)\n\n# Create a channel to the queue you want to connect to\nchannel = connection.channel()\n\n# Declare the queue\nchannel.queue_declare(queue='my_queue')\n\n# Declare exchange and queue bindings\nchannel.exchange_declare(exchange='my_exchange', type='direct', durable=True)\nchannel.queue_declare(queue='my_queue', durable=True)\n\n# Declare the exchange and queue bindings\nchannel.queue_declare(exchange='my_exchange', type='direct', durable=True)\nchannel.queue_declare(queue='my_queue', durable=True)\n```"
"```python\nimport time\nfrom tqdm import tqdm\n\ndef progress_bar(title, max_value, incremental_value):\n    \"\"\"\n    Creates a progress bar using a while loop and print statements.\n\n    Args:\n        title (str): The title of the progress bar.\n        max_value (int): The maximum value of the progress bar.\n        incremental_value (int): The incremental value of the progress bar.\n    \"\"\"\n\n    # Initialize the progress bar\n    bar = tqdm(total=max_value, desc=title)\n\n    # Initialize the current value\n    current_value = 0\n\n    # Initialize the elapsed time\n    elapsed_time = 0\n\n    # Start the timer\n    start_time = time.time()\n\n    # Loop until the current value reaches the maximum value\n    while current_value < max_value:\n        # Print the current value\n        print(f\"Progress: {current_value}/{max_value}\", end='\\r')\n\n        # Increment the current value\n        current_value += incremental_value\n\n        # Update the elapsed time\n        elapsed_time = time.time() - start_time\n\n        # Print the elapsed time\n        print(f\"Elapsed Time: {elapsed_time:.2f} seconds\", end='\\r')\n\n        # Wait for a short time before the next iteration\n        time.sleep(0.01)\n\n    # Print a message to indicate the completion of the operation\n    print(f\"\\nOperation completed. Time taken: {elapsed_time:.2f} seconds\")\n\n# Example usage\nprogress_bar(\"Long-running operation\", 100, 5)\n```"
"```python\nimport csv\nfrom collections import defaultdict\nimport re\n\ndef read_csv(file_path):\n    \"\"\"\n    Reads a CSV file and returns a dictionary.\n    \n    Args:\n        file_path (str): The path to the CSV file.\n    \n    Returns:\n        dict: A dictionary where the keys are the column names and the values are lists of values in each row.\n    \"\"\"\n    with open(file_path, 'r') as file:\n        reader = csv.DictReader(file)\n        data = {column: row for column, row in reader}\n    return data\n\ndef remove_duplicates(lst):\n    \"\"\"\n    Removes duplicates from a list while preserving the original order.\n    \n    Args:\n        lst (list): The list to remove duplicates from.\n    \n    Returns:\n        list: A new list with duplicates removed.\n    \"\"\"\n    return list(dict.fromkeys(lst))\n\ndef to_title_case(s):\n    \"\"\"\n    Converts a string to title case.\n    \n    Args:\n        s (str): The string to convert.\n    \n    Returns:\n        str: The string in title case.\n    \"\"\"\n    return re.sub(r'(\\w)([A-Z])', r'\\1 \\2', s).strip().title()\n\n# Example usage:\ndata = read_csv('example.csv')\nprint(\"Original data:\")\nprint(data)\n\n# Remove duplicates\nunique_data = remove_duplicates(data)\nprint(\"\\nUnique data:\")\nprint(unique_data)\n\n# Convert string to title case\ntitle_cased_data = to_title_case(data['Name'])\nprint(\"\\nTitle-cased data:\")\nprint(title_cased_data)\n```"
"```python\nimport os\n\ndef get_monotonic_time():\n    \"\"\"\n    Returns the monotonic time in seconds since the epoch (January 1, 1970) as a floating-point number.\n    \n    This is done by using the os.clock_gettime function with the CLOCK_MONOTONIC flag, which returns the time in nanoseconds.\n    We convert the result to seconds by dividing by 1e9 (1000000000).\n    \"\"\"\n    # Get the monotonic time in nanoseconds\n    monotonic_time_ns = os.clock_gettime(os.CLOCK_MONOTONIC, 0)\n    \n    # Convert the time from nanoseconds to seconds\n    monotonic_time_s = monotonic_time_ns / 1e9\n    \n    return monotonic_time_s\n\n# Test the function\nprint(get_monotonic_time())\n```"
"```python\n# Import necessary libraries\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score\nimport numpy as np\n\n# Define a class for the model\nclass CustomModel(keras.Model):\n    def __init__(self):\n        super(CustomModel, self).__init__()\n        # Define the model architecture using the Sequential API\n        self.model = keras.Sequential([\n            # Input layer with 784 units (28x28 images)\n            keras.layers.Dense(128, activation='relu', input_shape=(28, 28)),\n            # Flatten the output\n            keras.layers.Flatten(),\n            # Dense layer with 10 units (10 classes) and ReLU activation\n            keras.layers.Dense(10, activation='relu'),\n            # Output layer with 10 units (10 classes)\n            keras.layers.Dense(10, activation='softmax')\n        ])\n\n    # Compile the model with a loss function (mean squared error) and an optimizer (adam)\n    def compile(self, optimizer='adam', loss='mean_squared_error'):\n        super(CustomModel, self).compile()\n        if loss == 'mean_squared_error':\n            self optimizer = keras.optimizers.Adam(learning_rate=0.001)\n        elif loss == 'categorical_crossentropy':\n            self optimizer = keras.optimizers.Adam(learning_rate=0.001)\n        else:\n            raise ValueError(\"Invalid loss function. Supported options are 'mean_squared_error' and 'categorical_crossentropy'.\")\n        return self.optimizer\n\n    # Define the model's loss function and optimizer\n    def loss_function(self, x, y):\n        return tf.reduce_mean(tf.square(x - y))\n\n    def train_step(self, data):\n        # Split the data into input and labels\n        x, y = data\n\n        # Zero the gradients of the optimizer\n        with tf.GradientTape() as tape:\n            loss = self.loss_function(x, y)\n            # Compute the gradients of the loss with respect to the model's parameters\n            gradients = tape.gradient(loss, self.trainable_variables)\n        # Apply the gradients to the optimizer\n        self.optimizer.apply_gradients(zip(gradients, self.trainable_variables))\n        return {'loss': loss}\n\n    # Define the model's evaluation metrics\n    def evaluate(self, data):\n        # Split the data into input and labels\n        x, y = data\n\n        # Compute the accuracy of the model\n        predictions = self.predict(x)\n        correct_predictions = tf.equal(tf.argmax(predictions, axis=1), tf.argmax(y, axis=1))\n        accuracy = tf.reduce_mean(correct_predictions)\n        return accuracy\n\n    # Define the model's prediction function\n    def predict(self, x):\n        return self.model(x)\n```"
"```python\nfrom datetime import datetime, timedelta\nfrom itertools import cycle\n\ndef cron_like_iterator(format_string):\n    \"\"\"\n    Generate a cron-like iterator over dates in a given format string.\n    \n    Args:\n    format_string (str): A cron-like format string (e.g., \"%Y-%m-%d %H:%M:%S\").\n    \n    Yields:\n    datetime.date: An iterator over the matching dates in the given format string.\n    \"\"\"\n    \n    # Parse the format string into a datetime format\n    dt_format = \"%Y-%m-%d %H:%M:%S\"\n    date_format = \"%Y-%m-%d\"\n    \n    # Create a generator that yields the matching dates\n    for date in cycle(datetime.strptime(date_format, format_string).date(), datetime.strptime(date_format, format_string).date() + timedelta(days=1)):\n        yield date\n\n# Example usage:\nformat_string = \"%Y-%m-%d %H:%M:%S\"\nfor date in cron_like_iterator(format_string):\n    print(date)\n```\n\nIn this code:\n\n- We define a function `cron_like_iterator` that takes a format string as input and returns an iterator over the matching dates in the given format string.\n- We parse the format string into a datetime format using `strptime` from the `datetime` module.\n- We create a generator that yields the matching dates using `cycle` from the `itertools` module. The generator yields the dates in the specified format string.\n- In the example usage, we define a format string and call the `cron_like_iterator` function to generate an iterator over the matching dates. We then print each date in the iterator."
"```python\nimport pytest\n\n# Define a function to run tests in isolated subprocesses\ndef run_tests_isolated():\n    \"\"\"Run tests in isolated subprocesses using pytest.\"\"\"\n    # Run pytest with the '--isolated-subprocess' flag\n    try:\n        # Attempt to run pytest\n        pytest.main([\"--isolated-subprocess\"])\n    except Exception as e:\n        # Handle any exceptions that occur during pytest execution\n        print(f\"Error running tests: {e}\")\n\n# Call the function to run tests in isolated subprocesses\nrun_tests_isolated()\n```"
"```python\n# Import the necessary modules\nfrom django.http import JsonResponse\nfrom django.views import View\nfrom django.urls import path, include\nfrom rest_framework import status\nfrom rest_framework.response import Response\nfrom rest_framework.views import APIView\nfrom rest_framework import generics\nfrom rest_framework import permissions\nfrom rest_framework import serialization\nfrom rest_framework import viewsets\nfrom rest_framework import filters\nfrom .models import Product\nfrom .serializers import ProductSerializer\n\n# Define a Product class\nclass ProductView(APIView):\n    permission_classes = [permissions.IsAuthenticated]\n\n    def get(self, request):\n        # Return all products\n        products = Product.objects.all()\n        return JsonResponse([{'id': product.id, 'name': product.name, 'price': product.price} for product in products], safe=False)\n\n    def post(self, request):\n        # Create a new product\n        serializer = ProductSerializer(data=request.data)\n        if serializer.is_valid():\n            serializer.save()\n            return JsonResponse(serializer.data, status=status.HTTP_201_CREATED)\n        return JsonResponse(serializer.errors, status=status.HTTP_400_BAD_REQUEST)\n\nclass ProductSerializer(serialization.Serialization):\n    class Meta:\n        model = Product\n        fields = ('id', 'name', 'price')\n\nclass ProductViewsets(viewsets.ModelViewSet):\n    queryset = Product.objects.all()\n    serializer_class = ProductSerializer\n    filters_class = filters.SearchFilter\n    permission_classes = [permissions.IsAuthenticated]\n    serializer_class = ProductSerializer\n\n# Define a ProductSerializer class\nclass ProductSerializer(serialization.Serialization):\n    class Meta:\n        model = Product\n        fields = ('id', 'name', 'price')\n\nclass ProductView(generics.ListAPIView):\n    queryset = Product.objects.all()\n    serializer_class = ProductSerializer\n    pagination_class = None\n\nclass ProductViewsets(viewsets.ModelViewSet):\n    queryset = Product.objects.all()\n    serializer_class = ProductSerializer\n    filters_class = filters.SearchFilter\n    permission_classes = [permissions.IsAuthenticated]\n    serializer_class = ProductSerializer\n\n# Include all URLs\nurlpatterns = [\n    path('api/products/', ProductView.as_view(), name='product_list'),\n    path('api/products/<int:pk>/', ProductView.as_view(), name='product_detail'),\n    path('api/products/', ProductViewsets.as_view(), name='product_list'),\n    path('api/products/<int:pk>/', ProductViewsets.as_view(), name='product_detail'),\n]\n```"
