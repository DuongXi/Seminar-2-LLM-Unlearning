"```python\nimport os\n\ndef compress_http_headers(headers):\n    \"\"\"\n    Compress HTTP headers using HPACK algorithm.\n\n    Args:\n        headers (dict): A dictionary of HTTP headers.\n\n    Returns:\n        bytes: The compressed HTTP headers.\n    \"\"\"\n\n    # Initialize the HPACK buffer\n    hpack_buffer = b''\n\n    # Iterate over each header\n    for header, value in headers.items():\n        # Convert the header to bytes\n        header_bytes = header.encode('utf-8')\n\n        # Check if the header is a string\n        if isinstance(header_bytes, str):\n            # Add the string to the HPACK buffer\n            hpack_buffer += header_bytes + b'\\x00'\n        else:\n            # Add the bytes to the HPACK buffer\n            hpack_buffer += header_bytes\n\n    # Calculate the size of the HPACK buffer\n    hpack_size = len(hpack_buffer)\n\n    # Write the HPACK header\n    hpack_header = b'HTTP/1.1 200 OK\\r\\n'\n    hpack_header += b'Content-Encoding: hpack\\r\\n'\n    hpack_header += b'Content-Length: %d\\r\\n' % hpack_size\n    hpack_header += b'\\r\\n'\n\n    # Write the compressed headers\n    for header, value in headers.items():\n        hpack_header += header.encode('utf-8') + b'\\x00'\n        hpack_header += b' ' + value.encode('utf-8') + b'\\x00'\n\n    # Write the HPACK footer\n    hpack_footer = b'\\r\\n' + b'HTTP/1.1 200 OK\\r\\n'\n    hpack_footer += b'Content-Encoding: hpack\\r\\n'\n    hpack_footer += b'Content-Length: %d\\r\\n' % hpack_size\n    hpack_footer += b'\\r\\n'\n\n    # Write the compressed HPACK header\n    hpack_header_bytes = hpack_header + hpack_footer\n    hpack_buffer += hpack_header_bytes\n\n    return hpack_buffer\n\n# Example usage\nheaders = {\n    'Content-Type': 'text/html; charset=UTF-8',\n    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3'\n}\n\ncompressed_headers = compress_http_headers(headers)\nprint(compressed_headers)\n```"
