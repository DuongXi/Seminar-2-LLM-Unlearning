"```python\nimport logging\nfrom google.cloud import logging\n\n# Set up logging\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\ndef create_logging_client():\n    \"\"\"\n    Creates a Stackdriver Logging API client object to interact with Google Cloud's logging service.\n    \n    Returns:\n        logging.Client: A client object to create, read, update, and delete log entries and logs.\n    \"\"\"\n    # Create a client instance\n    client = logging.Client()\n    \n    # Create a log entry\n    log_entry = client.log_entries().create(\n        body={\n            'name': 'my-log-entry',\n            'log_level': 'INFO',\n            'log_time': '2023-03-16T14:30:00.000Z',\n            'log_message': 'This is a test log message.'\n        }\n    )\n    \n    # Return the log entry\n    return log_entry\n\ndef read_log_entries():\n    \"\"\"\n    Reads log entries from the Stackdriver Logging API.\n    \n    Returns:\n        list: A list of log entries.\n    \"\"\"\n    # Read log entries\n    log_entries = client.log_entries().list()\n    \n    # Return the log entries\n    return log_entries\n\ndef update_log_entry(log_entry_id):\n    \"\"\"\n    Updates a log entry in the Stackdriver Logging API.\n    \n    Args:\n        log_entry_id (str): The ID of the log entry to update.\n    \n    Returns:\n        bool: True if the log entry was updated, False otherwise.\n    \"\"\"\n    # Update a log entry\n    client.log_entries().patch(log_entry_id, body={\n        'log_level': 'DEBUG',\n        'log_time': '2023-03-16T14:30:00.000Z',\n        'log_message': 'This is a debug log message.'\n    })\n    \n    # Return True if the log entry was updated\n    return True\n\ndef delete_log_entry(log_entry_id):\n    \"\"\"\n    Deletes a log entry in the Stackdriver Logging API.\n    \n    Args:\n        log_entry_id (str): The ID of the log entry to delete.\n    \n    Returns:\n        bool: True if the log entry was deleted, False otherwise.\n    \"\"\"\n    # Delete a log entry\n    client.log_entries().delete(log_entry_id)\n    \n    # Return True if the log entry was deleted\n    return True\n\n# Example usage\nif __name__ == '__main__':\n    # Create a log entry\n    log_entry = create_logging_client()\n    logger.info('Creating log entry')\n    \n    # Read log entries\n    log_entries = read_log_entries()\n    logger.info('Reading log entries')\n    \n    # Update a log entry\n    update_log_entry(log_entry.id)\n    logger.info('Updating log entry')\n    \n    # Delete a log entry\n    delete_log_entry(log_entry.id)\n    logger.info('Deleting log entry')\n```"
