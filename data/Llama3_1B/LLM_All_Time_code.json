"```python\nimport jsonpath\nimport json\n\nclass JsonPathParser:\n    def __init__(self, json_string):\n        self.json_string = json_string\n        self.tree = self.parse_json_string()\n\n    def parse_json_string(self):\n        # Parse the JSON string into a nested dictionary\n        data = json.loads(self.json_string)\n        return data\n\n    def evaluate(self, expression):\n        # Evaluate the expression using the abstract syntax tree\n        return self._evaluate_expression(self.tree, expression)\n\n    def _evaluate_expression(self, tree, expression):\n        # Recursively evaluate the expression\n        if isinstance(tree, dict):\n            # If the tree is a dictionary, evaluate the expression at the current key\n            return self._evaluate_expression(tree, expression)\n        elif isinstance(tree, list):\n            # If the tree is a list, recursively evaluate each item\n            return [self._evaluate_expression(item, expression) for item in tree]\n        elif isinstance(tree, (int, float)):\n            # If the tree is a number, return it as is\n            return tree\n        elif isinstance(tree, str):\n            # If the tree is a string, evaluate the expression as a string\n            return self._evaluate_expression(tree, expression)\n        elif isinstance(tree, list):\n            # If the tree is a list, evaluate the expression\n            return self._evaluate_expression(tree, expression)\n        elif isinstance(tree, tuple):\n            # If the tree is a tuple, recursively evaluate each item\n            return [self._evaluate_expression(item, expression) for item in tree]\n        else:\n            # If the tree is not a supported data type, raise an error\n            raise ValueError(f\"Unsupported tree type: {type(tree)}\")\n\n    def _jsonpath(self, expression):\n        # Evaluate the expression using the abstract syntax tree\n        return self.evaluate(self._jsonpath_helper(expression))\n\n    def _jsonpath_helper(self, expression):\n        # Recursively evaluate the expression\n        if isinstance(expression, str):\n            # If the expression is a string, evaluate it as a string\n            return self._evaluate_expression(expression, expression)\n        elif isinstance(expression, dict):\n            # If the expression is a dictionary, evaluate it recursively\n            return {key: self._jsonpath_helper(value) for key, value in expression.items()}\n        elif isinstance(expression, list):\n            # If the expression is a list, recursively evaluate each item\n            return [self._jsonpath_helper(item) for item in expression]\n        else:\n            # If the expression is not a supported data type, raise an error\n            raise ValueError(f\"Unsupported expression type: {type(expression)}\")\n\n# Usage\njson_string = '''\n{\n    \"name\": \"John\",\n    \"age\": 30,\n    \"city\": \"New York\",\n    \"hobbies\": [\"reading\", \"coding\", \"running\"]\n}\n'''\n\nparser = JsonPathParser(json_string)\nprint(parser._jsonpath('$.name'))  # Output: John\nprint(parser._jsonpath('$.age'))   # Output: 30\nprint(parser._jsonpath('$.city'))  # Output: New York\nprint(parser._jsonpath('$.hobbies'))  # Output: ['reading', 'coding', 'running']\nprint(parser._jsonpath('$.age > 25'))  # Output: 30\n```"
