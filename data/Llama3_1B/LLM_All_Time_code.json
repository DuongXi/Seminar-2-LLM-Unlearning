"```python\nfrom twisted.internet import reactor, pubsub\n\nclass Signal:\n    def __init__(self):\n        self.broadcasted_messages = {}\n\n    def send(self, message):\n        \"\"\"Send a message to the broadcast channel\"\"\"\n        self.broadcasted_messages[message] = True\n\n    def broadcast(self, message):\n        \"\"\"Broadcast a message to all subscribers\"\"\"\n        self.broadcasted_messages[message] = True\n\n    def subscribe(self, message, callback):\n        \"\"\"Subscribe to a message\"\"\"\n        self.broadcasted_messages[message] = True\n        self.broadcast(message, callback)\n\nclass Subscriber:\n    def __init__(self, name):\n        self.name = name\n        self.callback = None\n\n    def subscribe(self, message, callback):\n        self.callback = callback\n        self.subscribe(message, callback)\n\ndef main():\n    # Create a new signal\n    signal = Signal()\n\n    # Create subscribers\n    subscriber1 = Subscriber(\"Subscriber 1\")\n    subscriber2 = Subscriber(\"Subscriber 2\")\n\n    # Subscribe to a message\n    def on_message(message):\n        print(f\"{subscriber1.name} received message: {message}\")\n\n    subscriber1.subscribe(\"example\", on_message)\n\n    def on_message2(message):\n        print(f\"{subscriber2.name} received message: {message}\")\n\n    subscriber2.subscribe(\"example\", on_message2)\n\n    # Send a message to the signal\n    signal.send(\"Hello, world!\")\n\n    # Subscribe to a broadcast message\n    def on_broadcast(message):\n        print(f\"{subscriber1.name} received broadcast message: {message}\")\n\n    signal.subscribe(\"example\", on_broadcast)\n\n    # Start the reactor\n    reactor.run()\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\n# Import necessary libraries\nimport pandas as pd\nimport statsmodels.api as sm\n\n# Define a function to create design matrices\ndef create_design_matrices(x, y):\n    \"\"\"\n    Create design matrices for statistical models.\n\n    Parameters:\n    x (list): Independent variable(s)\n    y (list): Dependent variable\n\n    Returns:\n    X (pd.DataFrame): Design matrix\n    X_b (pd.DataFrame): Baseline design matrix\n    X_x (pd.DataFrame): Covariate design matrix\n    X_xb (pd.DataFrame): Covariate baseline design matrix\n    \"\"\"\n    # Create design matrices using pandas DataFrame operations\n    X = pd.DataFrame(x, columns=['x'])\n    X_b = pd.DataFrame(x, columns=['b'])\n    X_x = pd.DataFrame(x, columns=['x^2'])\n    X_xb = pd.DataFrame(x, columns=['x^2*b'])\n\n    return X, X_b, X_x, X_xb\n\n# Define statistical models\ndef add_constant(X, X_b):\n    \"\"\"\n    Add a constant to the design matrices.\n\n    Parameters:\n    X (pd.DataFrame): Design matrix\n    X_b (pd.DataFrame): Baseline design matrix\n\n    Returns:\n    X_b (pd.DataFrame): Updated baseline design matrix with a constant\n    \"\"\"\n    X_b['constant'] = 1\n    return X_b\n\n# Define a simple linear regression model\ndef add_constant_and_intercept(X, X_b):\n    \"\"\"\n    Add a constant and intercept to the design matrices.\n\n    Parameters:\n    X (pd.DataFrame): Design matrix\n    X_b (pd.DataFrame): Baseline design matrix with a constant and intercept\n\n    Returns:\n    X_b (pd.DataFrame): Updated design matrix with a constant and intercept\n    \"\"\"\n    X_b['intercept'] = 1\n    return X_b\n\n# Define a generalized linear model (GLM) with a log link function\ndef add_constant_and_log_link(X, X_b):\n    \"\"\"\n    Add a constant and log link function to the design matrices.\n\n    Parameters:\n    X (pd.DataFrame): Design matrix\n    X_b (pd.DataFrame): Baseline design matrix with a constant and log link function\n\n    Returns:\n    X_b (pd.DataFrame): Updated design matrix with a constant and log link function\n    \"\"\"\n    X_b['log_link'] = sm.loglink(X_b['y'])\n    return X_b\n\n# Example usage\nx = [1, 2, 3, 4, 5]\ny = [2, 3, 5, 7, 11]\n\nX, X_b, X_x, X_xb = create_design_matrices(x, y)\n\nX_b = add_constant(X, X_b)\nX_b = add_constant_and_intercept(X_b, X_b)\nX_b = add_constant_and_log_link(X_b, X_b)\n\nprint(\"Design Matrix X:\")\nprint(X)\nprint(\"\\nDesign Matrix X_b:\")\nprint(X_b)\nprint(\"\\nDesign Matrix X_x:\")\nprint(X_x)\nprint(\"\\nDesign Matrix X_xb:\")\nprint(X_xb)\n```"
