"```python\n# Import the necessary libraries\nfrom googleapiclient.discovery import build\nfrom google_auth_oauthlib.flow import InstalledAppFlow\nfrom google.auth.transport.requests import Request\nimport pickle\nimport os.path\n\n# Set up the client ID and secret from the Google Cloud Console\nSCOPES = ['https://www.googleapis.com/auth/drive',\n         'https://www.googleapis.com/auth/spreadsheets',\n         'https://www.googleapis.com/auth/slides']\n\n# Set up the directory path to store the credentials\nCREDENTIALS_DIR = 'credentials'\n\n# Check if the credentials directory exists, if not create it\nif not os.path.exists(CREDENTIALS_DIR):\n    os.makedirs(CREDENTIALS_DIR)\n\n# Load the credentials from the directory\ncreds = None\nif os.path.exists(os.path.join(CREDENTIALS_DIR, 'token.pickle')):\n    with open(os.path.join(CREDENTIALS_DIR, 'token.pickle'), 'rb') as token:\n        creds = pickle.load(token)\n\n# If there are no credentials, authenticate\nif not creds or not creds.valid:\n    if creds and creds.expired and creds.refresh_token:\n        creds.refresh(Request())\n    else:\n        flow = InstalledAppFlow.from_client_secrets_file(\n            os.path.join(CREDENTIALS_DIR, 'client_secrets.json'),\n            SCOPES)\n        creds = flow.run_local_server(port=0)\n    # Save the credentials for the next run\n    with open(os.path.join(CREDENTIALS_DIR, 'token.pickle'), 'wb') as token:\n        pickle.dump(creds, token)\n\n# Create the service object\nSERVICE = build('drive', 'v3', credentials=creds)\n\n# Create a service object for Google Sheets\nSPREADSHEET_ID = 'your_spreadsheet_id'\nSERVICE_SHEETS = build('sheets', 'v4', credentials=creds)\n\n# Create a service object for Google Slides\nSLIDES_ID = 'your_slides_id'\nSERVICE_SLIDES = build('slides', 'v1', credentials=creds)\n```"
"```python\nimport pyparsing as pp\n\nclass Grammar:\n    def __init__(self):\n        # Define the start symbol\n        self.start = r\"(\\d{1,3})\\.(\\d{1,3})\\.(\\d{1,3})\"\n        \n        # Define the field name\n        self.field_name = r\"[a-zA-Z_][a-zA-Z0-9_]*\"\n        \n        # Define the field values\n        self.field_values = r\"(\\d{1,3})\\.(\\d{1,3})\\.(\\d{1,3})\"\n        \n    def parse_string(self, s):\n        return pp.parseString(s, self.start, self.field_name, self.field_values).asList()\n\n# Create an instance of the Grammar class\ngrammar = Grammar()\n\n# Test the parse_string method\ninput_string = \"1.2.3\"\nmatches = grammar.parse_string(input_string)\nprint(matches)  # Output: [1, 2, 3]\n```"
