"```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass Person:\n    \"\"\"Dataclass representing a person.\"\"\"\n    \n    # Attributes\n    name: str\n    age: int\n    \n    # Constructor\n    def __post_init__(self):\n        \"\"\"Initialize the person's name and age after object creation.\"\"\"\n        if not isinstance(self.name, str) or not isinstance(self.age, int):\n            raise ValueError(\"Name and age must be of type str and int respectively\")\n        \n        self.name = self.name.strip()\n        self.age = self.age\n\n# Example usage:\njohn = Person(\"John\", 30)\nprint(john.name)  # Output: John\nprint(john.age)   # Output: 30\n```"
