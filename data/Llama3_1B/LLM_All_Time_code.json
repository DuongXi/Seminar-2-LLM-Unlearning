"```python\nimport websocket\n\nclass CustomWebSocketClient:\n    def __init__(self, header, callback):\n        \"\"\"\n        Initialize the custom WebSocket client.\n\n        Args:\n            header (dict): Custom header to be sent with the message.\n            callback (function): Callback function to be executed when a message is received.\n        \"\"\"\n        self.ws = websocket.WebSocket()\n        self.ws.on_message = callback\n        self.ws.on_error = self.on_error\n        self.ws.connect(\"wss://example.com/ws\")\n\n    def on_error(self, ws, error):\n        \"\"\"\n        Callback function for error events.\n\n        Args:\n            ws (websocket.WebSocket): The WebSocket object that raised the error.\n            error (Exception): The error that was raised.\n        \"\"\"\n        print(f\"Error: {error}\")\n\n    def receive_message(self):\n        \"\"\"\n        Receive a message from the server and execute the callback function.\n\n        Returns:\n            str: The received message.\n        \"\"\"\n        while True:\n            try:\n                message = self.ws.recv()\n                self.ws.send(header, message)\n                return message\n            except websocket.exceptions.ConnectionClosed:\n                print(\"Connection closed. Stopping the client.\")\n                return None\n```"
"```python\nimport pygments\nimport pygments.lexers\nimport pygments.formatters\n\n# Define custom theme\ntheme = pygments Themes['default'].copy()\ntheme.styles['highlight'] = pygments.styles.default_style\n\n# Define custom formatter\nformatter = pygments.formatters.HtmlFormatter()\n\n# Define function to highlight code\ndef highlight_code(code, language):\n    # Initialize Pygments lexer\n    lexer = pygments.lexers.get_lexer_for_language(language)\n    \n    # Initialize Pygments formatter\n    formatter = pygments.formatters.HtmlFormatter(theme=theme)\n    \n    # Highlight code\n    highlight = pygments.highlight(code, lexer, formatter)\n    \n    return highlight\n\n# Example usage\ncode = \"\"\"\ndef greet(name):\n    print(f\"Hello, {name}!\")\n\ngreet(\"John\")\n\"\"\"\n\n# Highlight code with custom theme and formatter\nhighlighted_code = highlight_code(code, \"python\")\nprint(highlighted_code)\n```"
"```python\nfrom OpenSSL import SSL, ServerOptions\n\nclass SSLConnector:\n    def __init__(self, hostname, port, key_file, cert_file):\n        self.hostname = hostname\n        self.port = port\n        self.key_file = key_file\n        self.cert_file = cert_file\n\n    def create_connection(self):\n        \"\"\"Create an SSL/TLS connection to the specified hostname and port\"\"\"\n        server_options = ServerOptions()\n        server_options.load_cert_chain(self.cert_file, self.key_file, None)\n        server = SSL.create_server(self.hostname, self.port, server_options)\n        return server\n\n    def encrypt_data(self, data):\n        \"\"\"Encrypt the specified data using the SSL/TLS connection\"\"\"\n        encrypted_data = SSL.wrap_socket(data, server=server, certfile=self.cert_file, keyfile=self.key_file, mode=SSL.CERT_REQUIRED)\n        return encrypted_data\n\n    def verify_certificate(self, data):\n        \"\"\"Verify the specified data by checking the certificate\"\"\"\n        verified = False\n        try:\n            # Try to verify the data by checking the certificate\n            # This is a very basic example and not recommended for production use\n            ssl = SSL()\n            ssl.verify(data)\n            verified = True\n        except SSL Certificate verification failed:\n            # If the verification fails, set the flag to False\n            verified = False\n        return verified\n\n# Example usage:\nif __name__ == \"__main__\":\n    hostname = \"example.com\"\n    port = 443\n    key_file = \"server.key\"\n    cert_file = \"server.crt\"\n\n    connector = SSLConnector(hostname, port, key_file, cert_file)\n    server = connector.create_connection()\n    encrypted_data = connector.encrypt_data(b\"Hello, World!\")\n    print(connector.verify_certificate(encrypted_data))\n```"
"```python\nimport asyncio\nfrom typing import Callable\n\nasync def timeout_context_manager(time_limit: float, func: Callable) -> None:\n    \"\"\"\n    Creates a timeout context manager that cancels a task if it doesn't finish within the specified time limit.\n\n    Args:\n        time_limit (float): The maximum time allowed for the task to finish.\n        func (Callable): The function to be executed in an asynchronous task.\n\n    Raises:\n        asyncio.TimeoutError: If the task doesn't finish within the specified time limit.\n    \"\"\"\n    start_time = asyncio.get_event_loop().time()\n    try:\n        # Execute the function and wait for it to finish\n        loop = asyncio.get_event_loop()\n        future = loop.run_until_complete(func())\n        # Cancel the task if it didn't finish within the time limit\n        if loop.time() - start_time > time_limit:\n            raise asyncio.TimeoutError\n        # Return the result of the function\n        return future.result()\n    except asyncio.TimeoutError:\n        # If the task timed out, re-raise the exception\n        raise\n```"
"```python\nimport json\nimport os\n\nclass SwaggerClientRuntime:\n    def __init__(self, base_url, api_key=None):\n        self.base_url = base_url\n        self.api_key = api_key\n\n    def create_client(self, name):\n        client_url = f\"{self.base_url}/v1/{name}\"\n        client_config = {\n            \"type\": \"http\",\n            \"url\": client_url,\n            \"key\": self.api_key,\n            \"headers\": {\n                \"Content-Type\": \"application/json\"\n            }\n        }\n        return self._make_request(client_config)\n\n    def _make_request(self, config):\n        response = requests.request(config[\"type\"], config[\"url\"], config[\"headers\"], params=config[\"params\"], verify=config[\"verify\"], auth=(config[\"username\"], config[\"password\"]))\n        return response.json()\n\ndef main():\n    base_url = \"https://api.example.com\"\n    api_key = \"YOUR_API_KEY_HERE\"\n    client_runtime = SwaggerClientRuntime(base_url, api_key)\n\n    client_name = \"my_client\"\n    client_config = {\n        \"type\": \"http\",\n        \"url\": f\"{base_url}/v1/{client_name}\",\n        \"key\": api_key,\n        \"headers\": {\n            \"Content-Type\": \"application/json\"\n        }\n    }\n\n    client = client_runtime.create_client(client_name)\n    print(client)\n\nif __name__ == \"__main__\":\n    main()\n```"
"import immutablecollections\nimport toolz\n\n# Persistent data structure using immutable collections\npersistent_dict = immutablecollections.persistentdict(\n    default=toolz.defaultdict(toolz.defaultdict),\n    key_func=lambda x: str(x),\n    value_func=lambda x: toolz.defaultdict(toolz.defaultdict)(x)\n)\n\n# Functional data structure using immutable collections\ndef map_func(func, iterable):\n    return toolz.map(toolz.maplift(func), iterable)\n\ndef filter_func(func, iterable):\n    return toolz.filter(toolz.maplift(func), iterable)\n\n# Immutable data structure using toolz\nfrom toolz import isempty\n\nimmutable_list = toolz.immutablelist([1, 2, 3, 4, 5])\nprint(immutable_list)  # Output: [1, 2, 3, 4, 5]\n\nimmutable_set = toolz.immutableset({1, 2, 3, 4, 5})\nprint(immutable_set)  # Output: {1, 2, 3, 4, 5}\n\n# Toolz higher-order functions\ndef repeat(n):\n    return toolz.repeat(n)\n\ndef repeat_if(predicate, n):\n    return toolz.map(repeat, n)(predicate)\n\n# PyDS data structure\nimport pyds\n\n# Example usage\ndata = pyds.DataFrame({\n    'key': ['a', 'b', 'c'],\n    'value': [1, 2, 3]\n})\n\n# Accessing data\nprint(data['key'])  # Output: ['a', 'b', 'c']\n\n# Updating data\ndata['key'] = 'd'\nprint(data)  # Output: {'key': ['d', 'b', 'c'], 'value': [1, 2, 3]}\n\n# Filtering data\nprint(data['key'] == 'b'))  # Output: True\n\n# Grouping data\nfrom pyds import GroupBy\n\ngrouped_data = data.groupby('key')\nfor key, group in grouped_data:\n    print(key, group)  # Output: key a {value: 1}, key b {value: 2}, key c {value: 3}"
"```python\ndef check_vowels(input_string):\n    \"\"\"\n    This function checks if a given string contains any vowels.\n\n    Args:\n        input_string (str): The input string to be checked.\n\n    Returns:\n        str: \"Yes\" if the string contains any vowels, \"No\" otherwise.\n    \"\"\"\n\n    # Define a string of vowels\n    vowels = 'aeiou'\n\n    # Convert the input string to lowercase to make the check case-insensitive\n    input_string = input_string.lower()\n\n    # Use the 'any' function with a generator expression to check if any character in the string is a vowel\n    # The 'in' operator is used to check if a character is in the vowels string\n    has_vowel = any(char in vowels for char in input_string)\n\n    # Return \"Yes\" if the string contains any vowels, \"No\" otherwise\n    return \"Yes\" if has_vowel else \"No\"\n```"
