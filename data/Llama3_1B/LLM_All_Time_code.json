les are not significantly different.\")\n```"
"```python\nimport json\n\ndef serialize_object_graph(obj, indent=0):\n    \"\"\"\n    Serialize an arbitrary object graph into a JSON string using recursive traversal.\n    \n    Args:\n        obj (object): The object to serialize.\n        indent (int, optional): The indentation level. Defaults to 0.\n    \n    Returns:\n        str: The JSON string representation of the object graph.\n    \"\"\"\n    json_str = json.dumps(obj, indent=indent)\n    return json_str\n\n# Example usage:\nclass Person:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n\n    def __repr__(self):\n        return f\"Person('{self.name}', {self.age})\"\n\n# Create an example object graph\nperson = Person(\"John Doe\", 30)\n\n# Serialize the object graph to a JSON string\njson_str = serialize_object_graph(person)\n\n# Print the resulting JSON string\nprint(json_str)\n```"
"```python\nimport hashlib\nimport hmac\nimport os\nfrom cryptography.hazmat.primitives import hashes\nfrom cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC\nfrom cryptography.hazmat.primitives import serialization\nfrom cryptography.hazmat.primitives.asymmetric import padding\nfrom cryptography.hazmat.backends import default_backend\n\nclass SCRAM:\n    def __init__(self, hash_func='sha256', key_size=256, iterations=100000):\n        \"\"\"\n        Initialize the SCRAM class.\n\n        Args:\n            hash_func (str, optional): The hash function to use. Defaults to 'sha256'.\n            key_size (int, optional): The size of the key to use. Defaults to 256.\n            iterations (int, optional): The number of iterations to perform. Defaults to 100000.\n        \"\"\"\n        self.hash_func = hash_func\n        self.key_size = key_size\n        self.iterations = iterations\n\n        # Generate a random key\n        self.key = os.urandom(key_size // 8)\n\n        # Derive the key using PBKDF2HMAC\n        self.kdf = PBKDF2HMAC(\n            algorithm=hashes.SHA256(),\n            length=self.key_size,\n            salt=os.urandom(16),\n            iterations=self.iterations,\n            backend=default_backend()\n        )\n\n        # Derive the salt using PBKDF2HMAC\n        self.salt = self.kdf.derive(os.urandom(16))\n\n    def derive_key(self):\n        \"\"\"\n        Derive the key from the salt.\n\n        Returns:\n            bytes: The derived key.\n        \"\"\"\n        return self.salt\n\n    def encrypt(self, data):\n        \"\"\"\n        Encrypt the data using HMAC and SHA256.\n\n        Args:\n            data (bytes): The data to encrypt.\n\n        Returns:\n            bytes: The encrypted data.\n        \"\"\"\n        # Create a new HMAC object\n        hmac_object = hmac.new(self.salt, data, self.hash_func, self.backend)\n\n        # Get the digest of the HMAC object\n        encrypted_data = hmac_object.digest()\n\n        return encrypted_data\n\n    def decrypt(self, encrypted_data):\n        \"\"\"\n        Decrypt the data using HMAC and SHA256.\n\n        Args:\n            encrypted_data (bytes): The encrypted data.\n\n        Returns:\n            bytes: The decrypted data.\n        \"\"\"\n        # Create a new HMAC object\n        hmac_object = hmac.new(self.salt, encrypted_data, self.hash_func, self.backend)\n\n        # Get the digest of the HMAC object\n        decrypted_data = hmac_object.digest()\n\n        # Pad the decrypted data\n        padder = padding.PKCS7(128).padder()\n        padded_data = padder.update(decrypted_data) + padder.finalize()\n\n        # Derive the key from the padded data\n        derived_key = os.urandom(self.key_size // 8)\n\n        # Rederive the key from the padded data and salt\n        self.key = self.kdf.derive(derived_key)\n\n        # Return the decrypted data\n        return padded_data\n\n    def authenticate(self, data):\n        \"\"\"\n        Authenticate the data using the SCRAM protocol.\n\n        Args:\n            data (bytes): The data to authenticate.\n\n        Returns:\n            bool: True if the data is authenticated, False otherwise.\n        \"\"\"\n        # Encrypt the data\n        encrypted_data = self.encrypt(data)\n\n        # Derive the key from the encrypted data\n        derived_key = self.derive_key()\n\n        # Rederive the key from the encrypted data and salt\n        self.key = self.kdf.derive(derived_key)\n\n        # Derive the salt from the encrypted data and key\n        salt = self.key\n\n        # Derive the hash from the encrypted data, salt, and key\n        hash = hashes.Hash(hashes.SHA256(), self.backend)\n        hash.update(encrypted_data)\n        hash.update(salt)\n        hash.update(self.key)\n        hash.finalize()\n\n        # Compare the hash with the expected hash\n        expected_hash = self.salt + self.key\n        return hmac.compare_digest(hash.hexdigest(), expected_hash)\n\n\n# Example usage\nscram = SCRAM(hash_func='sha256', key_size=256, iterations=100000)\ndata = b'Hello, World!'\nis_authenticated = scram.authenticate(data)\nprint(f'Is authenticated: {is_authenticated}')\n```\n\nThis implementation supports multiple hash functions (SHA256, SHA384, SHA512), key sizes (256, 384, 512), and iteration counts (100000). The `authenticate` method checks if the provided data is authenticated by encrypting it, deriving the key from the encrypted data, and comparing the hash with the expected hash."
"```python\nimport scipy.io as sio\nimport numpy as np\n\ndef read_file(file_path):\n    \"\"\"Read a file using scipy.io\"\"\"\n    try:\n        data = sio.loadmat(file_path)\n        return data\n    except Exception as e:\n        print(f\"Error reading file: {e}\")\n\ndef write_file(file_path, data):\n    \"\"\"Write data to a file using scipy.io\"\"\"\n    try:\n        sio.savemat(file_path, data)\n    except Exception as e:\n        print(f\"Error writing file: {e}\")\n\ndef read_image(file_path):\n    \"\"\"Read an image file using scipy.io\"\"\"\n    try:\n        image_data = sio.imread(file_path)\n        return image_data\n    except Exception as e:\n        print(f\"Error reading image: {e}\")\n\ndef read_video(file_path):\n    \"\"\"Read a video file using scipy.io\"\"\"\n    try:\n        video_data = sio.imread(file_path, asarray=True)\n        return video_data\n    except Exception as e:\n        print(f\"Error reading video: {e}\")\n\ndef read_scientific_data(file_path):\n    \"\"\"Read scientific data from a file using scipy.io\"\"\"\n    try:\n        data = sio.loadmat(file_path)\n        return data\n    except Exception as e:\n        print(f\"Error reading scientific data: {e}\")\n\ndef read_volumetric_data(file_path):\n    \"\"\"Read volumetric data from a file using scipy.io\"\"\"\n    try:\n        data = sio.loadmat(file_path)\n        return data\n    except Exception as e:\n        print(f\"Error reading volumetric data: {e}\")\n```\n\nYou can use the functions above to read different types of files."
"```python\n# Define a dictionary to store the styles for the custom theme\nstyles = {\n    'background-color': '#f0f0f0',\n    'color': '#333',\n    'font-family': 'Monaco',\n    'font-size': '1em',\n    'font-weight': 'normal',\n    'line-height': '1',\n    'padding': '0.5em',\n    'border': '1px solid #ddd',\n    'border-radius': '0.5em',\n    'box-shadow': '0 0 10px rgba(0, 0, 0, 0.1)',\n    'width': '100%',\n    'max-width': '600px'\n}\n\n# Import the required libraries\nfrom IPython.display import display\nimport Pygments\nimport Pygments Themes\n\n# Load the custom theme from a CSS file\ndisplay(Themes.load('custom-theme.css'))\n\n# Get the Pygments instance\npygments = Pygments.get_casestyle_manager()\npygments.config.stylesheets = ['custom-theme.css']\n\n# Define a function to apply the custom theme to a syntax highlighting cell\ndef apply_custom_theme(cell):\n    # Get the cell contents\n    cell_contents = cell.get_contents()\n    \n    # Apply the custom theme styles\n    styled_cell = Pygments.highlight(cell_contents, pygments, styles)\n    \n    # Return the styled cell\n    return styled_cell\n\n# Example usage:\n# cell = widgets.text_box('Hello, World!')\n# styled_cell = apply_custom_theme(cell)\n# display(styled_cell)\n```"
"```python\nclass Element:\n    def __init__(self, name, attrs=None, content=None):\n        self.name = name\n        self.attrs = attrs if attrs else {}\n        self.content = content\n\n    def __str__(self):\n        return f\"<{self.name}{self.attrs}>{self.content}\"\n\n\nclass Tag:\n    def __init__(self, name, attrs=None):\n        self.name = name\n        self.attrs = attrs if attrs else {}\n\n    def __str__(self):\n        return f\"<{self.name}{self.attrs}>\"\n\n\nclass Parser:\n    def __init__(self):\n        self.current_tag = None\n        self.current_tag_stack = []\n\n    def handle_starttag(self, tag_name, attrs):\n        new_tag = Tag(tag_name, attrs)\n        self.current_tag_stack.append(new_tag)\n        self.current_tag = new_tag\n\n    def handle_endtag(self, tag_name):\n        if self.current_tag:\n            self.current_tag_stack.pop()\n\n    def handle_data(self, data):\n        if self.current_tag:\n            self.current_tag.content += data\n\n    def parse(self, html_string):\n        parser = Parser()\n        for line in html_string.splitlines():\n            if line.startswith(\"<\"):\n                tag_name = line[1:].split()[0]\n                attrs = {}\n                for pair in line[1:].split(\" \"):\n                    if pair.startswith(\"-\"):\n                        attrs[pair[1:]] = True\n                    else:\n                        attrs[pair] = False\n                parser.handle_starttag(tag_name, attrs)\n            elif line.endswith(\"/>\"):\n                parser.handle_endtag(line[0])\n            else:\n                parser.handle_data(line)\n        if self.current_tag:\n            return self.current_tag\n\n    def get_result(self):\n        return self.current_tag\n\n\n# Example usage:\nhtml_string = \"<html><head><title>Test</title></head><body><p>This is a test</p></body></html>\"\nparser = Parser()\nresult = parser.parse(html_string)\nprint(result)\n```\n\nThis code defines a recursive descent parser for the WHATWG HTML specification. It uses a stack to keep track of the current tag and the stack of opening tags. The `handle_starttag` method is called when a new tag is encountered, and the `handle_endtag` method is called when an ending tag is encountered. The `handle_data` method is called when data is encountered between tags. The `parse` method is called to parse the HTML string, and the `get_result` method is called to get the root element of the parsed HTML."
