"```python\nimport pdb\n\ndef debug_code():\n    # Create a pdb object with interactive mode enabled\n    pdb.set_trace()\n\n    # Set a breakpoint at the beginning of the function\n    pdb.set_trace(\"beginning of function\")\n\n    # Step through the code line by line\n    while True:\n        # Get the current line number\n        line_number = pdb.currentframe().f_back.f_lineno + 1\n\n        # Print the current line number\n        print(f\"Line {line_number}: {pdb.currentframe().f_back.f_code.co_name}\")\n\n        # Get the current variable value\n        variable_name = pdb.currentframe().f_back.f_back.f_locals.get('variable_name')\n\n        # Print the variable value\n        print(f\"Variable: {variable_name}\")\n\n        # Ask the user if they want to continue debugging\n        response = input(\"Do you want to continue debugging? (y/n): \")\n\n        # If the user wants to continue, continue debugging\n        if response.lower() == 'y':\n            continue\n        # If the user wants to quit, break out of the loop\n        elif response.lower() == 'n':\n            break\n        # If the user enters anything else, raise an error\n        else:\n            pdb.post_mortem()\n\ndebug_code()\n```"
