"```python\nimport psutil\nimport time\n\ndef check_and_start_app():\n    # Get the list of all running processes\n    running_processes = [p.info['name'] for p in psutil.process_iter(['pid', 'name'])]\n\n    # Check if Mozilla Firefox is running\n    if 'firefox' not in running_processes:\n        # If not, start it\n        print(\"Starting Mozilla Firefox...\")\n        p = psutil.Process()\n        p.start()\n        time.sleep(1)\n        print(\"Mozilla Firefox started successfully.\")\n\n    else:\n        # If it is already running, stop it and then start it again\n        print(\"Mozilla Firefox is already running. Stopping and starting...\")\n        p = psutil.Process()\n        p.stop()\n        p.start()\n        time.sleep(1)\n        print(\"Mozilla Firefox started successfully.\")\n\ncheck_and_start_app()\n```"
