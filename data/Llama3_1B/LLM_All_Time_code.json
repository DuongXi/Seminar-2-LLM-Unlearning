"```python\nimport discord\nfrom discord.ext import commands\n\n# Create a new bot instance\nintents = discord.Intents.default()\nintents.typing = False\nintents.presences = False\nbot = commands.Bot(command_prefix='!', intents=intents)\n\n# Token from the Discord Developer Portal\nTOKEN = 'YOUR_DISCORD_BOT_TOKEN_HERE'\n\n# Event to indicate that the bot has been ready\n@bot.event\nasync def on_ready():\n    \"\"\"Print a message to the console when the bot is ready\"\"\"\n    print(f'{bot.user.name} has connected to Discord!')\n\n# Command to create a new server\n@bot.command(name='server', help='Create a new server')\nasync def server(ctx, name: str):\n    \"\"\"Create a new server with the given name\"\"\"\n    await ctx.send(f'Server created with name: {name}')\n\n# Command to create a new channel\n@bot.command(name='channel', help='Create a new channel')\nasync def channel(ctx, name: str):\n    \"\"\"Create a new channel with the given name\"\"\"\n    await ctx.send(f'Channel created with name: {name}')\n\n# Command to send a message in a channel\n@bot.command(name='message', help='Send a message in a channel')\nasync def message(ctx, *, message: str):\n    \"\"\"Send a message in a channel\"\"\"\n    await ctx.send(message)\n\n# Command to delete a channel\n@bot.command(name='delete-channel', help='Delete a channel')\nasync def delete_channel(ctx, *, channel_name: str):\n    \"\"\"Delete a channel with the given name\"\"\"\n    try:\n        await ctx.channel.delete(name=channel_name)\n        await ctx.send(f'Channel {channel_name} deleted')\n    except discord.Forbidden:\n        await ctx.send(f'You do not have permission to delete channel {channel_name}')\n\n# Command to delete a server\n@bot.command(name='server-delete', help='Delete a server')\nasync def server_delete(ctx, *, server_name: str):\n    \"\"\"Delete a server with the given name\"\"\"\n    try:\n        await ctx.guild.delete(name=server_name)\n        await ctx.send(f'Server {server_name} deleted')\n    except discord.Forbidden:\n        await ctx.send(f'You do not have permission to delete server {server_name}')\n\n# Run the bot\nbot.run(TOKEN)\n```"
