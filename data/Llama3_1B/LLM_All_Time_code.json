"```python\nimport fiona\n\ndef read_write_spatial_data(file_path, file_type):\n    \"\"\"\n    Reads and writes spatial data files using Fiona library.\n\n    Args:\n        file_path (str): Path to the spatial data file.\n        file_type (str): Type of the spatial data file (e.g., GeoJSON, Shapefile, GPKG).\n\n    Returns:\n        None\n    \"\"\"\n\n    # Check if the file type is supported\n    supported_file_types = ['geojson', 'shaperef', 'gpkg']\n    if file_type not in supported_file_types:\n        print(\"Unsupported file type. Supported types are:\", supported_file_types)\n        return\n\n    # Try to read the file\n    try:\n        with fiona.open(file_path) as dataset:\n            # Iterate over the features in the dataset\n            for feature in dataset:\n                # Check if the feature is a GeoJSON feature\n                if isinstance(feature, dict) and 'type' in feature and 'geometry' in feature:\n                    print(f\"Reading GeoJSON feature: {feature['type']} {feature['geometry']}\")\n                # Check if the feature is a Shapefile feature\n                elif isinstance(feature, dict) and 'type' in feature and 'geometry' in feature and 'crs' in feature:\n                    print(f\"Reading Shapefile feature: {feature['type']} {feature['geometry']} with CRS {feature['crs']}\")\n                # Check if the feature is a GPKG feature\n                elif isinstance(feature, dict) and 'type' in feature and 'geometry' in feature:\n                    print(f\"Reading GPKG feature: {feature['type']} {feature['geometry']}\")\n\n    # Try to write the file\n    except Exception as e:\n        print(f\"Error writing file: {e}\")\n\n# Example usage\nread_write_spatial_data('path_to_your_file.geojson', 'geojson')\nread_write_spatial_data('path_to_your_shapefile.shp', 'shapefile')\nread_write_spatial_data('path_to_your_gpkg.gpkg', 'gpkg')\n```"
