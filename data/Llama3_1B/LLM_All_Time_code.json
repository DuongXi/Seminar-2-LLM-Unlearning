"import urllib.parse\n\ndef extract_tld(url):\n    parsed_url = urllib.parse.urlparse(url)\n    tld = parsed_url.netloc.split(\".\")[0]\n    return tld\n\n# Example usage:\nurl = \"https://www.example.com\"\ntld = extract_tld(url)\nprint(f\"The TLD of {url} is {tld}\")"
"```python\nimport click\nfrom click.utils import get_argument_value\nfrom click.command import Command\nfrom click.option import option, arg\nimport json\nimport geopandas as gpd\nfrom shapely.geometry import Point\nfrom shapely.wkt import parse\nfrom pygeopandas import GeoPandas\nfrom pyshapely.geometry import Polygon\n\n@click.command()\n@click.option('--input-gjson', help='Input GeoJSON file')\n@click.option('--output-gjson', help='Output GeoJSON file')\n@click.option('--input-wkt', help='Input WKT file')\n@click.option('--output-wkt', help='Output WKT file')\n@click.option('--input-shp', help='Input shapefile')\n@click.option('--output-shp', help='Output shapefile')\ndef convert_gjson(input_gjson, output_gjson, input_wkt, output_wkt, input_shp, output_shp):\n    \"\"\"\n    Convert GeoJSON and WKT data to GeoPandas format.\n\n    Args:\n        input_gjson (str): Input GeoJSON file\n        output_gjson (str): Output GeoJSON file\n        input_wkt (str): Input WKT file\n        output_wkt (str): Output WKT file\n        input_shp (str): Input shapefile\n        output_shp (str): Output shapefile\n    \"\"\"\n\n    # Parse input GeoJSON file\n    gdf = gpd.read_file(input_gjson)\n\n    # Parse input WKT file\n    wkt_gdf = gpd.read_file(input_wkt)\n\n    # Convert WKT geometry to GeoPandas Polygon\n    wkt_polygons = []\n    for polygon in wkt_gdf.geometry:\n        if isinstance(polygon, Point):\n            wkt_polygons.append((polygon.x, polygon.y))\n        else:\n            wkt_polygons.append(polygon)\n\n    # Convert GeoPandas Polygon to GeoJSON\n    geojson_gdf = gpd.GeoDataFrame(\n        geometry=wkt_polygons,\n        geometry_type='Polygon'\n    )\n\n    # Write GeoJSON output\n    with open(output_gjson, 'w') as f:\n        json.dump(geojson_gdf.to_crs('EPSG:3857').to_json(), f, indent=4)\n\n    # Write WKT output\n    with open(output_wkt, 'w') as f:\n        f.write(wkt_gdf.to_wkt())\n\n    # Write shapefile output\n    with open(output_shp, 'w') as f:\n        gpd.to_file(gdf, f, driver='ESRI Shapefile')\n\n# Define the command\nconvert_gjson.command = Command()\n\n# Register the command\n@click.command()\ndef main():\n    convert_gjson()\n    return\n\n# Run the command\nif __name__ == '__main__':\n    main()\n```"
