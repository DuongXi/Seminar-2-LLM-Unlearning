"```python\nimport http.client\nimport socket\nimport threading\n\nclass PureHttp:\n    def __init__(self):\n        self.request_handler = None\n        self.response_handler = None\n\n    def send_request(self, method, url, headers=None, data=None):\n        if self.request_handler is None:\n            raise ValueError(\"Request handler must be set before sending a request\")\n\n        if self.response_handler is None:\n            raise ValueError(\"Response handler must be set before sending a response\")\n\n        # Create a socket object\n        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:\n            # Connect to the server\n            s.connect((url, 80))\n\n            # Set the request method\n            if method.upper() == 'GET':\n                s.sendall(b'GET /'.encode())\n            elif method.upper() == 'POST':\n                s.sendall(b'POST /'.encode())\n            else:\n                raise ValueError(\"Unsupported request method\")\n\n            # Send the request data\n            if data:\n                s.sendall(data.encode())\n\n            # Receive the response\n            response = s.recv(4096).decode()\n            s.close()\n\n            # Set the response handler\n            self.response_handler = response\n\n    def receive_response(self):\n        return self.response_handler\n\nclass PureHttpServer(PureHttp):\n    def __init__(self, host='127.0.0.1', port=8080):\n        super().__init__()\n        self.host = host\n        self.port = port\n\n    def handle_request(self, method, url, headers=None, data=None):\n        self.send_request(method, url, headers, data)\n\n    def run(self):\n        server = http.client.HTTPServer((self.host, self.port), PureHttp())\n        server.serve_forever()\n\n# Example usage:\nserver = PureHttpServer()\nserver.handle_request('GET', 'http://example.com')\nprint(server.receive_response())\n```"
