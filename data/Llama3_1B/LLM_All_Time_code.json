"```python\nimport sys\nimport inspect\n\nnode = ast.parse(sys.stdin.read())\nframe = inspect.getframe(1)\n\ndef get_ast_info(node):\n    \"\"\"Returns information about the current AST node\"\"\"\n    return {\n        \"node\": node,\n        \"filename\": frame.f_code.co_filename,\n        \"lineno\": frame.f_lineno,\n        \"col_offset\": frame.f_code.co_first_line - frame.f_code.co_first_char,\n        \"col_width\": frame.f_code.co_first_width,\n        \"filename\": frame.f_code.co_filename,\n        \"lineno\": frame.f_lineno,\n        \"col_offset\": frame.f_code.co_first_line - frame.f_code.co_first_char,\n        \"col_width\": frame.f_code.co_first_width,\n    }\n\nast_info = get_ast_info(node)\n\nprint(\"Current AST Node Information:\")\nprint(\"-----------------------------\")\nfor key, value in ast_info.items():\n    print(f\"{key}: {value}\")\n```"
