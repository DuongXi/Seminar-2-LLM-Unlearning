"```python\nimport ast\n\ndef parse_sql_query(sql_query):\n    \"\"\"\n    Parse a SQL query and return its abstract syntax tree.\n\n    Args:\n    sql_query (str): The SQL query to parse.\n\n    Returns:\n    ast.AST: The abstract syntax tree of the parsed SQL query.\n    \"\"\"\n    try:\n        # Use the ast.parse function to parse the SQL query\n        tree = ast.parse(sql_query)\n        return tree\n    except SyntaxError as e:\n        # If a syntax error is raised, print the error message and return None\n        print(f\"Syntax error: {e}\")\n        return None\n\n# Example usage:\nsql_query = \"SELECT * FROM users WHERE name = 'John Doe'\"\ntree = parse_sql_query(sql_query)\n\nif tree is not None:\n    # You can now use the tree to analyze or modify the SQL query\n    print(ast.dump(tree))\n```"
