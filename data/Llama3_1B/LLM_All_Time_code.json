"```python\nfrom PIL import Image\nimport os\n\nclass ImageProcessor:\n    def __init__(self, input_file, output_file):\n        self.input_file = input_file\n        self.output_file = output_file\n\n    def open_image(self):\n        \"\"\"Open the input image file using Pillow.\"\"\"\n        try:\n            with Image.open(self.input_file) as img:\n                return img\n        except FileNotFoundError:\n            print(f\"Error: Input file '{self.input_file}' not found.\")\n            return None\n        except Exception as e:\n            print(f\"Error: Unable to open image '{self.input_file}': {e}\")\n            return None\n\n    def manipulate_image(self):\n        \"\"\"Manipulate the image by resizing and cropping it.\"\"\"\n        img = self.open_image()\n        if img:\n            # Resize the image\n            width, height = 800, 600\n            img = img.resize((width, height))\n            # Crop the image\n            img = img.crop((100, 100, 300, 300))\n            return img\n        else:\n            return None\n\n    def save_image(self):\n        \"\"\"Save the manipulated image to the output file.\"\"\"\n        img = self.manipulate_image()\n        if img:\n            # Save the image as BMP\n            img.save(self.output_file, 'BMP')\n            # Save the image as PNG\n            img.save(self.output_file, 'PNG')\n            # Save the image as JPEG\n            img.save(self.output_file, 'JPEG')\n            # Save the image as GIF\n            img.save(self.output_file, 'GIF')\n            # Save the image as TIFF\n            img.save(self.output_file, 'TIFF')\n        else:\n            return None\n\n# Usage example\ninput_file = 'input.bmp'\noutput_file = 'output.bmp'\nprocessor = ImageProcessor(input_file, output_file)\nprocessor.open_image()\nimg = processor.manipulate_image()\nprocessor.save_image()\n```\n\nThis code defines an `ImageProcessor` class that provides methods to open, manipulate, and save various image file formats using the Pillow library. The `open_image` method opens the input image file, the `manipulate_image` method resizes and crops the image, and the `save_image` method saves the manipulated image to the output file. The code also includes error handling and usage example."
"```python\nfrom datetime import datetime\n\ndef parse_iso_date(date_str):\n    \"\"\"\n    Parse an ISO 8601 date string into a datetime object.\n    \n    Args:\n        date_str (str): The ISO 8601 date string to parse.\n    \n    Returns:\n        datetime: The parsed datetime object.\n    \"\"\"\n    return datetime.fromisoformat(date_str)\n\ndef format_iso_time(time_obj):\n    \"\"\"\n    Format a datetime object into an ISO 8601 time string.\n    \n    Args:\n        time_obj (datetime): The datetime object to format.\n    \n    Returns:\n        str: The formatted ISO 8601 time string.\n    \"\"\"\n    return time_obj.strftime('%Y-%m-%dT%H:%M:%S')\n\ndef format_iso_duration(duration):\n    \"\"\"\n    Format a duration object into an ISO 8601 duration string.\n    \n    Args:\n        duration (int or float): The duration to format.\n    \n    Returns:\n        str: The formatted ISO 8601 duration string.\n    \"\"\"\n    hours, remainder = divmod(duration, 3600)\n    minutes, seconds = divmod(remainder, 60)\n    return f'{hours}h {minutes}m {seconds}s'\n\ndef main():\n    # Test the functions\n    date_str = '2022-09-01T00:00:00'\n    time_obj = datetime.strptime(date_str, '%Y-%m-%dT%H:%M:%S')\n    duration = 24 * 60 * 60  # 1 day in seconds\n    print(parse_iso_date(date_str))\n    print(format_iso_time(time_obj))\n    print(format_iso_duration(duration))\n\nif __name__ == '__main__':\n    main()\n```"
