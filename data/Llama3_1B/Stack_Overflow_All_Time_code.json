"To resolve the OutOfMemoryError when loading images from the SD card to the Bitmap object, you can use the following approach:\n\n```python\nimport android.app.Activity;\nimport android.content.Context;\nimport android.graphics.Bitmap;\nimport android.graphics.BitmapFactory;\nimport android.graphics.Matrix;\nimport android.os.Bundle;\nimport android.view.View;\nimport android.widget.Button;\nimport android.widget.ListView;\nimport android.widget.SimpleCursorAdapter;\nimport android.widget.Toast;\n\npublic class MainActivity extends Activity {\n    private ListView listView;\n    private Button button;\n    private Button[] buttons;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        super.onCreate(savedInstanceState);\n        setContentView(R.layout.activity_main);\n\n        listView = (ListView) findViewById(R.id.list_view);\n        button = (Button) findViewById(R.id.button);\n        buttons = new Button[2];\n\n        button.setOnClickListener(new View.OnClickListener() {\n            @Override\n            public void onClick(View v) {\n                Button clickedButton = (Button) v;\n                // Launch a new activity to display the map\n                Intent intent = new Intent(MainActivity.this, MapActivity.class);\n                startActivity(intent);\n            }\n        });\n\n        // Create a SimpleCursorAdapter to display the data\n        String[] from = new String[] { DBHelper.KEY_BUSINESSNAME, DBHelper.KEY_ADDRESS,\n                DBHelper.KEY_CITY, DBHelper.KEY_GPSLONG, DBHelper.KEY_GPSLAT,\n                DBHelper.KEY_IMAGEFILENAME  + \"&\" + DBHelper.KEY_IMAGEFILENAME};\n        int[] to = new int[] { R.id.businessname, R.id.address, R.id.city, R.id.gpslong,\n                R.id.gpslat, R.id.imagefilename };\n        notes = new SimpleCursorAdapter(this, R.layout.notes_row, c, from, to);\n        listView.setAdapter(notes);\n\n        // Add a new button to resize the image\n        Button resizeButton = (Button) findViewById(R.id.resize_button);\n        resizeButton.setOnClickListener(new View.OnClickListener() {\n            @Override\n            public void onClick(View v) {\n                // Get the current bitmap\n                Bitmap bitmap = (Bitmap) listView.getAdapter().getBackground();\n\n                // Get the image URI\n                String uri = bitmap.getUri();\n\n                // Use a library like Skia to resize the image\n                // Here, we assume you have a library like Skia installed\n                Bitmap resizedBitmap = BitmapFactory.decodeFile(uri);\n                Matrix matrix = new Matrix();\n                matrix.postScale(0.5f, 0.5f); // Resize the image\n                Bitmap resizedBitmap2 = BitmapFactory.decodeFile(uri, matrix);\n                // Update the bitmap\n                bitmap = resizedBitmap2;\n\n                // Update the image in the list view\n                listView.setAdapter(notes);\n            }\n        });\n    }\n}\n```\n\nTo resize the image on the fly, you can use a library like Skia. Here's a simplified example of how you can do it:\n\n```java\nimport android.app.Activity;\nimport android.content.Context;\nimport android.graphics.Bitmap;\nimport android.graphics.Matrix;\nimport android.graphics.RectF;\nimport android.util.Log;\n\npublic class MainActivity extends Activity {\n    private Button[] buttons;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        super.onCreate(savedInstanceState);\n        setContentView(R.layout.activity_main);\n\n        buttons = new Button[2];\n\n        // ...\n\n        // Add a new button to resize the image\n        Button resizeButton = (Button) findViewById(R.id.resize_button);\n        resizeButton.setOnClickListener(new View.OnClickListener() {\n            @Override\n            public void onClick(View v) {\n                // Get the current bitmap\n                Bitmap bitmap = (Bitmap) listView.getAdapter().getBackground();\n\n                // Get the image URI\n                String uri = bitmap.getUri();\n\n                // Use a library like Skia to resize the image\n                // Here, we assume you have a library like Skia installed\n                Bitmap resizedBitmap = BitmapFactory.decodeFile(uri);\n\n                // Calculate the new size\n                RectF rect = new RectF();\n                resizedBitmap.getRectF(rect);\n\n                // Resize the image\n                Matrix matrix = new Matrix();\n                matrix.postScale(0.5f, 0.5f);\n                Bitmap resizedBitmap2 = BitmapFactory.decodeFile(uri, matrix);\n\n                // Update the bitmap\n                bitmap = resizedBitmap2;\n\n                // Update the image in the list view\n                listView.setAdapter(notes);\n            }\n        });\n    }\n}\n```\n\nNote that this is a simplified example and you may need to modify it to fit your specific needs."
