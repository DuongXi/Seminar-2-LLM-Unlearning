"```python\ndef timezone_string(seconds):\n    if seconds == 0:\n        return \"Z\"\n    elif seconds > 0:\n        hours = seconds // 3600\n        minutes = (seconds % 3600) // 60\n        return f\"{hours:02d}:{minutes:02d}\"\n    else:\n        return \"Unknown parameter\"\n\nprint(timezone_string(0))  # Outputs: Z\nprint(timezone_string(123))  # Outputs: 02:30\nprint(timezone_string(456))  # Outputs: Unknown parameter\n```"
