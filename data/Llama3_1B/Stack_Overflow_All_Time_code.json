"def flatten_list(nested_list):\n    flat_list = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flat_list.extend(flatten_list(item))\n        else:\n            flat_list.append(item)\n    return flat_list\n\nnested_list = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7],\n    [8, 9]\n]\n\nprint(flatten_list(nested_list))  # Output: [1, 2, 3, 4, 5, 6, 7, 8, 9]"
"```python\ndef add(self, value):\n    \"\"\"\n    A method decorated with @staticmethod, which adds a value to the instance's data.\n\n    Args:\n        value (int): The value to be added.\n\n    Returns:\n        int: The sum of the value and the instance's data.\n    \"\"\"\n    return self.data + value\n\ndef increment(self, value):\n    \"\"\"\n    A method decorated with @classmethod, which increments the instance's data by a value.\n\n    Args:\n        value (int): The value to be added to the instance's data.\n\n    Returns:\n        None\n    \"\"\"\n    self.data = self.data + value\n\n# Create an instance of the class\ninstance = MyClass()\n\n# Add an instance variable\ninstance.data = 0\n\n# Increment the instance variable using a static method\nadd_value = add\nadd_value(5)\nprint(instance.data)  # Output: 5\n\n# Increment the instance variable using a class method\nincrement_value = increment\nincrement_value(5)\nprint(instance.data)  # Output: 10\n```"
"```python\ndef generate_slice_code():\n    # Define a sample list\n    xs = ['a', 'b', 'c', 'd', 'e']\n\n    # Explanation of slice notation\n    # The slice notation consists of three parts:\n    # 1. Start index (x): the index from which to start extracting elements\n    # 2. Stop index (y): the index up to which to extract elements\n    # 3. Step size (z): the increment between consecutive elements\n    # The slice notation is inclusive, meaning the last element included in the slice is included in the output.\n    # For example, a[x:y:z] means start at index x, end at index y (exclusive), and step by z.\n    print(\"Example 1: a[x:y:z]\")\n\n    # Explanation of upper-bound exclusive\n    # In Python, slice notation is exclusive of the upper bound. This means that the end index is exclusive, and the slice will not include the last element.\n    # For example, a[:] means start at the beginning, end at the end (exclusive), and step by 1.\n    print(\"Example 2: a[:]\")\n\n    # Explanation of range upper-bound exclusive\n    # In Python, the range function is exclusive of the upper bound. This means that the end index is exclusive, and the slice will not include the last element.\n    # For example, a[::2] means start at the beginning, end at the second last (exclusive), and step by 2.\n    print(\"Example 3: a[::2]\")\n\n    # Explanation of assignment with list slices\n    # When assigning a new value to a slice, the new value is assigned to all elements in the slice.\n    # For example, xs[0:2] = [a, b] means assign the values 'a' and 'b' to all elements in the slice from index 0 to 1 (exclusive).\n    print(\"Example 4: xs[0:2] = [a, b]\")\n```"
