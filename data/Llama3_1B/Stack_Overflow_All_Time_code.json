"import datetime\n\ndef format_date(date_str):\n    try:\n        return datetime.datetime.strptime(date_str, \"%Y-%m-%d\").strftime(\"%Y-%m-%d\")\n    except ValueError:\n        try:\n            return datetime.datetime.strptime(date_str, \"%d %B %Y %H:%M:%S\").strftime(\"%d %B %Y\")\n        except ValueError:\n            try:\n                return datetime.datetime.strptime(date_str, \"%d %b %Y %H:%M:%S\").strftime(\"%d %B %Y\")\n            except ValueError:\n                return date_str\n\nprint(format_date(\"25 Dec, 1995 23:15:00\"))  \nprint(format_date(\"2009 06 12,12:52:39\"))\nprint(format_date(\"20 09 2006,12:52:39\"))"
