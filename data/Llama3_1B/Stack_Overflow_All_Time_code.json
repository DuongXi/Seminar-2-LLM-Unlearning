"```python\nimport cv2\nimport numpy as np\n\ndef detect_text(image_path):\n    # Load the image\n    image = cv2.imread(image_path)\n\n    # Convert the image to grayscale\n    grayF = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n\n    # Calculate the local variances of the grayscale image\n    t_mean, t_mean_2 = cv2.mean(grayF, axis=(0, 1))\n    t_mean_2 -= t_mean\n\n    # Blur the image to reduce noise\n    blur = cv2.GaussianBlur(grayF, (35, 35), 0)\n\n    # Threshold the high variance regions\n    varMat = cv2.threshold(blur, 100, 255, cv2.THRESH_BINARY)[1]\n    varMatRegions = varMat > 50\n\n    # Find the contours of text\n    contours, _ = cv2.findContours(varMatRegions, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n\n    # Initialize the text bounding boxes\n    text_bboxes = []\n\n    # Iterate over the contours and find the text bounding boxes\n    for contour in contours:\n        # Calculate the bounding box of the contour\n        x, y, w, h = cv2.boundingRect(contour)\n\n        # Convert the bounding box coordinates to text coordinates\n        text_x = int(x + w / 2)\n        text_y = int(y + h / 2)\n\n        # Add the text bounding box to the list\n        text_bboxes.append((text_x, text_y, w, h))\n\n    return text_bboxes\n\n# Test the function\nimage_path = \"path_to_your_image.jpg\"\ntext_bboxes = detect_text(image_path)\nfor i, (x, y, w, h) in enumerate(text_bboxes):\n    print(f\"Bounding box {i+1}: ({x}, {y}), ({x+w}, {y+h})\")\n```"
