"```python\nimport os\n\ndef copy_file(source, destination):\n    \"\"\"\n    Copies a file from the source to the destination.\n\n    Args:\n        source (str): The path to the source file.\n        destination (str): The path to the destination file.\n\n    Returns:\n        None\n    \"\"\"\n    try:\n        # Check if the source and destination exist\n        if not os.path.exists(source):\n            raise FileNotFoundError(f\"The source file '{source}' does not exist.\")\n        if not os.path.exists(destination):\n            os.makedirs(destination)\n\n        # Check if the source and destination are files\n        if not os.path.isfile(source):\n            raise NotADirectoryError(f\"The source '{source}' is not a file.\")\n        if not os.path.isfile(destination):\n            raise NotADirectoryError(f\"The destination '{destination}' is not a file.\")\n\n        # Copy the file\n        os.copy(source, destination)\n\n        print(f\"File '{source}' copied successfully to '{destination}'.\")\n\n    except FileNotFoundError as e:\n        print(e)\n    except NotADirectoryError as e:\n        print(e)\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n\n# Example usage\ncopy_file(\"source.txt\", \"destination.txt\")\n```"
