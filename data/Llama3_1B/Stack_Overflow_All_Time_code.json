"```python\nfrom bs4 import BeautifulSoup\nimport re\n\ndef custom_validate_messages(html_form):\n    soup = BeautifulSoup(html_form, 'html.parser')\n    username_input = soup.find('input', {'name': 'username'})\n    password_input = soup.find('input', {'name': 'pass'})\n    remember_checkbox = soup.find('input', {'type': 'checkbox', 'name': 'remember'})\n\n    # Add custom validation message for username\n    username_input.attrs['class'] = 'form-field'\n    username_input.attrs['data-custom-message'] = 'This field cannot be left blank'\n\n    # Add custom validation message for password\n    password_input.attrs['class'] = 'form-field'\n    password_input.attrs['data-custom-message'] = '*****'\n\n    # Add custom validation message for remember checkbox\n    remember_checkbox.attrs['class'] = 'form-field'\n    remember_checkbox.attrs['data-custom-message'] = 'This field cannot be left blank'\n\n    return str(soup)\n\n# Example usage\nhtml_form = '<form id=\"form\" onsubmit=\"return(login())\"><input name=\"username\" placeholder=\"Username\" required><input name=\"pass\" type=\"password\" placeholder=\"Password\" required><br>Remember me:<br><input type=\"checkbox\" name=\"remember\" value=\"true\"><br><input type=\"submit\" name=\"submit\" value=\"Log In\"></form>'\nprint(custom_validate_messages(html_form))\n```"
"None\n\nTo validate an email address in Swift, you can use the following code:\n\n```swift\nfunc isValidEmail(_ email: String) -> Bool {\n    guard let emailString = email, !emailString.isEmpty else { return false }\n\n    let emailRegex = NSRegularExpression(pattern: \"[A-Z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,4}\")\n\n    do {\n        let regex = try emailRegex.compile()\n        return regex.matches(in: emailString)\n    } catch {\n        print(\"Invalid email regex: \\(error.localizedDescription)\")\n        return false\n    }\n}\n```\n\nThis function takes an email address as a string and returns `true` if it's valid, `false` otherwise. It uses a regular expression to match the typical format of an email address."
