"import socket\n\n# AF_INET represents IPv4 addresses\n# PF_INET represents network protocols\n# AF_INET is a protocol-level socket\n# PF_INET is a network-level socket\n\n# Example usage\nsock = socket.socket(socket.AF_INET, socket.PF_INET)\nsock.bind(('localhost', 8080))  # bind to localhost on port 8080\nprint(sock.getsockname())  # prints the address '127.0.0.1:8080'\n\n# AF_INET is used for IPv4\nsock = socket.socket(socket.AF_INET, socket.AF_INET)  # create a socket using AF_INET\nsock.bind(('127.0.0.1', 8080))  # bind to localhost on port 8080\nprint(sock.getsockname())  # prints the address '127.0.0.1:8080'\n\n# PF_INET is used for IPv4\nsock = socket.socket(socket.PF_INET, socket.AF_INET)  # create a socket using PF_INET\nsock.bind(('127.0.0.1', 8080))  # bind to localhost on port 8080\nprint(sock.getsockname())  # prints the address '127.0.0.1:8080'"
"import socket\n\ndef close_socket(sock):\n    sock.close()\n\ndef shutdown_socket(sock, mode):\n    if mode == 'shutdown':\n        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SHUTDOWN, 1)\n        sock.settimeout(0)\n    else:\n        raise ValueError(\"Invalid shutdown mode\")\n\n# Example usage:\nsock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\nshutdown_socket(sock, 'shutdown')\nclose_socket(sock)"
