"import os\n\ndef is_file_in_use(filename):\n    \"\"\"\n    Check if a file is in use.\n\n    This function uses the os module to check if the specified file is open.\n    If it is, the file is considered in use.\n\n    Args:\n        filename (str): The name of the file to check.\n\n    Returns:\n        bool: True if the file is in use, False otherwise.\n    \"\"\"\n    try:\n        # Attempt to open the file in read mode\n        with open(filename, 'r'):\n            # If we can open the file, it's in use\n            return True\n    except Exception:\n        # If an error occurs, the file is likely in use\n        return False\n\n# Example usage:\nfilename = 'example.txt'\nif is_file_in_use(filename):\n    print(f\"The file '{filename}' is in use.\")\nelse:\n    print(f\"The file '{filename}' is not in use.\")"
