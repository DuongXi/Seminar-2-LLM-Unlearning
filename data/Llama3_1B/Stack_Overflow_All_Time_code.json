"```javascript\nfunction areObjectsEqual(obj1, obj2) {\n    // Check if the objects are the same\n    if (obj1 === obj2) {\n        return true;\n    }\n    \n    // Check if the objects are objects themselves\n    if (typeof obj1 !== 'object' || typeof obj2 !== 'object') {\n        return false;\n    }\n    \n    // Check if the objects have the same keys\n    for (let key in obj1) {\n        if (obj2[key] !== obj1[key]) {\n            return false;\n        }\n    }\n    \n    // If all checks pass, the objects are equal\n    return true;\n}\n\n// Example usage:\nlet user1 = {name: \"nerd\", org: \"dev\"};\nlet user2 = {name: \"nerd\", org: \"dev\"};\nconsole.log(areObjectsEqual(user1, user2)); // Output: true\n\nlet user3 = {name: \"nerd\", org: \"dev\"};\nconsole.log(areObjectsEqual(user1, user3)); // Output: false\n\nlet user4 = Object.assign({}, user1);\nconsole.log(areObjectsEqual(user1, user4)); // Output: true\n```"
