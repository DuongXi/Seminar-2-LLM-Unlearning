"```python\nimport matplotlib.pyplot as plt\n\n# Simple data to display in various forms\nx = np.linspace(0, 2 * np.pi, 400)\ny = np.sin(x ** 2)\n\nplt.figure(figsize=(10, 8))  # Set the figure size\nplt.close('all')  # Close the current figure\n\n# Create a figure with two subplots\nf, ax = plt.subplots(2, sharex=True)\n\n# Plot data in the first subplot\nax.plot(x, y)\nax.set_title('Simple plot')\n\n# Plot data in the second subplot\nf, axarr = plt.subplots(2, sharex=True)\naxarr[0].plot(x, y)\naxarr[0].set_title('Sharing X axis')\naxarr[1].scatter(x, y)\n\n# Set the figure size for the second figure\nf.figure(figsize=(10, 8))\n\n# Create a figure with three subplots sharing both x/y axes\nf, (ax1, ax2, ax3) = plt.subplots(3, sharex=True, sharey=True)\n\n# Plot data in the first subplot\nax1.plot(x, y)\nax1.set_title('Sharing both axes')\n\n# Plot data in the second subplot\nax2.scatter(x, y)\nax2.set_title('Sharing Y axis')\nax3.scatter(x, 2 * y ** 2 - 1, color='r')\n\n# Set the figure size for the third figure\nf.figure(figsize=(10, 8))\n\n# Create a figure with four axes, returned as a 2-d array\nf, axarr = plt.subplots(2, 2)\n\n# Plot data in the first subplot\naxarr[0, 0].plot(x, y)\naxarr[0, 0].set_title('Axis [0,0]')\n\n# Plot data in the second subplot\naxarr[0, 1].scatter(x, y)\naxarr[0, 1].set_title('Axis [0,1]')\n\n# Plot data in the third subplot\naxarr[1, 0].plot(x, y ** 2)\naxarr[1, 0].set_title('Axis [1,0]')\n\n# Plot data in the fourth subplot\naxarr[1, 1].scatter(x, 2 * y ** 2 - 1, color='r')\naxarr[1, 1].set_title('Axis [1,1]')\n\n# Set the figure size for the fourth figure\nf.figure(figsize=(10, 8))\n\n# Fine-tune figure; make subplots close to each other and hide x ticks for all but bottom plot\nf.subplots_adjust(hspace=0)\n\n# Fine-tune figure; make subplots farther from each other\nplt.tight_layout()  # Adjust the layout to fit the figure\n\nplt.show()\n```"
