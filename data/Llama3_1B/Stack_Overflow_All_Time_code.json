"from tensorflow.keras.layers import BatchNormalization, Dropout\n\ndef batch_norm_dropout():\n    # Batch normalization followed by dropout\n    model = tf.keras.models.Sequential([\n        BatchNormalization(),\n        Dropout(0.2),\n        # Batch normalization followed by dropout\n        BatchNormalization(),\n        Dropout(0.2)\n    ])\n\n    # Batch normalization before dropout\n    model = tf.keras.models.Sequential([\n        BatchNormalization(),\n        Dropout(0.2),\n        # Batch normalization before dropout\n        BatchNormalization(),\n        Dropout(0.2)\n    ])\n\n    # Test the ordering\n    model.compile(optimizer='adam', loss='mean_squared_error')\n    model.fit(X_train, y_train, epochs=10, batch_size=32)\n    model.evaluate(X_test, y_test)\n\n    # Run the same network twice with only the batch norm and dropout reverse\n    model = tf.keras.models.Sequential([\n        BatchNormalization(),\n        Dropout(0.2),\n        BatchNormalization(),\n        Dropout(0.2)\n    ])\n    model.compile(optimizer='adam', loss='mean_squared_error')\n    model.fit(X_train, y_train, epochs=10, batch_size=32)\n    model.evaluate(X_test, y_test)"
"import tensorflow as tf\n\ndef get_available_gpus():\n    \"\"\"\n    Returns a list of available GPUs on the machine, restricting to two.\n    \n    Returns:\n    list: A list of available GPUs, restricted to two.\n    \"\"\"\n    # Get the list of GPUs available on the machine\n    gpus = tf.config.list_physical_devices('GPU')\n    \n    # Filter the list to only include GPUs that are visible to the CPU\n    visible_gpus = [gpu for gpu in gpus if tf.config.list_physical_devices('GPU')['CPU_visible'].startswith(gpu)]\n    \n    # Return the first two visible GPUs\n    return visible_gpus[:2]\n\nprint(get_available_gpus())"
