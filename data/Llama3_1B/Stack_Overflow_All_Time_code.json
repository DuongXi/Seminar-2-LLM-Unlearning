"import csv\n\ndef mysql_to_csv(mysql_query, db_name):\n    # Execute the MySQL query\n    mysql_command = f\"mysql -u {mysql_user} -p{mysql_password} -D {db_name} &lt;&lt; {mysql_query}\"\n    subprocess.run(mysql_command, shell=True)\n\n    # Open the CSV file in write mode\n    with open('list.csv', 'w', newline='') as csvfile:\n        # Create a CSV writer\n        writer = csv.writer(csvfile)\n        \n        # Write the header row\n        writer.writerow(['id', 'name'])\n        \n        # Read the MySQL query results\n        with open('list.csv', 'r') as input_file:\n            reader = csv.reader(input_file)\n            for row in reader:\n                # Construct the output row\n                output_row = [f\"'{value}'\" if value != '\"' else value for value in row]\n                # Write the output row\n                writer.writerow(output_row)\n\nmysql_to_csv(mysql_query=\"SELECT id, concat(name, ' ', surname) as full_name FROM students\", db_name=\"your_database_name\")"
"```python\nimport csv\nimport os\n\ndef save_plpgsql_output_to_csv(db_name, table_name, query):\n    # Connect to the PostgreSQL database\n    conn = None\n    with open(os.path.join(os.getcwd(), f\"{db_name}.pg\"), 'r') as file:\n        conn = psycopg2.connect(\n            host=file.name,\n            database=db_name,\n            user='your_username',\n            password='your_password'\n        )\n\n    # Create a cursor object\n    cur = conn.cursor()\n\n    # Execute the query and get the output\n    cur.execute(query)\n    output = cur.fetchall()\n\n    # Get the table name from the query\n    table_name = query.split('FROM ')[1].split(' ')[0]\n\n    # Create the CSV file path\n    csv_file_path = f\"{db_name}.csv\"\n\n    # Create the CSV writer\n    with open(csv_file_path, 'w', newline='') as file:\n        writer = csv.writer(file)\n\n        # Write the header row\n        writer.writerow([\"Column1\", \"Column2\", \"Column3\"])\n\n        # Write each row of output\n        for row in output:\n            writer.writerow([str(row[0]), str(row[1]), str(row[2])])\n\n    # Close the cursor and connection\n    cur.close()\n    conn.close()\n\n# Example query\nquery = \"SELECT * FROM my_table\"\nsave_plpgsql_output_to_csv('mydb', 'my_table', query)\n```\n\nPlease note that you need to replace `'your_username'` and `'your_password'` with your actual PostgreSQL username and password. Also, this code assumes that the PostgreSQL database is in the same directory as the Python script. If it's not, you'll need to specify the full path to the database file."
