"from System.Windows.Controls import StackPanel, DockPanel, GroupBox\n\ndef get_stackpanel_children_to_fill_max_space_downward():\n    \"\"\"Get StackPanel's children to fill maximum space downward.\"\"\"\n    stackpanel = StackPanel()\n    stackpanel_vertical_alignment = stackpanel.VerticalAlignment\n    stackpanel_height = stackpanel.Height\n    stackpanel_min_width = stackpanel.MinWidth\n    stackpanel_margin = stackpanel Margin\n\n    groupbox = GroupBox()\n    groupbox DockPanel.Dock = \"Right\"\n    groupbox.Header = \"Help\"\n    groupbox.Width = 100\n    groupbox.VerticalAlignment = \"Stretch\"\n    groupbox.VerticalContentAlignment = \"Stretch\"\n    groupbox.Height = stackpanel_height\n    groupbox Background = \"Beige\"\n    groupbox.VerticalAlignment = \"Stretch\"\n    groupbox.VerticalContentAlignment = \"Stretch\"\n    groupbox.Height = \"Auto\"\n\n    stackpanel.Children.Add(groupbox)\n\n    return stackpanel, groupbox\n\nstackpanel, groupbox = get_stackpanel_children_to_fill_max_space_downward()\nprint(\"StackPanel:\")\nprint(stackpanel)\nprint(\"\\nGroupBox:\")\nprint(groupbox)"
