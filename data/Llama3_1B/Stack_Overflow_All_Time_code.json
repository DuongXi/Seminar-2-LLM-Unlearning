"```python\n# Create a dictionary with words as keys and their frequencies as values\nword_freq = {'apple': 3, 'banana': 2, 'cherry': 1, 'date': 4}\n\n# Sort the dictionary by frequency in descending order\nsorted_word_freq = dict(sorted(word_freq.items(), key=lambda item: item[1], reverse=True))\n\n# Print the sorted dictionary\nprint(\"Sorted word frequency dictionary:\")\nfor word, freq in sorted_word_freq.items():\n    print(f\"{word}: {freq}\")\n```"
"```python\nimport sqlite3\n\ndef sort_columns(db_name, table_name, column1, column2, direction1='DESC', direction2='ASC'):\n    \"\"\"\n    Sorts multiple columns in a SQL database table.\n\n    Args:\n        db_name (str): Name of the SQLite database.\n        table_name (str): Name of the table to sort.\n        column1 (str): Name of the first column to sort.\n        column2 (str): Name of the second column to sort.\n        direction1 (str, optional): Sorting direction for column1. Defaults to 'DESC'.\n        direction2 (str, optional): Sorting direction for column2. Defaults to 'ASC'.\n\n    Returns:\n        None\n    \"\"\"\n\n    # Connect to the SQLite database\n    conn = sqlite3.connect(db_name)\n\n    # Create a cursor object\n    cur = conn.cursor()\n\n    # Create a SQL query to sort the columns\n    query = f\"\"\"\n        SELECT *\n        FROM {table_name}\n        ORDER BY {column1} {direction1}, {column2} {direction2}\n    \"\"\"\n\n    # Execute the SQL query\n    cur.execute(query)\n\n    # Fetch all the rows from the query\n    rows = cur.fetchall()\n\n    # Close the connection to the database\n    conn.close()\n\n    # Print the sorted rows\n    for row in rows:\n        print(row)\n\n# Example usage:\nsort_columns('example.db', 'my_table', 'column1', 'column2', 'DESC', 'ASC')\n```"
"```python\ndef sort_by_index(data, index):\n    \"\"\"\n    Sort a list/tuple of lists/tuples by the element at a given index.\n    \n    Args:\n        data (list/tuple): The list/tuple of lists/tuples to be sorted.\n        index (int): The index of the element to sort by.\n    \n    Returns:\n        list/tuple: The sorted list/tuple of lists/tuples.\n    \"\"\"\n    # Use the built-in sorted function with a custom sorting key\n    return sorted(data, key=lambda x: x[index])\n\n# Example usage:\ndata = [[1,2,3], [4,5,6], [7,8,9]]\ndata = [(1,2,3), (4,5,6), (7,8,9)]\n\nsorted_data = sort_by_index(data, 1)\nprint(sorted_data)  # Output: [(1, 2, 3), (4, 5, 6), (7, 8, 9)]\n\nsorted_data = sort_by_index(data, 2)\nprint(sorted_data)  # Output: [(4, 5, 6), (7, 8, 9), (1, 2, 3)]\n```"
"def calculate_difference_in_years():\n    # Define the two dates in year 1927\n    date1 = \"1927-12-31 23:54:07\"\n    date2 = \"1927-12-31 23:54:08\"\n\n    # Parse the dates into Date objects\n    try:\n        dt1 = datetime.strptime(date1, \"%Y-%m-%d %H:%M:%S\")\n        dt2 = datetime.strptime(date2, \"%Y-%m-%d %H:%M:%S\")\n    except ValueError:\n        print(\"Error parsing dates\")\n        return None\n\n    # Convert the times to seconds\n    time1 = dt1.timestamp()\n    time2 = dt2.timestamp()\n\n    # Calculate the difference in years\n    years_diff = time2 - time1\n\n    return years_diff\n\nresult = calculate_difference_in_years()\nif result is not None:\n    print(f\"The difference in years is {result}\")"
