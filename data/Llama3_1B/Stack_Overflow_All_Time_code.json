"```python\nimport pandas as pd\n\ndef remove_rows_with_na(data):\n    # Remove rows with all NA values\n    data = data.dropna(how='all')\n    \n    # Remove rows with NA values in only some columns\n    data = data.dropna(how='any', axis=1)\n    \n    return data\n\n# Example usage\ndata = pd.DataFrame({\n    'gene': ['ENSG00000208234', 'ENSG00000199674', 'ENSG00000221622', 'ENSG00000207604', 'ENSG00000207431', 'ENSG00000221312'],\n    'hsap': [0, 0, 0, 0, 0, 0],\n    'mmul': [None, 2, 2, None, 2, 2],\n    'mmus': [None, 2, 2, None, 2, 2],\n    'rnor': [None, 2, 2, None, 2, 2],\n    'cfam': [None, 2, 2, 1, 3, 2]\n})\n\nprint(\"Original DataFrame:\")\nprint(data)\n\ndata = remove_rows_with_na(data)\n\nprint(\"\\nDataFrame after removing rows with all NA values:\")\nprint(data)\n\ndata = remove_rows_with_na(data)\n\nprint(\"\\nDataFrame after removing rows with NA values in only some columns:\")\nprint(data)\n```"
