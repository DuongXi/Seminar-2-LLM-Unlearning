"```python\nimport pandas as pd\n\ndef rename_column_names(df, old_names, new_names):\n    \"\"\"\n    Rename column names in a Pandas DataFrame.\n\n    Args:\n        df (pd.DataFrame): The DataFrame to rename column names in.\n        old_names (list): The old column names to be renamed.\n        new_names (list): The new column names to be used.\n\n    Returns:\n        pd.DataFrame: The DataFrame with renamed column names.\n    \"\"\"\n    # Create a copy of the original DataFrame to avoid modifying it directly\n    new_df = df.copy()\n    \n    # Iterate over the old and new names\n    for old, new in zip(old_names, new_names):\n        # Use the replace method to rename the column\n        new_df = new_df.replace(old, new)\n    \n    return new_df\n\n# Example usage:\ndata = {'$a': [1, 2, 3], '$b': [4, 5, 6], '$c': [7, 8, 9], '$d': [10, 11, 12], '$e': [13, 14, 15]}\ndf = pd.DataFrame(data)\nprint(\"Original DataFrame:\")\nprint(df)\n\nnew_df = rename_column_names(df, ['$a', '$b', '$c', '$d', '$e'], ['a', 'b', 'c', 'd', 'e'])\nprint(\"\\nDataFrame with renamed column names:\")\nprint(new_df)\n```"
