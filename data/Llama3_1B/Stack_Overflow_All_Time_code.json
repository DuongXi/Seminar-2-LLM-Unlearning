"```python\nimport requests\n\ndef detect_request_type(url):\n    \"\"\"\n    Detects the request type (GET, POST, PUT, or DELETE) based on the URL.\n\n    Args:\n        url (str): The URL to analyze.\n\n    Returns:\n        str: The detected request type.\n    \"\"\"\n\n    # Send a GET request to the URL\n    try:\n        response = requests.get(url)\n    except requests.RequestException as e:\n        print(f\"Error: {e}\")\n        return None\n\n    # Check if the request was a GET request\n    if response.status_code == 200 and response.headers.get('Content-Type') == 'application/json':\n        return 'GET'\n\n    # If the request was not a GET, check if it was a POST request\n    elif response.status_code == 201:\n        return 'POST'\n\n    # If the request was not a POST, check if it was a PUT request\n    elif response.status_code == 200:\n        return 'PUT'\n\n    # If the request was not a PUT, it must be a DELETE request\n    else:\n        return 'DELETE'\n\n# Example usage\nurl = 'https://example.com/api/endpoint'\nrequest_type = detect_request_type(url)\nprint(f\"Request type: {request_type}\")\n```"
