"```python\nimport csv\nimport os\n\ndef split_csv_by_groups(file_path, num_files):\n    with open(file_path, 'r') as file:\n        reader = csv.reader(file)\n        groups = {}\n        current_group = 1\n        group_index = 0\n        for row in reader:\n            id = row[1]\n            if id not in groups:\n                groups[id] = [row]\n            else:\n                groups[id].append(row)\n\n            if len(groups[id]) >= num_files:\n                group_index += 1\n                current_group = (current_group % num_files) + 1\n                groups[id] = groups[id][group_index:]\n\n    for id, group in groups.items():\n        file_name = f\"{current_group}.csv\"\n        with open(file_name, 'w', newline='') as new_file:\n            writer = csv.writer(new_file)\n            writer.writerows(group)\n\nsplit_csv_by_groups('input.csv', 3)\n```"
