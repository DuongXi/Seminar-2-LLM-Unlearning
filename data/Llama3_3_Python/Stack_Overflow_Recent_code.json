"```go\npackage main\n\nimport (\n    \"bufio\"\n    \"fmt\"\n    \"io\"\n    \"log\"\n    \"os\"\n    \"strings\"\n)\n\nfunc main() {\n    file, err := os.Open(\"test.csv\")\n    if err != nil {\n        log.Fatal(err)\n    }\n    defer file.Close()\n\n    fileInfo, err := file.Stat()\n    if err != nil {\n        log.Fatal(err)\n    }\n    fmt.Printf(\"file total bytes is %d\\n\", fileInfo.Size())\n\n    // init reader\n    reader := bufio.NewReader(file)\n\n    byteCounter := 0\n    for {\n        // if we reached end of file, stop\n        data, err := reader.ReadString('\\n')\n        if err != nil {\n            break\n        }\n        // remove newline at the end\n        data = strings.TrimSpace(data)\n        // count bytes\n        byteCounter += len(data) + len(strings.Split(data, \",\")) + 2\n        if len(data) > 0 && strings.HasSuffix(data, \"\\r\\n\") {\n            byteCounter -= 1\n        }\n        fmt.Printf(\"record is %d bytes\\n\", len(data))\n        fmt.Println(\"total bytes so far is:\", byteCounter)\n    }\n}\n```"
