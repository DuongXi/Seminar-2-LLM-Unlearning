"```python\n# Define the Terraform configuration\nprovider \"helm\" {\n  kubernetes {\n    config_path    = \"~/.kube/config\"\n    config_context = \"clusterconfig\"\n  }\n  experiments {\n    manifest = true\n  }\n}\n\n# Create a resource to manage the Helm release\nresource \"helm_release\" \"release\" {\n  name      = \"example\"\n  chart     = \"../../helm/chart\"\n  namespace = \"example\"\n  wait      = true\n\n  # Use a for_each loop to iterate over the values file\n  for_each = file(\"helm/values-example.yaml\")\n\n  # Set the image.tag value to the current value from the file\n  set {\n    name  = \"image.tag\"\n    value = each.key\n  }\n\n  # Use a template to render the values file with the current value\n  template {\n    file = \"helm/values-example.yaml\"\n    content = <<EOF\nreplicaCount: ${each.value.replicaCount}\nimage:\n  repository: test\n  pullPolicy: ifNotPresent\nEOF\n  }\n}\n```"
