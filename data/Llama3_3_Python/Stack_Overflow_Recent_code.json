"```python\nimport requests\n\ndef update_alias(es_url, index_name, alias_name):\n    # Create the action to remove the old alias\n    remove_action = {\n        \"remove\": {\n            \"alias\": alias_name,\n            \"index\": f\"products-{index_name}\"\n        }\n    }\n\n    # Create the action to add the new alias\n    add_action = {\n        \"add\": {\n            \"alias\": alias_name,\n            \"index\": f\"products-{index_name}\"\n        }\n    }\n\n    # Combine the actions into a single request\n    actions = [remove_action, add_action]\n\n    # Send the request to update the alias\n    response = requests.post(es_url + \"/_aliases\", json=actions)\n\n    # Check if the response was successful\n    if response.status_code == 200:\n        # Check if the alias was updated\n        get_alias_response = requests.get(es_url + \"/_cat/aliases?v\")\n        if get_alias_response.json()[\"hits\"][\"total\"] > 0 and get_alias_response.json()[\"hits\"][\"hits\"][0][\"_source\"][\"alias\"] == alias_name:\n            return True\n    return False\n```"
