"```python\nimport time\n\ndef compare_methods(initial_file, config_file, output_file):\n    # Method 1: Write initial file, then read and append\n    start_time = time.time()\n    with open(initial_file, 'w') as f:\n        # Write initial content to file\n        pass  # Your code to write initial content goes here\n\n    start_time = time.time()\n    with open(initial_file, 'r') as f:\n        lines = f.readlines()\n\n    start_time = time.time()\n    with open(output_file, 'w') as f:\n        # Write initial lines to new file\n        for line in lines:\n            f.write(line)\n        # Append new lines to new file\n        with open(config_file, 'r') as c:\n            for line in c:\n                if line.strip():  # Check for empty lines\n                    f.write(line)\n\n    # Method 2: Read initial file, write to new file\n    start_time = time.time()\n    with open(initial_file, 'r') as f:\n        lines = f.readlines()\n\n    start_time = time.time()\n    with open(output_file, 'w') as f:\n        # Write initial lines to new file\n        for line in lines:\n            f.write(line)\n        # Append new lines to new file\n        with open(config_file, 'r') as c:\n            for line in c:\n                if line.strip():  # Check for empty lines\n                    f.write(line)\n\n    # Compare execution times\n    method1_time = time.time() - start_time\n    method2_time = time.time() - start_time\n\n    print(f\"Method 1 execution time: {method1_time} seconds\")\n    print(f\"Method 2 execution time: {method2_time} seconds\")\n\n# Example usage\ninitial_file = \"initial.txt\"\nconfig_file = \"config.txt\"\noutput_file = \"output.txt\"\n\ncompare_methods(initial_file, config_file, output_file)\n```"
