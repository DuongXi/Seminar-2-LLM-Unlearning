"```python\nimport base64\n\ndef encode_base64(text):\n    return base64.b64encode(text.encode('utf-8')).decode('utf-8')\n\ndef decode_base64(encoded):\n    return base64.b64decode(encoded).decode('utf-8')\n\ntext = '\u00dcml\u00e4ut'\nencoded_text = encode_base64(text)\ndecoded_text = decode_base64(encoded_text)\n\nprint(f\"{text} in base64: {encoded_text}\")\nprint(f\"and back: {decoded_text}\")\n\nsubject = \"=?UTF-8?B?\" + encode_base64(text) + \"=?\"\ndecoded_subject = decode_base64(subject[subject.find('?=') + 3:-3])\n\nprint(f\"in Subject: {subject}\")\nprint(f\"subject decoded: {decoded_subject}\")\n```"
"```python\n# Define a function to apply light theme styles\ndef apply_light_theme(email):\n    # Add light theme styles here\n    email = email.replace(\"dark_color\", \"light_color\")\n    email = email.replace(\"dark_background\", \"light_background\")\n    return email\n\n# Define a function to apply dark theme styles\ndef apply_dark_theme(email):\n    # Add dark theme styles here\n    email = email.replace(\"light_color\", \"dark_color\")\n    email = email.replace(\"light_background\", \"dark_background\")\n    return email\n\n# Example usage\nemail_content = \"<p>This is a sample email</p>\"\nlight_email = apply_light_theme(email_content)\ndark_email = apply_dark_theme(light_email)\n\n# Print the emails with different themes\nprint(\"Light Email:\")\nprint(light_email)\nprint(\"\\nDark Email:\")\nprint(dark_email)\n```"
