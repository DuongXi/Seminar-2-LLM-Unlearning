"```python\nfrom abc import ABC, abstractmethod\nfrom typing import Any\n\n# Define the Visitor interface with different return types\nclass IVisitor(ABC):\n    @abstractmethod\n    def visit_string(self, visitable_class: str) -> str:\n        pass\n\n    @abstractmethod\n    def visit_int(self, visitable_class: int) -> int:\n        pass\n\n# Define the concrete visitor class\nclass ConcreteVisitor(IVisitor):\n    def visit_string(self, visitable_class: str) -> str:\n        # Return type is correct\n        return f\"Visited {visitable_class}\"\n\n    def visit_int(self, visitable_class: int) -> int:\n        # Return type is correct\n        return visitable_class\n\n# Define the Visitable classes with different return types\nclass VisitableClassReturnString(ABC):\n    @abstractmethod\n    def accept(self, visitor: IVisitor) -> str:\n        pass\n\nclass VisitableClassReturnInt(ABC):\n    @abstractmethod\n    def accept(self, visitor: IVisitor) -> int:\n        pass\n\n# Implement the concrete Visitable classes\nclass ConcreteVisitableClassReturnString(VisitableClassReturnString):\n    def accept(self, visitor: IVisitor) -> str:\n        return visitor.visit_string(self)\n\nclass ConcreteVisitableClassReturnInt(VisitableClassReturnInt):\n    def accept(self, visitor: IVisitor) -> int:\n        return visitor.visit_int(self)\n\n# Example usage\nif __name__ == \"__main__\":\n    visitor = ConcreteVisitor()\n    visitable_class_string = ConcreteVisitableClassReturnString()\n    visitable_class_int = ConcreteVisitableClassReturnInt()\n\n    print(visitor.visit_string(visitable_class_string))  # Output: Visited \"Hello\"\n    print(visitor.visit_int(visitable_class_int))  # Output: 123\n```"
