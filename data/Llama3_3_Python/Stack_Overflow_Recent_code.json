"```python\nfrom maui import App, ContentPage, CollectionView, CollectionViewItemsLayout, Grid, GridItemsLayout, GridRowDefinitions, GridColumnDefinitions, Image, Label, StackLayout, VerticalStackLayout, CarouselView, ObservableCollection, Command, Property, Binding, Async, Task, Thread, Result, Event, PropertyChanged\n\nclass MenuDetailsViewModel(PropertyChangedEventHandler):\n    def __init__(self, sub_group):\n        self.SubGrInd = sub_group\n        self.ApiControl = VegaApi()\n        self.ProdListS = ObservableCollection()\n        self.startindex = 1\n        self.endindex = 10\n        self.IsShowMode = False\n\n    async def LoadDataS(self):\n        data = await self.ApiControl.GetMenuDetAsync(self.SubGrInd, self.startindex, self.endindex)\n        self.ProdListS = ObservableCollection(data)\n        self.PropertyChanged(self, \"ProdListS\")\n\n    @Property\n    def ProdListS(self):\n        return self._ProdListS\n\n    @Property\n    def LoadMoreS(self):\n        return Command(async def execute():\n            self.startindex += 16\n            self.endindex += 16\n            data = await self.ApiControl.GetMenuDetAsync(self.SubGrInd, self.startindex, self.endindex)\n            for item in data:\n                self.ProdListS.Add(item)\n            self.PropertyChanged(self, \"ProdListS\")\n\nclass MenuDetailsPage(ContentPage):\n    def __init__(self, sub_group):\n        super().__init__()\n        self.BindingsContext = MenuDetailsViewModel(sub_group)\n        self.ImageList = []\n\n    async def OnProdSelectionChanged(self, sender, e):\n        prod_item = self.prodcollect.SelectedItem\n        if prod_item:\n            id_param = prod_item.product_Id\n            param_list = await self.BindingsContext.ApiControl.GetParamDetAsync(id_param)\n            profile_page = ProdInformation()\n            profile_page.Title = self.Title\n            profile_page.BindingContext = prod_item\n            props_stack = profile_page.FindByName(\"InfoLayout\")\n            if props_stack:\n                for title_id in set(param_list).values():\n                    sub_list = [item for item in param_list if item.Title_Id == title_id]\n                    if sub_list:\n                        label = Label()\n                        label.Text = sub_list[0].Title_Name\n                        label.FontSize = 18\n                        label.TextColor = Color.FromRgb(16, 26, 175)\n                        label.Padding = Thickness(3, 5, 3, 5)\n                        label.HorizontalOptions = LayoutOptions.Start\n                        props_stack.Add(label)\n                        grid = Grid()\n                        grid.ColumnDefinitions = [\n                            GridColumnDefinition(Width=GridLength.Star),\n                            GridColumnDefinition(Width=GridLength.Star)\n                        ]\n                        for i, item in enumerate(sub_list):\n                            grid.AddRowDefinition()\n                            grid.Add(Label(\n                                Text=item.Param_Name + \" \",\n                                LineBreakMode=LineBreakMode.WordWrap,\n                                MaxLines=2,\n                                HorizontalOptions=LayoutOptions.Start,\n                                VerticalOptions=LayoutOptions.Center\n                            ), 0, i)\n                            grid.Add(Label(\n                                Text=item.Param_Value,\n                                LineBreakMode=LineBreakMode.WordWrap,\n                                MaxLines=2,\n                                HorizontalOptions=LayoutOptions.Start,\n                                VerticalOptions=LayoutOptions.Center\n                            ), 1, i)\n                        props_stack.Add(grid)\n\n            carousel_view = profile_page.FindByName(\"pcarousel\")\n            if carousel_view:\n                data = [Promo(ImgSource=prod_item.firstPicture)]\n                if len(prod_item.product_PicturePath.split('@')) > 1:\n                    for pic in prod_item.product_PicturePath.split('@')[1:]:\n                        if pic and len(pic) > 3:\n                            data.append(Promo(ImgSource=\"https://vega.am/image/\" + pic))\n                carousel_view.ItemsSource = data\n            await self.Navigation.PushAsync(profile_page)\n```"
