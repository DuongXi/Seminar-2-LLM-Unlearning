"```python\ndef YCrCb_to_RGB8(Y, Cr, Cb, R, G, B):\n   R = (int)(Y + 1.402 *(Cr - 128))\n   G = (int)(Y - 0.344136*(Cb-128) -0.71414*(Cr-128))\n   B = (int)(Y + 1.772 *(Cb-128))\n\n   if R < 0: R = 0; else if R > 255: R = 255\n   if G < 0: G = 0; else if G > 255: G = 255\n   if B < 0: B = 0; else if B > 255: B = 255\n\ndef get_RGB8buffer(pFrame, buffer):\n   width = pFrame.width\n   height = pFrame.height\n   Y, Cr, Cb = 0, 0, 0\n   R, G, B = 0, 0, 0\n\n   pixel = 0\n   for y in range(height):\n      for x in range(width):\n         Y = pFrame.data[0][x + y * width]\n         Cr = pFrame.data[1][x // 2 + ((y // 2)) * pFrame.linesize[1]]\n         Cb = pFrame.data[2][x // 2 + ((y // 2)) * pFrame.linesize[2]]\n\n         YCrCb_to_RGB8(Y, Cr, Cb, R, G, B)\n         buffer[pixel * 3 + 0] = R\n         buffer[pixel * 3 + 1] = G\n         buffer[pixel * 3 + 2] = B\n         pixel += 1\n\ndef save_RGB_frame(buf, wrap, xsize, ysize, filename):\n   f = open(filename, 'wb')\n   # portable ppm format - https://en.wikipedia.org/wiki/Netpbm#PPM_example\n   f.write(b'P6\\n%d %d\\n%d\\n' % (xsize, ysize, 255))\n\n   # writing line by line\n   for i in range(ysize):\n      f.write(buf[i * wrap] + b' ' * xsize + buf[i * wrap + xsize] + b' ' * xsize + buf[i * wrap + xsize * 2] + b'\\n')\n   f.close()\n```"
