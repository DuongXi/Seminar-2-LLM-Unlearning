"```python\nimport itertools\nimport numpy as np\n\ndef generate_matrices(n, p):\n    matrices = []\n    for permutation in itertools.product([0, 1], repeat=n * n // 2):\n        # Convert permutation to binary matrix\n        matrix = np.zeros((n, n))\n        for i in range(n * n // 2):\n            j = 2 * i + 1\n            matrix[i % n, j // n] = permutation[i]\n        \n        # Check if matrix is symmetric and row sum equals p\n        if all(matrix[i, j] == matrix[j, i] for i in range(n) for j in range(n)) and \\\n           all(np.sum(matrix[i]) == p for i in range(n)):\n            matrices.append(matrix)\n    \n    return matrices\n\n# Test the function\nn = 4\np = 2\nprint(generate_matrices(n, p))\n```"
"import math\nimport pandas as pd\nfrom scipy.spatial import Voronoi\nfrom scipy.spatial import Delaunay\n\ndef generate_teams(df, num_teams, team_size):\n    # Create a Voronoi diagram\n    vor = Voronoi(df[['lat', 'lon']])\n\n    # Create a Delaunay triangulation\n    tri = Delaunay(df[['lat', 'lon']])\n\n    teams = []\n    for i in range(num_teams):\n        team = []\n        # Iterate over the Voronoi cells\n        for simplex in tri.simplices:\n            if len(team) < team_size:\n                # Check if the cell is within the team's area\n                if any(vor.regions[vor.find(simplex)][i] == 1 for i in range(len(vor.regions[vor.find(simplex)]))):\n                    # Add the players to the team\n                    team.extend(df.loc[simplex, 'players'])\n                    break\n        teams.append(team)\n\n    return teams\n\n# Generate a random dataset\ndf = pd.DataFrame({'lat': [random.uniform(0, 90) for i in range(100)],\n                'lon': [random.uniform(0, 180) for i in range(100)],\n                'players':[math.ceil(abs(random.normalvariate(0, 5))) for i in range(100)]})\n\nnum_teams = 10\nteam_size = 11\n\nteams = generate_teams(df, num_teams, team_size)"
