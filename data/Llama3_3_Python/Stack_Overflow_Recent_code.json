"```python\nimport requests\n\nclass RedemptionLiteIntegrationServiceClient:\n    def __init__(self, url, timeout, basic_auth=None, client_cert=None):\n        self.url = url\n        self.timeout = timeout\n        self.basic_auth = basic_auth\n        self.client_cert = client_cert\n\n    def __call__(self, method, uri, body=None, headers=None, **kwargs):\n        try:\n            response = requests.request(method, uri, timeout=self.timeout,\n                                        auth=self.basic_auth,\n                                        verify=self.client_cert,\n                                        **kwargs)\n            return response.json()\n        except requests.exceptions.RequestException as e:\n            return str(e)\n\n# Usage\nurl = \"https://78.93.37.230:9799/RedemptionLiteIntegrationServiceBasicHttpEndPoint\"\ntimeout = timedelta(seconds=1*30)\nbasic_auth = None\nclient_cert = None\n\nclient = RedemptionLiteIntegrationServiceClient(url, timeout, basic_auth, client_cert)\n\nresponse = client(\"GET\", \"/MyService/MyMethod\")\nprint(response)\n```"
