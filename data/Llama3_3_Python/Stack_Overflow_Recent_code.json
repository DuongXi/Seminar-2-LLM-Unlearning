"```python\n# This issue is due to how Zod handles regex validation\n# Zod does not support chaining regex expressions directly\n\n# However, you can achieve the same result by using the 'or' operator\nexport const Schema = z.object({\n  fullname: z\n    .string()\n    .or([\n      z.regex(new RegExp(/^[a-zA-Z]+[-'s]?[a-zA-Z ]+$/), 'Name should contain only alphabets'),\n      z.regex(new RegExp(/^[a-zA-Z]+\\s+[a-zA-Z]+$/), 'Please enter both firstname and lastname'),\n      z.string().min(2, 'Name should have atleast 2 alphabets')\n    ])\n});\n```\n\nIn this code, the 'or' operator is used to specify multiple conditions that the 'fullname' field must meet. If none of the conditions are met, the error message will be displayed."
"```python\nimport gin\n\n# Define the validation structure\nclass CreateUserBasicParams:\n    def __init__(self, username, email, phone):\n        self.Username = username\n        self.Email = email\n        self.Phone = phone\n\n# Define a function to validate the parameters\ndef validate_create_user_basic_params(params):\n    if not params.Username:\n        raise gin.error.GinError(\"username is required\")\n    if not params.Email:\n        raise gin.error.GinError(\"email is required\")\n    if not params.Phone:\n        raise gin.error.GinError(\"phone is required\")\n\n# Define a handler for the CreateUserBasic endpoint\ndef create_user_basic_handler(c, ctx, params):\n    try:\n        validate_create_user_basic_params(params)\n    except gin.error.GinError as e:\n        ctx.AbortWithError(http.StatusBadRequest, e)\n\n    q = hmdb.New(c.DBPool)\n    u, err := q.CreateUserBasic(ctx, params)\n    if err != nil:\n        ctx.AbortWithError(http.StatusBadRequest, err)\n    ctx.JSON(http.StatusOK, gin.H{\"message\": \"Good!\"})\n```"
