"```python\ndef build_function(f, x, *args, **kwargs):\n    \"\"\"Build a new function with the parameters already set\"\"\"\n    def new_function(*args, **kwargs):\n        return f(x, *args, **kwargs)\n    return new_function\n\ndef assign_to(x, f, *args, **kwargs):\n    \"\"\"Assign the result of f to x\"\"\"\n    f(x, *args, **kwargs)\n\ndef foo(v, f, *args, **kwargs):\n    \"\"\"Pass a new function to some other function\"\"\"\n    new_f = build_function(f, v, *args, **kwargs)\n    assign_to(v, new_f)\n    return v\n\n# Example usage:\nletters = ['a', 'b', 'c', 'd', 'e']\nfoo(letters, lambda x: x, *letters, collapse=' ')\n```"
"```python\ndef lastOccurrence(arr, size, key):\n    start = 0\n    end = size - 1\n    last = -1\n    while start <= end:\n        mid = start / 2 + end / 2\n        if key == arr[int(mid)]:\n            last = int(mid)\n            start = int(mid) + 1\n        elif key > arr[int(mid)]:\n            start = int(mid) + 1\n        else:\n            end = int(mid) - 1\n        print(f\"start: {start}\\tend: {end}\\tmid: {int(mid)}\")\n    return last\n\narr = [1, 2, 3, 4, 4, 4, 4, 5, 6, 7, 11]\nsize = len(arr)\nkey = 4\nprint(f\"First occurrence of {key} is at index {lastOccurrence(arr, size, key)}\")\nprint(f\"Last occurrence of {key} is at index {lastOccurrence(arr, size, key)}\")\n```"
