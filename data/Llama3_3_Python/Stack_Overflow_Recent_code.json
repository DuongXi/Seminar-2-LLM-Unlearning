"```python\n# Import the required libraries\nimport requests\n\n# Define a function to fetch data from the API\ndef fetch_data(url):\n    try:\n        # Send a GET request to the API\n        response = requests.get(url)\n        \n        # Check if the request was successful\n        if response.status_code == 200:\n            # Return the JSON data\n            return response.json()\n        else:\n            # Return None if the request was not successful\n            return None\n    except Exception as e:\n        # Print any exceptions that occur\n        print(f\"An error occurred: {e}\")\n        return None\n\n# Define the Index component\ndef Index(props):\n    # Fetch the data from the API\n    data = fetch_data(\"http://127.0.0.1:8000/api/campaigns\")\n    \n    # Check if the data is not None\n    if data is not None:\n        # Map over the data and return the JSX\n        return (\n            <div>\n                <main>\n                    <h1>Available Campaigns</h1>\n                    {data.map((element) => (\n                        <div key={element.slug}>\n                            <div>\n                                <img src={element.logo} height={120} width={100} alt=\"image\" />\n                            </div>\n                            <div></div>\n                        </div>\n                    ))}\n                </main>\n            </div>\n        )\n    else:\n        # Return a message if the data is None\n        return <div>No data available.</div>\n\n# Export the Index component\nexport default Index\n```"
