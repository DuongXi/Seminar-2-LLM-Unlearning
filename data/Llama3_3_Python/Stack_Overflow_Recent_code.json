"```python\nimport enum\n\nclass LoginType(str, enum.Enum):\n    APPLE = \"APPLE\"\n    GOOGLE = \"GOOGLE\"\n    FACEBOOK = \"FACEBOOK\"\n    PHONE_NUMBER_OTP = \"PHONE_NUMBER_OTP\"\n\nclass LoginDto:\n    def __init__(self):\n        self.phoneNumber = None\n        self.fcmToken = None\n        self.accessToken = None\n        self.loginType = LoginType.PHONE_NUMBER_OTP\n\n    @property\n    def is_phone_number_otp(self):\n        return self.loginType == LoginType.PHONE_NUMBER_OTP\n\n    @property\n    def is_access_token_required(self):\n        return self.loginType in [LoginType.GOOGLE, LoginType.APPLE, LoginType.FACEBOOK]\n\n    @property\n    def is_phone_number_required(self):\n        return self.is_phone_number_otp and not self.phoneNumber\n\n    @property\n    def is_access_token_required(self):\n        return self.is_access_token_required\n\n    @property\n    def is_phone_number_mandatory(self):\n        return self.is_phone_number_required\n\n    @property\n    def is_access_token_mandatory(self):\n        return self.is_access_token_required and not self.accessToken\n\n    def validate(self):\n        if self.is_phone_number_mandatory:\n            self.phoneNumber = self.phoneNumber or raise ValueError(\"Phone number is required\")\n        if self.is_access_token_mandatory:\n            self.accessToken = self.accessToken or raise ValueError(\"Access token is required\")\n\nclass LoginDtoValidator:\n    def __init__(self, dto: LoginDto):\n        self.dto = dto\n\n    @classmethod\n    def from_login_type(cls, login_type: LoginType):\n        dto = LoginDto()\n        dto.loginType = login_type\n        return cls(dto)\n\n    def validate(self):\n        if self.dto.is_phone_number_mandatory:\n            self.dto.phoneNumber = self.dto.phoneNumber or raise ValueError(\"Phone number is required\")\n        if self.dto.is_access_token_mandatory:\n            self.dto.accessToken = self.dto.accessToken or raise ValueError(\"Access token is required\")\n\n# Usage\nlogin_type = LoginType.GOOGLE\nvalidator = LoginDtoValidator.from_login_type(login_type)\nvalidator.validate()\n\nlogin_type = LoginType.PHONE_NUMBER_OTP\nvalidator = LoginDtoValidator.from_login_type(login_type)\ntry:\n    validator.validate()\nexcept ValueError as e:\n    print(e)\n```"
