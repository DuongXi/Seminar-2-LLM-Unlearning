"```python\nserver {\n  listen 80;\n  listen [::]:80;\n  listen 443 ssl http2;\n  listen [::]:443 ssl http2;\n  root /path/to/your/root;\n  ssl_certificate /path/to/your/ssl/certificate;\n  ssl_certificate_key /path/to/your/ssl/certificate/key;\n  server_name crm.mydomain.it;\n\n  location ~ \\.php$ {\n    include fastcgi_params;\n    fastcgi_intercept_errors on;\n    fastcgi_index index.php;\n    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\n    try_files $uri =404;\n    fastcgi_read_timeout 3600;\n    fastcgi_send_timeout 3600;\n    fastcgi_param HTTPS &quot;on&quot;;\n    fastcgi_param SERVER_PORT 443;\n    fastcgi_pass 127.0.0.1:{{php_fpm_port}};\n    fastcgi_param PHP_VALUE &quot;{{php_settings}}&quot;;\n  }\n\n  location ~* (\\.css|\\.js|\\.png|\\.jpg|\\.jpeg|\\.gif|robots\\.txt|\\.ico|\\.woff|\\.woff2|.ttf|\\.svg)$ {\n    add_header Access-Control-Allow-Origin &quot;*&quot;;\n    expires max;\n    access_log off;\n  }\n\n  location /public/ {\n    autoindex off;\n  }\n\n  location / {\n    if (!-e $request_filename){\n      rewrite ^(.*)$ /%1 redirect;\n    }\n    if (!-e $request_filename){\n      rewrite ^(.*)$ /index.php break;\n    }\n    if (!-e $request_filename){\n      rewrite ^/(css|assets|landing|storage|installer|js|custom)/(.*)$ /public/$1/$2 break;\n    }\n  }\n}\n```"
