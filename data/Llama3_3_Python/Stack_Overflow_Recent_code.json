"```python\nimport pandas as pd\n\n# Create a sample dataframe\ndf = pd.DataFrame({\n    'Sites': range(1, 101),\n    'NYears': [1 if i % 2 == 0 else 0 for i in range(100)],\n    'Years': [[1982 + x for x in [0]*i + [1]*j] for i, j in [(10, 2), (20, 3), (30, 4)]]\n})\n\n# Function to find the maximum number of sites sharing at least 5 years\ndef max_shared_sites(df, min_years):\n    # Create a dictionary to store the count of shared years for each site\n    shared_years = {}\n    for site in df['Sites'].unique():\n        site_df = df[df['Sites'] == site]\n        years = site_df['Years'].apply(lambda x: len(set(x)))\n        shared_years[site] = sum([y for y in years if y >= min_years])\n\n    # Find the maximum count of shared years\n    max_count = max(shared_years.values())\n\n    # Return the sites with the maximum count of shared years\n    return [site for site, count in shared_years.items() if count == max_count]\n\n# Test the function\nmin_years = 5\nprint(max_shared_sites(df, min_years))\n```"
