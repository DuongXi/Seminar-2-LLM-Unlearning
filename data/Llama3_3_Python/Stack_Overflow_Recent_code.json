"`.check_dec_parameters <- function(x, sigDig) {\n  if (x == 0) {\n    stop(\"Error: x must be a non-zero value.\")\n  }\n  if (is.infinite(x)) {\n    stop(\"Error: x must not be infinite.\")\n  }\n  if (sigDig <= 0) {\n    stop(\"Error: sigDig must be a positive integer.\")\n  }\n  return(list(x=x, sigDig=sigDig))\n}\n\nceil_dec <- function(x, sigDig=1) {\n  check <- .check_dec_parameters(x, sigDig)\n  if (check sigDig <= 0) {\n    stop(check$sigDig)\n  }\n  sigDig = round(sigDig)\n  mostSig = ceiling(log10(abs(x)))\n  result <- ceiling(x*10^(sigDig-mostSig))*10^(-(sigDig-mostSig))\n  return(result)\n}\n\nfloor_dec <- function(x, sigDig=1) {\n  check <- .check_dec_parameters(x, sigDig)\n  if (check sigDig <= 0) {\n    stop(check$sigDig)\n  }\n  sigDig = round(sigDig)\n  mostSig = ceiling(log10(abs(x)))\n  result <- floor(x*10^(sigDig-mostSig))*10^(-(sigDig-mostSig))\n  return(result)\n}"
