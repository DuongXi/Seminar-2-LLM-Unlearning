"```python\nimport numpy as np\nimport time\nimport matplotlib.pyplot as plt\n\ndef einsum_impl(X, w):\n    return np.einsum('ijk,iljm,lmn->il', w, np.exp(np.einsum('ijk,ljn->ilkn',X,X)), w)\n\ndef matmult_impl(X, w):\n    G = np.zeros((X.shape[2], X.shape[2]))\n    for i in range(X.shape[2]):\n        G[:, i] = np.squeeze(w[:, i, None] @ (np.exp(X[:, :, i].T @ X) @ w[:, None, None]))\n    return G\n\n# Generate random data\nn = 4\nN = 200\nM = 100\nX = 0.1*np.random.rand(M, n, N)\nw = 0.1*np.random.rand(M, N, 1)\n\n# Measure time for einsum implementation\nstart_time = time.time()\nG_einsum = einsum_impl(X, w)\nend_time = time.time()\nprint(f\"Einsum implementation took {end_time - start_time} seconds\")\n\n# Measure time for matmult implementation\nstart_time = time.time()\nG_matmult = matmult_impl(X, w)\nend_time = time.time()\nprint(f\"Matmult implementation took {end_time - start_time} seconds\")\n\n# Test the performance of both implementations\nX = np.repeat(X, 10, axis=0)\nw = np.repeat(w, 10, axis=0)\nstart_time = time.time()\nG_einsum = einsum_impl(X, w)\nend_time = time.time()\nprint(f\"Einsum implementation took {end_time - start_time} seconds\")\n\nstart_time = time.time()\nG_matmult = matmult_impl(X, w)\nend_time = time.time()\nprint(f\"Matmult implementation took {end_time - start_time} seconds\")\n```"
