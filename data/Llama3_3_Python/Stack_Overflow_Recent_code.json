"```python\nimport asyncio\nimport json\nimport unittest\nfrom unittest.mock import patch\nfrom next import render\nfrom next.test.utils import createRequest, createResponse\nfrom your_module import getParticipantsInfo\n\nclass TestHomePage(unittest.IsolatedAsyncioTestCase):\n    @patch('your_module.fetch')\n    async def test_home_page(self, mock_fetch):\n        mock_response = {'json': lambda: json.dumps({'participant1': 'value1', 'participant2': 'value2'})}\n        mock_fetch.return_value = mock_response\n\n        response = await getParticipantsInfo()\n\n        await self.assertEqual(response, {'participant1': 'value1', 'participant2': 'value2'})\n\n    @patch('your_module.fetch')\n    async def test_home_page_render(self, mock_fetch):\n        mock_response = {'json': lambda: json.dumps({'participant1': 'value1', 'participant2': 'value2'})}\n        mock_fetch.return_value = mock_response\n\n        with patch('your_module.getParticipantsInfo', return_value={'participant1': 'value1', 'participant2': 'value2'}):\n            response = createRequest('GET', '/')\n            response.status = 200\n            response.body = json.dumps({'participant1': 'value1', 'participant2': 'value2'})\n\n            await self.assertEqual(await response.json(), {'participant1': 'value1', 'participant2': 'value2'})\n\n            render(response, '/')\n\n            # This should fix the error, as we are rendering the page after the async call\n            # is done, instead of trying to render it while it's still waiting\n            await self.assertEqual(screen.getByTestId('home-page')).toBeDefined()\n\nif __name__ == '__main__':\n    unittest.main()\n```"
