"```python\nimport csv\nimport math\n\ndef split_csv_by_groups(file_path, num_files):\n    with open(file_path, 'r') as file:\n        reader = csv.reader(file)\n        data = list(reader)\n\n    id_counts = {}\n    for row in data:\n        id = row[1]\n        if id not in id_counts:\n            id_counts[id] = 1\n        else:\n            id_counts[id] += 1\n\n    groups = {}\n    for id, count in id_counts.items():\n        group_id = (count - 1) // num_files + 1\n        if group_id not in groups:\n            groups[group_id] = []\n        groups[group_id].append(id)\n\n    for i, group in enumerate(groups.values()):\n        file_name = str(i % num_files + 1).zfill(num_files)\n        with open(f\"{file_name}.csv\", 'w', newline='') as output_file:\n            writer = csv.writer(output_file)\n            for id in group:\n                writer.writerow([data[0][0], id])\n\nsplit_csv_by_groups('input.csv', 3)\n```"
"```python\nimport os\nimport pandas as pd\nimport glob\n\n# Get a list of all csv files in the directory\ncsv_files = glob.glob('*.csv')\n\n# Initialize an empty list to store dataframes\ndfs = []\n\n# For each csv file, read the data and append the filename to the dataframe\nfor file in csv_files:\n    df = pd.read_csv(file)\n    df['File'] = file  # Add a new column 'File' with the filename\n    dfs.append(df)  # Add the dataframe to the list\n\n# Concatenate all dataframes into one\nresult_df = pd.concat(dfs, ignore_index=True)\n\nprint(result_df)\n```"
"import pandas as pd\n\n# Load the Excel file\ndf = pd.read_excel('your_file.xlsx')\n\n# Create a new dataframe with the same data\nnew_df = df.copy()\n\n# Split the data based on column A's value\nfor index, row in new_df.iterrows():\n    if row['A'] == row['B'] == row['C']:\n        new_df.loc[index, 'A'] = f\"{row['A']}{row['B']}{row['C']}\"\n        new_df.loc[index, 'B'] = row['B']\n        new_df.loc[index, 'C'] = row['C']\n        new_df = new_df.drop(index, axis=0)\n\n# Save the new dataframe to an Excel file\nnew_df.to_excel('output.xlsx', index=False)"
"```r\nlibrary(future)\nlibrary(future.utils)\nlibrary(readr)\n\n# Define the number of chunks for each file\nnum_chunks <- 10\n\n# Create a list of files\nfiles <- c(\"df_1.csv\", \"df_2.csv\")\n\n# Define a function to read and filter each file in chunks\nmy_function <- function(file) {\n  library(dplyr)\n  library(plyr)\n  library(readr)\n  \n  filter_df <- function(x, pos) {\n    subset(x, X1 %in% filter_by_df$X1 | X2 %in% filter_by_df$X1)\n  }\n  \n  readr_df <- future_map_dfr(\n    read_csv_chunked(file,\n                     callback = DataFrameCallback$new(filter_df),\n                     progress = FALSE,\n                     chunk_size = num_chunks) %>% \n    as.data.frame() %>% \n    distinct()\n  )\n  return(readr_df)\n}\n\n# Create a future plan with 100 cores\nplan(100)\n\n# Apply the custom function created above to all files in parallel and combine them\ndf <- future_join(\n  map_dfr(\n    future_map(\n      my_function,\n      files\n    ),\n    fun = rbind\n  ),\n  .combine = rbind\n)\n```"
