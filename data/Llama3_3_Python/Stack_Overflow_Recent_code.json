"```python\nimport yaml\n\ntree_str = \"\"\"\n{\n    'trees': [\n        {\n            'tree_idx': 0,\n            'dimensions': (1120, 640),\n            'branches': [\n                'leaves': [\n                    {'geometry': [[0.190673828125, 0.0859375], [0.74609375, 0.1181640625]]},\n                    {'geometry': [[0.1171875, 0.1162109375], [0.8076171875, 0.15625]]}\n                ],\n                'leaves': [\n                    {'geometry': [[0.2197265625, 0.1552734375], [0.7119140625, 0.1943359375]]},\n                    {'geometry': [[0.2060546875, 0.1923828125], [0.730712890625, 0.23046875]]}\n                ]\n            ]\n        }\n    ]\n}\n\"\"\"\n\ntree_dict = yaml.load(tree_str, Loader=yaml.Loader)\n\nleafcount = sum(len(branch['leaves']) for tree in tree_dict['trees'] for branch in tree['branches'] for leaf in branch['leaves'])\n\nleaves = [leaf['geometry'] for tree in tree_dict['trees'] for branch in tree['branches'] for leaf in branch['leaves']]\n\nsumleafwidth = sum(lxmax - lxmin for leaf in leaves for lxmin, lymin, lxmax, lymax in leaf['geometry'])\nsumleafheight = sum(lymax - lymin for leaf in leaves for lxmin, lymin, lxmax, lymax in leaf['geometry'])\n\navgleafwidth = sumleafwidth / leafcount\navgleafheight = sumleafheight / leafcount\n\nprint(\"LEAVES\")\nprint(\"\\tCOUNT:\", leafcount)\nprint(\"\\tAVERAGE WIDTH:\", avgleafwidth)\nprint(\"\\tAVERAGE HEIGHT:\", avgleafheight)\n```"
"```python\ndef hash_func1(item):\n    return hash(item)\n\ndef hash_func2(item):\n    prime = 997\n    return prime - (hash(item) % prime)\n\ndef probing_squence(key, size, prime):\n    h1 = hash_func1(key) % size\n    h2 = hash_func2(key) % size\n    i = 1\n    while True:\n        slot = (h1 + i*h2) % size\n        if self.slots[slot] is None:\n            self.slots[slot] = (key, None)\n            break\n        elif self.slots[slot] != (key, None):\n            i = 1\n            h1 = hash_func1(key) % size\n            h2 = hash_func2(key) % size\n        i += 1\n\nclass DoubleHashingHashMap:\n    def __init__(self, size, prime):\n        self.size = size\n        self.slots = [None] * size\n        self.prime = prime\n\nhashmap = DoubleHashingHashMap(15, 997)\nfor i in range(8):\n    hashmap[str(i)] = i\nprint(\"8 items added.\")\nprint(\"Going into the infinite loop when adding 9th item(which is 8)...\")\nhashmap[str(8)] = 8\nprint(\"This line can't be reached.\")\n```"
"```python\nclass WarehouseSum:\n    def __init__(self):\n        self.wh_units = {}\n\n    def available_units(self, warehouse):\n        if warehouse not in self.wh_units:\n            # You need to connect to your database here\n            # For this example, I'm assuming it's a SQLite database\n            import sqlite3\n            conn = sqlite3.connect('your_database.db')\n            c = conn.cursor()\n            c.execute(\"SELECT sum(units) as tot_units FROM warehouse WHERE warehouse = ?\", (warehouse,))\n            row = c.fetchone()\n            conn.close()\n            self.wh_units[warehouse] = row[0]\n        return self.wh_units[warehouse]\n```"
