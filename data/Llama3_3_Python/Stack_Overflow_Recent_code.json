"```perl\n# Create a temporary page to show while waiting for the response\nsub show_temporary_page {\n    my $self = shift;\n    my $response = $self->response;\n    $response->header('Content-Type' => 'text/html');\n    $response->body('<html><body><h1>Loading...</h1></body></html>');\n    return $response;\n}\n\n# Check if the async call is ready via Ajax\nsub check_async_ready {\n    my $self = shift;\n    my $response = $self->response;\n    $response->header('Content-Type' => 'text/html');\n    $response->body('<html><body><h1>Loading...</h1><script>var ready = function(){');\n    $response->body('  console.log(\"Async call is ready\");');\n    $response->body('  $.ajax({ async: true, url: \"/async\", success: function() {');\n    $response->body('    window.location.href = \"/\";');\n    $response->body('  }});');\n    $response->body('};</script></body></html>');\n    return $response;\n}\n\n# Example async call using Minion\nsub async_example {\n    my $self = shift;\n    my $minion = $self->minion;\n    $minion->async(sub {\n        my $result = 10;\n        $minion->post('/async', { result => $result });\n    });\n}\n\n# Main application\nsub example {\n    my $self = shift;\n    my $response = $self->response;\n    $response->header('Content-Type' => 'text/html');\n    $response->body('<html><body><h1>Hello World!</h1></body></html>');\n    return $response;\n}\n\n# Route to show temporary page\nget '/temp' => sub {\n    my $self = shift;\n    $self->show_temporary_page;\n};\n\n# Route to check async call\npost '/async' => sub {\n    my $self = shift;\n    $self->check_async_ready;\n};\n\n# Route to run async example\npost '/async_example' => sub {\n    my $self = shift;\n    $self->async_example;\n};\n\n# Run the application\nmy $app = Mojolicious::App->new->start;\n```"
