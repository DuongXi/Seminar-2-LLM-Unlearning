"```python\nimport cv2\nimport numpy as np\n\ndef save_webp_image(image_path, output_path, quality=75):\n    \"\"\"\n    Save an image as a webp file.\n\n    Args:\n    image_path (str): Path to the input image.\n    output_path (str): Path to save the output image.\n    quality (int, optional): Quality level of the output image. Defaults to 75.\n    \"\"\"\n    # Read the image using OpenCV\n    image = cv2.imread(image_path)\n\n    # Convert the image to BGR format (required for OpenCV)\n    image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)\n\n    # Save the image as a webp file with the specified quality\n    cv2.imwrite(output_path, image, [int(cv2.IMWRITE_WEBP_QUALITY), quality])\n\n# Example usage\nimage_path = \"input_image.jpg\"\noutput_path = \"output.webp\"\nsave_webp_image(image_path, output_path)\n```"
