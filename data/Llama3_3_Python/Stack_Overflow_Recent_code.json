"```javascript\n// In your next-auth options\nimport { NextAuthOptions } from 'next-auth';\n\nconst options: NextAuthOptions = {\n  // Your Google OAuth provider options\n  providers: [\n    GoogleProvider({\n      clientId: process.env.GOOGLE_CLIENT_ID,\n      clientSecret: process.env.GOOGLE_CLIENT_SECRET,\n      // Use your custom access and refresh tokens\n      callbacks: {\n        async token(user, account, profile) {\n          return {\n            ...user,\n            accessToken: process.env.ACCESS_TOKEN,\n            refreshToken: process.env.REFRESH_TOKEN,\n          };\n        },\n        async session(session, token) {\n          session.accessToken = token.accessToken;\n          session.refreshToken = token.refreshToken;\n          return session;\n        },\n      },\n    }),\n  ],\n  // Configure JWT tokens to be used for sessions\n  jwt: {\n    secret: process.env.JWT_SECRET,\n    encodingType: 'HS256',\n  },\n  // Configure the refresh token to be used for sessions\n  refreshTokens: {\n    class: 'Postgres',\n    // Store refresh tokens in the database\n    async store(token, user) {\n      const refreshToken = token.refreshToken;\n      // Store the refresh token in your database\n      await storeRefreshToken(user, refreshToken);\n      return token;\n    },\n  },\n};\n\n// In your next-auth options to refresh the access token every 10 minutes\nimport { NextAuthRequest, NextAuthResponse } from 'next-auth';\n\nconst refreshAccessToken = async (req: NextAuthRequest, res: NextAuthResponse) => {\n  const now = Date.now();\n  const accessTokenExpirationDate = process.env.ACCESS_TOKEN_EXPIRATION_DATE;\n  const refreshToken = req.cookies.refreshToken;\n\n  if (!refreshToken) {\n    return res.status(401).json({ error: 'No refresh token provided' });\n  }\n\n  const accessTokens = await getAccessTokensForRefreshToken(refreshToken);\n\n  if (!accessTokens || accessTokens.length === 0) {\n    return res.status(401).json({ error: 'Invalid refresh toke