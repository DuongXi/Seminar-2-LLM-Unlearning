"import pandas as pd\nimport glob\n\n# Load videodata\nvideodata = pd.read_csv('videodata.csv')\n\n# Load id_data for all participants\nall_ids = ['012', '013', '014']\nall_data = {}\nfor id in all_ids:\n    data = pd.read_csv(f'{id}_data.csv')\n    all_data[id] = data\n\n# Function to slice data for a given participant\ndef slice_data(participant_id, event_type):\n    # Get start and end rows from videodata\n    start_row = int(videodata.loc[videodata['Event.Type'] == event_type, 'Row'].min())\n    end_row = int(videodata.loc[videodata['Event.Type'] == event_type, 'Row'].max())\n    \n    # Slice data for the given participant\n    data = all_data[participant_id]\n    sliced_data = data.loc[start_row-1:end_row, 'score']\n    \n    # Save sliced data to a file\n    file_name = f'{event_type}_{participant_id}.csv'\n    sliced_data.to_csv(file_name, index=False, header=[participant_id])\n\n# Slice data for all participants and event types\nfor event_type in videodata['Event.Type'].unique():\n    for participant_id in all_ids:\n        slice_data(participant_id, event_type)"
