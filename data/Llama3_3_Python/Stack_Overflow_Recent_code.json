"```python\nimport shapely.geometry as sg\nfrom shapely.validation import validate, shape\n\ndef check_shacl_constraint():\n    # Define the shapes\n    ex:valueIfExists = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:optionalValue': {\n                'type': 'object',\n                'properties': {\n                    'ex:is': {\n                        'type': 'string',\n                        'enum': ['ok']\n                    }\n                },\n                'required': ['ex:is']\n            }\n        },\n        'additionalProperties': False\n    })\n\n    ex:mainShape = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:valueIfExists': ex:valueIfExists\n        },\n        'additionalProperties': False\n    })\n\n    # Test data\n    ex:Test_OK_nothing = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:valueIfExists': None\n        },\n        'additionalProperties': False\n    })\n\n    ex:Test_OK_1 = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:valueIfExists': {\n                'type': 'object',\n                'properties': {\n                    'ex:is': {\n                        'type': 'string',\n                        'enum': ['ok']\n                    }\n                },\n                'required': ['ex:is']\n            }\n        },\n        'additionalProperties': False\n    })\n\n    ex:Test_OK_1_2 = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:valueIfExists': [\n                {'ex:is': 'ok'},\n                {'ex:is': 'other 1'},\n                {'ex:is': 'other 2'}\n            ]\n        },\n        'additionalProperties': False\n    })\n\n    ex:Test_Not_OK = sg.Shape({\n        'type': 'object',\n        'properties': {\n            'ex:valueIfExists': [\n                {'ex:is': 'other 1'},\n                {'ex:is': 'other 2'}\n            ]\n        },\n        'additionalProperties': False\n    })\n\n    # Validate the shapes\n    results = {\n        'ex:valueIfExists': validate(ex:valueIfExists, shape=ex:mainShape),\n        'ex:mainShape': validate(ex:mainShape, shape=ex:mainShape)\n    }\n    results['ex:Test_OK_nothing'] = validate(ex:Test_OK_nothing, shape=ex:mainShape)\n    results['ex:Test_OK_1'] = validate(ex:Test_OK_1, shape=ex:mainShape)\n    results['ex:Test_OK_1_2'] = validate(ex:Test_OK_1_2, shape=ex:mainShape)\n    results['ex:Test_Not_OK'] = validate(ex:Test_Not_OK, shape=ex:mainShape)\n\n    return results\n\nprint(check_shacl_constraint())\n```"
