"```python\nfrom clerk import Clerk\n\n# Initialize Clerk instance\nclerk = Clerk()\n\n# Define a function to handle sign up\n@clerk.route('/sign_up', methods=['GET', 'POST'])\ndef sign_up():\n    # This route will always redirect to login\n    return clerk.redirect('/login')\n\n# Define a function to handle login\n@clerk.route('/login', methods=['GET', 'POST'])\ndef login():\n    # Handle login logic here\n    # If user is already signed in, redirect to dashboard\n    if clerk.user_signed_in():\n        return clerk.redirect('/dashboard')\n    # If user signs up, redirect to sign up form\n    elif request.method == 'POST':\n        return clerk.redirect('/sign_up')\n    # Otherwise, handle login form submission\n    else:\n        # Handle form submission logic here\n        pass\n\n# Define a function to handle sign out\n@clerk.route('/sign_out', methods=['POST'])\ndef sign_out():\n    # Handle sign out logic here\n    clerk.user_signed_out()\n    return clerk.redirect('/')\n```"
