"```python\nimport unittest\nfrom unittest.mock import patch, MagicMock\nfrom pulumi import run_err\n\ndef create_my_custom_role(ctx, name, oidc_provider):\n    role = None\n    component_urn = f\"{name}-custom-role\"\n    err = ctx.register_component_resource(component_urn, role, oidc_provider)\n    if err:\n        return None, err\n\n    url = oidc_provider.url.apply(lambda s: s.replace(\"https://\", \"\").replace(\":sub\", \":sub\"))\n    assume_role_policy = {\n        \"Version\": \"2012-10-17\",\n        \"Statement\": [\n            {\n                \"Effect\": \"Allow\",\n                \"Principal\": {\"Federated\": \"\"},\n                \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n                \"Condition\": {\n                    \"StringEquals\": {\n                        \"someurl:sub\": [\n                            \"system:serviceaccount:kube-system:*\",\n                            \"system:serviceaccount:kube-system:cluster-autoscaler\"\n                        ]\n                    }\n                }\n            }\n        ]\n    }\n\n    role_urn = f\"{name}-custom-role\"\n    role, err = iam.Role.create(ctx, role_urn, {\n        \"Name\": role_urn,\n        \"Description\": \"Create Custom Role\",\n        \"AssumeRolePolicy\": assume_role_policy,\n        \"Tags\": {\"project\": \"test\"}\n    })\n    if err:\n        return None, err\n\n    return role, None\n\nclass TestCreateMyCustomRole(unittest.TestCase):\n    @patch('pulumi.runtime.get_resource')\n    def test_create_my_custom_role(self, mock_get_resource):\n        mock_resource = MagicMock()\n        mock_resource.return_value = {\n            'arn': 'arn:aws:iam::123:oidc-provider/oidc.eks.us-west-2.amazonaws.com/id/abc',\n            'id': 'abc',\n            'url': 'https://someurl'\n        }\n        mock_get_resource.return_value = mock_resource\n\n        err = run_err(create_my_custom_role, 'test', 'oidc-provider', opts=['--resource-name', 'test'])\n        self.assertIsNone(err)\n\n        role, err = create_my_custom_role('test', 'oidc-provider', 'oidc-provider')\n        self.assertIsNone(err)\n\n        # Check Assume Role Policy is formatted correctly\n        assume_role_policy = role.assume_role_policy.apply(lambda p: p.replace('https://', '').replace(':sub', ':sub'))\n        assert assume_role_policy == {\n            \"Version\": \"2012-10-17\",\n            \"Statement\": [\n                {\n                    \"Effect\": \"Allow\",\n                    \"Principal\": {\"Federated\": \"\"},\n                    \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n                    \"Condition\": {\n                        \"StringEquals\": {\n                            \"someurl:sub\": [\n                                \"system:serviceaccount:kube-system:*\",\n                                \"system:serviceaccount:kube-system:cluster-autoscaler\"\n                            ]\n                        }\n                    }\n                }\n            ]\n        }\n```"
