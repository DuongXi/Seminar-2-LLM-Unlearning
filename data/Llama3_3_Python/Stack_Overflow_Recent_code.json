"```csharp\nusing System;\nusing System.Net.Http;\nusing System.Threading;\nusing System.Threading.Tasks;\n\npublic class CustomHttpClient : HttpClient\n{\n    private readonly TimeSpan _connectTimeout;\n    private readonly TimeSpan _responseTimeout;\n\n    public CustomHttpClient(TimeSpan connectTimeout, TimeSpan responseTimeout)\n    {\n        _connectTimeout = connectTimeout;\n        _responseTimeout = responseTimeout;\n    }\n\n    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)\n    {\n        try\n        {\n            var connectTimeout = TimeSpan.FromMilliseconds(_connectTimeout.TotalMilliseconds);\n            var response = await SendAsync(request, cancellationToken);\n\n            if (response.RequestAborted)\n            {\n                throw new TaskCanceledException();\n            }\n\n            var responseTimeout = TimeSpan.FromMilliseconds(_responseTimeout.TotalMilliseconds);\n            await Task.Delay(responseTimeout - response.Content.Headers.ContentLength.Value, cancellationToken);\n\n            return response;\n        }\n        catch (TaskCanceledException)\n        {\n            return null;\n        }\n        catch (HttpRequestException ex)\n        {\n            throw;\n        }\n    }\n}\n\npublic class Program\n{\n    public static async Task Main()\n    {\n        var client = new CustomHttpClient(TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10));\n\n        var response = await client.GetAsync(\"https://example.com\");\n\n        if (response == null)\n        {\n            Console.WriteLine(\"Request cancelled\");\n        }\n        else\n        {\n            Console.WriteLine(\"Request completed successfully\");\n        }\n    }\n}\n```"
