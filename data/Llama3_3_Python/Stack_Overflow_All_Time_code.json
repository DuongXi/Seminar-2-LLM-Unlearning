"```python\nimport mysql.connector\nimport csv\n\ndef mysql_to_csv(host, database, user, password, query):\n    try:\n        cnx = mysql.connector.connect(\n            user=user,\n            password=password,\n            host=host,\n            database=database\n        )\n        cursor = cnx.cursor()\n        cursor.execute(query)\n        results = cursor.fetchall()\n        column_names = [desc[0] for desc in cursor.description]\n        with open('output.csv', 'w', newline='') as file:\n            writer = csv.writer(file)\n            writer.writerow(column_names)\n            writer.writerows(results)\n        cnx.close()\n    except mysql.connector.Error as err:\n        print(f\"Error: {err}\")\n\n# Example usage\nmysql_to_csv('localhost', 'dbname', 'uid', 'pwd', \"SELECT id, name FROM students\")\n```"
"```python\nimport psycopg2\n\ndef save_to_csv(host, database, username, password, query, filename):\n    conn = psycopg2.connect(\n        host=host,\n        database=database,\n        user=username,\n        password=password\n    )\n    cur = conn.cursor()\n    cur.execute(query)\n    rows = cur.fetchall()\n    with open(filename, 'w', newline='') as csvfile:\n        writer = csv.writer(csvfile)\n        writer.writerows(rows)\n    conn.close()\n\n# Example usage:\nquery = \"SELECT * FROM your_table\"\nfilename = 'output.csv'\nsave_to_csv('localhost', 'your_database', 'your_username', 'your_password', query, filename)\n```"
