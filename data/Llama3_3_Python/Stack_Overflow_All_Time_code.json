urn sum(new_board[i][y] for i in range(len(new_board)) if new_board[i][y] != 0)\n    elif direction == \"left\":\n        new_board = [row[:] for row in board]\n        new_board[x][y] = 0\n        new_board[x][y-1] = new_board[x][y]\n        new_board[x][y-1] = 0\n        for i in range(x):\n            if new_board[i][y] == new_board[i+1][y]:\n                new_board[i][y] *= 2\n                new_board[i+1][y] = 0\n        return sum(new_board[i][y] for i in range(len(new_board)) if new_board[i][y] != 0)\n    elif direction == \"right\":\n        new_board = [row[:] for row in board]\n        new_board[x][y] = 0\n        new_board[x][y+1] = new_board[x][y]\n        new_board[x][y+1] = 0\n        for i in range(x):\n            if new_board[i][y] == new_board[i+1][y]:\n                new_board[i][y] *= 2\n                new_board[i+1][y] = 0\n        return sum(new_board[i][y] for i in range(len(new_board)) if new_board[i][y] != 0)\n\ndef best_move(board):\n    best_move = None\n    best_score = -float(\"inf\")\n    for i in range(len(board)):\n        for j in range(len(board[0])):\n            if board[i][j] != 0:\n                for direction in [\"up\", \"down\", \"left\", \"right\"]:\n                    if is_valid_move(board, i, j, direction):\n                        score = count_merges(board, i, j, direction)\n                        if score > best_score:\n                            best_score = score\n                            best_move = (i, j, direction)\n    return best_move\n\ndef play_game():\n    board = [[0]*4 for _ in range(4)]\n    new_tile = random.choice([2, 4])\n    while True:\n        print_board(board)\n        move = input(\"Enter your move (up, down, left, right): \")\n        new_i, new_j = 0, 0\n        if move == \"up\":\n            new_i = 0\n        elif move == \"down\":\n            new_i = len(board) - 1\n        elif move == \"left\":\n            new_j = 0\n        elif move == \"right\":\n            new_j = len(board[0]) - 1\n        for i in range(len(board)):\n            for j in range(len(board[0])):\n                if board[i][j] != 0 and (i == new_i and j == new_j) or (i == new_i and j == new_j - 1 and board[i][j] == 2) or (i == new_i and j == new_j + 1 and board[i][j] == 4):\n                    board[i][j] = 0\n        board[new_i][new_j] = new_tile\n        new_tile = random.choice([2, 4])\n        if new_tile == 2048:\n            print_board(board)\n            print(\"You won!\")\n            break\n\nplay_game()\n```"
