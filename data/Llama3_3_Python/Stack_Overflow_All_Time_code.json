"import org.ksoap2.KSoap2;\nimport org.ksoap2.SoapEnvelope;\nimport org.ksoap2.SoapObject;\nimport org.ksoap2.SoapFault;\nimport org.ksoap2.transport.HttpTransport;\n\nimport android.util.Log;\n\npublic class SoapServiceClient {\n    private String url;\n    private KSoap2 soap;\n\n    public SoapServiceClient(String url) {\n        this.url = url;\n        soap = KSoap2.CreateSoapFromWSDL(url);\n    }\n\n    public String callMethod(String methodName, Object... params) {\n        SoapObject request = new SoapObject(soap);\n        for (int i = 0; i < params.length; i++) {\n            request.addProperty(i, params[i]);\n        }\n\n        SoapObject response = (SoapObject) soap.call(request, methodName);\n        return response.getProperty(0).toString();\n    }\n}"
