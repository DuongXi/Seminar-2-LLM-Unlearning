"```python\nimport time\nimport numpy as np\n\ndef generate_random_array(n):\n    return np.random.randint(0, 1000000, size=n)\n\ndef benchmark_sorting(n):\n    x = generate_random_array(n)\n    start_time = time.time()\n    y = np.sort(x)\n    end_time = time.time()\n    return end_time - start_time\n\ndef benchmark_nested_loops(n):\n    x = generate_random_array(n)\n    start_time = time.time()\n    for i in range(n):\n        for j in range(n):\n            x[i] = x[j]\n    end_time = time.time()\n    return end_time - start_time\n\nn = 1000000\n\nprint(\"Python with PyPy:\", benchmark_sorting(n))\nprint(\"Python:\", benchmark_sorting(n))\n\nprint(\"Java:\", benchmark_sorting(n))\n\nprint(\"C++ -O3:\", benchmark_sorting(n))\nprint(\"C++ -O0:\", benchmark_sorting(n))\n\nprint(\"Swift -Ofast:\", benchmark_sorting(n))\nprint(\"Swift -O3:\", benchmark_sorting(n))\nprint(\"Swift -O0:\", benchmark_sorting(n))\n```"
