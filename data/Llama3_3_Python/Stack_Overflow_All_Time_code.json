"```python\nimport time\nimport random\n\ndef test_if_else(n):\n    a = random.randint(1, n)\n    start_time = time.time()\n    if a == 1:\n        pass\n    elif a == 2:\n        pass\n    elif a == 3:\n        pass\n    elif a == 4:\n        pass\n    else:\n        pass\n    end_time = time.time()\n    return end_time - start_time\n\ndef test_switch(n):\n    a = random.randint(1, n)\n    start_time = time.time()\n    if a == 1:\n        pass\n    elif a == 2:\n        pass\n    elif a == 3:\n        pass\n    elif a == 4:\n        pass\n    else:\n        pass\n    end_time = time.time()\n    return end_time - start_time\n\nn = 1000000\nif_time = test_if_else(n)\nswitch_time = test_switch(n)\nprint(f\"if/else time: {if_time} seconds\")\nprint(f\"switch time: {switch_time} seconds\")\n\nif if_time < switch_time:\n    print(\"Using if/else statements is faster\")\nelif if_time > switch_time:\n    print(\"Using switch statements is faster\")\nelse:\n    print(\"Both if/else and switch statements have the same performance\")\n```"
