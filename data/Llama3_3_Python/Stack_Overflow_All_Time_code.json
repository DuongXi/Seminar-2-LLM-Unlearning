"```python\nimport subprocess\nimport json\n\ndef get_k8s_logs(replication_controller, namespace='default'):\n    # Run kubectl logs command with --all-namespaces flag to get logs from all pods\n    command = f\"kubectl logs -f --all-namespaces -n {namespace} --selector=replicationcontroller={replication_controller}\"\n    output = subprocess.check_output(command, shell=True).decode('utf-8')\n\n    # Parse JSON output\n    logs = json.loads(output)\n\n    # Extract logs from all containers\n    aggregated_logs = {}\n    for log in logs['items']:\n        container_name = log['metadata']['name']\n        container_logs = log['status']['containerStatuses'][0]['message']\n        aggregated_logs[container_name] = container_logs\n\n    return aggregated_logs\n\n# Example usage:\nreplication_controller = 'my-replication-controller'\nnamespace = 'default'\nlogs = get_k8s_logs(replication_controller, namespace)\nfor container, log in logs.items():\n    print(f\"Container: {container}\")\n    print(f\"Log: {log}\")\n    print(\"--------\")\n```\n\nThis script uses the `subprocess` module to run the `kubectl logs` command with the `--all-namespaces` flag to get logs from all pods, and then parses the JSON output to extract logs from all containers. The result is a dictionary where the keys are the container names and the values are the aggregated logs."
"```python\nfrom kubernetes import client, config\n\n# Load Kubernetes configuration from default location (~/.kube/config)\nconfig.load_kube_config()\n\n# Create a Kubernetes client\nv1 = client.CoreV1Api()\n\n# Define the job name\njob_name = \"your-scheduled-job-name\"\n\n# Define the schedule\nschedule = \"0 0 * * *\"\n\n# Define the job object to trigger manually\ntrigger_job = client.V1Job(\n    api_version=\"batch/v1\",\n    kind=\"Job\",\n    metadata=client.V1ObjectMeta(name=job_name),\n    spec=client.V1JobSpec(\n        template=client.V1PodTemplateSpec(\n            metadata=client.V1ObjectMeta(labels={\"app\": \"your-scheduled-job\"}),\n            spec=client.V1PodSpec(containers=[client.V1Container(name=\"your-scheduled-job\")])\n        ),\n        backoff_limit=4,\n        schedule=schedule,\n        jobTemplate=client.V1JobTemplateSpec(\n            spec=client.V1PodTemplateSpec(\n                metadata=client.V1ObjectMeta(labels={\"app\": \"your-scheduled-job\"}),\n                spec=client.V1PodSpec(containers=[client.V1Container(name=\"your-scheduled-job\")])\n            )\n        )\n    )\n)\n\n# Trigger the job manually\nv1.create_namespaced_job(namespace=\"default\", body=trigger_job)\n```"
"```python\nfrom kubernetes import client, config\n\n# Load the Kubernetes configuration from the default location (~/.kube/config)\nconfig.load_kube_config()\n\n# Create a Kubernetes client\nv1 = client.CoreV1Api()\n\n# Define a deployment that keeps the container running\ndeployment = client.V1Deployment(\n    metadata=client.V1ObjectMeta(name=\"test_container\"),\n    spec=client.V1DeploymentSpec(\n        replicas=1,\n        selector=client.V1LabelSelector(match_labels={\"app\": \"test_container\"}),\n        template=client.V1PodTemplateSpec(\n            metadata=client.V1ObjectMeta(labels={\"app\": \"test_container\"}),\n            spec=client.V1PodSpec(\n                containers=[client.V1Container(\n                    name=\"test_container\",\n                    image=\"ubuntu:latest\",\n                    command=[\"/bin/bash\"],\n                    tty=True\n                )]\n            )\n        )\n    )\n)\n\n# Create the deployment\nv1.create_namespaced_deployment(namespace=\"default\", body=deployment)\n\n# Define a deployment strategy that keeps the container running\ndeployment_strategy = client.V1DeploymentStrategy(\n    type=\"Recreate\"\n)\n\n# Update the deployment with the strategy\nv1.update_namespaced_deployment(namespace=\"default\", name=\"test_container\", body=client.V1Deployment(body=deployment, strategy=deployment_strategy))\n\n# Define a ReplicaSet that keeps the container running\nreplica_set = client.V1ReplicaSet(\n    metadata=client.V1ObjectMeta(name=\"test_container\"),\n    spec=client.V1ReplicaSetSpec(\n        selector=client.V1LabelSelector(match_labels={\"app\": \"test_container\"}),\n        template=client.V1PodTemplateSpec(\n            metadata=client.V1ObjectMeta(labels={\"app\": \"test_container\"}),\n            spec=client.V1PodSpec(\n                containers=[client.V1Container(\n                    name=\"test_container\",\n                    image=\"ubuntu:latest\",\n                    command=[\"/bin/bash\"],\n                    tty=True\n                )]\n            )\n        ),\n        replicas=1\n    )\n)\n\n# Create the ReplicaSet\nv1.create_namespaced_replica_set(namespace=\"default\", body=replica_set)\n\n# Define a Service that exposes the container\nservice = client.V1Service(\n    metadata=client.V1ObjectMeta(name=\"test_container\"),\n    spec=client.V1ServiceSpec(\n        selector=client.V1LabelSelector(match_labels={\"app\": \"test_container\"}),\n        ports=[client.V1ServicePort(port=22, protocol=\"TCP\")]\n    )\n)\n\n# Create the Service\nv1.create_namespaced_service(namespace=\"default\", body=service)\n```"
"```python\nimport subprocess\n\ndef delete_pod(namespace, pod_name):\n    try:\n        subprocess.check_call(['kubectl', 'delete', 'pod', pod_name, '--namespace=' + namespace, '--grace-period=0'])\n    except subprocess.CalledProcessError as e:\n        print(f\"Failed to delete pod {pod_name}: {e}\")\n\n# Usage\nnamespace = 'default'\npod_name = 'busybox-c9rnx'\ndelete_pod(namespace, pod_name)\n```"
