"from datetime import datetime\nimport os\n\ndef get_file_info(file_path):\n    file_stats = os.stat(file_path)\n    return {\n        'creation_time': datetime.fromtimestamp(file_stats.st_ctime),\n        'modification_time': datetime.fromtimestamp(file_stats.st_mtime)\n    }\n\nfile_path = 'path_to_your_file.txt'\nfile_info = get_file_info(file_path)\nprint(f\"Creation time: {file_info['creation_time']}\")\nprint(f\"Modification time: {file_info['modification_time']}\")"
"```python\nimport os\n\ndef remove_symlink(link):\n    if os.path.islink(link):\n        os.remove(link)\n    else:\n        print(f\"The path '{link}' is not a symlink.\")\n\ndef remove_symlink_directory(link):\n    try:\n        os.rmdir(link)\n    except OSError as e:\n        if e.errno == 13:  # Directory not empty\n            print(f\"Cannot remove directory '{link}' because it is not empty.\")\n        else:\n            print(f\"An error occurred: {e}\")\n\n# Usage\nremove_symlink(\"path_to_your_symlink\")\nremove_symlink_directory(\"path_to_your_symlink\")\n```"
