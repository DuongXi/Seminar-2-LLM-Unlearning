"```python\nclass APIError(Exception):\n    def __init__(self, status_code, error_message):\n        self.status_code = status_code\n        self.error_message = error_message\n\nclass StorageQuotaError(APIError):\n    def __init__(self):\n        super().__init__(400, \"Storage quota exceeded\")\n\nclass InvalidRequestError(APIError):\n    def __init__(self):\n        super().__init__(400, \"Invalid request\")\n\ndef handle_error(error):\n    if isinstance(error, StorageQuotaError):\n        return {\"error\": error.error_message}\n    elif isinstance(error, InvalidRequestError):\n        return {\"error\": error.error_message}\n    else:\n        return {\"error\": \"Unknown error\"}\n\n# Example usage:\nerror = StorageQuotaError()\nprint(handle_error(error))  # Output: {'error': 'Storage quota exceeded'}\n\nerror = InvalidRequestError()\nprint(handle_error(error))  # Output: {'error': 'Invalid request'}\n\nclass ResourceAPI:\n    def add_resource(self, data):\n        # Simulate storage quota check\n        if data[\"storage_quota\"] > 100:\n            raise StorageQuotaError()\n        # Add resource logic here\n        return {\"message\": \"Resource added successfully\"}\n\n    def validate_request(self, data):\n        # Simulate invalid request check\n        if not data[\"required_field\"]:\n            raise InvalidRequestError()\n        # Validate request logic here\n        return {\"message\": \"Request validated successfully\"}\n\n# Example usage:\napi = ResourceAPI()\ntry:\n    result = api.add_resource({\"storage_quota\": 50, \"data\": \"example\"})\n    print(result)  # Output: {'message': 'Resource added successfully'}\nexcept StorageQuotaError as e:\n    print(handle_error(e))  # Output: {'error': 'Storage quota exceeded'}\n\ntry:\n    result = api.validate_request({\"required_field\": False, \"data\": \"example\"})\n    print(result)  # Output: {'message': 'Request validated successfully'}\nexcept InvalidRequestError as e:\n    print(handle_error(e))  # Output: {'error': 'Invalid request'}\n```"
"### Understanding REST: Verbs, error codes, and authentication\n\n#### 1. Correct Representation of RESTful Architecture\n```python\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\nusers = [\n    {\"id\": 1, \"name\": \"John Doe\"},\n    {\"id\": 2, \"name\": \"Jane Doe\"}\n]\n\n@app.route('/api/users', methods=['GET'])\ndef get_users():\n    return jsonify(users)\n\n@app.route('/api/users', methods=['POST'])\ndef create_user():\n    new_user = {\n        \"id\": len(users) + 1,\n        \"name\": request.json[\"name\"]\n    }\n    users.append(new_user)\n    return jsonify(new_user), 201\n\n@app.route('/api/users/<int:user_id>', methods=['GET'])\ndef get_user(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    return jsonify(user)\n\n@app.route('/api/users/<int:user_id>', methods=['PUT'])\ndef update_user(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    user[\"name\"] = request.json[\"name\"]\n    return jsonify(user)\n\n@app.route('/api/users/<int:user_id>', methods=['DELETE'])\ndef delete_user(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    users.remove(user)\n    return jsonify({\"message\": \"User deleted\"})\n\n@app.route('/api/users/<int:user_id>/activate_login', methods=['PUT'])\ndef activate_login(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    user[\"active_login\"] = True\n    return jsonify(user)\n\n@app.route('/api/users/<int:user_id>/deactivate_login', methods=['PUT'])\ndef deactivate_login(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    user[\"active_login\"] = False\n    return jsonify(user)\n\n@app.route('/api/users/<int:user_id>/change_password', methods=['PUT'])\ndef change_password(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    user[\"password\"] = request.json[\"new_password\"]\n    return jsonify(user)\n\n@app.route('/api/users/<int:user_id>/add_credit', methods=['PUT'])\ndef add_credit(user_id):\n    user = next((user for user in users if user[\"id\"] == user_id), None)\n    if user is None:\n        return jsonify({\"error\": \"User not found\"}), 404\n    user[\"credit\"] += request.json[\"amount\"]\n    return jsonify(user)\n```\n\n#### 2. Expressing Actions in RESTful URL Architecture\n```python\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\n# ...\n\n@app.route('/api/users/<int:user_id>/activate_login', methods=['PUT'])\ndef activate_login(user_id):\n    # ...\n```\n\n#### 3. Returning Error Messages and Codes\n```python\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\n# ...\n\n@app.route('/api/users/<int:user_id>/activate_login', methods=['PUT'])\ndef activate_login(user_id):\n    try:\n        # ...\n        return jsonify({\"message\": \"User activated successfully\"}), 200\n    except Exception as e:\n        return jsonify({\"error\": str(e)}), 500\n```\n\n#### 4. Authentication\n```python\nfrom flask import Flask, request, jsonify\nfrom flask_httpauth import HTTPBasicAuth\n\napp = Flask(__name__)\n\nauth = HTTPBasicAuth()\n\nusers = {\n    \"admin\": \"password\"\n}\n\n@auth.verify_password\ndef verify_password(username, password):\n    if username in users and users.get(username) == password:\n        return True\n    return False\n\n# ...\n\n@app.route('/api/users/<int:user_id>/activate_login', methods=['PUT'])\n@auth.login_required\ndef activate_login(user_id):\n    # ...\n```"
