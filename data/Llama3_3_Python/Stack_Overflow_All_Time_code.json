"from django.db import models\nfrom django.core.mail import send_mail\nfrom django.conf import settings\n\nclass User(models.Model):\n    name = models.CharField(max_length=255)\n    email = models.EmailField()\n\n    @classmethod\n    def get_present_name(cls, uid):\n        return remote_api.request_user_name(uid) or 'Anonymous'\n\n    @classmethod\n    def activate(cls, user):\n        user.status = 'activated'\n        user.save()\n        send_mail('Your account is activated!', '\u2026', [user.email])\n\ndef create_user(name, email):\n    user = User(name=name, email=email)\n    user.save()\n    # API call to another service\n    remote_api.create_user(user.uid)\n\ndef activate_user(user):\n    User.activate(user)\n    # send message to user\n    send_mail('Your account is activated!', '\u2026', [user.email])"
