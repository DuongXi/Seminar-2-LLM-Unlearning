"```xml\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<ResourceDictionary xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n                    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n                    xmlns:pack=\"http://xaml.schemas.microsoft.com/winfx/2006/xaml/presentation\"\n                    xmlns:local=\"clr-namespace:YourAssemblyName\">\n\n    <pack:ResourceDictionary.MergedDictionaries>\n        <pack:ResourceDictionary Source=\"MenuTemplate.xaml\"/>\n        <pack:ResourceDictionary Source=\"ButtonTemplate.xaml\"/>\n        <!-- Add more resource dictionaries here -->\n    </pack:ResourceDictionary.MergedDictionaries>\n</ResourceDictionary>\n```\n\n```csharp\nusing System.Windows;\nusing System.Windows.Resources;\n\nnamespace YourAssemblyName\n{\n    public partial class App : Application\n    {\n        public App()\n        {\n            InitializeComponent();\n            this.Resources.MergedDictionaries.Add(new ResourceDictionary { Source = new PackUri(\"MenuTemplate.xaml\", UriKind.RelativeOrAbsolute) });\n            this.Resources.MergedDictionaries.Add(new ResourceDictionary { Source = new PackUri(\"ButtonTemplate.xaml\", UriKind.RelativeOrAbsolute) });\n            // Add more resource dictionaries here\n        }\n    }\n}\n```"
"```python\nimport sys\nfrom System.Windows import *\nfrom System.Windows.Controls import *\n\nclass selectable_textblock(UserControl):\n    def __init__(self):\n        super(selectable_textblock, self).__init__()\n        self.Content = TextBlock()\n\n    def LoadContent(self, owner):\n        self.Content.LoadComponent(owner)\n        self.Content.IsReadOnly = False\n        self.Content.IsMultiline = True\n\nclass App.xaml:\n    def OnInitialized(self, sender, args):\n        self.root = Window()\n        self.root.Content = selectable_textblock()\n        self.root.Show()\n\nif __name__ == \"__main__\":\n    app = Application()\n    app.Run(sys.argv)\n```"
