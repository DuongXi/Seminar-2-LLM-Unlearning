"```python\nfrom PIL import Image\nfrom io import BytesIO\nimport os\n\ndef resize_image(image_path, new_size):\n    image = Image.open(image_path)\n    buffer = BytesIO()\n    image.save(buffer, format=\"JPEG\", quality=90)\n    buffer.seek(0)\n    new_image = Image.open(buffer)\n    new_image.thumbnail(new_size)\n    new_buffer = BytesIO()\n    new_image.save(new_buffer, format=\"JPEG\", quality=90)\n    new_buffer.seek(0)\n    return new_buffer\n\n# Usage\nimage_path = 'path_to_your_image.jpg'\nnew_size = (800, 600)  # new size in pixels\nnew_image = resize_image(image_path, new_size)\nwith open('new_image.jpg', 'wb') as f:\n    f.write(new_image.getvalue())\n```"
