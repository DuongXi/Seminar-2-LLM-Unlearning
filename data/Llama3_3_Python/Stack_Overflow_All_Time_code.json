"```python\nimport cv2\nimport numpy as np\n\n# Load the image\nimg = cv2.imread('image.jpg')\n\n# Convert to grayscale\ngray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n\n# Calculate the local variances of the grayscale image\nwinSize = 35\nblur1 = cv2.blur(gray, (winSize, winSize))\nblur2 = cv2.blur(gray.mul(gray), (winSize, winSize))\nvarMat = blur2 - blur1.mul(blur1)\nvarMat = varMat.convertScaleAbs(255)\n\n# Apply threshold to the high variance regions\nvarMatRegions = np.zeros_like(varMat)\nvarMatRegions[varMat > 100] = 255\n\n# Find contours of text regions\ncontours, _ = cv2.findContours(varMatRegions, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n\n# Create a copy of the original image\ntextImg = img.copy()\n\n# Iterate through contours\nfor contour in contours:\n    # Calculate the area of the contour\n    area = cv2.contourArea(contour)\n    \n    # Ignore small contours\n    if area < 1000:\n        continue\n    \n    # Calculate the bounding box of the contour\n    x, y, w, h = cv2.boundingRect(contour)\n    \n    # Draw the bounding box on the text image\n    cv2.rectangle(textImg, (x, y), (x+w, y+h), (0, 255, 0), 2)\n\n# Display the output\ncv2.imshow('Text Image', textImg)\ncv2.waitKey(0)\ncv2.destroyAllWindows()\n```"
