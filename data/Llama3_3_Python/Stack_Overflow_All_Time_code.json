"```python\nfrom abc import ABC, abstractmethod\n\n# Interface example\nclass ShapeInterface(ABC):\n    @abstractmethod\n    def area(self):\n        pass\n\n    @abstractmethod\n    def perimeter(self):\n        pass\n\n# Abstract Class example\nclass ShapeABC(ABC):\n    def __init__(self, color):\n        self.color = color\n\n    @abstractmethod\n    def area(self):\n        pass\n\n    def perimeter(self):\n        pass\n\n# Concrete class implementing ShapeInterface\nclass Circle(ShapeInterface):\n    def __init__(self, radius):\n        self.radius = radius\n\n    def area(self):\n        return 3.14 * (self.radius ** 2)\n\n    def perimeter(self):\n        return 2 * 3.14 * self.radius\n\n# Concrete class implementing ShapeABC\nclass Rectangle(ShapeABC):\n    def __init__(self, width, height):\n        self.width = width\n        self.height = height\n\n    def area(self):\n        return self.width * self.height\n\n    def perimeter(self):\n        return 2 * (self.width + self.height)\n\n# Testing the classes\ncircle = Circle(5)\nprint(f\"Circle area: {circle.area()}\")\nprint(f\"Circle perimeter: {circle.perimeter()}\")\n\nrectangle = Rectangle(4, 6)\nprint(f\"Rectangle area: {rectangle.area()}\")\nprint(f\"Rectangle perimeter: {rectangle.perimeter()}\")\n```"
"```python\n# Differences between type() and isinstance():\n# type() checks if the object is of a specific type, \n# while isinstance() checks if the object is of a specific type or its subclasses.\n\ndef compare_types():\n    class CustomDict(dict):\n        pass\n\n    a = CustomDict()\n    b = \"Hello\"\n    c = 123\n\n    # Using type()\n    if type(a) is dict:\n        print(\"a is a dict\")\n    else:\n        print(\"a is not a dict\")\n\n    if type(b) in (str, bytes):\n        print(\"b is a string\")\n    else:\n        print(\"b is not a string\")\n\n    if type(c) in (int, float):\n        print(\"c is a number\")\n    else:\n        print(\"c is not a number\")\n\n    # Using isinstance()\n    if isinstance(a, dict):\n        print(\"a is a dict\")\n    else:\n        print(\"a is not a dict\")\n\n    if isinstance(b, (str, bytes)):\n        print(\"b is a string\")\n    else:\n        print(\"b is not a string\")\n\n    if isinstance(c, (int, float)):\n        print(\"c is a number\")\n    else:\n        print(\"c is not a number\")\n\ncompare_types()\n```"
