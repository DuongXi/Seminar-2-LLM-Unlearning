"def build_heap(arr):\n    n = len(arr)\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\ndef heapify(arr, n, i):\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and arr[left] > arr[largest]:\n        largest = left\n\n    if right < n and arr[right] > arr[largest]:\n        largest = right\n\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        heapify(arr, n, largest)"
"def permutations(lst):\n    if len(lst) == 0:\n        return [[]]\n    result = []\n    for i in range(len(lst)):\n        element = lst[i]\n        rest = lst[:i] + lst[i+1:]\n        for p in permutations(rest):\n            result.append([element] + p)\n    return result"
"import math\n\ndef calculate_pi(n):\n    pi = 0.0\n    for k in range(n * 10):  # Increase the number for more accuracy\n        pi += 4 * ((-1) ** k) / (2 * k + 1)\n    return pi\n\ndef check_accuracy(n, calculated_pi, expected_pi):\n    error = abs(calculated_pi - expected_pi)\n    accuracy = error / expected_pi * 100\n    return error, accuracy\n\ndef main():\n    n = 100  # Number of digits to calculate\n    expected_pi = math.pi\n    calculated_pi = calculate_pi(n)\n    error, accuracy = check_accuracy(n, calculated_pi, expected_pi)\n    print(f\"Calculated {n} digits of pi: {calculated_pi}\")\n    print(f\"Error: {error:.6f}\")\n    print(f\"Accuracy: {accuracy:.2f}%\")\n\nif __name__ == \"__main__\":\n    main()"
"import sys\nimport os\n\ndef ramsort(arr):\n    n = len(arr)\n    min_run = 32\n    temp = [0] * n\n\n    for start in range(0, n, min_run):\n        insertion_sort(arr, start, min((start + min_run - 1), n - 1))\n\n    for length in range(min_run, n, min_run * 2):\n        for start in range(0, n, length):\n            mid = start + length // 2\n            end = start + length\n            if mid > end - 1:\n                break\n            count = 0\n            left = start\n            right = end\n            while left < mid:\n                while right > mid and arr[right - 1] >= arr[mid]:\n                    right -= 1\n                temp[count] = arr[right]\n                right -= 1\n                count += 1\n                arr[right] = arr[left]\n                left += 1\n            while left < mid:\n                temp[count] = arr[left]\n                left += 1\n                count += 1\n            for i in range(left, end):\n                arr[i] = arr[i + 1]\n            for i in range(count - 1, -1, -1):\n                arr[i + count - 1] = temp[i]\n\ndef insertion_sort(arr, start, end):\n    for i in range(start + 1, end + 1):\n        key = arr[i]\n        j = i - 1\n        while j >= start and arr[j] > key:\n            arr[j + 1] = arr[j]\n            j -= 1\n        arr[j + 1] = key\n\n# Example usage\narr = []\nfor _ in range(1000000):\n    arr.append(float(input()))\n\nramsort(arr)\n\n# Send sorted list over TCP connection\n# (Code not provided as it is already handled by the question's Ethernet port and TCP/IP connection code)"
"def auto_resize_image(image_width, image_height, container_width):\n    \"\"\"\n    Calculate the new width and height of an image while maintaining its aspect ratio\n    to fit into a smaller container width.\n\n    Args:\n        image_width (int): The original width of the image.\n        image_height (int): The original height of the image.\n        container_width (int): The width of the container.\n\n    Returns:\n        tuple: A tuple containing the new width and height of the image.\n    \"\"\"\n    aspect_ratio = image_width / image_height\n    new_width = container_width\n    new_height = new_width / aspect_ratio\n\n    return new_width, new_height\n\n# Example usage\nimage_width = 800\nimage_height = 600\ncontainer_width = 400\n\nnew_width, new_height = auto_resize_image(image_width, image_height, container_width)\nprint(f\"New width: {new_width}, New height: {new_height}\")"
"```python\nfrom PIL import Image\nfrom io import BytesIO\nimport requests\n\nclass ImageDownloader:\n    def download_image(self, url):\n        response = requests.get(url)\n        image = Image.open(BytesIO(response.content))\n        return image\n\ndef lazy_load_image(image_view, url, index):\n    image_downloader = ImageDownloader()\n    image = image_downloader.download_image(url)\n    image_view.set_image(image, index)\n\n# Example usage\nimport android\nfrom android.widget.ImageView import ImageView\n\n# Replace with your ListView and ImageView objects\nlist_view = android.widget.ListView()\nimage_view = android.widget.ImageView()\n\n# Assuming you have a list of image URLs\nimage_urls = [\"http://example.com/image1.jpg\", \"http://example.com/image2.jpg\", ...]\n\nfor i, url in enumerate(image_urls):\n    android.runOnUiThread(lambda index=i: lazy_load_image(image_view, url, index))\n```"
