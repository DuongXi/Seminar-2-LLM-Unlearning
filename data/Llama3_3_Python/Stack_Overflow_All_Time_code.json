"class Mixin:\n    def method1(self):\n        pass\n\n    def method2(self):\n        pass\n\nclass ClassWithMixin:\n    def __init__(self):\n        self.mixin = Mixin()\n\n    def method3(self):\n        self.mixin.method1()\n\n    def method4(self):\n        self.mixin.method2()\n\nclass ClassWithoutMixin:\n    def method1(self):\n        pass\n\n    def method2(self):\n        pass\n\n    def method3(self):\n        self.method1()\n\n    def method4(self):\n        self.method2()\n\n# Create instances\nobj_with_mixin = ClassWithMixin()\nobj_without_mixin = ClassWithoutMixin()\n\n# Test methods\nprint(obj_with_mixin.method3())  # Output: None\nprint(obj_without_mixin.method3())  # Output: None\n\nprint(obj_with_mixin.method4())  # Output: None\nprint(obj_without_mixin.method4())  # Output: None\n\n# Composition example\nclass ComposedClass:\n    def __init__(self):\n        self.mixin = Mixin()\n\n    def method1(self):\n        self.mixin.method1()\n\n    def method2(self):\n        self.mixin.method2()\n\n    def method3(self):\n        self.mixin.method1()\n\n    def method4(self):\n        self.mixin.method2()\n\ncomposed_obj = ComposedClass()\nprint(composed_obj.method3())  # Output: None\nprint(composed_obj.method4())  # Output: None\n\n# The key difference between a mixin and multiple inheritance is that a mixin doesn't inherit from any base class,\n# it's just a collection of methods that can be used by other classes. This makes mixins more flexible and reusable.\n\n# Multiple inheritance, on the other hand, can lead to the \"diamond problem\" where a class inherits conflicting methods from multiple bases.\n\n# In contrast, composition involves creating an instance of a class and using its methods, which avoids the potential conflicts that can arise with multiple inheritance."
