"```python\ndef http_method_choice(resource_exists):\n    \"\"\"\n    Choose the appropriate HTTP method based on whether the resource already exists.\n\n    Args:\n    resource_exists (bool): True if the resource exists, False otherwise.\n\n    Returns:\n    str: The chosen HTTP method ('POST' or 'PUT').\n    \"\"\"\n    if resource_exists:\n        return 'PUT'  # PUT is used to create or replace a resource\n    else:\n        return 'POST'  # POST is used to create a new resource\n\n# Example usage:\nresource_exists = True  # Replace with your condition\nchosen_method = http_method_choice(resource_exists)\nprint(f\"Chosen HTTP method: {chosen_method}\")\n```"
