"```python\nimport csv\nimport psycopg2\n\ndef import_csv_to_postgres(csv_file, db_name, db_user, db_password, table_name):\n    conn = psycopg2.connect(\n        dbname=db_name,\n        user=db_user,\n        password=db_password\n    )\n    cur = conn.cursor()\n\n    with open(csv_file, 'r') as file:\n        reader = csv.reader(file)\n        headers = next(reader)\n\n        cur.execute(f\"CREATE TABLE IF NOT EXISTS {table_name} ({', '.join([f'{header} TEXT' for header in headers])})\")\n        cur.execute(\"TRUNCATE {table_name}\")\n\n        for row in reader:\n            cur.execute(f\"INSERT INTO {table_name} VALUES ({', '.join(['%s'] * len(row))})\", tuple(row))\n\n    conn.commit()\n    cur.close()\n    conn.close()\n\n# Example usage:\nimport_csv_to_postgres('data.csv', 'mydatabase', 'myuser', 'mypassword', 'mytable')\n```"
