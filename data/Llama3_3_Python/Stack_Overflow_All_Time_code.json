"```python\ndef sort_homes_by_price(homes, order='asc'):\n    \"\"\"\n    Sorts an array of objects by the 'price' property.\n\n    Args:\n        homes (list): The list of objects to sort.\n        order (str): The order of sorting, either 'asc' for ascending or 'desc' for descending.\n\n    Returns:\n        list: The sorted list of objects.\n    \"\"\"\n    if order not in ['asc', 'desc']:\n        raise ValueError(\"Invalid order. Use 'asc' or 'desc'.\")\n\n    return sorted(homes, key=lambda x: int(x['price']), reverse=(order == 'desc'))\n\nhomes = [\n    {\n        \"h_id\": \"3\",\n        \"city\": \"Dallas\",\n        \"state\": \"TX\",\n        \"zip\": \"75201\",\n        \"price\": \"162500\"\n    }, {\n        \"h_id\": \"4\",\n        \"city\": \"Bevery Hills\",\n        \"state\": \"CA\",\n        \"zip\": \"90210\",\n        \"price\": \"319250\"\n    }, {\n        \"h_id\": \"5\",\n        \"city\": \"New York\",\n        \"state\": \"NY\",\n        \"zip\": \"00010\",\n        \"price\": \"962500\"\n    }\n]\n\nsorted_homes = sort_homes_by_price(homes)\nprint(sorted_homes)\n\nsorted_homes_desc = sort_homes_by_price(homes, 'desc')\nprint(sorted_homes_desc)\n```"
