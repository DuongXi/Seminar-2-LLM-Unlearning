"```python\nfrom django.db.models import Q\n\ndef combine_querysets(page_list, article_list, post_list):\n    combined_list = page_list.union(article_list).union(post_list)\n    return combined_list\n\nresult_list = combine_querysets(\n    Page.objects.filter(\n        Q(title__icontains=cleaned_search_term) |\n        Q(body__icontains=cleaned_search_term)),\n    Article.objects.filter(\n        Q(title__icontains=cleaned_search_term) |\n        Q(body__icontains=cleaned_search_term) |\n        Q(tags__icontains=cleaned_search_term)),\n    Post.objects.filter(\n        Q(title__icontains=cleaned_search_term) |\n        Q(body__icontains=cleaned_search_term) |\n        Q(tags__icontains=cleaned_search_term)))\n\nreturn object_list(\n    request,\n    queryset=result_list,\n    template_object_name='result',\n    paginate_by=10,\n    extra_context={\n        'search_term': search_term},\n    template_name=\"search/result_list.html\")\n```"
"```python\nimport mysql.connector\nfrom mysql.connector import errorcode\n\n# Establish a connection to the MySQL database\ncnx = mysql.connector.connect(\n    user='your_username',\n    password='your_password',\n    host='127.0.0.1',\n    database='your_database'\n)\n\n# Create a cursor object\ncursor = cnx.cursor()\n\n# SQL query to disable foreign key constraint temporarily\nquery = \"SET FOREIGN_KEY_CHECKS = 0\"\n\ntry:\n    # Execute the query to disable foreign key constraint\n    cursor.execute(query)\n    \n    # Delete instances of a model\n    cursor.execute(\"DELETE FROM myapp_item WHERE n = %s\", n)\n    cursor.execute(\"DELETE FROM myapp_style WHERE n = %s\", n)\n    \n    # Commit the transaction\n    cnx.commit()\n    \nexcept mysql.connector.Error as err:\n    # Rollback the transaction if an error occurs\n    cnx.rollback()\n    print(\"Error: {}\".format(err))\nfinally:\n    # Close the cursor and connection\n    cursor.close()\n    cnx.close()\n```"
"```python\n# Revert the last migration\nfrom alembic import op\nimport sqlalchemy as sa\n\nrevision = 'head'  # Replace with the latest revision number\ndown_revision = 'base'  # Replace with the revision number of the migration you want to revert\n\ndef downgrade():\n    # Delete the table\n    op.drop_table('new_table')\n\n# Apply the downgrade\nwith open('migrations/versions/{}.py'.format(revision), 'r') as f:\n    code = f.read()\n\n# Replace the migration file with the downgrade function\nwith open('migrations/versions/{}.py'.format(revision), 'w') as f:\n    f.write(code.replace('op.create_table', 'downgrade()'))\n```"
