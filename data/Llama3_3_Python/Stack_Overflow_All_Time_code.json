"```python\nimport tkinter as tk\nfrom threading import Thread\nfrom queue import Queue\n\nclass Application(tk.Frame):\n    def __init__(self, master=None):\n        super().__init__(master)\n        self.master = master\n        self.pack()\n        self.create_widgets()\n        self.queue = Queue()\n\n    def create_widgets(self):\n        self.label = tk.Label(self)\n        self.label[\"text\"] = \"Status: \"\n        self.label.pack(side=\"top\")\n\n        self.button = tk.Button(self)\n        self.button[\"text\"] = \"Start\"\n        self.button[\"command\"] = self.start_thread\n        self.button.pack(side=\"top\")\n\n        self.update_label = tk.Button(self)\n        self.update_label[\"text\"] = \"Update\"\n        self.update_label[\"command\"] = self.update_label_text\n        self.update_label.pack(side=\"top\")\n\n        self.running = False\n\n    def start_thread(self):\n        self.running = True\n        thread = Thread(target=self.process_files)\n        thread.start()\n\n    def process_files(self):\n        # Simulate some work\n        for i in range(10):\n            self.queue.put(f\"Processing file {i+1}...\")\n            self.update_label_text()\n            self.master.update_idletasks()\n            import time\n            time.sleep(1)\n\n    def update_label_text(self):\n        if self.running:\n            try:\n                status = self.queue.get(block=False)\n                self.label[\"text\"] = status\n            except:\n                pass\n\nroot = tk.Tk()\napp = Application(master=root)\napp.mainloop()\n```\n\nThe `Queue` class from the `threading` module is used to communicate between threads. In this example, the main thread puts the status updates into the queue and the thread processing files retrieves them and updates the label. The `update_idletasks` method is used to update the GUI from the main thread."
