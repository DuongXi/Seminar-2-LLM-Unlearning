"import threading\n\nclass Mutex:\n    def __init__(self):\n        self._locked = False\n        self._queue = []\n\n    def acquire(self):\n        while self._locked:\n            self._queue.append(threading.current_thread())\n        self._locked = True\n\n    def release(self):\n        if not self._locked:\n            raise Exception(\"Mutex is not locked\")\n        self._locked = False\n        thread = self._queue.pop(0)\n        thread.join()\n\n# Example usage\nmutex = Mutex()\n\ndef thread_func():\n    mutex.acquire()\n    print(\"Thread is running\")\n    mutex.release()\n\nthread1 = threading.Thread(target=thread_func)\nthread2 = threading.Thread(target=thread_func)\n\nthread1.start()\nthread2.start()\n\nthread1.join()\nthread2.join()"
