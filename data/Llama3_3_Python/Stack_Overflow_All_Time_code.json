"```python\nimport smtplib\nfrom email.mime.multipart import MIMEMultipart\nfrom email.mime.base import MIMEBase\nfrom email.mime.text import MIMEText\nfrom email import encoders\n\ndef send_email_attachment(subject, message, to_address, from_address, password, attachment_path):\n    msg = MIMEMultipart()\n    msg['From'] = from_address\n    msg['To'] = to_address\n    msg['Subject'] = subject\n    \n    body = message\n    msg.attach(MIMEText(body, 'plain'))\n    \n    attachment = open(attachment_path, \"rb\")\n    part = MIMEBase('application', 'octet-stream')\n    part.set_payload((attachment).read())\n    encoders.encode_base64(part)\n    part.add_header('Content-Disposition', \"attachment; filename= %s\" % attachment_path)\n    msg.attach(part)\n\n    server = smtplib.SMTP('smtp.gmail.com', 587)\n    server.starttls()\n    server.login(from_address, password)\n    text = msg.as_string()\n    server.sendmail(from_address, to_address, text)\n    server.quit()\n\n# Example usage:\nsubject = \"Test Email with Attachment\"\nmessage = \"This is a test email with an attachment.\"\nto_address = \"recipient@example.com\"\nfrom_address = \"sender@example.com\"\npassword = \"password\"\nattachment_path = \"path_to_your_attachment.txt\"\n\nsend_email_attachment(subject, message, to_address, from_address, password, attachment_path)\n```"
"```python\nfrom email.mime.multipart import MIMEMultipart\nfrom email.mime.text import MIMEText\nimport smtplib\n\ndef send_html_email(subject, message, from_addr, to_addr, password, smtp_server, smtp_port):\n    msg = MIMEMultipart()\n    msg['From'] = from_addr\n    msg['To'] = to_addr\n    msg['Subject'] = subject\n\n    body = message\n    msg.attach(MIMEText(body, 'html'))\n\n    server = smtplib.SMTP(smtp_server, smtp_port)\n    server.starttls()\n    server.login(from_addr, password)\n    text = msg.as_string()\n    server.sendmail(from_addr, to_addr, text)\n    server.quit()\n\n# Example usage:\nsubject = \"Example HTML Email\"\nmessage = \"\"\"\n<html>\n<body>\n<p>Hello World!</p>\n<p>This is an example HTML email.</p>\n</body>\n</html>\n\"\"\"\nfrom_addr = \"your_email@gmail.com\"\nto_addr = \"recipient_email@example.com\"\npassword = \"your_password\"\nsmtp_server = \"smtp.gmail.com\"\nsmtp_port = 587\n\nsend_html_email(subject, message, from_addr, to_addr, password, smtp_server, smtp_port)\n```"
