"```python\nimport struct\nimport zlib\n\nclass HPACKHeader:\n    def __init__(self, type, flags, length):\n        self.type = type\n        self.flags = flags\n        self.length = length\n\n    def pack(self):\n        return struct.pack('BBH', self.type, self.flags, self.length)\n\n    @staticmethod\n    def unpack(data):\n        type, flags, length = struct.unpack('BBH', data)\n        return HPACKHeader(type, flags, length)\n\nclass HPACKEncoder:\n    def __init__(self):\n        self.index = 0\n        self.headers = []\n\n    def add_header(self, header):\n        self.headers.append(header)\n\n    def compress(self):\n        encoded_headers = []\n        for header in self.headers:\n            encoded_header = self.encode_header(header)\n            encoded_headers.append(encoded_header)\n        encoded_headers = self.encode_length(encoded_headers)\n        encoded_headers = self.encode_frame(encoded_headers)\n        return encoded_headers\n\n    def encode_header(self, header):\n        if header.type == 0:  # Constant\n            return b'\\x00\\x00' + header.pack()\n        elif header.type == 1:  # Length\n            return b'\\x01' + header.pack()\n        elif header.type == 2:  # String\n            return b'\\x02' + header.pack() + header.value.encode()\n        elif header.type == 3:  # Field\n            return b'\\x03' + header.pack() + header.value.encode()\n        elif header.type == 4:  # Enum\n            return b'\\x04' + header.pack() + header.value.encode()\n        else:\n            raise ValueError('Invalid header type')\n\n    def encode_length(self, headers):\n        encoded_headers = []\n        for header in headers:\n            if header.type == 1:  # Length\n                encoded_header = header.pack()\n                encoded_headers.append(encoded_header)\n            else:\n                encoded_header = self.encode_header(header)\n                length = len(encoded_header) + 2\n                encoded_header = b'\\x01' + struct.pack('H', length) + encoded_header\n                encoded_headers.append(encoded_header)\n        return encoded_headers\n\n    def encode_frame(self, headers):\n        frame = b'\\x00\\x00\\x00\\x00'\n        for i, header in enumerate(headers):\n            frame += header.pack()\n            if i < len(headers) - 1:\n                frame += b'\\x00\\x00'\n        return frame\n\ndef decompress(data):\n    # Implement HPACK decompression logic here\n    pass\n\ndef main():\n    # Example usage\n    encoder = HPACKEncoder()\n    encoder.add_header(HPACKHeader(0, 0, 0))  # Constant header\n    encoder.add_header(HPACKHeader(1, 0, 10))  # Length header\n    encoded_data = encoder.compress()\n    decompressed_data = decompress(encoded_data)\n    print(decompressed_data)\n\nif __name__ == '__main__':\n    main()\n```"
