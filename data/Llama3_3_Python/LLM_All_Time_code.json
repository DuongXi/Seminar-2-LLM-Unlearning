"```python\nimport fnmatch\nimport os\n\ndef get_file_metadata(file_path):\n    \"\"\"\n    Reads and returns the metadata of a file.\n\n    Args:\n        file_path (str): The path to the file.\n\n    Returns:\n        dict: A dictionary containing the file's metadata.\n    \"\"\"\n    metadata = {}\n    try:\n        with open(file_path, 'r') as file:\n            metadata['size'] = os.path.getsize(file_path)\n            metadata['last_modified'] = os.path.getmtime(file_path)\n            metadata['last_accessed'] = os.path.getatime(file_path)\n    except Exception as e:\n        print(f\"Error reading file: {e}\")\n    return metadata\n\ndef check_file_pattern(file_path, pattern):\n    \"\"\"\n    Checks if a file matches a specified pattern.\n\n    Args:\n        file_path (str): The path to the file.\n        pattern (str): The pattern to match.\n\n    Returns:\n        bool: True if the file matches the pattern, False otherwise.\n    \"\"\"\n    return fnmatch.fnmatch(file_path, pattern)\n\ndef check_file_extension(file_path, extension):\n    \"\"\"\n    Checks if a file has a specific extension.\n\n    Args:\n        file_path (str): The path to the file.\n        extension (str): The extension to check for.\n\n    Returns:\n        bool: True if the file has the extension, False otherwise.\n    \"\"\"\n    return file_path.endswith(extension)\n\ndef get_files_in_directory(directory, pattern=None, extension=None):\n    \"\"\"\n    Finds files in a directory that match a specified pattern and/or extension.\n\n    Args:\n        directory (str): The path to the directory.\n        pattern (str, optional): The pattern to match. Defaults to None.\n        extension (str, optional): The extension to check for. Defaults to None.\n\n    Returns:\n        list: A list of files that match the specified pattern and/or extension.\n    \"\"\"\n    files = []\n    for root, dirs, filenames in os.walk(directory):\n        for filename in filenames:\n            if (pattern is None or fnmatch.fnmatch(filename, pattern)) and (extension is None or filename.endswith(extension)):\n                files.append(os.path.join(root, filename))\n    return files\n\n# Example usage\ndirectory = '/path/to/directory'\npattern = '*.txt'\nextension = '.txt'\n\nfiles = get_files_in_directory(directory, pattern, extension)\nfor file in files:\n    print(file)\n\nmetadata = get_file_metadata('/path/to/file.txt')\nprint(metadata)\n\nmatches = check_file_pattern('/path/to/file.txt', pattern)\nprint(matches)\n\nmatches = check_file_extension('/path/to/file.txt', extension)\nprint(matches)\n```"
