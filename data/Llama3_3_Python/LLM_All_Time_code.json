"```python\nimport asyncio\n\nclass AsynchronousConsole:\n    def __init__(self):\n        self.commands = {\n            'exit': self.exit,\n            'help': self.help,\n            'echo': self.echo,\n        }\n\n    async def run(self):\n        while True:\n            user_input = await self.get_user_input()\n            command = user_input.split()[0].lower()\n            if command in self.commands:\n                await self.commands[command](user_input)\n            else:\n                print(\"Unknown command. Type 'help' for available commands.\")\n\n    def get_user_input(self):\n        while True:\n            user_input = input()\n            if user_input:\n                return user_input\n            else:\n                print(\"Please enter a command.\")\n\n    async def echo(self, user_input):\n        print(user_input)\n\n    async def help(self, user_input):\n        print(\"Available commands:\")\n        print(\"  exit - Exit the console\")\n        print(\"  help - Display this help message\")\n        print(\"  echo - Echo back the input\")\n\n    async def exit(self, user_input):\n        print(\"Exiting console...\")\n        await asyncio.sleep(1)\n        exit()\n\nasync def main():\n    console = AsynchronousConsole()\n    await console.run()\n\nasyncio.run(main())\n```"
"```python\nimport os\n\n# ANSI escape codes for colors\nGREEN = '\\033[92m'\nYELLOW = '\\033[93m'\nEND_COLOR = '\\033[0m'\n\ndef colorize_terminal():\n    # Set background color to green\n    os.system('echo -ne \"\\033[48;5;10m\"')\n\n    # Set text color to yellow\n    os.system('echo -ne \"\\033[33m\"')\n\n    # Print the current directory with green background and yellow text\n    print(f\"{GREEN}Current Directory: {os.getcwd()}{END_COLOR}\")\n\n    # Reset colors\n    os.system('echo -ne \"\\033[0m\"')\n\ncolorize_terminal()\n```"
"```python\nimport rasterio\nfrom rasterio.features import shapes\nfrom shapely.geometry import shape\n\n# Function to read TIFF file\ndef read_tiff_file(file_path):\n    with rasterio.open(file_path) as src:\n        return src.read(1)\n\n# Function to write TIFF file\ndef write_tiff_file(file_path, data, crs=None, transform=None, dtype=rasterio.uint8):\n    with rasterio.open(file_path, 'w', \n                      driver='GTiff', \n                      width=data.shape[1], \n                      height=data.shape[0], \n                      count=1, \n                      crs=crs, \n                      transform=transform, \n                      dtype=dtype) as dst:\n        dst.write(data, 1)\n\n# Function to extract shapes from TIFF file\ndef extract_shapes(file_path):\n    with rasterio.open(file_path) as src:\n        return shapes(src.read(1), mask=src.read_masks(1), all_touched=True)\n\n# Function to convert rasterio feature collection to Shapely geometry collection\ndef rasterio_to_shapely(feature_collection):\n    return [shape(feature['geometry']) for feature in feature_collection]\n```\n\nThis code includes four functions to read and write TIFF files using the rasterio library, as well as to extract shapes from TIFF files and convert rasterio feature collections to Shapely geometry collections. The `read_tiff_file` and `write_tiff_file` functions are straightforward, while the `extract_shapes` function uses the `shapes` function from rasterio to extract shapes from the TIFF file. The `rasterio_to_shapely` function is used to convert the feature collection to a Shapely geometry collection."
