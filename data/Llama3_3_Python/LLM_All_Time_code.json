"```python\nfrom pipeline import pipeline\n\n# Define a function to transform data\ndef transform_data(data):\n    # Apply some transformation here, for example\n    return [x * 2 for x in data]\n\n# Define a function to filter data\ndef filter_data(data):\n    # Filter the data here, for example\n    return [x for x in data if x > 5]\n\n# Define a function to aggregate data\ndef aggregate_data(data):\n    # Calculate the sum here, for example\n    return sum(data)\n\n# Create a pipeline\npipeline = pipeline([\n    ('transform', transform_data),\n    ('filter', filter_data),\n    ('aggregate', aggregate_data)\n])\n\n# Apply the pipeline to some data\ndata = [1, 2, 3, 4, 5]\nresult = pipeline.apply(data)\nprint(result)  # Output: 30\n```"
"```python\nclass URITemplate:\n    def __init__(self, template):\n        self.template = template\n\n    def replace(self, values):\n        for key, value in values.items():\n            self.template = self.template.replace('{' + key + '}', value)\n        return self.template\n\ndef parse_template(template):\n    parts = template.split('/')\n    uri_template = URITemplate(parts[0])\n    params = {}\n    for part in parts[1:]:\n        key, value = part.split('?')\n        key, value = value.split('#')\n        params[key] = value\n    return uri_template, params\n\ndef construct_template(uri_template, params):\n    template = uri_template.template\n    for key, value in params.items():\n        template = template.replace('{' + key + '}', value)\n    return template\n\nclass URI:\n    def __init__(self, template, values=None):\n        self.template = template\n        self.values = values if values else {}\n\n    def __str__(self):\n        return self.template\n\n    def replace(self):\n        self.values = parse_template(self.template).pop()\n\n    def __getitem__(self, key):\n        self.replace()\n        return self.values[key]\n\n# Example usage:\ntemplate = 'https://example.com/{path}?lang={lang}&id={id}#fragment'\nuri = URI(template, {'path': '/users', 'lang': 'en', 'id': '123'})\nprint(uri)  # Output: https://example.com/users?lang=en&id=123#fragment\nuri.replace()\nprint(uri)  # Output: https://example.com/users?lang=en&id=123#fragment\nprint(uri['path'])  # Output: /users\nprint(uri['lang'])  # Output: en\nprint(uri['id'])  # Output: 123\n```"
"```python\nimport pexpect\n\ndef run_command(command):\n    \"\"\"\n    Runs a command in a console application using pexpect.\n\n    Args:\n    command (str): The command to run.\n\n    Returns:\n    str: The output of the command.\n    \"\"\"\n    child = pexpect.spawn(command)\n    child.expect('Username: ')\n    child.sendline('your_username')\n    child.expect('Password: ')\n    child.sendline('your_password')\n    child.expect('# ')\n    child.sendline('your_command')\n    output = child.before.decode('utf-8') + child.after.decode('utf-8')\n    child.terminate()\n    return output\n\n# Example usage\ncommand = 'your_command'\noutput = run_command(command)\nprint(output)\n```"
