"```python\nimport operator\nfrom functools import reduce\n\ndef filter_iter(iterable, predicate):\n    \"\"\"Return an iterator that filters elements from the iterable based on a predicate function.\"\"\"\n    for element in iterable:\n        if predicate(element):\n            yield element\n\ndef groupby_iter(iterable, key=None):\n    \"\"\"Return an iterator that groups elements from the iterable based on a key function.\"\"\"\n    current_key = None\n    current_group = []\n    for element in iterable:\n        k = key(element) if key else element\n        if k != current_key:\n            if current_group:\n                yield current_key, list(current_group)\n            current_key = k\n            current_group = []\n        current_group.append(element)\n    if current_group:\n        yield current_key, current_group\n\ndef map_iter(iterable, function):\n    \"\"\"Return an iterator that maps a function over the elements of the iterable.\"\"\"\n    for element in iterable:\n        yield function(element)\n\ndef reduce_iter(iterable, function, initial=None):\n    \"\"\"Return the result of applying a function of two arguments cumulatively to the items of an iterable, \n    from left to right, so as to reduce the iterable to a single output.\"\"\"\n    it = iter(iterable)\n    result = initial\n    for element in it:\n        result = function(result, element)\n    return result\n\ndef zip_longest(*iterables):\n    \"\"\"Return an iterator that aggregates elements from each of the iterables. \n    Stop when the shortest input iterable is exhausted.\"\"\"\n    max_len = max(len(iterable) for iterable in iterables)\n    it = iter(iterables)\n    for i in range(max_len):\n        try:\n            yield [x[i] for x in it]\n        except StopIteration:\n            break\n\ndef chain(*iterables):\n    \"\"\"Return an iterator that returns elements from the first iterable until it is exhausted, \n    then proceeds to the next iterable, until all of the iterables are exhausted.\"\"\"\n    for it in iterables:\n        yield from it\n\ndef compress_iter(iterable, predicate):\n    \"\"\"Return an iterator that filters elements from the iterable based on a predicate function.\"\"\"\n    return map_iter(iterable, lambda x: x if predicate(x) else None)\n\ndef cycle_iter(iterable):\n    \"\"\"Return an iterator that cycles over the elements of the iterable.\"\"\"\n    seen = set()\n    while True:\n        yield next((x for x in iterable if x not in seen), None)\n        seen.add(x)\n\ndef repeat_iter(element, times):\n    \"\"\"Return an iterator that repeats the given element a specified number of times.\"\"\"\n    for _ in range(times):\n        yield element\n```"
