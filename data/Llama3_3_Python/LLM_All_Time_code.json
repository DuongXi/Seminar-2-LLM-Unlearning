"```python\nimport asyncio\nimport socket\nimport struct\n\n# HTTP/2 frame types\nFRAME_TYPES = {\n    b'\\x00': 'CONNECT',\n    b'\\x01': 'CONTINUATION',\n    b'\\x02': 'HEADERS',\n    b'\\x03': 'PAYLOAD',\n    b'\\x04': 'PUSH_PROMISE',\n    b'\\x05': 'UNORDERED_CONTENT',\n    b'\\x06': 'HANDSHAKE',\n    b'\\x07': 'PROTOCOL_ERROR',\n    b'\\x08': 'SYNSET',\n    b'\\x09': 'ACK',\n    b'\\x0a': 'WINDOW_UPDATE',\n    b'\\x0b': 'END_STREAM'\n}\n\nclass HTTP2Stream:\n    def __init__(self, connection):\n        self.connection = connection\n        self.state = 'INIT'\n        self.stream_id = None\n        self.stream_flags = {}\n        self.header_frame = None\n        self.payload_frames = []\n        self.push Promises = []\n\n    async def handle_frame(self, frame):\n        if self.state == 'INIT':\n            if frame.type == b'\\x01' and frame.stream_id == 0:\n                self.state = 'ESTABLISHING'\n            elif frame.type == b'\\x06':\n                self.state = 'HANDSHAKE'\n            else:\n                raise ValueError('Invalid frame type')\n\n        elif self.state == 'ESTABLISHING':\n            if frame.type == b'\\x01' and frame.stream_id == self.stream_id:\n                self.state = 'ESTABLISHED'\n            elif frame.type == b'\\x02' and frame.stream_id == self.stream_id:\n                self.state = 'ESTABLISHED'\n            elif frame.type == b'\\x07' and frame.stream_id == 0:\n                self.state = 'CLOSED'\n\n        elif self.state == 'ESTABLISHED':\n            if frame.type == b'\\x02':\n                self.header_frame = frame\n            elif frame.type == b'\\x03':\n                self.payload_frames.append(frame)\n            elif frame.type == b'\\x04':\n                self.push Promises.append(frame)\n            elif frame.type == b'\\x05':\n                self.push Promises.append(frame)\n            elif frame.type == b'\\x0a':\n                if 'max_stream_size' in self.stream_flags:\n                    self.connection.max_stream_size = self.stream_flags['max_stream_size']\n            elif frame.type == b'\\x0b':\n                self.stream_flags['max_stream_size'] = frame.stream_id\n            elif frame.type == b'\\x0b' and frame.stream_id == self.stream_id:\n                self.state = 'CLOSED'\n            elif frame.type == b'\\x0b' and frame.stream_id == 0:\n                self.state = 'CLOSED'\n\n            elif frame.type == b'\\x09':\n                if frame.stream_id == self.stream_id:\n                    self.state = 'CLOSED'\n\n        elif self.state == 'CLOSED':\n            if frame.type == b'\\x08':\n                self.state = 'CLOSED'\n\nclass HTTP2Connection:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n        self.max_stream_size = None\n        self.streams = {}\n        self.server_socket = None\n\n    async def establish_connection(self):\n        self.server_socket = await asyncio.start_server(self.handle_client, self.host, self.port)\n\n    async def handle_client(self, reader, writer):\n        self.streams[writer.get_extra_info('remote_address')] = HTTP2Stream(writer)\n        await self.handle_client_loop(reader, writer)\n\n    async def handle_client_loop(self, reader, writer):\n        while True:\n            frame = await asyncio.to_thread(socket.recv, writer.fileno(), 1024)\n            await self.streams[writer.get_extra_info('remote_address')].handle_frame(frame)\n            if self.streams[writer.get_extra_info('remote_address')].state == 'CLOSED':\n                writer.close()\n                break\n\nasync def main():\n    connection = HTTP2Connection('localhost', 8000)\n    await connection.establish_connection()\n    await asyncio.Future()  # run forever\n\nasyncio.run(main())\n```"
