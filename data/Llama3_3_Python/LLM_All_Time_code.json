"```python\nimport requests\n\ndef make_request(url, params=None):\n    \"\"\"\n    Sends an HTTP request to the specified URL with optional parameters.\n    \n    Args:\n    url (str): The URL of the HTTP request.\n    params (dict): Optional parameters to be included in the request.\n    \n    Returns:\n    requests.Response: The response object from the HTTP request.\n    \"\"\"\n    return requests.get(url, params=params)\n```"
"```python\nfrom azure.identity import DefaultAzureCredential\nfrom azure.mgmt.compute import ComputeManagementClient\nfrom azure.mgmt.network import NetworkManagementClient\nfrom azure.mgmt.storage import StorageManagementClient\nfrom azure.core.exceptions import ResourceNotFoundError\n\n# Set up Azure subscription and resource group\nsubscription_id = \"your_subscription_id\"\nresource_group_name = \"your_resource_group_name\"\n\n# Create credentials for authentication\ncredential = DefaultAzureCredential()\n\n# Create Compute Management Client\ncompute_client = ComputeManagementClient(credential, subscription_id)\n\n# Create Network Management Client\nnetwork_client = NetworkManagementClient(credential, subscription_id)\n\n# Create Storage Management Client\nstorage_client = StorageManagementClient(credential, subscription_id)\n\n# Create resource group if it doesn't exist\ntry:\n    compute_client.resource_groups.get(resource_group_name)\nexcept ResourceNotFoundError:\n    compute_client.resource_groups.begin_create_or_update(resource_group_name=\"your_resource_group_name\", location=\"your_location\").result()\n\n# Create storage account\nstorage_account_name = \"your_storage_account_name\"\nstorage_account_resource_id = f\"resourceId={subscription_id}/providers/Microsoft.Storage/storageAccounts/{storage_account_name}\"\nstorage_account_info = compute_client.storage_accounts.begin_create_or_update(resource_group_name=resource_group_name, location=\"your_location\", properties={\"location\": \"your_location\"}).result()\nstorage_client.storage_accounts.begin_create_or_update(resource_group_name=resource_group_name, location=\"your_location\", name=storage_account_name, properties={\"sku\": {\"name\": \"Standard_LRS\"}}).result()\n\n# Create virtual machine\nvm_name = \"your_vm_name\"\nvm_resource_id = f\"resourceId={subscription_id}/providers/Microsoft.Compute/virtualMachines/{vm_name}\"\nvm_info = compute_client.virtual_machines.begin_create_or_update(resource_group_name=resource_group_name, location=\"your_location\", properties={\"properties\": {\"hardwareProfile\": {\"vmSize\": \"Standard_DS2_v2\"}}}).result()\n\n# Create network interface\nnic_name = \"your_nic_name\"\nnic_resource_id = f\"resourceId={subscription_id}/providers/Microsoft.Network/networkInterfaces/{nic_name}\"\nnic_info = network_client.network_interfaces.begin_create_or_update(resource_group_name=resource_group_name, location=\"your_location\", properties={\"properties\": {\"networkInterfaces\": [{\"id\": f\"your_subnet_id\"}]}}).result()\n\n# Associate virtual machine with network interface\ncompute_client.virtual_machines.begin_update(resource_group_name=resource_group_name, location=\"your_location\", id=vm_resource_id, properties={\"properties\": {\"hardwareProfile\": {\"vmSize\": \"Standard_DS2_v2\"}}}).result()\nnetwork_client.network_interfaces.begin_update(resource_group_name=resource_group_name, location=\"your_location\", id=nic_resource_id, properties={\"properties\": {\"networkInterfaces\": [{\"id\": f\"your_subnet_id\"}]}}).result()\n```"
