"```python\nimport psutil\nimport os\n\ndef check_and_start_mozilla():\n    # Get the current Mozilla process\n    mozilla_process = None\n    for proc in psutil.process_iter(['pid', 'name']):\n        if proc.info['name'] == 'firefox.exe' or proc.info['name'] == 'firefox':\n            mozilla_process = proc.info['pid']\n            break\n\n    if mozilla_process is None:\n        # Mozilla is not running, start it\n        print(\"Starting Mozilla...\")\n        os.system('start firefox.exe')\n    else:\n        # Mozilla is running, stop it\n        print(\"Stopping Mozilla...\")\n        try:\n            os.system(f'taskkill /im firefox.exe')\n        except Exception as e:\n            print(f\"Failed to stop Mozilla: {e}\")\n\n        # Start Mozilla again\n        print(\"Starting Mozilla again...\")\n        os.system('start firefox.exe')\n\n# Run the function\ncheck_and_start_mozilla()\n```"
