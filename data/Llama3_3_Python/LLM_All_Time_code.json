"```python\nimport psycopg2\n\ndef create_connection(dbhost, dbuser, dbpassword, dbdatabase):\n    try:\n        connection = psycopg2.connect(\n            dbname=dbdatabase,\n            user=dbuser,\n            password=dbpassword,\n            host=dbhost\n        )\n        print(\"Connection to PostgreSQL DB successful\")\n        return connection\n    except psycopg2.Error as e:\n        print(f\"Error connecting to database: {e}\")\n        return None\n\n# Example usage:\ndbhost = 'localhost'\ndbuser = 'your_username'\ndbpassword = 'your_password'\ndbdatabase = 'your_database'\n\nconnection = create_connection(dbhost, dbuser, dbpassword, dbdatabase)\nif connection is not None:\n    cursor = connection.cursor()\n    # Now you can execute SQL queries using the cursor object\n    # For example:\n    # cursor.execute(\"SELECT * FROM your_table\")\n    # results = cursor.fetchall()\n    # print(results)\n    connection.close()\n```"
"```python\nimport ast\nimport re\nimport sys\n\ndef check_vulnerabilities(code):\n    # Initialize a dictionary to store the results\n    results = {\n        'vulnerabilities': [],\n        'best_practices': []\n    }\n\n    # Parse the abstract syntax tree\n    tree = ast.parse(code)\n\n    # Check for SQL injection vulnerability\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Str):\n            if re.search(r'\\bSELECT\\b|\\bINSERT\\b|\\bUPDATE\\b|\\bDELETE\\b', node.s, re.IGNORECASE):\n                results['vulnerabilities'].append(f\"Potential SQL injection vulnerability: {node.s}\")\n\n    # Check for sensitive data exposure\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Str):\n            if re.search(r'\\bpassword\\b|\\bapi_key\\b|\\bsecret_key\\b', node.s, re.IGNORECASE):\n                results['vulnerabilities'].append(f\"Potential sensitive data exposure: {node.s}\")\n\n    # Check for insecure password storage\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Str):\n            if re.search(r'\\bbcrypt\\b|\\bargon2\\b|\\bpbkdf2\\b', node.s, re.IGNORECASE):\n                # Check if the password is being stored directly\n                if isinstance(node.parent, (ast.Assign, ast.Store)):\n                    results['best_practices'].append(f\"Insecure password storage: {node.s}\")\n\n    # Check for weak passwords\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Str):\n            if re.search(r'\\b12345\\b|\\babcde\\b|\\babc123\\b', node.s, re.IGNORECASE):\n                results['best_practices'].append(f\"Weak password: {node.s}\")\n\n    # Check for insecure HTTP headers\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Str):\n            if re.search(r'\\bXSS\\b|\\bXSRF\\b', node.s, re.IGNORECASE):\n                results['best_practices'].append(f\"Insecure HTTP header: {node.s}\")\n\n    return results\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: python script.py <python_code>\")\n        return\n\n    code = open(sys.argv[1], 'r').read()\n    results = check_vulnerabilities(code)\n\n    if results['vulnerabilities']:\n        print(\"Vulnerabilities:\")\n        for vulnerability in results['vulnerabilities']:\n            print(vulnerability)\n    else:\n        print(\"No vulnerabilities found.\")\n\n    if results['best_practices']:\n        print(\"\\nBest Practices:\")\n        for best_practice in results['best_practices']:\n            print(best_practice)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport google.protobuf\n\n# Define a message\nclass Greeter_pb2(google.protobuf.Message):\n    name = google.protobuf.FieldDescriptor(\n        name='name',\n        full_name='Greeter_pb2.Greeter',\n        index=0,\n        number=1,\n        type=google.protobuf.FieldDescriptor.Type.STRING,\n        cpp_type=1,\n        label=google.protobuf.FieldDescriptor.Label.UNIQUE,\n        has_default_value=False,\n        default_value='World',\n        message_type=None,\n        enum_type=None,\n        containing_type=None,\n        is_extension=False,\n        extension_scope=None,\n        options=None)\n    message = google.protobuf.FieldDescriptor(\n        name='message',\n        full_name='Greeter_pb2.Greeter',\n        index=1,\n        number=2,\n        type=google.protobuf.FieldDescriptor.Type.STRING,\n        cpp_type=12,\n        label=google.protobuf.FieldDescriptor.Label.UNIQUE,\n        has_default_value=False,\n        default_value='Hello, ',\n        message_type=None,\n        enum_type=None,\n        containing_type=None,\n        is_extension=False,\n        extension_scope=None,\n        options=None)\n\n# Create a message instance\ngreeter = Greeter_pb2.Greeter(name='Alice', message='Hello, Alice!')\n\n# Serialize the message to a string\nserialized_message = greeter.SerializeToString()\n\n# Print the serialized message\nprint(serialized_message)\n```"
"```python\nimport networkx as nx\nimport matplotlib.pyplot as plt\n\nclass Graph:\n    def __init__(self):\n        self.G = nx.Graph()\n\n    def add_node(self, node):\n        self.G.add_node(node)\n\n    def remove_node(self, node):\n        self.G.remove_node(node)\n\n    def add_edge(self, node1, node2):\n        self.G.add_edge(node1, node2)\n\n    def remove_edge(self, node1, node2):\n        self.G.remove_edge(node1, node2)\n\n    def display_graph(self):\n        nx.draw(self.G, with_labels=True)\n        plt.show()\n\n    def bfs(self, start_node):\n        visited = set()\n        queue = [start_node]\n        visited.add(start_node)\n        while queue:\n            node = queue.pop(0)\n            print(node, end=\" \")\n            for neighbor in self.G.neighbors(node):\n                if neighbor not in visited:\n                    visited.add(neighbor)\n                    queue.append(neighbor)\n\n    def dfs(self, start_node):\n        visited = set()\n        self._dfs_helper(start_node, visited)\n        print()\n\n    def _dfs_helper(self, node, visited):\n        visited.add(node)\n        print(node, end=\" \")\n        for neighbor in self.G.neighbors(node):\n            if neighbor not in visited:\n                self._dfs_helper(neighbor, visited)\n\n    def shortest_path(self, start_node, end_node):\n        try:\n            path = nx.shortest_path(self.G, start_node, end_node)\n            print(\"Shortest path:\", path)\n        except nx.NetworkXNoPath:\n            print(\"No path exists\")\n\n    def network_analysis(self):\n        degree_centrality = nx.degree_centrality(self.G)\n        betweenness_centrality = nx.betweenness_centrality(self.G)\n        closeness_centrality = nx.closeness_centrality(self.G)\n        print(\"Degree Centrality:\")\n        for node, centrality in degree_centrality.items():\n            print(f\"{node}: {centrality}\")\n        print(\"Betweenness Centrality:\")\n        for node, centrality in betweenness_centrality.items():\n            print(f\"{node}: {centrality}\")\n        print(\"Closeness Centrality:\")\n        for node, centrality in closeness_centrality.items():\n            print(f\"{node}: {centrality}\")\n\n\n# Example usage:\ngraph = Graph()\ngraph.add_node(\"A\")\ngraph.add_node(\"B\")\ngraph.add_node(\"C\")\ngraph.add_edge(\"A\", \"B\")\ngraph.add_edge(\"B\", \"C\")\ngraph.add_edge(\"C\", \"A\")\ngraph.display_graph()\ngraph.bfs(\"A\")\ngraph.dfs(\"A\")\ngraph.shortest_path(\"A\", \"C\")\ngraph.network_analysis()\n```"
