"```python\nimport os\n\ndef get_user_directories():\n    home_dir = os.getenv('HOME')\n    desktop = os.path.join(home_dir, 'Desktop')\n    documents = os.path.join(home_dir, 'Documents')\n    downloads = os.path.join(home_dir, 'Downloads')\n    temp = os.path.join(home_dir, 'Temp')\n\n    return {\n        'desktop': desktop,\n        'documents': documents,\n        'downloads': downloads,\n        'temp': temp\n    }\n\nprint(get_user_directories())\n```"
"```python\nimport pkg_resources\n\n# Get all entry points\nentry_points = pkg_resources.iter_entry_points()\n\n# Iterate over each entry point and print its name\nfor entry_point_name in entry_points:\n    print(entry_point_name)\n\n# Iterate over each entry point and print its description\nfor entry_point_name, entry_point in entry_points:\n    print(f\"Name: {entry_point_name}\")\n    print(f\"Description: {entry_point.description}\")\n    print(f\"Module: {entry_point.module}\")\n    print(\"\")\n\n# Load an entry point\nentry_point = entry_points.get(\"my.tool\", None)\nif entry_point:\n    print(\"Module:\", entry_point.module)\n    print(\"Function:\", entry_point.load())\n```"
"```python\nimport pytest\nimport distutils.core\nfrom setuptools import setup\n\ndef run_tests():\n    \"\"\"Run tests and report results.\"\"\"\n    try:\n        # Resolve dependencies\n        distutils.core.setup_args = lambda args: args\n        # Run tests\n        exit(pytest.main(['-v', '-s', '--cov=module_name']))\n    except Exception as e:\n        print(f\"Error running tests: {e}\")\n\nif __name__ == \"__main__\":\n    run_tests()\n```"
"```python\nimport mysql.connector\n\ndef connect_to_mysql(host, username, password, database):\n    try:\n        connection = mysql.connector.connect(\n            host=host,\n            user=username,\n            password=password,\n            database=database\n        )\n        return connection\n    except mysql.connector.Error as err:\n        print(\"Something went wrong: {}\".format(err))\n        return None\n\n# Example usage:\nconnection = connect_to_mysql('localhost', 'username', 'password', 'database_name')\nif connection:\n    print(\"Connected to MySQL database successfully.\")\n    connection.close()\n```"
"```python\nimport importlib\nimport inspect\nimport sys\n\ndef sort_imports():\n    sorted_imports = {}\n    for filename in sys.modules.values():\n        module = importlib.import_module(filename.name)\n        for name in dir(module):\n            obj = getattr(module, name)\n            if inspect.ismodule(obj):\n                if obj not in sorted_imports:\n                    sorted_imports[obj] = []\n                sorted_imports[obj].append((name, inspect.getfile(obj)))\n\n    sorted_imports = dict(sorted(sorted_imports.items(), key=lambda item: (len(item[1]), item[1][0])))\n    for module, imports in sorted_imports.items():\n        print(f\"Module: {module}\")\n        for line, filename in imports:\n            print(f\"  Line {line}: {filename}\")\n\nsort_imports()\n```"
"```python\nimport git\nimport os\n\nclass ObjectDatabase:\n    def __init__(self, repo_path):\n        self.repo = git.Repo(repo_path)\n        self.objects = {}\n\n    def store_object(self, name, data):\n        if name in self.objects:\n            raise ValueError(\"Object with name '{}' already exists\".format(name))\n        branch = self.repo.active_branch\n        self.repo.git.add(name, data)\n        self.repo.git.commit(\"-m\", \"Stored object {}\".format(name))\n        self.objects[name] = data\n\n    def retrieve_object(self, name):\n        if name not in self.objects:\n            raise ValueError(\"Object with name '{}' does not exist\".format(name))\n        branch = self.repo.active_branch\n        self.repo.git checkout(branch)\n        self.repo.git checkout -b 'temp-branch'\n        self.repo.git checkout 'temp-branch'\n        self.repo.git add name\n        self.repo.git checkout branch\n        return self.repo.git.show(name)\n\n    def delete_object(self, name):\n        if name not in self.objects:\n            raise ValueError(\"Object with name '{}' does not exist\".format(name))\n        branch = self.repo.active_branch\n        self.repo.git checkout branch\n        self.repo.git checkout -b 'temp-branch'\n        self.repo.git checkout 'temp-branch'\n        self.repo.git rm name\n        self.repo.git checkout branch\n        self.repo.git commit(\"-m\", \"Deleted object {}\".format(name))\n        del self.objects[name]\n\ndef main():\n    db = ObjectDatabase('/path/to/repo')\n    # Usage\n    db.store_object('test.txt', 'Hello, World!')\n    print(db.retrieve_object('test.txt'))\n    db.delete_object('test.txt')\n\nif __name__ == \"__main__\":\n    main()\n```\n\nThis code uses the Git Python library to interact with a Git repository. It defines a class `ObjectDatabase` that stores objects in the Git repository. The `store_object` method adds an object to the repository, the `retrieve_object` method retrieves an object from the repository, and the `delete_object` method deletes an object from the repository. The `main` function demonstrates how to use the `ObjectDatabase` class."
"```python\nimport pickle\nimport zlib\nimport io\n\nclass CustomPickler(pickle.Pickler):\n    def dump_with_optional_compression(self, file, compression=None):\n        if compression is not None:\n            compressed_data = zlib.compress(self.dumps(), level=compression)\n            file.write(compressed_data)\n        else:\n            super().dump(file)\n\n# Usage:\nwith open('data.pkl', 'wb') as f:\n    pickler = CustomPickler(f, compression=9)  # level 9 is the highest compression\n    pickler.dump((1, 2, 3))\n```"
"```python\nimport re\n\nclass MarkdownProcessor:\n    def __init__(self):\n        pass\n\n    def text_to_html(self, text):\n        lines = text.split('\\n')\n        html = ''\n        for line in lines:\n            line = line.strip()\n            if line.startswith('# '):\n                level = line[2:].count(' ')\n                line = line[len('# '):].strip()\n                html += '<h' + str(level) + '>' + line + '</h' + str(level) + '>\\n'\n            elif line.startswith('*'):\n                line = line[1:].strip()\n                html += '<em>' + line + '</em>\\n'\n            elif line.startswith('**'):\n                line = line[2:].strip()\n                html += '<strong>' + line + '</strong>\\n'\n            elif line.startswith('---'):\n                html += '<hr>\\n'\n            elif line.startswith('## '):\n                level = line[3:].count(' ')\n                line = line[len('## '):].strip()\n                html += '<h' + str(level + 1) + '>' + line + '</h' + str(level + 1) + '>\\n'\n            elif line.startswith('### '):\n                level = line[4:].count(' ')\n                line = line[len('### '):].strip()\n                html += '<h' + str(level + 2) + '>' + line + '</h' + str(level + 2) + '>\\n'\n            elif line.startswith('#### '):\n                level = line[6:].count(' ')\n                line = line[len('#### '):].strip()\n                html += '<h' + str(level + 3) + '>' + line + '</h' + str(level + 3) + '>\\n'\n            elif line.startswith('##### '):\n                level = line[7:].count(' ')\n                line = line[len('##### '):].strip()\n                html += '<h' + str(level + 4) + '>' + line + '</h' + str(level + 4) + '>\\n'\n            elif line.startswith('###### '):\n                level = line[8:].count(' ')\n                line = line[len('###### '):].strip()\n                html += '<h' + str(level + 5) + '>' + line + '</h' + str(level + 5) + '>\\n'\n            elif line.startswith('###### '):\n                line = line.strip()\n                html += '<p>' + line + '</p>\\n'\n            else:\n                html += '<p>' + line + '</p>\\n'\n        return html\n\ndef main():\n    processor = MarkdownProcessor()\n    text = \"\"\"\n# Heading 1\n## Heading 2\n### Heading 3\n#### Heading 4\n##### Heading 5\n###### Heading 6\nThis is a paragraph of text.\n\"\"\"\n    html = processor.text_to_html(text)\n    print(html)\n\nif __name__ == \"__main__\":\n    main()\n```"
