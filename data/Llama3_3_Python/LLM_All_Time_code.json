"```python\nimport hashlib\nimport hmac\nimport base64\n\ndef generate_signature(data, private_key):\n    \"\"\"\n    Generate a digital signature for the given data using the private key.\n    \"\"\"\n    # Convert data to bytes\n    data_bytes = str(data).encode('utf-8')\n    \n    # Create a new SHA-256 hash object\n    hash_object = hashlib.sha256()\n    \n    # Update the hash object with the data bytes\n    hash_object.update(data_bytes)\n    \n    # Get the hash value as bytes\n    hash_bytes = hash_object.digest()\n    \n    # Convert the hash bytes to a hexadecimal string\n    hash_hex = hash_bytes.hex()\n    \n    # Create a new HMAC object using the private key and the hash value\n    hmac_object = hmac.new(private_key.encode('utf-8'), hash_bytes, hashlib.sha256)\n    \n    # Get the HMAC value as bytes\n    hmac_bytes = hmac_object.digest()\n    \n    # Convert the HMAC bytes to a hexadecimal string\n    hmac_hex = hmac_bytes.hex()\n    \n    return hmac_hex\n\ndef verify_signature(data, public_key, signature):\n    \"\"\"\n    Verify the digital signature for the given data using the public key.\n    \"\"\"\n    # Convert data to bytes\n    data_bytes = str(data).encode('utf-8')\n    \n    # Create a new SHA-256 hash object\n    hash_object = hashlib.sha256()\n    \n    # Update the hash object with the data bytes\n    hash_object.update(data_bytes)\n    \n    # Get the hash value as bytes\n    hash_bytes = hash_object.digest()\n    \n    # Create a new HMAC object using the public key and the hash value\n    hmac_object = hmac.new(public_key.encode('utf-8'), hash_bytes, hashlib.sha256)\n    \n    # Get the HMAC value as bytes\n    expected_hmac_bytes = hmac_object.digest()\n    \n    # Convert the HMAC bytes to a hexadecimal string\n    expected_hmac_hex = expected_hmac_bytes.hex()\n    \n    # Check if the expected HMAC value matches the provided signature\n    return hmac_hex == expected_hmac_hex\n\ndef encrypt_data(data, public_key):\n    \"\"\"\n    Encrypt the given data using the public key.\n    \"\"\"\n    # Convert data to bytes\n    data_bytes = str(data).encode('utf-8')\n    \n    # Create a new RSA object using the public key\n    rsa_object = RSA()\n    \n    # Encrypt the data using the public key\n    encrypted_data = rsa_object.encrypt(data_bytes)\n    \n    return encrypted_data\n\ndef decrypt_data(encrypted_data, private_key):\n    \"\"\"\n    Decrypt the given encrypted data using the private key.\n    \"\"\"\n    # Create a new RSA object using the private key\n    rsa_object = RSA()\n    \n    # Decrypt the data using the private key\n    decrypted_data = rsa_object.decrypt(encrypted_data)\n    \n    return decrypted_data\n\nclass RSA:\n    def __init__(self):\n        self.public_key = None\n        self.private_key = None\n    \n    def generate_keys(self):\n        # Generate a new RSA key pair\n        self.public_key, self.private_key = self.generate_key_pair()\n    \n    def generate_key_pair(self):\n        # Generate a new RSA key pair\n        key = RSA.generate(2048)\n        return key.publickey(), key\n        \ndef transmit_data(data, trusted_environment, untrusted_environment):\n    \"\"\"\n    Transmit the given data to the untrusted environment while ensuring its integrity and authenticity.\n    \"\"\"\n    # Generate a new digital signature for the data using the private key\n    signature = generate_signature(data, trusted_environment['private_key'])\n    \n    # Encrypt the data using the public key\n    encrypted_data = encrypt_data(data, trusted_environment['public_key'])\n    \n    # Create a new message that includes the encrypted data and the digital signature\n    message = encrypted_data + ':' + signature\n    \n    # Transmit the message to the untrusted environment\n    print(\"Transmitting message:\", message)\n    \n    # Verify the digital signature in the received message\n    received_message = untrusted_environment['received_message']\n    signature = received_message.split(':')[-1]\n    if verify_signature(received_message.split(':')[0], trusted_environment['public_key'], signature):\n        print(\"Data integrity and authenticity verified.\")\n    else:\n        print(\"Data integrity or authenticity compromised.\")\n\n# Example usage:\nif __name__ == \"__main__\":\n    trusted_environment = {\n        'private_key': 'your_private_key',\n        'public_key': 'your_public_key',\n        'received_message': 'your_encrypted_data:your_signature'\n    }\n    \n    untrusted_environment = {\n        'private_key': 'your_untrusted_private_key',\n        'public_key': 'your_untrusted_public_key'\n    }\n    \n    data = \"Hello, World!\"\n    transmit_data(data, trusted_environment, untrusted_environment)\n```"
