"```python\nimport importlib.util\nimport sys\n\ndef get_entry_point(spec):\n    spec = spec.replace('lib', '')\n    spec = spec.replace('.', '/')\n    try:\n        spec = spec.replace('==', '')\n        spec = spec.replace('>=', '')\n        spec = spec.replace('<=', '')\n    except AttributeError:\n        pass\n\n    spec = spec.replace('==', '')\n    spec = spec.replace('>=', '')\n    spec = spec.replace('<=', '')\n\n    if spec.startswith('=='):\n        spec = spec[2:]\n    elif spec.startswith('>'):\n        spec = spec[1:]\n    elif spec.startswith('<'):\n        spec = spec[1:]\n    elif spec.startswith('-'):\n        spec = spec[1:]\n\n    spec = spec.replace('/', '.')\n    spec = spec.replace('-', '.')\n\n    spec = spec.replace('lib', '')\n\n    try:\n        spec = spec.replace('==', '')\n        spec = spec.replace('>=', '')\n        spec = spec.replace('<=', '')\n    except AttributeError:\n        pass\n\n    module_spec = importlib.util.spec_from_string(f\"module://{spec}.py\")\n    module = importlib.util.module_from_spec(module_spec)\n    module_spec.loader.exec_module(module)\n    return module\n```"
"```python\nimport re\nfrom collections import defaultdict\n\nclass CSSParser:\n    def __init__(self, file_path):\n        self.file_path = file_path\n        self.css_rules = defaultdict(dict)\n\n    def parse_css(self):\n        with open(self.file_path, 'r') as file:\n            css_content = file.read()\n\n        rules = re.findall(r'([^{]+)\\s*\\{\\s*([^}]+)\\s*\\}', css_content)\n        for rule in rules:\n            selector, properties = rule\n            properties = re.split(r';|:', properties)\n            for prop in properties:\n                if prop:\n                    key, value = prop.split(':', 1)\n                    self.css_rules[selector][key.strip()] = value.strip()\n\n    def get_selectors(self):\n        return list(self.css_rules.keys())\n\n    def get_properties(self, selector):\n        return self.css_rules.get(selector, {})\n\n    def get_property_value(self, selector, property_name):\n        return self.css_rules.get(selector, {}).get(property_name)\n\n# Example usage:\nparser = CSSParser('path_to_your_css_file.css')\nparser.parse_css()\nselectors = parser.get_selectors()\nprint(selectors)\n\nselector = 'your_selector_here'\nproperties = parser.get_properties(selector)\nprint(properties)\n\nproperty_name = 'your_property_name_here'\nproperty_value = parser.get_property_value(selector, property_name)\nprint(property_value)\n```"
