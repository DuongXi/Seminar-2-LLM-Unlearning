"```python\nimport asyncio\nimport websockets\n\nclass WebSocketStateMachine:\n    def __init__(self):\n        self.clients = set()\n\n    async def handle_connection(self, websocket, path):\n        self.clients.add(websocket)\n        print(f\"New connection established: {websocket.remote_address}\")\n\n        try:\n            async for message in websocket:\n                print(f\"Received message: {message}\")\n                await self.process_message(websocket, message)\n        except websockets.ConnectionClosed:\n            print(f\"Connection closed: {websocket.remote_address}\")\n            self.clients.remove(websocket)\n\n    async def process_message(self, websocket, message):\n        # Handle incoming message here\n        print(f\"Handling message: {message}\")\n        # You can add your logic to process the message here\n\n    async def start(self):\n        async with websockets.serve(self.handle_connection, \"localhost\", 8765):\n            print(\"Server started on port 8765\")\n            await asyncio.Future()  # run forever\n\nif __name__ == \"__main__\":\n    state_machine = WebSocketStateMachine()\n    asyncio.run(state_machine.start())\n```"
"```python\nfrom dataclasses import dataclass\nimport json\n\n@dataclass\nclass Person:\n    name: str\n    age: int\n    occupation: str\n\ndef serialize_to_json(data):\n    return json.dumps(data, indent=4)\n\ndef deserialize_from_json(json_str):\n    return json.loads(json_str)\n\nperson = Person(\"John Doe\", 30, \"Software Engineer\")\n\njson_str = serialize_to_json(person)\n\ndeserialized_person = deserialize_from_json(json_str)\n\nprint(deserialized_person)\n```"
"```python\nfrom wtforms import Form, StringField, validators\n\nclass UserForm(Form):\n    username = StringField('Username', [validators.Length(min=4, max=25)])\n    email = StringField('Email', [validators.Length(min=6, max=35), validators.Email()])\n\nclass UserFormValidator:\n    def validate_username(self, field):\n        if len(field.data) < 4 or len(field.data) > 25:\n            raise validators.ValidationError('Username must be between 4 and 25 characters')\n\n    def validate_email(self, field):\n        if not validators.email(field.data):\n            raise validators.ValidationError('Invalid email address')\n\n# Example usage:\nuser_form = UserForm()\nuser_form.username.data = 'test_user'\nuser_form.email.data = 'test@example.com'\n\nif user_form.validate():\n    print('Form is valid')\nelse:\n    for field, errors in user_form.errors.items():\n        print(f'Error in {field}: {errors}')\n```"
"```python\nimport socket\n\n# Get the current network interface information\ninfo = socket.getaddrinfo(None, None)\n\n# Print the results\nfor result in info:\n    # Extract the address family (AF_INET for IPv4)\n    family = result[0]\n    \n    # Check if the address family is IPv4\n    if family == socket.AF_INET:\n        # Extract the IP address, hostname, port, and protocol\n        ip_address, hostname, port, protocol = result[1], result[2], result[3], result[4]\n        \n        # Print the IP address and hostname\n        print(f\"IP Address: {ip_address}\")\n        print(f\"Hostname: {hostname}\")\n        print(f\"Port: {port}\")\n        print(f\"Protocol: {protocol}\\n\")\n```"
"```python\nfrom typing import TypeVar, Generic, Type, Callable, Iterable, Sequence, Mapping, Any\n\nfrom abc import ABC, abstractmethod\n\nT = TypeVar('T')\nK = TypeVar('K')\nV = TypeVar('V')\n\nclass AbstractBaseTypes(Generic[T, K, V]):\n    @abstractmethod\n    def __new__(cls, *args, **kwargs):\n        pass\n\nclass AbstractSequence(AbstractBaseTypes[Sequence[T], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __len__(self):\n        pass\n\nclass AbstractMapping(AbstractBaseTypes[Mapping[K, V], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __setitem__(self, key, value):\n        pass\n\n    @abstractmethod\n    def __delitem__(self, key):\n        pass\n\nclass AbstractIterable(AbstractBaseTypes[Iterable[T], None, None]):\n    @abstractmethod\n    def __iter__(self):\n        pass\n\n    @abstractmethod\n    def __next__(self):\n        pass\n\nclass AbstractType(AbstractBaseTypes[Type[T], K, V]):\n    @abstractmethod\n    def __origin__(self):\n        pass\n\n    @abstractmethod\n    def __args__(self):\n        pass\n\nclass AbstractCallable(AbstractBaseTypes[Callable[[T], V], None, None]):\n    @abstractmethod\n    def __call__(self, *args, **kwargs):\n        pass\n\nclass AbstractGenericAbstractBaseTypes(Generic[T, K, V]):\n    @abstractmethod\n    def __new__(cls, *args, **kwargs):\n        pass\n\nclass AbstractGenericSequence(AbstractGenericAbstractBaseTypes[Sequence[T], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __len__(self):\n        pass\n\nclass AbstractGenericMapping(AbstractGenericAbstractBaseTypes[Mapping[K, V], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __setitem__(self, key, value):\n        pass\n\n    @abstractmethod\n    def __delitem__(self, key):\n        pass\n\nclass AbstractGenericIterable(AbstractGenericAbstractBaseTypes[Iterable[T], None, None]):\n    @abstractmethod\n    def __iter__(self):\n        pass\n\n    @abstractmethod\n    def __next__(self):\n        pass\n\nclass AbstractGenericType(AbstractGenericAbstractBaseTypes[Type[T], K, V]):\n    @abstractmethod\n    def __origin__(self):\n        pass\n\n    @abstractmethod\n    def __args__(self):\n        pass\n\nclass AbstractGenericCallable(AbstractGenericAbstractBaseTypes[Callable[[T], V], None, None]):\n    @abstractmethod\n    def __call__(self, *args, **kwargs):\n        pass\n\nclass AbstractGenericAbstractBaseTypes(Generic[T, K, V]):\n    @abstractmethod\n    def __new__(cls, *args, **kwargs):\n        pass\n\nclass AbstractGenericSequence(AbstractGenericAbstractBaseTypes[Sequence[T], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __len__(self):\n        pass\n\nclass AbstractGenericMapping(AbstractGenericAbstractBaseTypes[Mapping[K, V], None, None]):\n    @abstractmethod\n    def __getitem__(self, key):\n        pass\n\n    @abstractmethod\n    def __setitem__(self, key, value):\n        pass\n\n    @abstractmethod\n    def __delitem__(self, key):\n        pass\n\nclass AbstractGenericIterable(AbstractGenericAbstractBaseTypes[Iterable[T], None, None]):\n    @abstractmethod\n    def __iter__(self):\n        pass\n\n    @abstractmethod\n    def __next__(self):\n        pass\n\nclass AbstractGenericType(AbstractGenericAbstractBaseTypes[Type[T], K, V]):\n    @abstractmethod\n    def __origin__(self):\n        pass\n\n    @abstractmethod\n    def __args__(self):\n        pass\n\nclass AbstractGenericCallable(AbstractGenericAbstractBaseTypes[Callable[[T], V], None, None]):\n    @abstractmethod\n    def __call__(self, *args, **kwargs):\n        pass\n```\n\nPlease note that this code is a direct implementation and may not cover all edge cases. For example, abstract classes are not meant to be instantiated directly, and some methods may require additional parameters or handling."
"```python\nfrom google.cloud import vision\nfrom google.cloud.vision import types\n\ndef recognize_image(image_path):\n    # Create a client instance\n    client = vision.ImageAnnotatorClient()\n\n    # Load the image\n    with open(image_path, 'rb') as image_file:\n        content = image_file.read()\n\n    # Define the image\n    image = types.Image(content=content)\n\n    # Perform image recognition\n    response = client.label_detection(image=image)\n    labels = response.label_annotations\n\n    # Print the labels\n    print(\"Labels:\")\n    for label in labels:\n        print(f\"{label.description}: {label.score}\")\n\n    # Annotate the image\n    response = client.text_detection(image=image)\n    texts = response.text_annotations\n\n    # Print the texts\n    print(\"\\nTexts:\")\n    for text in texts:\n        print(f\"{text.description}: {text.bounding_poly.vertices[0].x}, {text.bounding_poly.vertices[0].y}, {text.bounding_poly.vertices[1].x}, {text.bounding_poly.vertices[1].y}\")\n\ndef detect_faces(image_path):\n    # Create a client instance\n    client = vision.ImageAnnotatorClient()\n\n    # Load the image\n    with open(image_path, 'rb') as image_file:\n        content = image_file.read()\n\n    # Define the image\n    image = types.Image(content=content)\n\n    # Perform face detection\n    response = client.face_detection(image=image)\n    faces = response.face_annotations\n\n    # Print the faces\n    print(\"\\nFaces:\")\n    for face in faces:\n        print(f\"Label: {face.label}, Confidence: {face.score}, Bounding Poly: ({face.bounding_poly.vertices[0].x}, {face.bounding_poly.vertices[0].y}), ({face.bounding_poly.vertices[1].x}, {face.bounding_poly.vertices[1].y}), ({face.bounding_poly.vertices[2].x}, {face.bounding_poly.vertices[2].y}), ({face.bounding_poly.vertices[3].x}, {face.bounding_poly.vertices[3].y})\")\n\ndef detect_objects(image_path):\n    # Create a client instance\n    client = vision.ImageAnnotatorClient()\n\n    # Load the image\n    with open(image_path, 'rb') as image_file:\n        content = image_file.read()\n\n    # Define the image\n    image = types.Image(content=content)\n\n    # Perform object detection\n    response = client.object_localization(image=image)\n    localization_data = response.localization_map\n\n    # Print the objects\n    print(\"\\nObjects:\")\n    for object in localization_data.object_localizations:\n        score = object.score\n        print(f\"Object: {object.description}, Confidence: {score}\")\n\n# Test the functions\nrecognize_image('path_to_your_image.jpg')\ndetect_faces('path_to_your_image.jpg')\ndetect_objects('path_to_your_image.jpg')\n```"
"```python\nfrom pyodbc import connect\n\ndef create_connection(server, database, username, password):\n    \"\"\"\n    Establish a connection to a Microsoft SQL Server database.\n\n    Args:\n        server (str): The server name or IP address of the SQL Server instance.\n        database (str): The name of the database to connect to.\n        username (str): The username to use for the connection.\n        password (str): The password to use for the connection.\n\n    Returns:\n        conn: A connection object to the SQL Server database.\n    \"\"\"\n    return connect(f'DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};UID={username};PWD={password}')\n\n# Example usage:\nif __name__ == \"__main__\":\n    server = \"your_server_name\"\n    database = \"your_database_name\"\n    username = \"your_username\"\n    password = \"your_password\"\n\n    conn = create_connection(server, database, username, password)\n    print(\"Connected to the database.\")\n    conn.close()\n```"
"### CRC Generator Code\n\n#### 1. General CRC Calculator\n\n```python\ndef crc_calculator(data, polynomial):\n    \"\"\"\n    Calculates the acyclic redundancy check (CRC) for given data using a specified polynomial.\n\n    Args:\n    - data (bytes): The data to be checked.\n    - polynomial (int): The CRC polynomial.\n\n    Returns:\n    - crc (int): The calculated CRC.\n    \"\"\"\n    crc = 0xFFFFFFFF\n    for byte in data:\n        crc = (crc ^ byte) & 0xFFFFFFFF\n        for _ in range(8):\n            if crc & 1:\n                crc = (crc >> 1) ^ polynomial\n            else:\n                crc = crc >> 1\n    return ~crc & 0xFFFFFFFF\n\n# Example usage:\ndata = b'Hello, World!'\npolynomial = 0xEDB88320\ncrc = crc_calculator(data, polynomial)\nprint(f'CRC: {crc}')\n```\n\n#### 2. CRC-32 Generator\n\n```python\ndef crc32_generator(data):\n    \"\"\"\n    Generates a CRC-32 checksum for a given string of binary data.\n\n    Args:\n    - data (bytes): The data to be checked.\n\n    Returns:\n    - crc (int): The calculated CRC-32.\n    \"\"\"\n    polynomial = 0xEDB88320\n    crc = 0xFFFFFFFF\n    for byte in data:\n        crc = (crc ^ byte) & 0xFFFFFFFF\n        for _ in range(8):\n            if crc & 1:\n                crc = (crc >> 1) ^ polynomial\n            else:\n                crc = crc >> 1\n    return ~crc & 0xFFFFFFFF\n\n# Example usage:\ndata = b'Hello, World!'\ncrc = crc32_generator(data)\nprint(f'CRC-32: {crc}')\n```\n\n#### 3. CRC-64 Generator\n\n```python\ndef crc64_generator(data):\n    \"\"\"\n    Generates a CRC-64 checksum for a given string of binary data.\n\n    Args:\n    - data (bytes): The data to be checked.\n\n    Returns:\n    - crc (int): The calculated CRC-64.\n    \"\"\"\n    polynomial = 0x106AA078\n    crc = 0xFFFFFFFFFFFFFFFF\n    for byte in data:\n        crc = (crc ^ byte) & 0xFFFFFFFFFFFFFFFF\n        for _ in range(8):\n            if crc & 1:\n                crc = (crc >> 1) ^ polynomial\n            else:\n                crc = crc >> 1\n    return ~crc & 0xFFFFFFFFFFFFFFFF\n\n# Example usage:\ndata = b'Hello, World!'\ncrc = crc64_generator(data)\nprint(f'CRC-64: {crc}')\n```\n\n#### 4. CRC Generator for Multiple Blocks\n\n```python\ndef crc_generator(data_blocks):\n    \"\"\"\n    Calculates the CRC for each block separately.\n\n    Args:\n    - data_blocks (list[bytes]): The blocks of data to be checked.\n\n    Returns:\n    - crcs (list[int]): A list of calculated CRCs.\n    \"\"\"\n    polynomials = [0xEDB88320, 0x106AA078]  # CRC-32 and CRC-64 polynomials\n    crcs = []\n    for block in data_blocks:\n        crc = 0xFFFFFFFF\n        for byte in block:\n            crc = (crc ^ byte) & 0xFFFFFFFF\n            for _ in range(8):\n                if crc & 1:\n                    crc = (crc >> 1) ^ polynomials[0]\n                else:\n                    crc = crc >> 1\n        crcs.append(~crc & 0xFFFFFFFF)\n    return crcs\n\n# Example usage:\ndata_blocks = [b'Hello, World!', b'Foo Bar']\ncrcs = crc_generator(data_blocks)\nfor crc, block in zip(crcs, data_blocks):\n    print(f'CRC: {crc}, Block: {block}')\n```\n\nNote that the CRC polynomials used in this code are the standard polynomials for CRC-32 and CRC-64. These polynomials may vary depending on the specific requirements of your application."
"```python\nfrom autopep8 import fix_code\n\ndef format_code(code):\n    \"\"\"Format Python code according to the PEP 8 style guide.\"\"\"\n    return fix_code(code, options={\"aggressive\": True, \"aggressive_indent\": 4, \"max_line_length\": 79})\n\n# Example usage:\ncode = \"\"\"\nif True:\n    print('Hello, World!')\n    print('This is a test.')\n\"\"\"\nformatted_code = format_code(code)\nprint(formatted_code)\n```"
"```python\nfrom datetime import datetime\n\nclass DateTime:\n    @staticmethod\n    def parse(date_string):\n        \"\"\"\n        Parse a date string into a datetime object.\n        \n        Args:\n        date_string (str): The date string to parse.\n        \n        Returns:\n        datetime: The parsed datetime object.\n        \"\"\"\n        return datetime.strptime(date_string, \"%Y-%m-%d %H:%M:%S\")\n\n    @staticmethod\n    def format(date_object, format_string):\n        \"\"\"\n        Format a datetime object into a string.\n        \n        Args:\n        date_object (datetime): The datetime object to format.\n        format_string (str): The format string to use.\n        \n        Returns:\n        str: The formatted string.\n        \"\"\"\n        return date_object.strftime(format_string)\n\n    @staticmethod\n    def to_datetime(date_string):\n        \"\"\"\n        Parse a date string into a datetime object.\n        \n        Args:\n        date_string (str): The date string to parse.\n        \n        Returns:\n        datetime: The parsed datetime object.\n        \"\"\"\n        return datetime.strptime(date_string, \"%Y-%m-%d\")\n\n    @staticmethod\n    def to_date(date_object):\n        \"\"\"\n        Format a datetime object into a date string.\n        \n        Args:\n        date_object (datetime): The datetime object to format.\n        \n        Returns:\n        str: The formatted date string.\n        \"\"\"\n        return date_object.strftime(\"%Y-%m-%d\")\n\n    @staticmethod\n    def to_time(date_object):\n        \"\"\"\n        Format a datetime object into a time string.\n        \n        Args:\n        date_object (datetime): The datetime object to format.\n        \n        Returns:\n        str: The formatted time string.\n        \"\"\"\n        return date_object.strftime(\"%H:%M:%S\")\n```"
"```python\nimport msgpack\nimport msgpack unpacker\n\ndef serialize(obj):\n    \"\"\"Serialize a Python object into a bytes message using msgpack.\"\"\"\n    return msgpack.packb(obj)\n\ndef deserialize(bytes_obj):\n    \"\"\"Deserialize a bytes message into a Python object using msgpack.\"\"\"\n    return msgpack.unpackb(bytes_obj, raw=False)\n```"
