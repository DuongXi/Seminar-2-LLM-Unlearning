"```python\nimport os\nimport subprocess\nimport json\n\nclass AwsCLI:\n    def __init__(self):\n        self.aliases = {\n            'ec2': 'ec2',\n            's3': 's3',\n            'iam': 'iam'\n        }\n        self.commands = {\n            'ec2': {\n                'create_instance': 'create_instance',\n                'delete_instance': 'delete_instance',\n                'list_instances': 'describe_instances'\n            },\n            's3': {\n                'create_bucket': 'create_bucket',\n                'delete_bucket': 'delete_bucket',\n                'list_buckets': 'list_buckets'\n            },\n            'iam': {\n                'create_user': 'create_user',\n                'delete_user': 'delete_user',\n                'list_users': 'list_users'\n            }\n        }\n\n    def execute_command(self, command, args=None):\n        if args is None:\n            args = []\n\n        for alias, cmd in self.commands.items():\n            if command in cmd:\n                for key, value in cmd.items():\n                    args.append(f'--{key}={value}')\n\n        subprocess.run(['aws', *args], check=True)\n\n    def create_ec2_instance(self, instance_type, ami_id, key_pair_name, security_group_ids):\n        args = ['ec2', 'run-instances', '--instance-type', instance_type, '--image-id', ami_id, '--key-name', key_pair_name, '--security-group-ids', ','.join(security_group_ids)]\n        self.execute_command('ec2', args)\n\n    def delete_ec2_instance(self, instance_id):\n        args = ['ec2', 'terminate-instances', instance_id]\n        self.execute_command('ec2', args)\n\n    def list_ec2_instances(self):\n        args = ['ec2', 'describe-instances']\n        self.execute_command('ec2', args)\n\n    def create_s3_bucket(self, bucket_name):\n        args = ['s3', 'mb', bucket_name]\n        self.execute_command('s3', args)\n\n    def delete_s3_bucket(self, bucket_name):\n        args = ['s3', 'mb', bucket_name]\n        self.execute_command('s3', args)\n\n    def list_s3_buckets(self):\n        args = ['s3', 'ls']\n        self.execute_command('s3', args)\n\n    def create_iam_user(self, username):\n        args = ['iam', 'create-user', username]\n        self.execute_command('iam', args)\n\n    def delete_iam_user(self, username):\n        args = ['iam', 'delete-user', username]\n        self.execute_command('iam', args)\n\n    def list_iam_users(self):\n        args = ['iam', 'list-users']\n        self.execute_command('iam', args)\n\ndef main():\n    aws_cli = AwsCLI()\n\n    while True:\n        print('AWS CLI')\n        print('--------')\n        print('1. EC2')\n        print('2. S3')\n        print('3. IAM')\n        print('4. Exit')\n\n        choice = input('Choose an option: ')\n\n        if choice == '1':\n            print('EC2 Options')\n            print('---------')\n            print('1. Create instance')\n            print('2. Delete instance')\n            print('3. List instances')\n\n            ec2_choice = input('Choose an option: ')\n\n            if ec2_choice == '1':\n                instance_type = input('Enter instance type: ')\n                ami_id = input('Enter AMI ID: ')\n                key_pair_name = input('Enter key pair name: ')\n                security_group_ids = input('Enter security group IDs (comma separated): ').split(',')\n                aws_cli.create_ec2_instance(instance_type, ami_id, key_pair_name, security_group_ids)\n            elif ec2_choice == '2':\n                instance_id = input('Enter instance ID: ')\n                aws_cli.delete_ec2_instance(instance_id)\n            elif ec2_choice == '3':\n                aws_cli.list_ec2_instances()\n\n        elif choice == '2':\n            print('S3 Options')\n            print('--------')\n            print('1. Create bucket')\n            print('2. Delete bucket')\n            print('3. List buckets')\n\n            s3_choice = input('Choose an option: ')\n\n            if s3_choice == '1':\n                bucket_name = input('Enter bucket name: ')\n                aws_cli.create_s3_bucket(bucket_name)\n            elif s3_choice == '2':\n                bucket_name = input('Enter bucket name: ')\n                aws_cli.delete_s3_bucket(bucket_name)\n            elif s3_choice == '3':\n                aws_cli.list_s3_buckets()\n\n        elif choice == '3':\n            print('IAM Options')\n            print('--------')\n            print('1. Create user')\n            print('2. Delete user')\n            print('3. List users')\n\n            iam_choice = input('Choose an option: ')\n\n            if iam_choice == '1':\n                username = input('Enter username: ')\n                aws_cli.create_iam_user(username)\n            elif iam_choice == '2':\n                username = input('Enter username: ')\n                aws_cli.delete_iam_user(username)\n            elif iam_choice == '3':\n                aws_cli.list_iam_users()\n\n        elif choice == '4':\n            break\n\n        else:\n            print('Invalid choice')\n\nif __name__ == '__main__':\n    main()\n```\n\nThis script creates a simple command-line interface for managing AWS resources. It includes options for creating and deleting EC2 instances, S3 buckets, and IAM users. The user can navigate through the options using numbers and execute the desired action."
"```python\nimport re\nimport json\n\n# Define a function to parse JSON data using regular expressions\ndef parse_json(json_str):\n    pattern = r'\"(\\w+)\"\\s*:\\s*\"([^\"]*)\"'\n    matches = re.findall(pattern, json_str)\n    return {match[0]: match[1] for match in matches}\n\n# Define a function to convert Python objects to JSON strings\ndef obj_to_json(obj):\n    return json.dumps(obj, indent=4)\n\n# Define a function to convert JSON strings to Python objects\ndef json_to_obj(json_str):\n    return json.loads(json_str)\n\n# Example usage:\njson_str = '{\"name\": \"John\", \"age\": 30, \"city\": \"New York\"}'\nparsed_json = parse_json(json_str)\nprint(parsed_json)\n\nobj = {\"name\": \"Jane\", \"age\": 25, \"city\": \"London\"}\njson_str = obj_to_json(obj)\nprint(json_str)\n\nnew_obj = json_to_obj(json_str)\nprint(new_obj)\n```"
"```python\nimport struct\n\n# ASN.1 Type Enum\nclass ASN1Type:\n    INT = 0\n    OCTET_STRING = 1\n    SEQUENCE = 2\n    SET = 3\n    CHOICE = 4\n    ANY = 5\n\n# ASN.1 Type Definition\nclass ASN1TypeDefinition:\n    def __init__(self, tag, type):\n        self.tag = tag\n        self.type = type\n\n    def to_der(self):\n        return struct.pack('!H', self.tag) + struct.pack('!B', self.type)\n\n# DER Encoding\ndef der_encode(value, type_definition):\n    if type_definition.type == ASN1Type.SET:\n        return b''.join(der_encode(v, t) for v, t in zip(value, type_definition.type))\n    elif type_definition.type == ASN1Type CHOICE:\n        return b''.join(der_encode(v, t) for v, t in zip(value, type_definition.type))\n    else:\n        return struct.pack('!B', value) + der_encode(type_definition.type, type_definition)\n\n# BER Encoding\ndef ber_encode(value, type_definition):\n    if type_definition.type == ASN1Type.OCTET_STRING:\n        return b''.join(struct.pack('!B', v) for v in value)\n    elif type_definition.type == ASN1Type.SEQUENCE:\n        return struct.pack('!B', len(value)) + b''.join(ber_encode(v, t) for v, t in zip(value, type_definition.type))\n    else:\n        return struct.pack('!B', value)\n\n# CER Encoding\ndef cer_encode(value, type_definition):\n    return b''.join(der_encode(v, t) for v, t in zip(value, type_definition.type))\n\n# Example Usage:\ntype_def = ASN1TypeDefinition(0x30, [ASN1TypeDefinition(0x05, ASN1Type.OCTET_STRING), ASN1TypeDefinition(0x03, ASN1Type.OCTET_STRING)])\nvalue = [b'Hello', b'World']\n\nder_encoded = der_encode(value, type_def)\nber_encoded = ber_encode(value, type_def)\ncer_encoded = cer_encode(value, type_def)\n\nprint(der_encoded)\nprint(ber_encoded)\nprint(cer_encoded)\n```"
"```python\nimport random\n\ndef is_prime(num):\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef gcd(a, b):\n    while b != 0:\n        a, b = b, a % b\n    return a\n\ndef mod_inverse(a, m):\n    def extended_gcd(a, b):\n        if a == 0:\n            return b, 0, 1\n        else:\n            gcd, x, y = extended_gcd(b % a, a)\n            return gcd, y - (b // a) * x, x\n\n    gcd, x, _ = extended_gcd(a, m)\n    if gcd != 1:\n        return None\n    else:\n        return x % m\n\ndef keygen(p, q):\n    n = p * q\n    phi = (p - 1) * (q - 1)\n    e = random.randrange(1, phi)\n    while gcd(e, phi) != 1:\n        e = random.randrange(1, phi)\n    d = mod_inverse(e, phi)\n    return ((e, n), (d, n))\n\ndef encrypt(public_key, message):\n    e, n = public_key\n    encrypted_message = [pow(ord(char), e, n) for char in message]\n    return encrypted_message\n\ndef decrypt(private_key, encrypted_message):\n    d, n = private_key\n    decrypted_message = [chr(pow(char, d, n)) for char in encrypted_message]\n    return ''.join(decrypted_message)\n\n# Example usage:\np = random.randint(2**7, 2**8)\nq = random.randint(2**7, 2**8)\nwhile not is_prime(p) or not is_prime(q):\n    p = random.randint(2**7, 2**8)\n    q = random.randint(2**7, 2**8)\n\npublic_key, private_key = keygen(p, q)\n\nmessage = \"Hello, World!\"\nencrypted_message = encrypt(public_key, message)\ndecrypted_message = decrypt(private_key, encrypted_message)\n\nprint(\"Message:\", message)\nprint(\"Encrypted Message:\", encrypted_message)\nprint(\"Decrypted Message:\", decrypted_message)\n```"
"from setuptools import setup, find_packages\nimport os\n\nwith open(\"README.md\", \"r\") as f:\n    long_description = f.read()\n\nsetup(\n    name=\"my_package\",\n    version=\"1.0.0\",\n    author=\"Your Name\",\n    author_email=\"your@email.com\",\n    description=\"A brief description of your package\",\n    long_description=long_description,\n    long_description_content_type=\"text/markdown\",\n    url=\"https://github.com/your-username/my-package\",\n    packages=find_packages(),\n    install_requires=[],\n    classifiers=[\n        \"Programming Language :: Python :: 3\",\n        \"License :: OSI Approved :: MIT License\",\n        \"Operating System :: OS Independent\",\n    ],\n    python_requires=\">=3.6\",\n    include_package_data=True,\n    zip_safe=False,\n)\n\nwith open(\"MANIFEST.in\", \"w\") as f:\n    f.write(\"include my_package\")"
"```python\nimport numpy as np\n\n# Create a 1D array\narray1 = np.array([1, 2, 3, 4, 5])\nprint(\"1D Array: \", array1)\n\n# Create a 2D array\narray2 = np.array([[1, 2], [3, 4]])\nprint(\"2D Array: \\n\", array2)\n\n# Create an array with a specific data type\narray3 = np.array([1, 2, 3, 4, 5], dtype=float)\nprint(\"Float Array: \", array3)\n\n# Create an array with a specified shape\narray4 = np.array([1, 2, 3, 4, 5], dtype=int).reshape(2, 2)\nprint(\"Reshaped Array: \\n\", array4)\n\n# Indexing\nprint(\"Indexing: \", array1[0])\nprint(\"Indexing: \", array1[-1])\n\n# Slicing\nprint(\"Slicing: \", array1[1:3])\nprint(\"Slicing: \", array2[0:2, 0:2])\n\n# Element-wise arithmetic\narray5 = np.array([[1, 2], [3, 4]])\narray6 = np.array([[5, 6], [7, 8]])\nprint(\"Element-wise Addition:\\n\", array5 + array6)\nprint(\"Element-wise Subtraction:\\n\", array5 - array6)\nprint(\"Element-wise Multiplication:\\n\", array5 * array6)\nprint(\"Element-wise Division:\\n\", array5 / array6)\n```"
"```python\nfrom typing import (\n    Literal,\n    Union,\n    Protocol,\n    Any,\n    TypeHint,\n    TypeVar,\n    Generic,\n    NewType,\n    cast,\n    get_origin,\n    get_args,\n)\n\nfrom typing_extensions import (\n    Optional,\n    Union as _Union,\n    Literal as _Literal,\n    Protocol as _Protocol,\n    TypeGuard,\n)\n\nfrom typing_inspect import get_origin, get_args\n\n# Define a type hint for a union type\ndef union_type(*args):\n    return _Union(*args)\n\n# Define a type hint for a literal type\ndef literal_type(*args):\n    return _Literal(*args)\n\n# Define a type hint for a protocol\ndef protocol_type(*args):\n    return _Protocol(*args)\n\n# Define a generic type hint\nT = TypeVar('T')\nclass GenericType(Generic[T]):\n    pass\n\n# Define a new type hint for a union type with a specific origin\ndef union_type_origin(*args):\n    return _Union[get_origin(args[0])](*args)\n\n# Define a type guard for a union type\ndef union_type_guard(arg: Any, *args):\n    return cast(UnionType, arg)  # Replace UnionType with the actual type\n\n# Define a type hint for an optional type\ndef optional_type(*args):\n    return Optional[get_origin(args[0])(*args)]\n\n# Define a type hint for a union type with a specific origin and args\ndef union_type_args(*args):\n    return _Union[get_origin(args[0])](*args)\n\n# Define a type hint for a protocol with a specific origin and args\ndef protocol_type_args(*args):\n    return _Protocol[get_origin(args[0])](*args)\n```"
