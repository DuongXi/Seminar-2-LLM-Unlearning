"```python\nimport terminal\nimport rich\nfrom rich.console import Console\nfrom rich.table import Table\nfrom rich.markdown import Markdown\nfrom rich.progress import Progress\nfrom rich.highlighter import Highlighter\n\n# Initialize the console\nconsole = Console()\n\n# Create a table\ntable = Table(title=\"Table Example\")\ntable.add_column(\"Column 1\", style=\"cyan\")\ntable.add_column(\"Column 2\", style=\"magenta\")\n\n# Add rows to the table\ntable.add_row(\"Row 1\", \"Cell 1\")\ntable.add_row(\"Row 2\", \"Cell 2\")\n\n# Print the table\nconsole.print(table)\n\n# Render Markdown\nconsole.print(Markdown(\"# Heading\\nThis is a paragraph.\"))\n\n# Render a progress bar\nprogress = Progress()\nwith progress:\n    task = progress.add_task(\"[bold magenta]Task[/bold magenta]\", total=10)\n    for i in range(10):\n        progress.update(task, advance=1)\n        # Simulate some work\n        import time\n        time.sleep(0.1)\n\n# Highlighter example\nhighlighter = Highlighter(\"python\")\nhighlighter.highlight(\"def add(a, b):\\n    return a + b\")\n\n```"
"```python\nimport typing\n\ndef check_type(variable, expected_type):\n    \"\"\"\n    Checks if the type of a variable matches the expected type.\n\n    Args:\n    variable (any): The variable to check.\n    expected_type (type): The expected type of the variable.\n\n    Raises:\n    TypeError: If the type of the variable does not match the expected type.\n    \"\"\"\n    if not isinstance(variable, expected_type):\n        raise TypeError(f\"Expected {expected_type.__name__}, got {type(variable).__name__}\")\n\n\n# Example usage:\nclass Person:\n    def __init__(self, name: str, age: int):\n        self.name = name\n        self.age = age\n\n    def greet(self) -> str:\n        return f\"Hello, my name is {self.name} and I am {self.age} years old.\"\n\n\ndef main():\n    # Check if a string is a string\n    check_type(\"Hello\", str)\n\n    # Check if an integer is an integer\n    check_type(123, int)\n\n    # Check if a list is a list\n    check_type([1, 2, 3], list)\n\n    # Create a Person object\n    person = Person(\"John\", 30)\n\n    # Check if the person object is a Person object\n    check_type(person, Person)\n\n    # Check if the person object's greet method returns a string\n    check_type(person.greet(), str)\n\n\nif __name__ == \"__main__\":\n    main()\n```"
