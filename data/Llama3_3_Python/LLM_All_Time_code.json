"```python\nimport trio\n\nasync def handle_connection(stream):\n    # Handle incoming data from the stream\n    while True:\n        message = await stream.receive_some(1024)\n        if not message:\n            break\n        # Process the message\n        print(f\"Received message: {message.decode()}\")\n\nasync def main():\n    # Create a WebSocket server that listens on port 8765\n    async with trio.open_nursery() as nursery:\n        nursery.start_serve(\n            trio.web.server.make_service(\n                trio.web.server.make_handler(\n                    trio.web.resource.WebSocketResource(\n                        trio.web.resource.WebSocketEndpoint(\n                            handle_connection\n                        )\n                    )\n                )\n            ),\n            \"127.0.0.1:8765\"\n        )\n\ntrio.run(main)\n```"
