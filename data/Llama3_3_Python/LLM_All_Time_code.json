"```python\nimport pydanny\nimport ast\n\ndef scan_code(project_path):\n    tree = ast.parse(open(project_path).read())\n    classes = []\n    functions = []\n    modules = []\n\n    for node in ast.walk(tree):\n        if isinstance(node, ast.ClassDef):\n            classes.append(node.name)\n        elif isinstance(node, ast.FunctionDef):\n            functions.append(node.name)\n        elif isinstance(node, ast.Module):\n            modules.append(node.name)\n\n    documentation = {\n        \"classes\": classes,\n        \"functions\": functions,\n        \"modules\": modules\n    }\n\n    return documentation\n\ndef generate_documentation(project_path, output_format):\n    documentation = scan_code(project_path)\n    if output_format == \"md\":\n        with open(\"documentation.md\", \"w\") as f:\n            f.write(\"# Project Documentation\\n\")\n            f.write(\"## Classes\\n\")\n            for class_name in documentation[\"classes\"]:\n                f.write(f\"- {class_name}\\n\")\n            f.write(\"\\n## Functions\\n\")\n            for function_name in documentation[\"functions\"]:\n                f.write(f\"- {function_name}\\n\")\n            f.write(\"\\n## Modules\\n\")\n            for module_name in documentation[\"modules\"]:\n                f.write(f\"- {module_name}\\n\")\n    elif output_format == \"rst\":\n        with open(\"documentation.rst\", \"w\") as f:\n            f.write(\".. automodule:: __init__\\n\")\n            f.write(\".. automodule:: class1\\n\")\n            f.write(\".. automodule:: function1\\n\")\n            f.write(\".. automodule:: module1\\n\")\n    elif output_format == \"json\":\n        import json\n        with open(\"documentation.json\", \"w\") as f:\n            json.dump(documentation, f)\n\nproject_path = \"path_to_your_project\"\noutput_format = \"md\"\ngenerate_documentation(project_path, output_format)\n```"
"```python\nimport os\nfrom rich import print\nfrom rich.console import Console\nfrom rich.table import Table\n\nclass TextBasedApp:\n    def __init__(self):\n        self.console = Console()\n\n    def clear_screen(self):\n        os.system('cls' if os.name == 'nt' else 'clear')\n\n    def display_header(self, title):\n        self.console.print(f\"[bold magenta]{title}[/bold magenta]\")\n        self.console.print(\"-\" * len(title))\n\n    def display_table(self, table):\n        self.console.print(table)\n\n    def display_message(self, message):\n        self.console.print(message)\n\n    def run(self):\n        while True:\n            self.clear_screen()\n            self.display_header(\"Text-Based Application\")\n            self.display_message(\"Welcome to our text-based application!\")\n            table = Table(title=\"Application Status\")\n            table.add_column(\"Status\", style=\"cyan\")\n            table.add_row(\"Running\")\n            self.display_table(table)\n            choice = input(\"Enter 'q' to quit or any other key to continue: \")\n            if choice.lower() == 'q':\n                break\n\n\nif __name__ == \"__main__\":\n    app = TextBasedApp()\n    app.run()\n```"
"```python\nimport asyncio\nimport logging\nfrom typing import Callable, Any\n\n# Define a logger\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\n# ASGI application factory\nasync def application_factory(\n    config: dict[str, Any],\n    middlewares: list[Callable[[dict[str, Any]], Any]] = None,\n) -> Callable[[dict[str, Any]], Any]:\n    def app(scope: dict[str, Any], receive: Callable[[Any], None], send: Callable[[Any], None]):\n        if middlewares is not None:\n            for middleware in middlewares:\n                middleware(config)\n\n        await receive(config)\n        response = await send(config)\n        logger.info(f\"Received {response['status']} {response['body']}\")\n        return response\n\n    return app\n\n\n# ASGI application\nasync def my_app(scope: dict[str, Any], receive: Callable[[Any], None], send: Callable[[Any], None]):\n    logger.info(\"Received request\")\n    await receive({\"type\": \"http.request\", \"method\": \"GET\", \"path\": \"/\"})\n    await send({\"type\": \"http.response\", \"status\": 200, \"body\": \"Hello, world!\"})\n\n\n# ASGI adapter for Starlette\ndef starlette_adapter(app: Callable[[dict[str, Any]], Any]) -> Callable[[dict[str, Any]], Any]:\n    async def starlette_app(scope: dict[str, Any], receive: Callable[[Any], None], send: Callable[[Any], None]):\n        return await app(scope, receive, send)\n\n    return starlette_app\n\n\n# ASGI adapter for FastAPI\ndef fastapi_adapter(app: Callable[[dict[str, Any]], Any]) -> Callable[[dict[str, Any]], Any]:\n    async def fastapi_app(scope: dict[str, Any], receive: Callable[[Any], None], send: Callable[[Any], None]):\n        return await app(scope, receive, send)\n\n    return fastapi_app\n\n\n# ASGI adapter for SQLAlchemy\ndef sqlalchemy_adapter(app: Callable[[dict[str, Any]], Any]) -> Callable[[dict[str, Any]], Any]:\n    async def sqlalchemy_app(scope: dict[str, Any], receive: Callable[[Any], None], send: Callable[[Any], None]):\n        # Initialize SQLAlchemy database\n        from sqlalchemy import create_engine, Column, Integer, String\n        from sqlalchemy.ext.declarative import declarative_base\n        from sqlalchemy.orm import sessionmaker\n\n        engine = create_engine(\"sqlite:///example.db\")\n        Base = declarative_base()\n\n        Session = sessionmaker(bind=engine)\n        session = Session()\n\n        # Call ASGI application\n        return await app(scope, receive, send)\n\n    return sqlalchemy_app\n```"
