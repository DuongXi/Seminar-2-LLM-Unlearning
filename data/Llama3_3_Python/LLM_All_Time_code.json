"```python\nimport chardet\n\ndef detect_encoding(text):\n    \"\"\"\n    Detects the encoding of a given string using the chardet library.\n    \n    Args:\n    text (str): The string to detect the encoding for.\n    \n    Returns:\n    dict: A dictionary containing the detected encoding and its confidence level.\n    \n    Raises:\n    Exception: If the encoding cannot be detected.\n    \"\"\"\n    result = chardet.detect(text.encode())\n    if 'encoding' in result and result['encoding']:\n        return result\n    else:\n        raise Exception(\"Unable to detect encoding\")\n\n# Example usage:\ntext = \"Hello, World!\"\ntry:\n    encoding = detect_encoding(text)\n    print(f\"Detected encoding: {encoding['encoding']}, Confidence: {encoding['confidence']}\")\nexcept Exception as e:\n    print(e)\n```"
