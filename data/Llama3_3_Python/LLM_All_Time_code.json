"```python\nfrom os import path\nfrom shutil import which\nfrom contextlib import contextmanager\nimport zipfile\n\nclass ZipPath:\n    def __init__(self, zip_file):\n        self.zip_file = zip_file\n\n    @property\n    def path(self):\n        return path.basename(self.zip_file)\n\n    @property\n    def is_dir(self):\n        return path.isfile(self.zip_file) and path.getsize(self.zip_file) > 0\n\n    def __enter__(self):\n        self.original_cwd = os.getcwd()\n        os.chdir(path.dirname(self.zip_file))\n\n    def __exit__(self, exc_type, exc_val, exc_tb):\n        os.chdir(self.original_cwd)\n\n@contextmanager\ndef zip_context(zip_file):\n    if not path.isfile(zip_file):\n        raise FileNotFoundError(f\"The file '{zip_file}' does not exist.\")\n    if not zipfile.is_zipfile(zip_file):\n        raise ValueError(f\"'{zip_file}' is not a valid ZIP file.\")\n    yield ZipPath(zip_file)\n\n# Usage:\nwith zip_context('path_to_your_zip_file.zip') as zip_path:\n    print(zip_path.path)\n    print(zip_path.is_dir)\n```"
"```python\nimport ast\n\ndef parse_c_code(code):\n    try:\n        return ast.parse(code, mode='c')\n    except SyntaxError as e:\n        print(f\"Syntax error in C code: {e}\")\n        return None\n\ndef main():\n    c_code = \"\"\"\n    int main() {\n        int x = 5;\n        int y = 10;\n        return x + y;\n    }\n    \"\"\"\n    tree = parse_c_code(c_code)\n\n    if tree is not None:\n        print(\"Abstract Syntax Tree:\")\n        print(ast.dump(tree))\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport requests\nimport hmac\nimport base64\nimport json\nimport time\nimport urllib.parse\n\ndef generate_signature(client_id, client_secret, method, url, headers, body):\n    \"\"\"\n    Generates a signature for an OAuth request.\n    \n    Args:\n        client_id (str): The client ID.\n        client_secret (str): The client secret.\n        method (str): The HTTP method (e.g., GET, POST, PUT, DELETE).\n        url (str): The URL of the request.\n        headers (dict): The headers of the request.\n        body (dict): The body of the request.\n    \n    Returns:\n        str: The base64-encoded signature.\n    \"\"\"\n    # Create a dictionary of all the parameters\n    params = {\n        'client_id': client_id,\n        'client_secret': client_secret,\n        'method': method,\n        'url': url,\n        'headers': headers,\n        'body': body\n    }\n\n    # Convert the parameters to JSON\n    params_json = json.dumps(params)\n\n    # Encode the JSON string\n    encoded_params = urllib.parse.quote_plus(params_json)\n\n    # Compute the HMAC-SHA256 signature\n    signature = hmac.new(\n        client_secret.encode('utf-8'),\n        (encoded_params + method + url + str(time.time())).encode('utf-8'),\n        'sha256'\n    ).digest()\n\n    # Return the base64-encoded signature\n    return base64.b64encode(signature).decode('utf-8')\n\ndef oauth_sign_request(client_id, client_secret, method, url, headers, body):\n    \"\"\"\n    Signs an OAuth request using the provided client ID and client secret.\n    \n    Args:\n        client_id (str): The client ID.\n        client_secret (str): The client secret.\n        method (str): The HTTP method (e.g., GET, POST, PUT, DELETE).\n        url (str): The URL of the request.\n        headers (dict): The headers of the request.\n        body (dict): The body of the request.\n    \n    Returns:\n        dict: The signed request headers.\n    \"\"\"\n    # Generate the signature\n    signature = generate_signature(client_id, client_secret, method, url, headers, body)\n\n    # Update the headers with the signature\n    headers['oauth_signature_method'] = 'HMAC-SHA256'\n    headers['oauth_timestamp'] = str(int(time.time()))\n    headers['oauth_nonce'] = str(int(time.time() * 1000))\n    headers['oauth_version'] = '1.0'\n    headers['oauth_signature'] = signature\n\n    return headers\n\n# Example usage:\nclient_id = 'your_client_id'\nclient_secret = 'your_client_secret'\nmethod = 'GET'\nurl = 'https://api.example.com/endpoint'\nheaders = {'Content-Type': 'application/json'}\nbody = {'key': 'value'}\n\nsigned_headers = oauth_sign_request(client_id, client_secret, method, url, headers, body)\nprint(signed_headers)\n```"
"```python\nimport base64\nimport hmac\nimport json\nimport hashlib\nfrom cryptography.hazmat.primitives import serialization, hashes\nfrom cryptography.hazmat.primitives.asymmetric import padding\nfrom cryptography.hazmat.primitives import serialization\nfrom cryptography.hazmat.backends import default_backend\nfrom cryptography.exceptions import InvalidSignature\n\ndef generate_jwt(payload, key):\n    # Generate JWT header\n    header = {\n        'alg': 'RS256',\n        'typ': 'JWT'\n    }\n\n    # Generate JWT payload\n    payload_json = json.dumps(payload)\n\n    # Generate JWT signature\n    jwt = {\n        'header': header,\n        'payload': payload_json\n    }\n\n    # Sign the JWT using the HMAC SHA-256 algorithm\n    signature = hmac.new(key, jwt.encode(), hashlib.sha256).digest()\n\n    # Return the JWT\n    return {\n        'header': header,\n        'payload': payload_json,\n        'signature': base64.urlsafe_b64encode(signature).decode('utf-8')\n    }\n\ndef verify_jwt(jwt, key):\n    # Extract the JWT signature\n    signature = jwt['signature']\n    jwt_json = jwt['payload']\n    jwt_header = jwt['header']\n\n    # Load the key\n    key = serialization.load_pem_private_key(\n        key,\n        password=None,\n        backend=default_backend()\n    )\n\n    # Verify the JWT signature\n    try:\n        jwt.verify(\n            signature,\n            jwt_header['header'],\n            algorithm=jwt_header['alg'],\n            headers=jwt_header,\n            key=key\n        )\n    except InvalidSignature:\n        return False\n    except Exception as e:\n        return str(e)\n\n    # Return True if the JWT is valid\n    return True\n\n# Example usage\nprivate_key = \"\"\"\nMIIEpAIBAAKCAQEAnrj7V1xQrB7xXqZ1fXxG8jJ7z7xJzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjz\njzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzjzj"
