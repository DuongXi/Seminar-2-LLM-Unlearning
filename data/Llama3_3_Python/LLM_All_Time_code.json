"```python\nimport fcntl\nimport os\n\ndef create_lock_file(lock_file, exclusive=True):\n    \"\"\"\n    Create a lock file using fcntl.flock and return the file descriptor.\n    If exclusive is True, the lock is acquired exclusively.\n    \"\"\"\n    with open(lock_file, 'w') as f:\n        if exclusive:\n            fcntl.flock(f, fcntl.LOCK_EX)\n        else:\n            fcntl.flock(f, fcntl.LOCK_SH)\n\ndef release_lock_file(lock_file):\n    \"\"\"\n    Release the lock on a file using fcntl.flock.remove.\n    \"\"\"\n    fcntl.flock(lock_file, fcntl.LOCK_UN)\n    os.remove(lock_file)\n\ndef check_lock_file(lock_file):\n    \"\"\"\n    Check if a lock file exists and return its existence.\n    \"\"\"\n    return os.path.exists(lock_file)\n\nlock_file = \"lock.txt\"\n\n# Create the lock file\ncreate_lock_file(lock_file)\n\n# Check if the lock file exists\nif check_lock_file(lock_file):\n    print(f\"The lock file {lock_file} exists.\")\nelse:\n    print(f\"The lock file {lock_file} does not exist.\")\n\n# Release the lock file\nrelease_lock_file(lock_file)\n```"
