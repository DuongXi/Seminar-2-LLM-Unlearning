"```python\nimport asyncio\nimport pytest\n\nasync def my_async_function():\n    await asyncio.sleep(1)\n    return \"Hello, World!\"\n\n@pytest.mark.asyncio\nasync def test_my_async_function():\n    result = await my_async_function()\n    assert result == \"Hello, World!\"\n\n# Test with concurrent execution\nasync def test_concurrent_execution():\n    tasks = [my_async_function(), my_async_function()]\n    results = await asyncio.gather(*tasks)\n    assert results[0] == \"Hello, World!\"\n    assert results[1] == \"Hello, World!\"\n\n# Test with concurrent execution and timeout\nasync def test_concurrent_execution_timeout():\n    tasks = [my_async_function(), my_async_function()]\n    result = await asyncio.wait_for(asyncio.gather(*tasks), timeout=0.5)\n    assert len(result) == 2\n    assert result[0] == \"Hello, World!\"\n    assert result[1] == \"Hello, World!\"\n```"
"```python\nimport asyncio\nimport ssl\nimport aiohttp\n\nasync def create_tls_transport(host, port):\n    async with ssl.create_default_context(ssl.Purpose.CLIENT_AUTH) as ctx:\n        ctx.load_cert_chain('path_to_your_cert.pem', 'path_to_your_key.pem')\n        ctx.load_verify_locations('path_to_your_ca.pem')\n        ctx.verify_mode = ssl.CERT_REQUIRED\n        return await ctx.wrap_socket(await aiohttp.ClientSocket(host, port))\n```"
