"```python\nfrom twilio.twiml.v1 import TwiML\n\ndef create_twiml_response(phone_number, greeting_message, message, hang_up_message):\n    twiml = TwiML()\n    twiml.gather(\n        numDigits=1,\n        action=\"http://example.com/handle\",\n        method=\"POST\",\n        data={\n            \"phone_number\": phone_number,\n            \"message\": message\n        }\n    )\n    \n    greeting = twiml.say(greeting_message)\n    twiml.say(message)\n    twiml.gather(\n        numDigits=1,\n        action=\"http://example.com/hangup\",\n        method=\"POST\",\n        data={\n            \"phone_number\": phone_number,\n            \"message\": hang_up_message\n        }\n    )\n    twiml.hangup()\n\n# Example usage:\ntwiml_response = create_twiml_response(\"+1234567890\", \"Welcome to our call!\", \"Thank you for calling us!\", \"Goodbye!\")\n```"
