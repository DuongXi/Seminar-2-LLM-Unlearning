"```python\nimport dask\nfrom dask.distributed import Client\nfrom dask.config import set\n\n# Set Dask configuration\nset({\n    'scheduler': 'threads',\n    'threads-per-process': 4,\n    'threads-per-core': 2,\n    'memory-limit': '10GB',\n    'temp-dir': '/tmp'\n})\n\n# Create a Dask client\nclient = Client(n_workers=4, threads_per_worker=2, threads_per_core=1)\n\n# Define a function to be executed\ndef task(x):\n    return x * x\n\n# Define a list of inputs for the task\ninputs = [1, 2, 3, 4, 5]\n\n# Use Dask to execute the task in parallel\nresults = client.map(task, inputs)\n\n# Wait for all tasks to complete\nclient.wait()\n\n# Check the results\nfor result in results:\n    print(result)\n\n# Close the Dask client\nclient.close()\n```"
