"```python\nimport requests\nimport oauthlib.oauth1\n\nclass OAuthSession(requests.Session):\n    def __init__(self, consumer_key, consumer_secret, token=None, token_secret=None):\n        super(OAuthSession, self).__init__()\n        self.consumer_key = consumer_key\n        self.consumer_secret = consumer_secret\n        self.token = token\n        self.token_secret = token_secret\n        self._build_authorization()\n\n    def _build_authorization(self):\n        if self.token and self.token_secret:\n            auth = oauthlib.oauth1.OAuth1(\n                consumer_key=self.consumer_key,\n                consumer_secret=self.consumer_secret,\n                token=self.token,\n                token_secret=self.token_secret\n            )\n        else:\n            auth = oauthlib.oauth1.OAuth1(\n                consumer_key=self.consumer_key,\n                consumer_secret=self.consumer_secret\n            )\n        self.headers['Authorization'] = auth.authorize_url()\n\n    def request(self, method, url, **kwargs):\n        self._build_authorization()\n        return super(OAuthSession, self).request(method, url, **kwargs)\n\n# Usage:\nconsumer_key = 'your_consumer_key'\nconsumer_secret = 'your_consumer_secret'\nurl = 'https://api.example.com/endpoint'\n\nsession = OAuthSession(consumer_key, consumer_secret)\nresponse = session.get(url)\n\nprint(response.status_code)\nprint(response.text)\n```"
