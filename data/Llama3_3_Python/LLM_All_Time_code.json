"```python\nimport boto3\n\n# Create an IAM client to manage IAM roles\niam = boto3.client('iam')\n\n# Create an IAM role for EC2 instance\niam.create_role(\n    RoleName='EC2InstanceRole',\n    AssumeRolePolicyDocument={\n        'Version': '2012-10-17',\n        'Statement': [\n            {\n                'Effect': 'Allow',\n                'Principal': {\n                    'Service': 'ec2.amazonaws.com'\n                },\n                'Action': 'sts:AssumeRole'\n            }\n        ]\n    }\n)\n\n# Create an IAM policy for EC2 instance\nec2_policy = {\n    'Version': '2012-10-17',\n    'Statement': [\n        {\n            'Effect': 'Allow',\n            'Action': [\n                'ec2:StartInstances',\n                'ec2:StopInstances',\n                'ec2:RebootInstances',\n                'ec2:DescribeInstances'\n            ],\n            'Resource': '*'\n        }\n    ]\n}\n\niam.create_policy(\n    PolicyName='EC2InstancePolicy',\n    PolicyDocument=ec2_policy\n)\n\n# Attach the IAM policy to the IAM role\niam.attach_role_policy(\n    RoleName='EC2InstanceRole',\n    PolicyArn=boto3.client('iam').get_policy(PolicyName='EC2InstancePolicy')['Policy']['Arn']\n)\n\n# Create an IAM role for RDS database\nrds_role = iam.create_role(\n    RoleName='RDSInstanceRole',\n    AssumeRolePolicyDocument={\n        'Version': '2012-10-17',\n        'Statement': [\n            {\n                'Effect': 'Allow',\n                'Principal': {\n                    'Service': 'rds.amazonaws.com'\n                },\n                'Action': 'sts:AssumeRole'\n            }\n        ]\n    }\n)\n\n# Create an IAM policy for RDS database\nrds_policy = {\n    'Version': '2012-10-17',\n    'Statement': [\n        {\n            'Effect': 'Allow',\n            'Action': [\n                'rds:CreateDBInstance',\n                'rds:ModifyDBInstance',\n                'rds:RebootDBInstance',\n                'rds:DescribeDBInstances'\n            ],\n            'Resource': '*'\n        }\n    ]\n}\n\niam.create_policy(\n    PolicyName='RDSInstancePolicy',\n    PolicyDocument=rds_policy\n)\n\n# Attach the IAM policy to the IAM role\niam.attach_role_policy(\n    RoleName='RDSInstanceRole',\n    PolicyArn=boto3.client('iam').get_policy(PolicyName='RDSInstancePolicy')['Policy']['Arn']\n)\n\n# Create an S3 client to manage S3 buckets\ns3 = boto3.client('s3')\n\n# Create an S3 bucket\ns3.create_bucket(Bucket='my-s3-bucket')\n\n# Create an EC2 client to manage EC2 instances\nec2 = boto3.client('ec2')\n\n# Create an EC2 instance\nec2.run_instances(\n    ImageId='ami-0c94855ba95c71c99',  # Replace with your desired AMI ID\n    InstanceType='t2.micro',\n    MinCount=1,\n    MaxCount=1\n)\n\n# Wait for the EC2 instance to be running\nec2.get_waiter('instance_running').wait(InstanceIds=[ec2.describe_instances()['Reservations'][0]['Instances'][0]['InstanceId']])\n\n# Create an RDS client to manage RDS databases\nrds = boto3.client('rds')\n\n# Create an RDS database\nrds.create_db_instance(\n    DBInstanceClass='db.t2.micro',\n    DBName='my-rds-database',\n    MasterUsername='my-rds-username',\n    MasterUserPassword='my-rds-password'\n)\n\n# Wait for the RDS database to be available\nrds.get_waiter('db_instance_available').wait(DBInstanceIdentifier='my-rds-database')\n```"
"```python\nimport json\nimport requests\nfrom typing import Any, Dict, List\n\nclass AWSCore:\n    def __init__(self, region: str, endpoint: str = None):\n        self.region = region\n        self.endpoint = endpoint or 'https://api.us-east-1.amazonaws.com'\n\n    def _build_url(self, service: str, method: str, path: str, params: Dict[str, Any] = None) -> str:\n        url = f'{self.endpoint}/{self.region}/{service}/{method}'\n        if path:\n            url += '/' + path\n        if params:\n            url += '?' + '&'.join(f'{k}={v}' for k, v in params.items())\n        return url\n\n    def _http_request(self, method: str, url: str, body: Dict[str, Any] = None, headers: Dict[str, str] = None) -> requests.Response:\n        response = requests.request(method, url, json=body, headers=headers)\n        response.raise_for_status()\n        return response\n\n    def _get(self, service: str, path: str, params: Dict[str, Any] = None) -> requests.Response:\n        url = self._build_url(service, 'GET', path, params)\n        return self._http_request('GET', url)\n\n    def _post(self, service: str, path: str, body: Dict[str, Any] = None, headers: Dict[str, str] = None) -> requests.Response:\n        url = self._build_url(service, 'POST', path, body)\n        return self._http_request('POST', url, body, headers)\n\n    def get(self, service: str, path: str, params: Dict[str, Any] = None) -> Dict[str, Any]:\n        response = self._get(service, path, params)\n        return response.json()\n\n    def post(self, service: str, path: str, body: Dict[str, Any] = None, headers: Dict[str, str] = None) -> Dict[str, Any]:\n        response = self._post(service, path, body, headers)\n        return response.json()\n\n# Example usage:\ncore = AWSCore('us-east-1')\nresponse = core.post('lambda', '2014-11-05', {'functionName': 'my-function'})\nprint(response)\n```"
"```python\nfrom __future__ import absolute_import, division, print_function, unicode_literals\nfrom future.builtins import ascii, filter, hex, map, oct, zip\nfrom backports import textwrap\nfrom backports import builtins\nfrom builtins import bytes, object\nfrom builtins import range\nfrom builtins import str\nfrom builtins import int\nfrom builtins import float\nfrom builtins import complex\nfrom builtins import bool\nfrom builtins import tuple\nfrom builtins import zip\nfrom builtins import chr\nfrom builtins import ord\nfrom builtins import len\nfrom builtins import super\nfrom builtins import execfile\nfrom builtins import file\nfrom builtins import ascii\nfrom builtins import filter\nfrom builtins import hex\nfrom builtins import map\nfrom builtins import oct\nfrom builtins import round\nfrom builtins import zip\nfrom builtins import bool\nfrom builtins import object\nfrom builtins import bytes\nfrom builtins import map\nfrom builtins import filter\nfrom builtins import execfile\nfrom builtins import file\nfrom builtins import builtins\nimport textwrap\nimport six\n```"
"```python\nimport pip\n\ndef install_package(package_name):\n    try:\n        pip.main(['install', package_name])\n        print(f\"Package {package_name} installed successfully.\")\n    except Exception as e:\n        print(f\"Failed to install package {package_name}: {e}\")\n\ndef upgrade_packages():\n    try:\n        pip.main(['upgrade'])\n        print(\"All packages upgraded successfully.\")\n    except Exception as e:\n        print(f\"Failed to upgrade packages: {e}\")\n\ndef uninstall_package(package_name):\n    try:\n        pip.main(['uninstall', package_name])\n        print(f\"Package {package_name} uninstalled successfully.\")\n    except Exception as e:\n        print(f\"Failed to uninstall package {package_name}: {e}\")\n\ndef main():\n    while True:\n        print(\"\\n1. Install Package\")\n        print(\"2. Upgrade Packages\")\n        print(\"3. Uninstall Package\")\n        print(\"4. Quit\")\n        \n        choice = input(\"Enter your choice: \")\n        \n        if choice == \"1\":\n            package_name = input(\"Enter the package name to install: \")\n            install_package(package_name)\n        elif choice == \"2\":\n            upgrade_packages()\n        elif choice == \"3\":\n            package_name = input(\"Enter the package name to uninstall: \")\n            uninstall_package(package_name)\n        elif choice == \"4\":\n            break\n        else:\n            print(\"Invalid choice. Please try again.\")\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport requests\nfrom bs4 import BeautifulSoup\nimport json\nimport urllib3\n\n# Disable SSL warnings\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\ndef send_request(url, method='GET', data=None, headers=None, params=None, cookies=None):\n    try:\n        response = requests.request(method, url, data=data, headers=headers, params=params, cookies=cookies)\n        response.raise_for_status()\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"An error occurred: {e}\")\n        return None\n\ndef parse_html(html):\n    soup = BeautifulSoup(html, 'html.parser')\n    return soup\n\ndef make_api_call(url, method='GET', data=None, headers=None, params=None, cookies=None):\n    response = send_request(url, method, data, headers, params, cookies)\n    if response:\n        return parse_html(response.text)\n    return None\n\n# Example usage:\nurl = 'https://jsonplaceholder.typicode.com/todos/1'\nresponse = make_api_call(url)\nif response:\n    print(response.prettify())\n```"
"```python\nimport idna\n\ndef idna_encode(domain_name):\n    try:\n        return idna.encode(domain_name, allow_unassigned=True)\n    except idna.IDNAError as e:\n        return f\"Invalid IDNA encoding: {e}\"\n\ndef idna_decode(ascii_domain_name):\n    try:\n        return idna.decode(ascii_domain_name)\n    except idna.IDNAError as e:\n        return f\"Invalid IDNA decoding: {e}\"\n\n# Example usage:\ndomain_name = \"example.com\"\nascii_domain_name = idna_encode(domain_name)\nprint(f\"IDNA encoded domain name: {ascii_domain_name}\")\n\n# Validation\ntry:\n    idna.decode(domain_name)\n    print(\"Domain name is valid for IDNA encoding.\")\nexcept idna.IDNAError:\n    print(\"Domain name is not valid for IDNA encoding.\")\n\n# Decoding\ntry:\n    idna.decode(ascii_domain_name)\n    print(\"IDNA decoded domain name is valid.\")\nexcept idna.IDNAError:\n    print(\"IDNA decoded domain name is not valid.\")\n```"
"```python\nimport boto3\nfrom botocore.exceptions import NoCredentialsError\n\nclass S3TransferManager:\n    def __init__(self, bucket_name, local_path):\n        self.bucket_name = bucket_name\n        self.local_path = local_path\n        self.s3 = boto3.client('s3')\n\n    def upload_file(self, local_file_path):\n        try:\n            self.s3.upload_file(local_file_path, self.bucket_name, local_file_path.split('/')[-1])\n            print(f\"File {local_file_path} uploaded to {self.bucket_name}\")\n        except FileNotFoundError:\n            print(f\"File {local_file_path} not found\")\n        except NoCredentialsError:\n            print(\"Credentials not available\")\n\n    def download_file(self, remote_file_path):\n        try:\n            self.s3.download_file(self.bucket_name, remote_file_path, self.local_path)\n            print(f\"File {remote_file_path} downloaded to {self.local_path}\")\n        except FileNotFoundError:\n            print(f\"File {self.local_path} not found\")\n        except NoCredentialsError:\n            print(\"Credentials not available\")\n\n# Example usage\nif __name__ == \"__main__\":\n    bucket_name = 'your-bucket-name'\n    local_path = '/path/to/local/file'\n    remote_file_path = 'file.txt'\n\n    s3_transfer_manager = S3TransferManager(bucket_name, local_path)\n    s3_transfer_manager.upload_file(local_path)\n    s3_transfer_manager.download_file(remote_file_path)\n```"
"```python\nfrom datetime import datetime\nimport decimal\n\nclass DateTime:\n    def __init__(self, year, month, day, hour, minute, second, microsecond=0, tzinfo=None):\n        self.year = year\n        self.month = month\n        self.day = day\n        self.hour = hour\n        self.minute = minute\n        self.second = second\n        self.microsecond = microsecond\n        self.tzinfo = tzinfo\n\n    def to_timestamp(self, precision='ns'):\n        if precision == 'ns':\n            return int(self.timestamp_ns())\n        elif precision == 'us':\n            return int(self.timestamp_us())\n        elif precision == 'ms':\n            return int(self.timestamp_ms())\n        else:\n            raise ValueError('Invalid precision')\n\n    @staticmethod\n    def from_timestamp(timestamp, precision='ns'):\n        if precision == 'ns':\n            return DateTime.fromtimestamp_ns(timestamp)\n        elif precision == 'us':\n            return DateTime.fromtimestamp_us(timestamp)\n        elif precision == 'ms':\n            return DateTime.fromtimestamp_ms(timestamp)\n        else:\n            raise ValueError('Invalid precision')\n\n    @staticmethod\n    def from_timestamp_ns(timestamp):\n        return DateTime(\n            year=datetime.fromtimestamp_ns(timestamp).year,\n            month=datetime.fromtimestamp_ns(timestamp).month,\n            day=datetime.fromtimestamp_ns(timestamp).day,\n            hour=datetime.fromtimestamp_ns(timestamp).hour,\n            minute=datetime.fromtimestamp_ns(timestamp).minute,\n            second=datetime.fromtimestamp_ns(timestamp).second,\n            microsecond=datetime.fromtimestamp_ns(timestamp).microsecond,\n        )\n\n    @staticmethod\n    def from_timestamp_us(timestamp):\n        return DateTime(\n            year=datetime.fromtimestamp_us(timestamp).year,\n            month=datetime.fromtimestamp_us(timestamp).month,\n            day=datetime.fromtimestamp_us(timestamp).day,\n            hour=datetime.fromtimestamp_us(timestamp).hour,\n            minute=datetime.fromtimestamp_us(timestamp).minute,\n            second=datetime.fromtimestamp_us(timestamp).second,\n            microsecond=datetime.fromtimestamp_us(timestamp).microsecond,\n        )\n\n    @staticmethod\n    def from_timestamp_ms(timestamp):\n        return DateTime(\n            year=datetime.fromtimestamp_ms(timestamp).year,\n            month=datetime.fromtimestamp_ms(timestamp).month,\n            day=datetime.fromtimestamp_ms(timestamp).day,\n            hour=datetime.fromtimestamp_ms(timestamp).hour,\n            minute=datetime.fromtimestamp_ms(timestamp).minute,\n            second=datetime.fromtimestamp_ms(timestamp).second,\n            microsecond=datetime.fromtimestamp_ms(timestamp).microsecond,\n        )\n\n    def __repr__(self):\n        return f\"DateTime(year={self.year}, month={self.month}, day={self.day}, hour={self.hour}, minute={self.minute}, second={self.second}, microsecond={self.microsecond})\"\n\n    def __str__(self):\n        return f\"{self.year}-{self.month}-{self.day} {self.hour}:{self.minute}:{self.second}.{self.microsecond}\"\n\n    def __eq__(self, other):\n        return (\n            self.year == other.year\n            and self.month == other.month\n            and self.day == other.day\n            and self.hour == other.hour\n            and self.minute == other.minute\n            and self.second == other.second\n            and self.microsecond == other.microsecond\n        )\n\ndef parse_datetime(s, precision='ns'):\n    try:\n        if precision == 'ns':\n            return DateTime.from_timestamp_ns(int(s))\n        elif precision == 'us':\n            return DateTime.from_timestamp_us(int(s))\n        elif precision == 'ms':\n            return DateTime.from_timestamp_ms(int(s))\n        else:\n            raise ValueError('Invalid precision')\n    except Exception as e:\n        raise ValueError(f\"Failed to parse datetime: {e}\")\n\n# Test the new DateTime class\ndt = DateTime(2022, 1, 1, 12, 0, 0, microsecond=123456789)\nprint(dt.to_timestamp('ns'))  # 1643723400.123456789\n\ndt = DateTime.from_timestamp_ns(1643723400.123456789)\nprint(dt)  # 2022-01-01 12:00:00.123456789\n```"
"```python\nimport requests\n\n# URL of the Mozilla SSL CA bundle\nurl = 'https://raw.githubusercontent.com/SSL-for-HTTP/ssl-certificates/master/chainable ca_bundle.pem'\n\n# Send a GET request to the URL\nresponse = requests.get(url)\n\n# Check if the request was successful\nif response.status_code == 200:\n    # Save the response content to a file\n    with open('/etc/ssl/certs/ca_bundle.pem', 'wb') as f:\n        f.write(response.content)\nelse:\n    print(f\"Failed to download the CA bundle. Status code: {response.status_code}\")\n```"
"```python\nimport yaml\n\nclass YAMLParser:\n    def __init__(self, data):\n        self.data = data\n\n    def parse(self):\n        return yaml.safe_load(self.data)\n\n\nclass YAMLEmitter:\n    def __init__(self, data):\n        self.data = data\n\n    def emit(self):\n        return yaml.dump(self.data, default_flow_style=False)\n\n\n# Example usage\nif __name__ == \"__main__\":\n    yaml_data = \"\"\"\n    name: John Doe\n    age: 30\n    address:\n        street: 123 Main St\n        city: Anytown\n        state: CA\n        zip: 12345\n    \"\"\"\n\n    parser = YAMLParser(yaml_data)\n    parsed_data = parser.parse()\n    print(\"Parsed Data:\")\n    print(parsed_data)\n\n    emitter = YAMLEmitter(parsed_data)\n    emitted_data = emitter.emit()\n    print(\"\\nEmitted YAML Data:\")\n    print(emitted_data)\n```"
