"```python\nfrom flask import Flask, render_template\nfrom flask_wtf import FlaskForm\nfrom wtforms import StringField, SubmitField\nfrom wtforms.validators import DataRequired\n\napp = Flask(__name__)\napp.config['SECRET_KEY'] = 'mysecretkey'\n\nclass MyForm(FlaskForm):\n    name = StringField('Name', validators=[DataRequired()])\n    submit = SubmitField('Submit')\n\n@app.route('/', methods=['GET', 'POST'])\ndef index():\n    form = MyForm()\n    if form.validate_on_submit():\n        name = form.name.data\n        return f\"Hello, {name}!\"\n    return render_template('index.html', form=form)\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```"
"```python\nimport requests\nimport json\n\nclass SalesforceAPI:\n    def __init__(self, access_token):\n        self.access_token = access_token\n        self.base_url = \"https://login.salesforce.com\"\n\n    def get(self, endpoint, params=None):\n        headers = {\n            \"Authorization\": f\"Bearer {self.access_token}\",\n            \"Content-Type\": \"application/json\"\n        }\n        response = requests.get(f\"{self.base_url}{endpoint}\", headers=headers, params=params)\n        response.raise_for_status()\n        return response.json()\n\n    def post(self, endpoint, data=None, params=None):\n        headers = {\n            \"Authorization\": f\"Bearer {self.access_token}\",\n            \"Content-Type\": \"application/json\"\n        }\n        response = requests.post(f\"{self.base_url}{endpoint}\", headers=headers, json=data, params=params)\n        response.raise_for_status()\n        return response.json()\n\n    def put(self, endpoint, data=None, params=None):\n        headers = {\n            \"Authorization\": f\"Bearer {self.access_token}\",\n            \"Content-Type\": \"application/json\"\n        }\n        response = requests.put(f\"{self.base_url}{endpoint}\", headers=headers, json=data, params=params)\n        response.raise_for_status()\n        return response.json()\n\n    def delete(self, endpoint, params=None):\n        headers = {\n            \"Authorization\": f\"Bearer {self.access_token}\",\n            \"Content-Type\": \"application/json\"\n        }\n        response = requests.delete(f\"{self.base_url}{endpoint}\", headers=headers, params=params)\n        response.raise_for_status()\n        return response.json()\n\n# Example usage:\nif __name__ == \"__main__\":\n    access_token = \"your_access_token_here\"\n    api = SalesforceAPI(access_token)\n\n    # GET request\n    response = api.get(\"/services/data/v50.0/query\", {\"query\": \"SELECT Id, Name FROM Account\"})\n    print(json.dumps(response, indent=4))\n\n    # POST request\n    data = {\"Name\": \"New Account\", \"AccountNumber\": \"123456789\"}\n    response = api.post(\"/services/data/v50.0/query\", data=data, params={\"query\": \"SELECT Id, Name FROM Account\"})\n    print(json.dumps(response, indent=4))\n\n    # PUT request\n    data = {\"Name\": \"Updated Account\"}\n    response = api.put(\"/services/data/v50.0/query/123456789\", data=data, params={\"query\": \"SELECT Id, Name FROM Account\"})\n    print(json.dumps(response, indent=4))\n\n    # DELETE request\n    response = api.delete(\"/services/data/v50.0/query/123456789\", params={\"query\": \"SELECT Id, Name FROM Account\"})\n    print(json.dumps(response, indent=4))\n```"
"```python\nimport requests\n\nclass GeoIP2:\n    def __init__(self, api_key):\n        self.api_key = api_key\n\n    def lookup_ip(self, ip):\n        url = f\"https://geoip2.maxmind.com/geoip2/json/{self.api_key}/{ip}\"\n        response = requests.get(url)\n        return response.json()\n\ndef main():\n    api_key = \"YOUR_API_KEY\"  # Replace with your MaxMind GeoIP2 API key\n    geo_ip = GeoIP2(api_key)\n\n    ip_address = \"8.8.8.8\"  # Replace with the IP address you want to look up\n    result = geo_ip.lookup_ip(ip_address)\n\n    if result[\"status\"] == \"success\":\n        data = result[\"geoip\"]\n        print(\"Country:\", data[\"country\"][\"names\"][\"en\"])\n        print(\"Region:\", data[\"subdivisions\"][0][\"names\"][\"en\"])\n        print(\"City:\", data[\"city\"][\"names\"][\"en\"])\n        print(\"Latitude:\", data[\"latitude\"])\n        print(\"Longitude:\", data[\"longitude\"])\n    else:\n        print(\"Failed to look up IP address:\", result[\"status\"])\n\nif __name__ == \"__main__\":\n    main()\n```\n\nThis Python script uses the MaxMind GeoIP2 API to look up an IP address and retrieve information such as country, region, city, latitude, and longitude. To use this script, you need to replace `YOUR_API_KEY` with your actual MaxMind GeoIP2 API key."
"```python\nimport traceback\n\nclass TracebackSerializer:\n    @staticmethod\n    def serialize(traceback_obj):\n        \"\"\"Serializes a traceback object into a string.\"\"\"\n        return repr(traceback_obj)\n\n    @staticmethod\n    def deserialize(serialized_str):\n        \"\"\"Deserializes a string back into a traceback object.\"\"\"\n        return eval(serialized_str)\n\n# Example usage\ntry:\n    x = 1 / 0\nexcept ZeroDivisionError:\n    tb = traceback.format_exc()\n    serialized_tb = TracebackSerializer.serialize(tb)\n    print(serialized_tb)\n\n    deserialized_tb = TracebackSerializer.deserialize(serialized_tb)\n    print(deserialized_tb)\n```"
