"```python\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\nimport numpy as np\n\n# Creating a sample dataset\nnp.random.seed(0)\ndata = {\n    'Category': np.random.choice(['A', 'B', 'C'], 100),\n    'Value1': np.random.rand(100),\n    'Value2': np.random.rand(100),\n    'Value3': np.random.rand(100)\n}\ndf = pd.DataFrame(data)\n\n# Line plot\nplt.figure(figsize=(10,6))\nsns.lineplot(data=df, x='Category', y='Value1', palette='viridis')\nplt.title('Line Plot')\nplt.xlabel('Category')\nplt.ylabel('Value1')\nplt.legend(title='Series')\nplt.show()\n\n# Scatter plot\nplt.figure(figsize=(10,6))\nsns.scatterplot(data=df, x='Value1', y='Value2', palette='muted')\nplt.title('Scatter Plot')\nplt.xlabel('Value1')\nplt.ylabel('Value2')\nplt.legend(title='Series')\nplt.show()\n\n# Bar chart\nplt.figure(figsize=(10,6))\nsns.barplot(data=df, x='Category', y='Value3', palette='deep')\nplt.title('Bar Chart')\nplt.xlabel('Category')\nplt.ylabel('Value3')\nplt.legend(title='Series')\nplt.show()\n\n# Histogram\nplt.figure(figsize=(10,6))\nsns.histplot(data=df, x='Value1', kde=True, palette='coolwarm')\nplt.title('Histogram')\nplt.xlabel('Value1')\nplt.ylabel('Frequency')\nplt.show()\n\n# Box plot\nplt.figure(figsize=(10,6))\nsns.boxplot(data=df, x='Category', y='Value2', palette='bright')\nplt.title('Box Plot')\nplt.xlabel('Category')\nplt.ylabel('Value2')\nplt.show()\n\n# Heatmap\ndata = np.random.rand(10, 10)\nplt.figure(figsize=(10,6))\nsns.heatmap(data, annot=True, cmap='hot', fmt='.2f')\nplt.title('Heatmap')\nplt.show()\n```"
"```python\nimport os\nimport requests\nimport hmac\nimport time\nfrom datetime import datetime, timedelta\n\nAWS_ACCESS_KEY_ID = os.environ.get('AWS_ACCESS_KEY_ID')\nAWS_SECRET_ACCESS_KEY = os.environ.get('AWS_SECRET_ACCESS_KEY')\nAWS_REGION = os.environ.get('AWS_REGION')\n\ndef get_signing_date():\n    return datetime.now().strftime('%Y%m%dT%H%M%SZ')\n\ndef get_aws_auth_header(date, region, service, credentials):\n    date = date.replace('Z', '+00:00')\n    signature = hmac.new(\n        credentials.encode('utf-8'),\n        (date + '/' + region + '/' + service + '/aws4_request').encode('utf-8'),\n        digestmod=hmac.new(b'secret_key', b'secret_key', digestmod=hmac.new(b'ssha256', b'sha256', digestmod=hashlib.sha256)).digest()\n    ).digest()\n    signature_hex = signature.hex()\n    signing_date = date\n    signing_region = region\n    signing_service = service\n    signing_sha256 = hashlib.sha256(\n        (signing_date + '/' + signing_region + '/' + signing_service + '/aws4_request').encode('utf-8')\n    ).digest()\n    aws_auth_header = {\n        'Host': f'aws.{signing_region}.amazonaws.com',\n        'Date': signing_date,\n        'Content-Type': 'application/x-www-form-urlencoded',\n        'X-Amz-Date': signing_date,\n        'X-Amz-Region': signing_region,\n        'X-Amz-Signing-Region': signing_region,\n        'X-Amz-Signature': hmac.new(\n            signing_sha256,\n            (f'aws4_request&Content-Type=application/x-www-form-urlencoded&Host=aws.{signing_region}.amazonaws.com&X-Amz-Date={signing_date}&X-Amz-Region={signing_region}&X-Amz-Signing-Region={signing_region}&X-Amz-Signature={signature_hex}'.encode('utf-8'), \n            digestmod=hmac.new(b'secret_key', b'secret_key', digestmod=hashlib.sha256).digest()\n        ).hexdigest(),\n        'AWS4-HMAC-SHA256'\n    }\n    return aws_auth_header\n\ndef get_aws_request_url(path, method='GET', headers=None, data=None, auth=None):\n    if not auth:\n        auth = get_aws_auth_header(get_signing_date(), AWS_REGION, 'execute-api', AWS_SECRET_ACCESS_KEY)\n    response = requests.request(method, f'https://{AWS_ACCESS_KEY_ID}:{auth[\"X-Amz-Access-Key\"]}@{AWS_REGION}.execute-api.amazonaws.com/{path}', headers=headers, data=data, auth=auth)\n    return response\n\n# Usage\npath = '/prod/dev/2023-03-01T00:00:00.000Z/execute-api/2023-03-01T00:00:00.000Z/lambdafunction'\nmethod = 'POST'\nheaders = {}\ndata = {}\nauth = None\n\nresponse = get_aws_request_url(path, method, headers, data, auth)\nprint(response.text)\n```"
