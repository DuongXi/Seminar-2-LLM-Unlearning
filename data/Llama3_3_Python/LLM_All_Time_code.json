"```python\nimport json\n\nclass JsonPathParser:\n    def __init__(self, json_string):\n        self.json_string = json_string\n        self.root = self.parse_json()\n\n    def parse_json(self):\n        return json.loads(self.json_string)\n\n    def parse_path(self, path):\n        nodes = path.split('/')\n        current_node = self.root\n        for node in nodes:\n            if node.isdigit():\n                node = int(node)\n            if node in current_node:\n                current_node = current_node[node]\n            else:\n                return None\n        return current_node\n\n    def evaluate(self, path, value):\n        node = self.parse_path(path)\n        if node is None:\n            return None\n        return self.evaluate_node(node, value)\n\n    def evaluate_node(self, node, value):\n        if isinstance(node, dict):\n            return self.evaluate_dict(node, value)\n        elif isinstance(node, list):\n            return self.evaluate_list(node, value)\n        else:\n            return node == value\n\n    def evaluate_dict(self, dictionary, value):\n        for key, item in dictionary.items():\n            if isinstance(item, (dict, list)):\n                result = self.evaluate(item, value)\n                if result is not None:\n                    return result\n            elif isinstance(item, (int, float)):\n                if item == value:\n                    return True\n        return None\n\n    def evaluate_list(self, list, value):\n        for item in list:\n            if isinstance(item, (dict, list)):\n                result = self.evaluate(item, value)\n                if result is not None:\n                    return result\n            elif isinstance(item, (int, float)):\n                if item == value:\n                    return True\n        return None\n\n\nclass JsonPathEvaluator:\n    def __init__(self, json_string):\n        self.parser = JsonPathParser(json_string)\n\n    def evaluate(self, path, value):\n        return self.parser.evaluate(path, value)\n\n\nclass AbstractSyntaxTree:\n    def __init__(self, value):\n        self.value = value\n\n    def __str__(self):\n        return str(self.value)\n\n\nclass JsonPathNode(AbstractSyntaxTree):\n    def __init__(self, value, left=None, right=None):\n        self.value = value\n        self.left = left\n        self.right = right\n\n    def __str__(self):\n        return f'JsonPathNode({self.value})'\n\n\nclass JsonPathBinaryOperator(JsonPathNode):\n    def __init__(self, left, operator, right):\n        self.left = left\n        self.operator = operator\n        self.right = right\n\n    def __str__(self):\n        return f'JsonPathBinaryOperator({self.left}, {self.operator}, {self.right})'\n\n\nclass JsonPathArithmeticOperator(JsonPathNode):\n    def __init__(self, left, operator, right):\n        self.left = left\n        self.operator = operator\n        self.right = right\n\n    def __str__(self):\n        return f'JsonPathArithmeticOperator({self.left}, {self.operator}, {self.right})'\n\n\nclass JsonPathComparisonOperator(JsonPathNode):\n    def __init__(self, left, operator, right):\n        self.left = left\n        self.operator = operator\n        self.right = right\n\n    def __str__(self):\n        return f'JsonPathComparisonOperator({self.left}, {self.operator}, {self.right})'\n\n\ndef create_node(node_type, value):\n    if node_type == 'number':\n        return int(value)\n    elif node_type == 'string':\n        return str(value)\n    elif node_type == 'dict':\n        return dict()\n    elif node_type == 'list':\n        return []\n    elif node_type == 'boolean':\n        return bool(value)\n    else:\n        raise ValueError('Invalid node type')\n\n\ndef create_binary_operator(operator, left, right):\n    return JsonPathBinaryOperator(left, operator, right)\n\n\ndef create_arithmetic_operator(operator, left, right):\n    return JsonPathArithmeticOperator(left, operator, right)\n\n\ndef create_comparison_operator(operator, left, right):\n    return JsonPathComparisonOperator(left, operator, right)\n\n\ndef parse_path(path):\n    nodes = path.split('/')\n    current_node = None\n    for node in nodes:\n        if node in current_node:\n            current_node = current_node[node]\n        else:\n            current_node = current_node[node] if current_node is not None else create_node('dict', {})\n    return current_node\n\n\ndef evaluate(path, value):\n    node = parse_path(path)\n    if node is None:\n        return None\n    return evaluate_node(node, value)\n\n\ndef evaluate_node(node, value):\n    if isinstance(node, dict):\n        return evaluate_dict(node, value)\n    elif isinstance(node, list):\n        return evaluate_list(node, value)\n    else:\n        return node == value\n\n\ndef evaluate_dict(dictionary, value):\n    for key, item in dictionary.items():\n        if isinstance(item, (dict, list)):\n            result = evaluate(item, value)\n            if result is not None:\n                return result\n        elif isinstance(item, (int, float)):\n            if item == value:\n                return True\n    return None\n\n\ndef evaluate_list(list, value):\n    for item in list:\n        if isinstance(item, (dict, list)):\n            result = evaluate(item, value)\n            if result is not None:\n                return result\n        elif isinstance(item, (int, float)):\n            if item == value:\n                return True\n    return None\n\n\nclass JsonPathParserEvaluator:\n    def __init__(self, json_string):\n        self.parser = JsonPathParser(json_string)\n\n    def evaluate(self, path, value):\n        return self.parser.evaluate(path, value)\n\n\n# Example usage\njson_string = '''\n{\n    \"name\": \"John\",\n    \"age\": 30,\n    \"city\": \"New York\"\n}\n'''\n\nparser = JsonPathParserEvaluator(json_string)\npath = '/name'\nvalue = 'Jane'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: None\n\npath = '/age'\nvalue = 31\nresult = parser.evaluate(path, value)\nprint(result)  # Output: True\n\npath = '/city'\nvalue = 'Los Angeles'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: None\n\npath = '/name'\nvalue = 'Bob'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: None\n\npath = '/age'\nvalue = 25\nresult = parser.evaluate(path, value)\nprint(result)  # Output: False\n\npath = '/city'\nvalue = 'Chicago'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: False\n\npath = '/name'\nvalue = 'John'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: True\n\npath = '/age'\nvalue = 30\nresult = parser.evaluate(path, value)\nprint(result)  # Output: True\n\npath = '/city'\nvalue = 'New York'\nresult = parser.evaluate(path, value)\nprint(result)  # Output: True\n```"
