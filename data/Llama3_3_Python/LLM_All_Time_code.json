"```python\nfrom proton import Connection, Server, Client, Producer, Consumer, Receiver\n\ndef create_amqp_connection(host='localhost', port=5672, username='guest', password='guest'):\n    # Create a server connection\n    conn = Connection.create(\n        host=host, \n        port=port, \n        username=username, \n        password=password\n    )\n    \n    # Create a producer\n    producer = Producer(conn, transport='amqp')\n    \n    # Create a consumer\n    consumer = Consumer(conn, transport='amqp')\n    \n    # Create a receiver\n    receiver = Receiver(conn, transport='amqp')\n    \n    return conn, producer, consumer, receiver\n\n# Example usage\nconn, producer, consumer, receiver = create_amqp_connection()\n```"
"```python\nimport requests\nfrom io import BytesIO\nfrom typing import Any\n\nclass FileTransportAdapter:\n    def __init__(self, url: str):\n        self.url = url\n\n    def get(self, params: Any = None) -> requests.Response:\n        response = requests.get(self.url, params=params)\n        return response\n\n    def post(self, data: Any = None, json: Any = None) -> requests.Response:\n        response = requests.post(self.url, data=data, json=json)\n        return response\n\n    def put(self, data: Any = None, json: Any = None) -> requests.Response:\n        response = requests.put(self.url, data=data, json=json)\n        return response\n\n    def delete(self) -> requests.Response:\n        response = requests.delete(self.url)\n        return response\n\n    def send_file(self, filename: str, chunk_size: int = 1024) -> requests.Response:\n        with open(filename, 'rb') as file:\n            response = requests.put(self.url, data=file, stream=True, chunk_size=chunk_size)\n            return response\n\n    def receive_file(self, filename: str, chunk_size: int = 1024) -> None:\n        with open(filename, 'wb') as file:\n            for chunk in self.get().iter_content(chunk_size=chunk_size):\n                file.write(chunk)\n```"
