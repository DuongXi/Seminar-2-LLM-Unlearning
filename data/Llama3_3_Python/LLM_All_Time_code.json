"```python\nimport github\n\ndef list_public_repos():\n    github.repository_list(type=\"public\")\n\ndef create_repository(repo_name, repo_description):\n    new_repo = github.create_repository(repo_name, repo_description)\n    return new_repo\n\ndef add_collaborator(repo_name, collaborator, email):\n    repo = github.get_repository(repo_name)\n    github.add_collaborator(repo, collaborator, email)\n\ndef get_issues(repository):\n    issues = github.issue_list(repository=repository)\n    return issues\n\ndef create_issue(repository, title, body):\n    issue = github.create_issue(repository=repository, title=title, body=body)\n    return issue\n\ndef get_pull_requests(repository):\n    pull_requests = github.pull_request_list(repository=repository)\n    return pull_requests\n\ndef main():\n    # List all public repositories\n    list_public_repos()\n    \n    # Create a new repository\n    new_repo = create_repository(\"my-new-repo\", \"My New Repo\")\n    print(f\"Created repository: {new_repo.name}\")\n    \n    # Add a collaborator to a repository\n    add_collaborator(\"my-repo\", \"user\", \"Collaborator\")\n    \n    # Get a list of all issues for a repository\n    issues = get_issues(\"my-repo\")\n    for issue in issues:\n        print(f\"Issue: {issue.number}, Title: {issue.title}\")\n    \n    # Create a new issue\n    issue = create_issue(\"my-repo\", \"New Issue\", \"This is a new issue.\")\n    print(f\"Created issue: {issue.number}\")\n    \n    # Get a list of all pull requests for a repository\n    pull_requests = get_pull_requests(\"my-repo\")\n    for pull_request in pull_requests:\n        print(f\"Pull Request: {pull_request.number}, Title: {pull_request.title}\")\n\nif __name__ == \"__main__\":\n    main()\n```"
