"```python\nimport psycopg2\n\n# Define database connection parameters\nhost = 'localhost'\ndatabase = 'mydatabase'\nusername = 'myuser'\npassword = 'mypassword'\n\ntry:\n    # Establish a connection to the database\n    conn = psycopg2.connect(\n        host=host,\n        database=database,\n        user=username,\n        password=password\n    )\n    \n    # Create a cursor object\n    cur = conn.cursor()\n    \n    # Execute an SQL query\n    cur.execute(\"SELECT * FROM mytable\")\n    \n    # Fetch all results\n    results = cur.fetchall()\n    \n    # Print the results\n    for row in results:\n        print(row)\n        \n    # Close the cursor and connection\n    cur.close()\n    conn.close()\n    \nexcept psycopg2.Error as e:\n    print(f\"Error: {e}\")\n```"
"```python\nfrom google.oauth2 import service_account\nfrom googleapiclient.discovery import build\n\n# Replace 'path_to_service_account_key.json' with your actual service account key file\nSCOPES = ['https://www.googleapis.com/auth/cloud-platform']\nSERVICE_ACCOUNT_FILE = 'path_to_service_account_key.json'\n\ndef create_client():\n    credentials = service_account.Credentials.from_service_account_file(\n        SERVICE_ACCOUNT_FILE, scopes=SCOPES)\n    service = build('bigquery', 'v2', credentials=credentials)\n    return service\n\n# Create a client object\nclient = create_client()\n```"
"```python\nimport os\nfrom google.cloud import storage\n\nclass GoogleCloudStorage:\n    def __init__(self, bucket_name):\n        self.bucket_name = bucket_name\n        self.client = storage.Client()\n        self.bucket = self.client.get_bucket(bucket_name)\n\n    def list_buckets(self):\n        return self.bucket.list_blobs()\n\n    def list_objects(self, prefix=''):\n        return self.bucket.list_blobs(prefix=prefix)\n\n    def upload_file(self, local_file_path, object_name):\n        blob = self.bucket.blob(object_name)\n        blob.upload_from_filename(local_file_path)\n\n    def download_file(self, object_name, local_file_path):\n        blob = self.bucket.blob(object_name)\n        blob.download_to_filename(local_file_path)\n\n    def mkdir(self, directory):\n        blob = self.bucket.blob(directory)\n        blob.create()\n\n    def rmdir(self, directory):\n        blob = self.bucket.blob(directory)\n        blob.delete()\n\n    def remove_file(self, object_name):\n        blob = self.bucket.blob(object_name)\n        blob.delete()\n\n    def get_file_size(self, object_name):\n        blob = self.bucket.blob(object_name)\n        return blob.size\n\n    def is_directory(self, object_name):\n        return self.get_file_size(object_name) != 0\n\n# Example usage:\nif __name__ == \"__main__\":\n    gcs = GoogleCloudStorage(\"your-bucket-name\")\n    gcs.upload_file(\"local_file_path\", \"object_name\")\n    gcs.download_file(\"object_name\", \"local_file_path\")\n    gcs.mkdir(\"directory\")\n    gcs.rmdir(\"directory\")\n    gcs.remove_file(\"object_name\")\n    print(gcs.get_file_size(\"object_name\"))\n    print(gcs.is_directory(\"object_name\"))\n```"
"```python\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom sklearn.preprocessing import MinMaxScaler, StandardScaler\nfrom sklearn.model_selection import train_test_split\nfrom tensorflow.keras.preprocessing.image import ImageDataGenerator\nfrom tensorflow.keras.preprocessing.sequence import pad_sequences\n\n# Importing libraries\nimport numpy as np\n\n# Load dataset\n(X_train, y_train), (X_test, y_test) = keras.datasets.mnist.load_data()\n\n# Resizing images\nX_train = X_train.reshape(-1, 28, 28, 1).astype('float32') / 255\nX_test = X_test.reshape(-1, 28, 28, 1).astype('float32') / 255\n\n# Normalization\nX_train = X_train / 127.5 - 1\nX_test = X_test / 127.5 - 1\n\n# Feature scaling\nscaler = MinMaxScaler()\nX_train = scaler.fit_transform(X_train)\nX_test = scaler.transform(X_test)\n\n# Data augmentation\ndatagen = ImageDataGenerator(\n    rescale=1./255,\n    shear_range=0.2,\n    zoom_range=0.2,\n    horizontal_flip=True\n)\n\n# Applying data augmentation\nX_train = datagen.flow(X_train, y_train, batch_size=32).next()\nX_test = datagen.flow(X_test, y_test, batch_size=32).next()\n\n# Converting images to sequences\ndef img_to_seq(img):\n    return np.array([img.flatten()])\n\nX_train = np.array([img_to_seq(img) for img in X_train])\nX_test = np.array([img_to_seq(img) for img in X_test])\n\n# Pad sequences\nmax_len = 784\nX_train = pad_sequences(X_train, maxlen=max_len)\nX_test = pad_sequences(X_test, maxlen=max_len)\n```"
