"```python\ndef parse_query_string(query_string):\n    \"\"\"\n    Parse a query string into a nested dictionary structure.\n\n    Args:\n        query_string (str): The query string to parse.\n\n    Returns:\n        dict: A nested dictionary representing the query string.\n    \"\"\"\n    query_dict = {}\n    params = query_string.split('&')\n\n    for param in params:\n        key, value = param.split('=')\n        current_dict = query_dict\n\n        # Split the key by '.' to handle nested keys\n        key_parts = key.split('.')\n\n        # Iterate through each key part\n        for i, key_part in enumerate(key_parts):\n            # If this is not the last key part, create a new sub-dictionary if it doesn't exist\n            if i < len(key_parts) - 1:\n                if key_part not in current_dict:\n                    current_dict[key_part] = {}\n                current_dict = current_dict[key_part]\n            # If this is the last key part, set the value\n            else:\n                current_dict[key_part] = value\n\n    return query_dict\n\n# Example usage\nquery_string = \"name=John&age=30&address.city=New+York&address.country=USA\"\nprint(parse_query_string(query_string))\n```"
