"```python\nimport asyncio\nimport contextlib\n\nclass AsyncGenerator:\n    def __init__(self, gen):\n        self.gen = gen\n\n    async def __aenter__(self):\n        return self\n\n    async def __aexit__(self, exc_type, exc_value, traceback):\n        await self.gen.__aexit__(exc_type, exc_value, traceback)\n\n    async def __aiter__(self):\n        return self\n\n    async def __anext__(self):\n        return await self.gen.__anext__()\n\n\nclass AsyncContextManager:\n    def __init__(self, func):\n        self.func = func\n\n    async def __aenter__(self):\n        return await self.func()\n\n    async def __aexit__(self, exc_type, exc_value, traceback):\n        await self.func.__aexit__(exc_type, exc_value, traceback)\n\n\nasync def example_gen():\n    for i in range(3):\n        await asyncio.sleep(1)\n        yield i\n\nasync def example_context_manager():\n    async with AsyncContextManager(lambda: print(\"Entering context\")):\n        await asyncio.sleep(2)\n        print(\"Exiting context\")\n\nasync def main():\n    async with AsyncGenerator(example_gen()) as gen:\n        async for value in gen:\n            print(value)\n\n    async with AsyncContextManager(example_context_manager) as cm:\n        await asyncio.sleep(1)\n\nasyncio.run(main())\n```"
"```python\nimport ast\n\n# Define the source code for each Python version\nsource_code = {\n    '3.5': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\n''',\n    '3.6': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\ndef main():\n    print(main())\nmain()\n''',\n    '3.7': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\ndef main():\n    print(main())\ndef hello(name):\n    print(f\"Hello, {name}!\")\ndef world():\n    print(\"World\")\ndef add(a, b):\n    return a + b\ndef main():\n    hello(\"Alice\")\n    world()\n    print(add(1, 2))\nmain()\n''',\n    '3.8': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\ndef main():\n    print(main())\ndef hello(name):\n    print(f\"Hello, {name}!\")\ndef world():\n    print(\"World\")\ndef add(a, b):\n    return a + b\ndef main():\n    hello(\"Alice\")\n    world()\n    print(add(1, 2))\ndef outer():\n    x = 10\n    def inner():\n        nonlocal x\n        x += 1\n        return x\n    return inner()\ndef main():\n    result = outer()\n    print(result)\nmain()\n''',\n    '3.9': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\ndef main():\n    print(main())\ndef hello(name):\n    print(f\"Hello, {name}!\")\ndef world():\n    print(\"World\")\ndef add(a, b):\n    return a + b\ndef main():\n    hello(\"Alice\")\n    world()\n    print(add(1, 2))\ndef outer():\n    x = 10\n    def inner():\n        nonlocal x\n        x += 1\n        return x\n    return inner()\ndef main():\n    result = outer()\n    print(result)\ndef foo(x: int) -> None:\n    pass\ndef bar(x: int) -> None:\n    pass\ndef main():\n    foo(1)\n    bar(1)\nmain()\n''',\n    '3.10': '''\ndef add(a, b):\n    return a + b\nprint(add(1, 2))\ndef main():\n    print(main())\ndef hello(name):\n    print(f\"Hello, {name}!\")\ndef world():\n    print(\"World\")\ndef add(a, b):\n    return a + b\ndef main():\n    hello(\"Alice\")\n    world()\n    print(add(1, 2))\ndef outer():\n    x: int = 10\n    def inner():\n        nonlocal x\n        x += 1\n        return x\n    return inner()\ndef main():\n    result = outer()\n    print(result)\ndef foo(x: int) -> None:\n    pass\ndef bar(x: int) -> None:\n    pass\ndef main():\n    foo(1)\n    bar(1)\ndef greet(name: str) -> None:\n    print(f\"Hello, {name}!\")\ndef farewell(name: str) -> None:\n    print(f\"Goodbye, {name}!\")\ndef main():\n    greet(\"Alice\")\n    farewell(\"Alice\")\nmain()\n'''\n}\n\n# Parse and dump the AST for each Python version\nfor version, source in source_code.items():\n    tree = ast.parse(source)\n    with open(f\"ast_{version}.txt\", \"w\") as f:\n        ast.dump(tree, f, indent=4)\n    print(f\"Dumped AST for Python {version}\")\n```"
"```python\nimport IPython\nfrom IPython.display import display, HTML\nfrom IPython.display import Math, display, HTML\n\n# Create a new IPython kernel\nIPythonKernel = IPython.kernel.KernelApp()\nIPythonKernel.start_new_kernel()\n\n# Create an interactive Jupyter terminal console\ndisplay(HTML('<div style=\"background-color: #f2f2f2; padding: 10px; border: 1px solid #ccc;\">'))\ndisplay(HTML('<h1>Interactive Jupyter Terminal</h1>'))\n\n# Create a text area for input\ndisplay(HTML('<textarea id=\"console\" style=\"width: 100%; height: 300px; font-size: 14px; font-family: monospace;\"></textarea>'))\n\n# Create a text area for output\ndisplay(HTML('<textarea id=\"output\" style=\"width: 100%; height: 300px; font-size: 14px; font-family: monospace;\"></textarea>'))\n\n# Create a button to run code\ndisplay(HTML('<button id=\"run-button\">Run</button>'))\n\n# Get the text areas and button\nconsole = document.getElementById('console')\noutput = document.getElementById('output')\nrun_button = document.getElementById('run-button')\n\n# Define a function to run code\nfunction runCode() {\n    var code = console.value;\n    var language = getLanguage();\n    var lines = code.split('\\n');\n    var outputLines = [];\n    var errorLines = [];\n\n    // Run code in each line\n    for (var i = 0; i < lines.length; i++) {\n        var line = lines[i];\n        try {\n            if (language === 'python') {\n                // Use the ipython kernel to run the code\n                var kernel = new IPythonKernel();\n                var result = kernel.execute(line);\n                outputLines.push(result);\n            } else {\n                // Run code in other languages\n                var output = runCodeInLanguage(line, language);\n                outputLines.push(output);\n            }\n        } catch (e) {\n            errorLines.push(line + ' ' + e.message);\n        }\n    }\n\n    // Display the output\n    output.value = outputLines.join('\\n');\n    output.value += '\\nError:\\n' + errorLines.join('\\n');\n}\n\n// Define a function to get the language\nfunction getLanguage() {\n    // Get the language from the code\n    var language = '';\n    var firstLine = console.value.split('\\n')[0];\n    if (firstLine.startsWith('#')) {\n        language = 'python';\n    } else if (firstLine.startsWith('print')) {\n        language = 'python';\n    } else {\n        // Other languages\n    }\n    return language;\n}\n\n// Define a function to run code in other languages\nfunction runCodeInLanguage(line, language) {\n    // Other languages\n}\n\n// Add event listener to the run button\nrun_button.addEventListener('click', runCode);\n\n// Initialize the console\nconsole.value = '';\noutput.value = '';\n```"
"```python\nimport ast\nimport astunparse\nimport astroid\n\nclass RefactorAST(astroid.NodeTransformer):\n    def __init__(self, source_code):\n        self.source_code = source_code\n        self.ast = ast.parse(source_code)\n        self.astroid_ast = astroid.from_source(source_code)\n\n    def rename_variables(self, node):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child, ast.Name):\n                child.id = child.id + '_temp'\n        return node\n\n    def move_definitions(self, node):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child, ast.Assign):\n                for target in child.targets:\n                    if isinstance(target, ast.Name):\n                        target.id = target.id + '_temp'\n        return node\n\n    def consolidate_similar_code(self, node):\n        if isinstance(node, ast.If):\n            for child in ast.iter_child_nodes(node):\n                if isinstance(child, ast.With):\n                    for target in child.items:\n                        if isinstance(target.value, ast.Name):\n                            target.value.id = target.value.id + '_temp'\n        return node\n\n    def refactor_ast(self):\n        # Refactor the AST using the defined techniques\n        self.ast = self.rename_variables(self.ast)\n        self.astroid_ast = self.move_definitions(self.astroid_ast)\n        self.ast = self.consolidate_similar_code(self.ast)\n        self.astroid_ast = self.consolidate_similar_code(self.astroid_ast)\n\n        # Convert the refactored AST back to source code\n        refactored_source_code = astunparse.unparse(self.astroid_ast)\n\n        return refactored_source_code\n\n# Example usage:\nsource_code = \"\"\"\nx = 5\ny = 10\nif x > y:\n    print('x is greater than y')\nelse:\n    print('y is greater than x')\n\"\"\"\n\nrefactor_ast = RefactorAST(source_code)\nrefactored_source_code = refactor_ast.refactor_ast()\nprint(refactored_source_code)\n```"
