"```python\nfrom prometheus_client import generate_latest\nfrom prometheus_api_client import PrometheusConnection, QueryParameter\n\ndef scrape_prometheus_api(url, username=None, password=None):\n    # Create a connection to the Prometheus API\n    connection = PrometheusConnection(\n        url=url,\n        username=username,\n        password=password\n    )\n    \n    # Query the metrics\n    query_params = [\n        QueryParameter('metric', 'sum:cpu_usage[1m]'),\n        QueryParameter('alert', 'AlertExample')\n    ]\n    result = connection.query(query_params)\n    \n    # Display the metrics and alerts\n    print(\"Metrics:\")\n    for metric in result.metrics:\n        print(f\"  - {metric.name}: {metric.value}\")\n    print(\"\\nAlerts:\")\n    for alert in result.alerts:\n        print(f\"  - {alert.title}: {alert.description}\")\n\ndef main():\n    url = \"http://localhost:9090\"  # replace with your Prometheus API URL\n    scrape_prometheus_api(url)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nclass StyleSheet:\n    def __init__(self, name):\n        self.name = name\n        self.variables = {}\n        self.styles = {}\n\n    def add_variable(self, name, value):\n        self.variables[name] = value\n\n    def add_style(self, property_name, value):\n        self.styles[property_name] = value\n\n    def compose(self, other_stylesheet):\n        composed_stylesheet = StyleSheet(self.name + \"_composed\")\n        for property_name, value in self.variables.items():\n            composed_stylesheet.add_variable(property_name, value)\n        for property_name, value in other_stylesheet.variables.items():\n            composed_stylesheet.add_variable(property_name, value)\n        for property_name, value in self.styles.items():\n            composed_stylesheet.add_style(property_name, value)\n        for property_name, value in other_stylesheet.styles.items():\n            composed_stylesheet.add_style(property_name, value)\n        return composed_stylesheet\n\n    def to_css(self):\n        css = f\"@{self.name} {{\\n\"\n        for variable_name, value in self.variables.items():\n            css += f\"  --{variable_name}: {value};\\n\"\n        for property_name, value in self.styles.items():\n            css += f\"  {property_name}: {value};\\n\"\n        css += \"}\"\n        return css\n\n\nclass Compositor:\n    def __init__(self):\n        self.stylesheets = []\n\n    def add_stylesheet(self, stylesheet):\n        self.stylesheets.append(stylesheet)\n\n    def compose_stylesheets(self):\n        composed_stylesheet = StyleSheet(\"composed\")\n        for stylesheet in self.stylesheets:\n            composed_stylesheet = composed_stylesheet.compose(stylesheet)\n        return composed_stylesheet\n\n    def to_css(self):\n        css = \"\"\n        for stylesheet in self.stylesheets:\n            css += stylesheet.to_css() + \"\\n\"\n        return css\n\n\n# Example usage:\ncompositor = Compositor()\nstylesheet1 = StyleSheet(\"stylesheet1\")\nstylesheet1.add_variable(\"primary-color\", \"#3498db\")\nstylesheet1.add_style(\"background-color\", \"#f9f9f9\")\nstylesheet1.add_style(\"color\", \"#333333\")\n\nstylesheet2 = StyleSheet(\"stylesheet2\")\nstylesheet2.add_variable(\"primary-color\", \"#2ecc71\")\nstylesheet2.add_style(\"background-color\", \"#f1c40f\")\nstylesheet2.add_style(\"color\", \"#2ecc71\")\n\ncompositor.add_stylesheet(stylesheet1)\ncompositor.add_stylesheet(stylesheet2)\n\ncomposed_stylesheet = compositor.compose_stylesheets()\nprint(composed_stylesheet.to_css())\n```"
