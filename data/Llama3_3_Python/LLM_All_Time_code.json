"```python\nimport tkinter as tk\nfrom tkinter import filedialog, messagebox\n\nclass Application(tk.Tk):\n    def __init__(self):\n        super().__init__()\n        self.title(\"Custom Widget Demo\")\n        self.geometry(\"800x600\")\n\n        self.file_menu = tk.Menu(self)\n        self.file_menu.add_command(label=\"Open\", command=self.open_file)\n        self.file_menu.add_command(label=\"Save\", command=self.save_file)\n        self.file_menu.add_separator()\n        self.file_menu.add_command(label=\"Exit\", command=self.destroy)\n\n        self.edit_menu = tk.Menu(self, tearoff=0)\n        self.edit_menu.add_command(label=\"Cut\", shortcut=\"Ctrl+X\")\n        self.edit_menu.add_command(label=\"Copy\", shortcut=\"Ctrl+C\")\n        self.edit_menu.add_command(label=\"Paste\", shortcut=\"Ctrl+V\")\n\n        self.config(menu=[self.file_menu, self.edit_menu])\n\n        self.custom_widget = CustomWidget(self)\n\n        self.bind(\"Ctrl+O\", self.open_file)\n        self.bind(\"Ctrl+S\", self.save_file)\n        self.bind(\"Ctrl+X\", self.edit_menu.edit_command_default)\n        self.bind(\"Ctrl+C\", self.edit_menu.edit_command_default)\n        self.bind(\"Ctrl+V\", self.edit_menu.edit_command_default)\n\n    def open_file(self):\n        file_path = filedialog.askopenfilename()\n        if file_path:\n            print(f\"Opened file: {file_path}\")\n\n    def save_file(self):\n        file_path = filedialog.asksaveasfilename()\n        if file_path:\n            print(f\"Saved file: {file_path}\")\n\nclass CustomWidget(tk.Frame):\n    def __init__(self, master):\n        super().__init__(master)\n        self.pack(fill=\"both\", expand=True)\n\n        self.label = tk.Label(self, text=\"Custom Widget\")\n        self.label.pack()\n\nroot = Application()\nroot.mainloop()\n```"
"```python\nimport argparse\nimport openapi_generator\n\ndef generate_client(api_spec_path, output_dir):\n    \"\"\"\n    Generate a pluggable API client implementation from an OpenAPI specification file.\n\n    Args:\n    - api_spec_path (str): Path to the OpenAPI specification file.\n    - output_dir (str): Output directory for the generated client code.\n    \"\"\"\n    # Create a generator instance\n    generator = openapi_generator.OpenAPIGenerator()\n\n    # Configure the generator\n    generator.set_spec(api_spec_path)\n    generator.set_output_dir(output_dir)\n    generator.set_base_path('api_client')\n\n    # Generate the client code\n    generator.generate()\n\ndef main():\n    parser = argparse.ArgumentParser(description='Generate a pluggable API client implementation')\n    parser.add_argument('-i', '--input', required=True, help='Path to the OpenAPI specification file')\n    parser.add_argument('-o', '--output', required=True, help='Output directory for the generated client code')\n    args = parser.parse_args()\n\n    # Generate the client code\n    generate_client(args.input, args.output)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport termios\nimport os\n\ndef get_terminal_size():\n    fd = sys.stdout.fileno()\n    old_settings = termios.tcgetattr(fd)\n    try:\n        # Save the original terminal settings\n        old_settings[3][3] = 0x1f  # raw - OPOST\n        # Disable line buffering\n        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)\n        rows, cols = os.stat(0).st_fsturns + 1, 0\n        # Get the terminal size\n        for i in range(0, 1024):\n            try:\n                cols = i\n                break\n            except:\n                pass\n        return rows, cols\n    finally:\n        # Restore original terminal settings\n        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)\n\n# Example usage\nimport sys\nrows, cols = get_terminal_size()\nprint(f\"Terminal size: {rows}x{cols}\")\n```"
"```python\ndef parse_format_string(format_str):\n    \"\"\"\n    This function parses a string in the same logic as the format() function.\n    \n    It replaces placeholders in the format string with values from a dictionary.\n    \n    Args:\n    format_str (str): The format string to parse.\n    values (dict): A dictionary containing the values to replace the placeholders.\n    \n    Returns:\n    str: The parsed string with the placeholders replaced.\n    \"\"\"\n    \n    # Find all placeholders in the format string\n    placeholders = [f\"{{{i}}}\" for i in range(1, len(format_str) // 2 + 1)]\n    \n    # Replace each placeholder with a key-value pair from the dictionary\n    for placeholder in placeholders:\n        key = placeholder[2:-2]\n        if key in values:\n            format_str = format_str.replace(placeholder, str(values[key]))\n        else:\n            raise ValueError(f\"No value found for placeholder {key}\")\n    \n    return format_str\n```"
"```python\nimport os\nimport cryptography\nfrom cryptography.hazmat.primitives import serialization, hashes\nfrom cryptography.hazmat.primitives.asymmetric import padding\nfrom cryptography.hazmat.backends import default_backend\nimport cryptography.x509\nimport cryptography.x509.oid\nimport cryptography.x509.oid extensions\nimport cryptography.hazmat.primitives.asymmetric import rsa\nfrom cryptography.hazmat.primitives.asymmetric import padding\nfrom cryptography.hazmat.backends import default_backend\nfrom cryptography.hazmat.primitives import hashes\nfrom cryptography.hazmat.primitives.asymmetric import padding\nfrom cryptography.hazmat.primitives.asymmetric import utils\nimport pyOpenSSL\n\n# Generate a private key\nprivate_key = rsa.generate_private_key(\n    public_exponent=65537,\n    key_size=2048,\n    backend=default_backend()\n)\n\n# Generate a self-signed certificate\ncert = private_key.sign(\n    cryptography.x509.Name([\n        cryptography.x509.NameAttribute(name=\"C\", value=\"US\"),\n        cryptography.x509.NameAttribute(name=\"ST\", value=\"California\"),\n        cryptography.x509.NameAttribute(name=\"L\", value=\"Los Angeles\"),\n        cryptography.x509.NameAttribute(name=\"O\", value=\"My Company\"),\n        cryptography.x509.NameAttribute(name=\"CN\", value=\"example.com\"),\n        cryptography.x509.NameAttribute(name=\"emailAddress\", value=\"info@example.com\")\n    ]),\n    cryptography.x509.VaultPolicy(ca_sign=True),\n    padding.PSS(\n        mgf=padding.MGF1(hashes.SHA256()),\n        salt_length=padding.PSS.MAX_LENGTH\n    ),\n    hashes.SHA256()\n)\n\n# Convert the private key to PEM format\npem_private_key = private_key.private_bytes(\n    encoding=serialization.Encoding.PEM,\n    format=serialization.PrivateFormat.TraditionalOpenSSL,\n    encryption_algorithm=serialization.NoEncryption()\n)\n\n# Convert the certificate to PEM format\npem_cert = cert.public_bytes(\n    encoding=serialization.Encoding.PEM,\n    format=serialization.PublicFormat.SubjectPublicKeyInfo\n)\n\n# Create a Certificate Signing Request (CSR)\ncsr = private_key.sign(\n    cryptography.x509.Name([\n        cryptography.x509.NameAttribute(name=\"C\", value=\"US\"),\n        cryptography.x509.NameAttribute(name=\"ST\", value=\"California\"),\n        cryptography.x509.NameAttribute(name=\"L\", value=\"Los Angeles\"),\n        cryptography.x509.NameAttribute(name=\"O\", value=\"My Company\"),\n        cryptography.x509.NameAttribute(name=\"CN\", value=\"example.com\"),\n        cryptography.x509.NameAttribute(name=\"emailAddress\", value=\"info@example.com\")\n    ]),\n    padding.PSS(\n        mgf=padding.MGF1(hashes.SHA256()),\n        salt_length=padding.PSS.MAX_LENGTH\n    ),\n    hashes.SHA256()\n)\n\n# Convert the CSR to PEM format\npem_csr = csr.public_bytes(\n    encoding=serialization.Encoding.PEM,\n    format=serialization.PublicFormat.SubjectPublicKeyInfo\n)\n\n# Verify the signature on the CSR using the private key\nverified = utils.verify_pem_certificate(\n    pem_csr,\n    pem_private_key,\n    hashes.SHA256()\n)\n\nprint(verified)\n```"
"```python\nimport http.server\nimport socketserver\nimport graphql\nimport json\n\nclass GraphQLServer(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        if self.path == '/graphql':\n            content_type = self.send_header('Content-type', 'application/json')\n            content_type['Content-type'] = 'application/json'\n            return self.end_headers(), json.dumps({'message': 'Hello, World!'})\n\n    def do_POST(self):\n        if self.path == '/graphql':\n            content_length = int(self.headers['Content-Length'])\n            body = self.rfile.read(content_length)\n            try:\n                data = json.loads(body.decode('utf-8'))\n                result = graphql.GraphQLServer().query(data['query'], data['variables'])\n                return self.end_headers(), json.dumps({'data': result})\n            except Exception as e:\n                return self.end_headers(), json.dumps({'error': str(e)})\n\nclass GraphQLServerHandler(socketserver.TCPServer):\n    def serve_forever(self):\n        print('GraphQL Server is running on port 8080...')\n        httpd = socketserver.TCPServer(('localhost', 8080), GraphQLServer)\n        httpd.serve_forever()\n\nif __name__ == \"__main__\":\n    handler = GraphQLServerHandler(('localhost', 8080))\n    handler.serve_forever()\n```"
"```python\nfrom sympy import pi, exp, sqrt, golden_ratio\n\ndef get_symbol_value(symbol):\n    if symbol == pi:\n        return pi\n    elif symbol == exp(1):\n        return exp(1)\n    elif symbol == sqrt(5) - 1:\n        return golden_ratio\n    else:\n        return None\n\nprint(get_symbol_value(pi))\nprint(get_symbol_value(exp(1)))\nprint(get_symbol_value(sqrt(5) - 1))\n```"
"```python\nclass ATM:\n    def __init__(self):\n        self.balance = 1000\n        self.pin = 1234\n        self.state = 'login'\n\n    def login(self):\n        print(\"Enter your PIN:\")\n        pin = input()\n        if pin == str(self.pin):\n            self.state = 'main_menu'\n        else:\n            print(\"Invalid PIN. Please try again.\")\n            self.login()\n\n    def main_menu(self):\n        while self.state == 'main_menu':\n            print(\"\\n1. Check Balance\")\n            print(\"2. Withdraw Cash\")\n            print(\"3. Change PIN\")\n            print(\"4. Exit\")\n            choice = input(\"Enter your choice: \")\n            if choice == '1':\n                self.check_balance()\n            elif choice == '2':\n                self.withdraw_cash()\n            elif choice == '3':\n                self.change_pin()\n            elif choice == '4':\n                self.state = 'login'\n            else:\n                print(\"Invalid choice. Please try again.\")\n\n    def check_balance(self):\n        print(f\"\\nYour current balance is: ${self.balance}\")\n\n    def withdraw_cash(self):\n        print(\"\\nWithdrawal options:\")\n        print(\"1. Up to $100\")\n        print(\"2. Up to $500\")\n        print(\"3. Exit\")\n        choice = input(\"Enter your choice: \")\n        if choice == '1':\n            amount = float(input(\"Enter amount to withdraw (up to $100): \"))\n            if amount <= self.balance and amount <= 100:\n                self.balance -= amount\n                print(f\"\\nYou have withdrawn ${amount}. Your new balance is: ${self.balance}\")\n            else:\n                print(\"Invalid amount. Please try again.\")\n        elif choice == '2':\n            amount = float(input(\"Enter amount to withdraw (up to $500): \"))\n            if amount <= self.balance and amount <= 500:\n                self.balance -= amount\n                print(f\"\\nYou have withdrawn ${amount}. Your new balance is: ${self.balance}\")\n            else:\n                print(\"Invalid amount. Please try again.\")\n        elif choice == '3':\n            self.state = 'main_menu'\n        else:\n            print(\"Invalid choice. Please try again.\")\n\n    def change_pin(self):\n        print(\"\\nCurrent PIN: \", self.pin)\n        new_pin = int(input(\"Enter new PIN: \"))\n        confirm_pin = int(input(\"Confirm new PIN: \"))\n        if new_pin == confirm_pin:\n            self.pin = new_pin\n            print(\"\\nPIN changed successfully.\")\n            self.state = 'main_menu'\n        else:\n            print(\"Invalid PIN. Please try again.\")\n\natm = ATM()\natm.login()\n```"
"```python\nfrom sqlalchemy import create_engine, Column, Integer, String\nfrom sqlalchemy.ext.declarative import declarative_base\nfrom sqlalchemy.orm import sessionmaker\nfrom marshmallow import Schema, fields, validates, ValidationError\n\n# Create a database engine\nengine = create_engine('sqlite:///example.db')\n\n# Create a base class for our models\nBase = declarative_base()\n\n# Define a model for a User\nclass User(Base):\n    __tablename__ = 'users'\n    id = Column(Integer, primary_key=True)\n    name = Column(String)\n    email = Column(String)\n\n# Create all tables in the engine\nBase.metadata.create_all(engine)\n\n# Create a session class\nSession = sessionmaker(bind=engine)\n\n# Define a schema for a User\nclass UserSchema(Schema):\n    id = fields.Int(dump_only=True)\n    name = fields.Str(required=True)\n    email = fields.Str(required=True)\n\n    @validates('name')\n    def validate_name(self, value):\n        if len(value) < 2:\n            raise ValidationError('Name must be at least 2 characters long')\n\n# Create a session\nsession = Session()\n\n# Create a new user\nnew_user = User(name='John Doe', email='john@example.com')\nsession.add(new_user)\nsession.commit()\n\n# Serialize the new user\nuser_schema = UserSchema()\ndata = user_schema.dump(new_user)\n\n# Query the database for all users\nusers = session.query(User).all()\nuser_schema = UserSchema(many=True)\ndata = user_schema.dump(users)\n\n# Update a user\nexisting_user = session.query(User).filter_by(id=1).first()\nexisting_user.name = 'Jane Doe'\nsession.commit()\n\n# Deserialize a user\nuser_schema = UserSchema()\ndata = user_schema.load({'id': 1, 'name': 'Jane Doe', 'email': 'jane@example.com'})\n```"
"```python\nimport pytest\nimport time\nfrom contextlib import contextmanager\nfrom pytest import fixture\n\nclass TimeoutError(Exception):\n    pass\n\n@contextmanager\ndef timeout(timeout_value):\n    start_time = time.time()\n    try:\n        yield\n    except Exception:\n        pass\n    finally:\n        elapsed_time = time.time() - start_time\n        if elapsed_time > timeout_value:\n            raise TimeoutError(f\"Test timed out after {timeout_value} seconds\")\n\ndef pytest_runtest_setup(item):\n    if hasattr(item, \"timeout\"):\n        timeout_value = item.timeout\n        yield from timeout(timeout_value)\n\n@pytest.fixture(scope=\"session\")\ndef timeout_fixture(request):\n    def func(*args, **kwargs):\n        yield\n        pytest.fail(f\"Test timed out after {request.config.get('timeout')} seconds\")\n    return func\n```\n\nThis code defines a plugin for pytest that intercepts test functions and aborts them if they hang for too long. The plugin uses a context manager to measure the time it takes to execute a test, and raises a TimeoutError if the test takes longer than the configured timeout value. The pytest_runtest_setup hook is used to apply the timeout to each test, and a pytest fixture is provided to demonstrate how to use the timeout plugin in a test function."
"```python\nfrom PyPDF2 import PdfReader\nfrom PyPDF2 import PdfWriter\nfrom PyPDF2 import PdfFileReader\nfrom PyPDF2 import PdfFileWriter\nimport fitz\nimport os\nfrom fpdf import FPDF\n\ndef split_pdf(input_pdf, output_folder):\n    \"\"\"Splits a PDF into individual pages and saves them as separate PDFs.\"\"\"\n    pdf_reader = PdfReader(input_pdf)\n    for page_num in range(len(pdf_reader.pages)):\n        output_filename = f\"page_{page_num+1}.pdf\"\n        output_path = os.path.join(output_folder, output_filename)\n        pdf_writer = PdfWriter()\n        pdf_writer.add_page(pdf_reader.pages[page_num])\n        pdf_writer.write(output_path)\n        print(f\"Page {page_num+1} saved as {output_filename}\")\n\ndef merge_pdfs(input_pdfs, output_pdf):\n    \"\"\"Merges multiple PDFs into a single PDF.\"\"\"\n    pdf_writer = PdfWriter()\n    for input_pdf in input_pdfs:\n        pdf_reader = PdfReader(input_pdf)\n        for page_num in range(len(pdf_reader.pages)):\n            pdf_writer.add_page(pdf_reader.pages[page_num])\n    pdf_writer.write(output_pdf)\n    print(\"PDFs merged successfully\")\n\ndef crop_pdf(input_pdf, output_pdf, x1, y1, x2, y2):\n    \"\"\"Crops a PDF to a specified rectangle.\"\"\"\n    with fitz.open(input_pdf) as doc:\n        page = doc.load_page(1)\n        xref = page.get_xref()\n        for x, y, w, h in xref:\n            if x1 <= x <= x2 and y1 <= y <= y2:\n                page.crop((x1, y1, x2, y2))\n                doc.save(output_pdf)\n                print(\"PDF cropped successfully\")\n\ndef transform_pdf(input_pdf, output_pdf, rotation=0):\n    \"\"\"Rotates a PDF by a specified angle.\"\"\"\n    with fitz.open(input_pdf) as doc:\n        page = doc.load_page(1)\n        page.rotate(rotation)\n        doc.save(output_pdf)\n        print(\"PDF rotated successfully\")\n\ndef main():\n    # Usage\n    input_pdf = \"input.pdf\"\n    output_folder = \"output\"\n    if not os.path.exists(output_folder):\n        os.makedirs(output_folder)\n\n    split_pdf(input_pdf, output_folder)\n    # merge_pdfs([\"page1.pdf\", \"page2.pdf\"], \"merged.pdf\")\n    # crop_pdf(\"input.pdf\", \"cropped.pdf\", 0, 0, 100, 100)\n    # transform_pdf(\"input.pdf\", \"rotated.pdf\", 90)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport ephem\nimport datetime\n\ndef calculate_celestial_body_position(body_name, date):\n    # Create an observer\n    observer = ephem.Observer()\n    observer.date = date\n    \n    # Create a celestial body\n    body = ephem.Body()\n    body.name = body_name\n    \n    # Set the body's observer and time\n    body.compute(observer)\n    \n    # Get the body's RA and Dec\n    ra = body.ra\n    dec = body.dec\n    \n    return ra, dec\n\ndef calculate_planetary_position(date):\n    # Create a list of planets\n    planets = ['Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune']\n    \n    # Create a dictionary to store the planets' positions\n    positions = {}\n    \n    # Calculate the positions of each planet\n    for planet in planets:\n        ra, dec = calculate_celestial_body_position(planet, date)\n        positions[planet] = (ra, dec)\n    \n    return positions\n\ndef generate_ephemeris(date):\n    # Create a list of planets\n    planets = ['Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune']\n    \n    # Create a dictionary to store the ephemeris\n    ephemeris = {}\n    \n    # Generate the ephemeris for each planet\n    for planet in planets:\n        ra = ephem.RA(planet)\n        dec = ephem.DEC(planet)\n        \n        # Set the observer and time\n        observer = ephem.Observer()\n        observer.date = date\n        \n        # Set the planet's observer and time\n        ra.compute(observer)\n        dec.compute(observer)\n        \n        # Get the planet's RA and Dec\n        ephemeris[planet] = (ra, dec)\n    \n    return ephemeris\n\n# Test the functions\ndate = datetime.date(2022, 1, 1)\npositions = calculate_planetary_position(date)\nprint(positions)\n\nephemeris = generate_ephemeris(date)\nprint(ephemeris)\n```"
"```python\nimport avro.io\nfrom avro.schema import SchemaBuilder\nfrom avro.io import DatumWriter, DatumReader\n\n# Define a simple schema\nschema = SchemaBuilder()\nschema.field('name', 'string')\nschema.field('age', 'int')\nschema.field('scores', 'array', ['int'])\nschema = schema.build()\n\n# Create a datum\ndatum = {\n    'name': 'John Doe',\n    'age': 30,\n    'scores': [90, 85, 95]\n}\n\n# Create an array of datums\narray_datums = [datum, {\n    'name': 'Jane Doe',\n    'age': 25,\n    'scores': [80, 75, 90]\n}]\n\n# Create a record\nrecord = {\n    'name': 'Bob Smith',\n    'age': 40,\n    'scores': [95, 90, 85]\n}\n\n# Write the datum, array of datums, and record to a file\nwith open('output.avro', 'wb') as f:\n    writer = DatumWriter(schema)\n    io.write(f, [datum], writer)\n    io.write(f, array_datums, writer)\n    io.write(f, record, writer)\n```"
"```python\nimport sphinx\nfrom sphinx import theme\nfrom sphinx.application import Sphinx\nfrom sphinx.errors import SphinxError\nfrom sphinx.util import log\n\n# Define a custom theme class\nclass ReadTheDocsTheme(theme.Theme):\n    name = 'ReadTheDocs Theme'\n    description = 'A clean and modern Sphinx theme inspired by Read the Docs'\n\n    # Define the CSS files to include in the theme\n    css_files = ['theme.css']\n\n    # Define the language support for the theme\n    languages = ['en', 'fr', 'de', 'es', 'pt', 'zh-cn', 'ja', 'ko']\n\n    # Define the custom CSS classes for the theme\n    custom_css_classes = {\n        'toc-title': 'toc-title',\n        'heading-level': 'heading-level',\n        'code-block': 'code-block',\n        'pre': 'pre',\n        'highlight': 'highlight'\n    }\n\n    # Define the custom JavaScript classes for the theme\n    custom_js_classes = {\n        'toc-js': 'toc-js',\n        'search-js': 'search-js'\n    }\n\n    # Define the custom HTML templates for the theme\n    custom_html_templates = {\n        'index.html': 'index.html',\n        'about.html': 'about.html',\n        'toc.html': 'toc.html'\n    }\n\n# Define a Sphinx extension class to register the custom theme\nclass ReadTheDocsThemeExtension(sphinx.ext.theme):\n    name = 'ReadTheDocs Theme Extension'\n    description = 'A Sphinx extension to register the custom theme'\n\n    def setup_app(self, app):\n        # Register the custom theme with the Sphinx application\n        app.add_theme(ReadTheDocsTheme)\n\n# Define a Sphinx command to apply the custom theme\nclass ReadTheDocsThemeCommand(sphinx.cmd.Command):\n    name = 'readthedocs-theme'\n    description = 'Apply the custom Read the Docs theme to the Sphinx project'\n\n    def run(self):\n        # Create a new Sphinx application instance\n        app = Sphinx(project='my_project', source_suffix='.rst')\n\n        # Register the custom theme with the Sphinx application\n        app.add_theme(ReadTheDocsTheme)\n\n        # Run the Sphinx build command to apply the custom theme\n        app.build()\n\n# Define a Sphinx directive to include the custom theme CSS files\nclass ReadTheDocsThemeDirective(sphinx.directives.Directive):\n    name = 'readthedocs-theme'\n    description = 'Include the custom Read the Docs theme CSS files'\n\n    def run(self, value, lineno, inliner):\n        # Get the current theme\n        theme = self.state.theme\n\n        # Get the CSS files to include in the theme\n        css_files = theme.css_files\n\n        # Create the CSS code to include the custom CSS files\n        css_code = '\\n'.join(f'<link rel=\"stylesheet\" href=\"{file}\" />' for file in css_files)\n\n        # Return the CSS code\n        return css_code\n\n# Define a Sphinx directive to include the custom theme JavaScript files\nclass ReadTheDocsThemeJsDirective(sphinx.directives.Directive):\n    name = 'readthedocs-theme-js'\n    description = 'Include the custom Read the Docs theme JavaScript files'\n\n    def run(self, value, lineno, inliner):\n        # Get the current theme\n        theme = self.state.theme\n\n        # Get the JavaScript files to include in the theme\n        js_files = theme.custom_js_classes\n\n        # Create the JavaScript code to include the custom JavaScript files\n        js_code = '\\n'.join(f'<script src=\"{file}\" />' for file in js_files)\n\n        # Return the JavaScript code\n        return js_code\n\n# Define a Sphinx directive to include the custom theme HTML templates\nclass ReadTheDocsThemeHtmlDirective(sphinx.directives.Directive):\n    name = 'readthedocs-theme-html'\n    description = 'Include the custom Read the Docs theme HTML templates'\n\n    def run(self, value, lineno, inliner):\n        # Get the current theme\n        theme = self.state.theme\n\n        # Get the HTML templates to include in the theme\n        html_templates = theme.custom_html_templates\n\n        # Create the HTML code to include the custom HTML templates\n        html_code = '\\n'.join(f'<link rel=\"stylesheet\" href=\"{template}\" />' for template in html_templates)\n\n        # Return the HTML code\n        return html_code\n```"
"```python\nimport logging\nfrom colorama import init, Fore, Style\n\n# Initialize colorama\ninit()\n\n# Set the logging level\nlogging.basicConfig(level=logging.INFO)\n\n# Define ANSI escape codes\ncolors = {\n    \"INFO\": Fore.GREEN,\n    \"WARNING\": Fore.YELLOW,\n    \"ERROR\": Fore.RED,\n    \"CRITICAL\": Fore.MAGENTA\n}\n\ndef log_message(level, message):\n    # Create a formatted message with color\n    colored_message = f\"{colors[level]}{message}{Style.RESET_ALL}\"\n    \n    # Log the message\n    if level == \"INFO\":\n        logging.info(colored_message)\n    elif level == \"WARNING\":\n        logging.warning(colored_message)\n    elif level == \"ERROR\":\n        logging.error(colored_message)\n    elif level == \"CRITICAL\":\n        logging.critical(colored_message)\n\n# Example usage\nlog_message(\"INFO\", \"This is an info message\")\nlog_message(\"WARNING\", \"This is a warning message\")\nlog_message(\"ERROR\", \"This is an error message\")\nlog_message(\"CRITICAL\", \"This is a critical message\")\n```"
"```python\nfrom rich import print\nfrom rich.console import Console\n\nconsole = Console()\n\ndef style_string(input_str, color='white', background='black', bold=False, italic=False):\n    style = f\"[{color}]{background}]{input_str}\"\n    if bold:\n        style += \"[bold]\"\n    if italic:\n        style += \"[italic]\"\n    console.print(style)\n\n# Example usage:\nstyle_string(\"Hello, World!\", color='blue', background='red')\n```"
"```python\nimport hamcrest as hc\nfrom hamcrest import Matcher\n\nclass CustomMatcher(Matcher):\n    def matches(self, item):\n        # Define your custom matching criteria here\n        # For example, checking if a string is equal to \"hello\"\n        return str(item) == \"hello\"\n\n    def describe_to(self, matcher):\n        return f\"Custom matcher that checks if the item is equal to 'hello'\"\n\n    def does_not_describe(self):\n        return False\n\n# Example usage:\nhc.assert_that(\"hello\", CustomMatcher())\n```"
"```python\nimport logging\n\n# Create a logger\nlogger = logging.getLogger(__name__)\n\n# Set the logging level\nlogger.setLevel(logging.DEBUG)\n\n# Create a formatter\nformatter = logging.Formatter(\n    '%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n    datefmt='%Y-%m-%d %H:%M:%S'\n)\n\n# Create a console handler\nconsole_handler = logging.StreamHandler()\nconsole_handler.setFormatter(formatter)\n\n# Create a file handler\nfile_handler = logging.FileHandler('log_file.log')\nfile_handler.setFormatter(formatter)\n\n# Create a structured logger\nstructured_logger = logging.getLogger('structured_logger')\n\n# Add the handlers to the structured logger\nstructured_logger.addHandler(console_handler)\nstructured_logger.addHandler(file_handler)\n\n# Create a structured logger with a specific name and level\nstructured_logger_structured = logging.getLogger('structured_logger_structured')\nstructured_logger_structured.setLevel(logging.INFO)\nstructured_logger_structured.addHandler(console_handler)\nstructured_logger_structured.addHandler(file_handler)\n\n# Example usage:\nlogger.debug('This is a debug message')\nlogger.info('This is an info message')\nlogger.warning('This is a warning message')\nlogger.error('This is an error message')\nlogger.critical('This is a critical message')\n```"
"```python\nfrom paramiko import SSHClient\nimport paramiko\n\ndef copy_file_ssh(src_host, src_user, src_port, src_path, dst_host, dst_user, dst_path):\n    ssh = SSHClient()\n    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())\n    ssh.connect(dst_host, username=dst_user, password=None, port=dst_port)\n\n    sftp = ssh.open_sftp()\n    sftp.get(src_path, dst_path)\n\n    ssh.close()\n\n# Usage\ncopy_file_ssh('192.168.1.100', 'username', 22, '/path/to/source/file', '192.168.1.101', 'username', '/path/to/destination/file')\n```"
"```python\nimport importlib_resources\nimport importlib_metadata\n\ndef lazy_import(name):\n    try:\n        spec = importlib_metadata.specifier(name)\n        if spec.isdir():\n            return importlib_resources.contents(spec)\n        else:\n            return importlib_resources.files(spec).open()\n    except importlib_metadata.Invalid specifier:\n        return None\n\n# Example usage:\nmodule_name = \"package.module_name\"\ncontents = lazy_import(module_name)\n\nif contents:\n    for item in contents:\n        print(item)\nelse:\n    print(f\"Failed to import {module_name}\")\n```"
"```python\nimport requests\nimport urllib3\n\n# Send an HTTP GET request to a URL\ndef send_get_request(url):\n    try:\n        response = requests.get(url)\n        print(f\"HTTP GET Request to {url} returned status code {response.status_code}\")\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"Error sending GET request: {e}\")\n        return None\n\n# Send an HTTP POST request to a URL\ndef send_post_request(url, data):\n    try:\n        response = requests.post(url, data=data)\n        print(f\"HTTP POST Request to {url} returned status code {response.status_code}\")\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"Error sending POST request: {e}\")\n        return None\n\n# Send an HTTP PUT request to a URL\ndef send_put_request(url, data):\n    try:\n        response = requests.put(url, data=data)\n        print(f\"HTTP PUT Request to {url} returned status code {response.status_code}\")\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"Error sending PUT request: {e}\")\n        return None\n\n# Send an HTTP DELETE request to a URL\ndef send_delete_request(url):\n    try:\n        response = requests.delete(url)\n        print(f\"HTTP DELETE Request to {url} returned status code {response.status_code}\")\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"Error sending DELETE request: {e}\")\n        return None\n\n# Retrieve the contents of a URL\ndef retrieve_url_contents(url):\n    try:\n        response = requests.get(url)\n        return response.text\n    except requests.exceptions.RequestException as e:\n        print(f\"Error retrieving URL contents: {e}\")\n        return None\n\n# Get the response headers from a URL\ndef get_response_headers(url):\n    try:\n        response = requests.get(url)\n        return response.headers\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response headers: {e}\")\n        return None\n\n# Get the response body from a URL\ndef get_response_body(url):\n    try:\n        response = requests.get(url)\n        return response.text\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response body: {e}\")\n        return None\n\n# Get the response status code from a URL\ndef get_response_status_code(url):\n    try:\n        response = requests.get(url)\n        return response.status_code\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response status code: {e}\")\n        return None\n\n# Get the response headers as a dictionary\ndef get_response_headers_dict(url):\n    try:\n        response = requests.get(url)\n        return dict(response.headers)\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response headers as a dictionary: {e}\")\n        return None\n\n# Get the response body as a dictionary\ndef get_response_body_dict(url):\n    try:\n        response = requests.get(url)\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response body as a dictionary: {e}\")\n        return None\n\n# Get the response headers and body as a dictionary\ndef get_response_dict(url):\n    try:\n        response = requests.get(url)\n        return {\n            \"status_code\": response.status_code,\n            \"headers\": dict(response.headers),\n            \"body\": response.text\n        }\n    except requests.exceptions.RequestException as e:\n        print(f\"Error getting response headers and body as a dictionary: {e}\")\n        return None\n\n# Main function\nif __name__ == \"__main__\":\n    url = \"http://example.com\"\n    print(\"Sending HTTP GET Request to\", url)\n    response = send_get_request(url)\n    if response:\n        print(\"Response Headers:\", get_response_headers(url))\n        print(\"Response Body:\", get_response_body(url))\n        print(\"Response Status Code:\", get_response_status_code(url))\n        print(\"Response Headers as Dictionary:\", get_response_headers_dict(url))\n        print(\"Response Body as Dictionary:\", get_response_body_dict(url))\n        print(\"Response Headers and Body as Dictionary:\", get_response_dict(url))\n\n    print(\"\\nSending HTTP POST Request to\", url)\n    data = {\"key\": \"value\"}\n    response = send_post_request(url, data)\n    if response:\n        print(\"Response Headers:\", get_response_headers(url))\n        print(\"Response Body:\", get_response_body(url))\n        print(\"Response Status Code:\", get_response_status_code(url))\n        print(\"Response Headers as Dictionary:\", get_response_headers_dict(url))\n        print(\"Response Body as Dictionary:\", get_response_body_dict(url))\n        print(\"Response Headers and Body as Dictionary:\", get_response_dict(url))\n\n    print(\"\\nSending HTTP PUT Request to\", url)\n    data = {\"key\": \"value\"}\n    response = send_put_request(url, data)\n    if response:\n        print(\"Response Headers:\", get_response_headers(url))\n        print(\"Response Body:\", get_response_body(url))\n        print(\"Response Status Code:\", get_response_status_code(url))\n        print(\"Response Headers as Dictionary:\", get_response_headers_dict(url))\n        print(\"Response Body as Dictionary:\", get_response_body_dict(url))\n        print(\"Response Headers and Body as Dictionary:\", get_response_dict(url))\n\n    print(\"\\nSending HTTP DELETE Request to\", url)\n    response = send_delete_request(url)\n    if response:\n        print(\"Response Headers:\", get_response_headers(url))\n        print(\"Response Body:\", get_response_body(url))\n        print(\"Response Status Code:\", get_response_status_code(url))\n        print(\"Response Headers as Dictionary:\", get_response_headers_dict(url))\n        print(\"Response Body as Dictionary:\", get_response_body_dict(url))\n        print(\"Response Headers and Body as Dictionary:\", get_response_dict(url))\n\n    print(\"\\nRetrieving URL Contents\")\n    contents = retrieve_url_contents(url)\n    print(contents)\n\n    print(\"\\nGetting Response Headers\")\n    headers = get_response_headers(url)\n    print(headers)\n\n    print(\"\\nGetting Response Body\")\n    body = get_response_body(url)\n    print(body)\n\n    print(\"\\nGetting Response Status Code\")\n    status_code = get_response_status_code(url)\n    print(status_code)\n\n    print(\"\\nGetting Response Headers as Dictionary\")\n    headers_dict = get_response_headers_dict(url)\n    print(headers_dict)\n\n    print(\"\\nGetting Response Body as Dictionary\")\n    body_dict = get_response_body_dict(url)\n    print(body_dict)\n\n    print(\"\\nGetting Response Headers and Body as Dictionary\")\n    response_dict = get_response_dict(url)\n    print(response_dict)\n```"
"```python\nimport os\nimport logging\nfrom slack_sdk import WebClient\nfrom slack_sdk.errors import SlackApiError\n\n# Set up logging\nlogging.basicConfig(level=logging.INFO)\n\n# Set your Slack bot token and channel\nSLACK_BOT_TOKEN = os.environ.get('SLACK_BOT_TOKEN')\nCHANNEL_ID = os.environ.get('CHANNEL_ID')\nKeyword = os.environ.get('Keyword')\n\n# Create a Slack client\nclient = WebClient(token=SLACK_BOT_TOKEN)\n\n# Function to handle incoming messages\ndef handle_message(message):\n    if message['text'].lower() == Keyword.lower():\n        try:\n            # Respond with a pre-defined message\n            response = client.chat_postMessage(\n                channel=CHANNEL_ID,\n                text='Pre-defined response'\n            )\n            logging.info(f'Response sent: {response}')\n        except SlackApiError as e:\n            logging.error(f'Error sending response: {e}')\n\n# Handle incoming messages from Slack\ndef main():\n    # Start listening for messages\n    client.listen_for_events(on_event=handle_message)\n\nif __name__ == '__main__':\n    main()\n```"
"```python\nimport os\nimport shutil\n\ndef run_command(command):\n    # Split the command into a list of arguments\n    args = command.split()\n    \n    # Create a temporary file to serve as the output\n    output_file = '/tmp/' + os.getpid() + '.out'\n    with open(output_file, 'w') as f:\n        # Write the command to the temporary file\n        f.write(' '.join(args))\n    \n    # Create a temporary file to serve as the error output\n    error_file = '/tmp/' + os.getpid() + '.err'\n    with open(error_file, 'w') as f:\n        # Write the command to the temporary file\n        f.write(' '.join(args))\n    \n    # Run the command using os.system and redirect the output\n    os.system(f'{\" \".join(args)} 2>&1')\n    \n    # Get the output and error files\n    with open(output_file, 'r') as f:\n        output = f.read()\n    with open(error_file, 'r') as f:\n        error = f.read()\n    \n    # Remove the temporary files\n    os.remove(output_file)\n    os.remove(error_file)\n    \n    return output, error\n\ndef copy_file(src, dst):\n    shutil.copy(src, dst)\n\ndef delete_file(file_path):\n    if os.path.exists(file_path):\n        os.remove(file_path)\n\ndef mkdir(path):\n    if not os.path.exists(path):\n        os.makedirs(path)\n```"
