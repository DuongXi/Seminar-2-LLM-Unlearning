"```python\nimport torch\nfrom sentencepiece import SentencePiece\n\nclass SentencePieceModel:\n    def __init__(self, model_path):\n        self.model = SentencePiece.from_file(model_path)\n\n    def tokenize(self, sentence):\n        return self.model.encode(sentence)\n\n    def get_sentence_length(self, sentence):\n        return len(self.tokenize(sentence))\n\n    def generate(self, input_sentence, max_length=100):\n        encoded_sentence = self.tokenize(input_sentence)\n        generated_sentence = self.model.generate(encoded_sentence, max_length=max_length)\n        return self.model.decode(generated_sentence)\n```"
