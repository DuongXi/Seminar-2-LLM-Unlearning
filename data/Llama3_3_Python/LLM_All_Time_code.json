"```python\nfrom cryptography.fernet import Fernet\nimport base64\nimport getpass\nimport os\n\ndef generate_key():\n    key = Fernet.generate_key()\n    return key\n\ndef encrypt_message(key, message):\n    cipher_suite = Fernet(key)\n    cipher_text = cipher_suite.encrypt(message.encode())\n    return cipher_text\n\ndef decrypt_message(key, cipher_text):\n    cipher_suite = Fernet(key)\n    plain_text = cipher_suite.decrypt(cipher_text).decode()\n    return plain_text\n\ndef main():\n    key = generate_key()\n    print(\"Generated Key: \", key)\n\n    message = input(\"Enter the message you want to encrypt/decrypt: \")\n    choice = input(\"Do you want to (E)ncrypt or (D)ecrypt? \")\n\n    if choice.upper() == \"E\":\n        cipher_text = encrypt_message(key, message)\n        print(\"Encrypted Message: \", cipher_text)\n    elif choice.upper() == \"D\":\n        cipher_text = input(\"Enter the encrypted message: \")\n        plain_text = decrypt_message(key, cipher_text)\n        print(\"Decrypted Message: \", plain_text)\n    else:\n        print(\"Invalid choice\")\n\nif __name__ == \"__main__\":\n    main()\n```"
