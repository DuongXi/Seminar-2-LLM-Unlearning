"```python\n# Importing necessary libraries\nfrom azure.data lake analytics import AnalyticsClient\nfrom azure.data lake analytics.models import DataLakeStorageAccount, ComputePolicy, JobSubmissionArguments, JobSubmissionOptions\nfrom azure.core.exceptions import HttpResponseError\n\n# Connecting to the Azure Data Lake Analytics account\nADLA_CLIENT = AnalyticsClient(\n    account_url=\"https://<account_name>.dfs.core.windows.net/\",\n    credentials=\"<account_key>\"\n)\n\n# Creating a data lake\ndef create_data_lake(account_name, container_name, storage_account):\n    try:\n        data_lake_storage_account = DataLakeStorageAccount(\n            name=container_name,\n            account=storage_account,\n            file_system_name=account_name\n        )\n        ADLA_CLIENT.data_lakes.create_or_update(data_lake_storage_account)\n        print(f\"Data lake '{container_name}' created successfully.\")\n    except HttpResponseError as e:\n        print(f\"Error creating data lake: {e.status_code}, {e.error_message}\")\n\n# Deleting a data lake\ndef delete_data_lake(account_name, container_name):\n    try:\n        ADLA_CLIENT.data_lakes.delete_by_name(container_name)\n        print(f\"Data lake '{container_name}' deleted successfully.\")\n    except HttpResponseError as e:\n        print(f\"Error deleting data lake: {e.status_code}, {e.error_message}\")\n\n# Creating a compute policy\ndef create_compute_policy(policy_name, policy_definition):\n    try:\n        compute_policy = ComputePolicy(\n            name=policy_name,\n            policy_definition=policy_definition\n        )\n        ADLA_CLIENT.compute_policies.create_or_update(compute_policy)\n        print(f\"Compute policy '{policy_name}' created successfully.\")\n    except HttpResponseError as e:\n        print(f\"Error creating compute policy: {e.status_code}, {e.error_message}\")\n\n# Deleting a compute policy\ndef delete_compute_policy(policy_name):\n    try:\n        ADLA_CLIENT.compute_policies.delete_by_name(policy_name)\n        print(f\"Compute policy '{policy_name}' deleted successfully.\")\n    except HttpResponseError as e:\n        print(f\"Error deleting compute policy: {e.status_code}, {e.error_message}\")\n\n# Submitting a job\ndef submit_job(job_name, job_body):\n    try:\n        job_submission_arguments = JobSubmissionArguments(\n            job_name=job_name,\n            body=job_body\n        )\n        job_submission_options = JobSubmissionOptions(\n            max_workers=1,\n            timeout=600  # 10 minutes\n        )\n        ADLA_CLIENT.jobs.submit(job_submission_arguments, job_submission_options)\n        print(f\"Job '{job_name}' submitted successfully.\")\n    except HttpResponseError as e:\n        print(f\"Error submitting job: {e.status_code}, {e.error_message}\")\n\n# Monitoring a job\ndef get_job_status(job_name):\n    try:\n        job = ADLA_CLIENT.jobs.get(job_name)\n        print(f\"Job '{job_name}' status: {job.status}\")\n    except HttpResponseError as e:\n        print(f\"Error getting job status: {e.status_code}, {e.error_message}\")\n```"
"```python\nimport inspect\n\ndef my_function(a, b):\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both arguments must be numbers\")\n    return a + b\n\ndef my_function_with_exception(a, b):\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both arguments must be numbers\")\n    return a / b\n\ndef my_function_with_input(a, b):\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Both arguments must be numbers\")\n    return a + b\n\ndef main():\n    # Test the functions\n    print(\"Testing my_function\")\n    try:\n        result = my_function(10, 5)\n        print(f\"Result: {result}\")\n    except Exception as e:\n        print(f\"Exception: {e}\")\n\n    print(\"\\nTesting my_function_with_exception\")\n    try:\n        result = my_function_with_exception(10, 0)\n        print(f\"Result: {result}\")\n    except Exception as e:\n        print(f\"Exception: {e}\")\n\n    print(\"\\nTesting my_function_with_input\")\n    try:\n        result = my_function_with_input(10, 5)\n        print(f\"Result: {result}\")\n    except Exception as e:\n        print(f\"Exception: {e}\")\n\n    # Capture the outcome of function calls using inspect\n    frame = inspect.currentframe().f_back\n    print(\"\\nCaptured Frame:\")\n    print(f\"Function: {frame.f_code.co_name}\")\n    print(f\"Arguments: {frame.f_code.co_varnames}\")\n    print(f\"Locals: {frame.f_locals}\")\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport os\n\ndef create_directory(path):\n    \"\"\"\n    Creates a new directory at the specified path.\n    \n    Args:\n        path (str): The path to the directory to create.\n    \"\"\"\n    try:\n        os.mkdir(path)\n    except FileExistsError:\n        print(f\"Directory '{path}' already exists.\")\n    except OSError as e:\n        print(f\"Error creating directory: {e}\")\n\ndef list_files(path):\n    \"\"\"\n    Lists all files in the specified directory.\n    \n    Args:\n        path (str): The path to the directory to list files from.\n    \n    Returns:\n        list: A list of file names in the directory.\n    \"\"\"\n    try:\n        return os.listdir(path)\n    except FileNotFoundError:\n        print(f\"Directory '{path}' not found.\")\n        return []\n\ndef delete_file(path):\n    \"\"\"\n    Deletes the specified file.\n    \n    Args:\n        path (str): The path to the file to delete.\n    \"\"\"\n    try:\n        os.remove(path)\n    except FileNotFoundError:\n        print(f\"File '{path}' not found.\")\n    except OSError as e:\n        print(f\"Error deleting file: {e}\")\n\ndef delete_directory(path):\n    \"\"\"\n    Deletes the specified directory and all its contents.\n    \n    Args:\n        path (str): The path to the directory to delete.\n    \"\"\"\n    try:\n        os.rmdir(path)\n    except FileNotFoundError:\n        print(f\"Directory '{path}' not found.\")\n    except OSError as e:\n        print(f\"Error deleting directory: {e}\")\n\ndef check_file_existence(path):\n    \"\"\"\n    Checks if the specified file exists.\n    \n    Args:\n        path (str): The path to the file to check.\n    \n    Returns:\n        bool: True if the file exists, False otherwise.\n    \"\"\"\n    return os.path.exists(path)\n\n# Example usage\nif __name__ == \"__main__\":\n    # Create a new directory\n    create_directory(\"new_directory\")\n\n    # List files in a directory\n    print(list_files(\"current_directory\"))\n\n    # Delete a file\n    delete_file(\"file_to_delete.txt\")\n\n    # Delete a directory\n    delete_directory(\"new_directory\")\n\n    # Check if a file exists\n    print(check_file_existence(\"file_to_check.txt\"))\n```"
