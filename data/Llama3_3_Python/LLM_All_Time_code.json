"```python\nimport asyncio\nfrom typing import Dict, List, Tuple\n\nclass SASL:\n    \"\"\"\n    Pure-python SASL library for asyncio.\n    \"\"\"\n\n    class Mechanism:\n        def __init__(self, name: str, requirements: Dict[str, List[str]]):\n            self.name = name\n            self.requirements = requirements\n\n        async def authenticate(self, username: str, password: str) -> Tuple[bool, str]:\n            raise NotImplementedError\n\n    class PLAIN(Mechanism):\n        def __init__(self):\n            super().__init__(\"PLAIN\", {\"username\": [], \"password\": []})\n\n        async def authenticate(self, username: str, password: str) -> Tuple[bool, str]:\n            return True, f\"PLAIN {username} {password}\"\n\n    class NTLM(Mechanism):\n        def __init__(self):\n            super().__init__(\"NTLM\", {\"username\": [], \"password\": []})\n\n        async def authenticate(self, username: str, password: str) -> Tuple[bool, str]:\n            # Simplified NTLM authentication for demonstration purposes\n            return True, f\"NTLM {username} {password}\"\n\n    class CRAM_MD5(Mechanism):\n        def __init__(self):\n            super().__init__(\"CRAM-MD5\", {\"username\": [], \"password\": []})\n\n        async def authenticate(self, username: str, password: str) -> Tuple[bool, str]:\n            # Simplified CRAM-MD5 authentication for demonstration purposes\n            return True, f\"CRAM-MD5 {username} {password}\"\n\n    class DIGEST(Mechanism):\n        def __init__(self):\n            super().__init__(\"DIGEST\", {\"username\": [], \"password\": []})\n\n        async def authenticate(self, username: str, password: str) -> Tuple[bool, str]:\n            # Simplified DIGEST authentication for demonstration purposes\n            return True, f\"DIGEST {username} {password}\"\n\n    mechanisms = {\n        \"PLAIN\": PLAIN(),\n        \"NTLM\": NTLM(),\n        \"CRAM-MD5\": CRAM_MD5(),\n        \"DIGEST\": DIGEST(),\n    }\n\n    async def authenticate(self, username: str, password: str, mechanism: str) -> Tuple[bool, str]:\n        if mechanism not in mechanisms:\n            raise ValueError(f\"Unsupported mechanism: {mechanism}\")\n\n        return await mechanisms[mechanism].authenticate(username, password)\n\n\nasync def main():\n    sasl = SASL()\n    username = \"test_user\"\n    password = \"test_password\"\n\n    # Test PLAIN mechanism\n    result1 = await sasl.authenticate(username, password, \"PLAIN\")\n    print(f\"PLAIN result: {result1}\")\n\n    # Test NTLM mechanism\n    result2 = await sasl.authenticate(username, password, \"NTLM\")\n    print(f\"NTLM result: {result2}\")\n\n    # Test CRAM-MD5 mechanism\n    result3 = await sasl.authenticate(username, password, \"CRAM-MD5\")\n    print(f\"CRAM-MD5 result: {result3}\")\n\n    # Test DIGEST mechanism\n    result4 = await sasl.authenticate(username, password, \"DIGEST\")\n    print(f\"DIGEST result: {result4}\")\n\n\nasyncio.run(main())\n```"
"```python\nimport os\n\ndef acquire_file_lock(file_path, exclusive=False):\n    # Check if the file exists\n    if not os.path.exists(file_path):\n        raise FileNotFoundError(f\"The file {file_path} does not exist.\")\n\n    # Open the file in read and write mode\n    with open(file_path, 'r+b') as file:\n        # Get the file descriptor\n        fd = file.fileno()\n\n        # Acquire the lock\n        if exclusive:\n            os.flock(fd, os.FLOCK_EX | os.FLOCK_NB)\n        else:\n            os.flock(fd, os.FLOCK_EX)\n\ndef release_file_lock(file_path):\n    # Get the file descriptor\n    with open(file_path, 'r+b') as file:\n        fd = file.fileno()\n        # Release the lock\n        os.flock(fd, os.FLOCK_UN)\n```"
"```python\nclass Node:\n    def __init__(self, key, value):\n        self.key = key\n        self.value = value\n        self.left = None\n        self.right = None\n\n\nclass BinarySearchTree:\n    def __init__(self):\n        self.root = None\n\n    def insert(self, key, value):\n        if self.root is None:\n            self.root = Node(key, value)\n        else:\n            self._insert(self.root, key, value)\n\n    def _insert(self, node, key, value):\n        if key < node.key:\n            if node.left is None:\n                node.left = Node(key, value)\n            else:\n                self._insert(node.left, key, value)\n        elif key > node.key:\n            if node.right is None:\n                node.right = Node(key, value)\n            else:\n                self._insert(node.right, key, value)\n        else:\n            node.value = value\n\n    def delete(self, key):\n        self.root = self._delete(self.root, key)\n\n    def _delete(self, node, key):\n        if node is None:\n            return node\n        if key < node.key:\n            node.left = self._delete(node.left, key)\n        elif key > node.key:\n            node.right = self._delete(node.right, key)\n        else:\n            if node.left is None:\n                return node.right\n            elif node.right is None:\n                return node.left\n            else:\n                min_node = self._find_min(node.right)\n                node.key = min_node.key\n                node.value = min_node.value\n                node.right = self._delete(node.right, min_node.key)\n        return node\n\n    def _find_min(self, node):\n        while node.left is not None:\n            node = node.left\n        return node\n\n    def get(self, key):\n        return self._get(self.root, key)\n\n    def _get(self, node, key):\n        if node is None or node.key == key:\n            return node.value if node else None\n        if key < node.key:\n            return self._get(node.left, key)\n        return self._get(node.right, key)\n\n\n# Example usage:\nbst = BinarySearchTree()\nbst.insert('apple', 5)\nbst.insert('banana', 10)\nbst.insert('cherry', 15)\n\nprint(bst.get('apple'))  # Output: 5\nprint(bst.get('banana'))  # Output: 10\nprint(bst.get('cherry'))  # Output: 15\n\nbst.delete('banana')\nprint(bst.get('banana'))  # Output: None\n```"
"```python\nfrom task import Task\n\nclass MyTask(Task):\n    def __init__(self, name, *args, **kwargs):\n        super().__init__(name, *args, **kwargs)\n\n    def execute(self):\n        print(f\"Executing task {self.name} with args: {self.args} and kwargs: {self.kwargs}\")\n\n\nclass MyTaskWithDependency(Task):\n    def __init__(self, name, other_task, *args, **kwargs):\n        super().__init__(name, other_task, *args, **kwargs)\n\n    def execute(self):\n        print(f\"Executing task {self.name} with args: {self.args} and kwargs: {self.kwargs}\")\n        other_task.execute()\n\n\n# Define tasks\ntask1 = MyTask(\"Task 1\")\ntask2 = MyTask(\"Task 2\", \"arg1\")\ntask3 = MyTask(\"Task 3\", \"arg2\", depends_on=[task1])\n\ntask4 = MyTaskWithDependency(\"Task 4\", task2)\ntask5 = MyTaskWithDependency(\"Task 5\", task3)\n\n# Execute tasks\ntask1.execute()\ntask4.execute()\ntask5.execute()\n```"
