"```python\nimport ast\nimport sqlparse\n\ndef parse_sql_query(sql_query):\n    # First, we'll use the sqlparse library to parse the SQL query into a list of statements\n    statements = sqlparse.split(sql_query)\n    \n    # Then, we'll join all the statements back into a single string\n    sql_query = ' '.join(statements)\n    \n    # Now, we'll use the ast.parse function to parse the SQL query into an abstract syntax tree\n    tree = ast.parse(sql_query)\n    \n    return tree\n\n# Example usage:\nsql_query = \"SELECT * FROM users WHERE age > 18\"\ntree = parse_sql_query(sql_query)\nprint(ast.dump(tree))\n```"
