"```python\nfrom ipywidgets import interact, Layout\nimport numpy as np\n\n# Define a function to create the interactive widgets\ndef create_widgets():\n    # Slider widget for numerical input\n    def update_value(value):\n        print(f\"Slider value: {value}\")\n\n    slider = interact(update_value, \n                     value=(0, 100, 1), \n                     description=\"Slider value:\", \n                     layout=Layout(width='50%'))\n\n    # Dropdown menu for selecting from a list of options\n    options = ['Option 1', 'Option 2', 'Option 3']\n    def update_option(option):\n        print(f\"Selected option: {option}\")\n\n    dropdown = interact(update_option, \n                        option=options, \n                        description=\"Selected option:\", \n                        layout=Layout(width='50%'))\n\n    # Checkbox for toggle boolean value\n    def update_checkbox(checked):\n        if checked:\n            print(\"Checkbox is checked\")\n        else:\n            print(\"Checkbox is unchecked\")\n\n    checkbox = interact(update_checkbox, \n                        checked=(False, True), \n                        description=\"Checkbox:\", \n                        layout=Layout(width='50%'))\n\n    return slider, dropdown, checkbox\n\n# Create the interactive widgets\nslider, dropdown, checkbox = create_widgets()\n```"
