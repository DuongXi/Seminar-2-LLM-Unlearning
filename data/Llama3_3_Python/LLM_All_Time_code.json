"```python\nfrom azure.storage.filedatalake import DataLakeServiceClient\nfrom azure.core.exceptions import HttpResponseError\n\n# Create an instance of the Azure Data Lake Store Filesystem client using the default credential chain\ndls_client = DataLakeServiceClient(\"https://<account_name>.file.core.windows.net/\", credential=None)\n\n# Use the client to list all files and directories in the root directory\ntry:\n    files_and_directories = dls_client.list_directory(\"/root\")\n    print(\"Files and directories in the root directory:\")\n    for file_or_directory in files_and_directories:\n        print(file_or_directory.name)\nexcept HttpResponseError as e:\n    print(f\"Failed to list files and directories: {e}\")\n\n# Create a new directory\nnew_directory = dls_client.create_directory(\"/root/new_directory\")\n\n# Upload a local file to the new directory\nwith open(\"local_file.txt\", \"rb\") as file:\n    dls_client.upload_file(\"/root/new_directory/local_file.txt\", file)\n\n# Delete the new directory\ntry:\n    dls_client.delete_directory(\"/root/new_directory\")\nexcept HttpResponseError as e:\n    print(f\"Failed to delete directory: {e}\")\n```"
"```python\nfrom flask import Flask, Response\nfrom functools import wraps\n\napp = Flask(__name__)\n\nCORS_ALLOWED_ORIGINS = ['http://example1.com', 'http://example2.com']\nCORS_ALLOWED_METHODS = ['GET', 'POST', 'PUT', 'DELETE']\nCORS_ALLOWED_HEADERS = ['Content-Type', 'Authorization']\n\ndef after_request(func):\n    @wraps(func)\n    def decorated_function(request):\n        response = func(request)\n        response.headers.add('Access-Control-Allow-Origin', ', '.join(CORS_ALLOWED_ORIGINS))\n        response.headers.add('Access-Control-Allow-Methods', ', '.join(CORS_ALLOWED_METHODS))\n        response.headers.add('Access-Control-Allow-Headers', ', '.join(CORS_ALLOWED_HEADERS))\n        return response\n    return decorated_function\n\napp.after_request(after_request)\n```"
