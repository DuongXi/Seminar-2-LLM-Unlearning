"```python\nfrom google.cloud import datastore\n\n# Create a client object to interact with the Datastore database\nclient = datastore.Client()\n\n# Create a key for a new entity\nentity_key = client.key(\"Entity\", \"id\")\n\n# Create a new entity\nentity = datastore.Entity(key=entity_key)\nentity[\"name\"] = \"New Entity\"\nentity[\"description\"] = \"This is a new entity.\"\n\n# Put the entity into the database\nclient.put(entity)\n\n# Read an entity by its key\nentity = client.get(key=entity_key)\nprint(entity)\n\n# Update an entity by its key\nentity[\"name\"] = \"Updated Entity\"\nclient.put(entity)\n\n# Read the updated entity\nentity = client.get(key=entity_key)\nprint(entity)\n\n# Delete an entity by its key\nclient.delete(entity)\n```"
"```python\nimport os\nimport sys\nfrom typing import Dict, List\nfrom setuptools import setup, find_packages\nfrom poetry.core.masonry import MasonryProject\nfrom poetry.core.masonry import MasonryEnvironment\n\nclass PoeticMasonryProject(MasonryProject):\n    name: str = \"poetic\"\n    version: str = \"0.1.0\"\n\n    def __init__(self, path: str):\n        super().__init__(path)\n\n    def _get_info(self) -> Dict:\n        return {\n            \"name\": self.name,\n            \"version\": self.version,\n            \"description\": \"A Poetic backend for building Python packages\",\n            \"classifiers\": [\n                \"Development Status :: 5 - Production/Stable\",\n                \"Intended Audience :: Developers\",\n                \"License :: OSI Approved :: MIT License\",\n                \"Programming Language :: Python :: 3.7\",\n                \"Programming Language :: Python :: 3.8\",\n                \"Programming Language :: Python :: 3.9\",\n                \"Programming Language :: Python :: 3.10\",\n            ],\n            \"packages\": find_packages(),\n        }\n\n    def _get_install_requires(self) -> List[str]:\n        return []\n\n    def _get_urls(self) -> Dict[str, str]:\n        return {\n            \"Source\": \"https://github.com/poetic/poetic\",\n            \"Bug Reports\": \"https://github.com/poetic/poetic/issues\",\n            \"Changelogs\": \"https://github.com/poetic/poetic/releases\",\n        }\n\n    def _get_package_data(self) -> Dict[str, List[str]]:\n        return {\"\": [\"poetic/*\"]}\n\n    def _get_metadata(self) -> Dict:\n        return {\n            \"name\": self.name,\n            \"version\": self.version,\n            \"description\": self.description,\n            \"long_description\": open(\"README.rst\").read(),\n            \"author\": \"Your Name\",\n            \"author_email\": \"your@email.com\",\n            \"license\": \"MIT\",\n            \"classifiers\": self.classifiers,\n        }\n\ndef main():\n    if len(sys.argv) != 2:\n        print(\"Usage: python setup.py <command>\")\n        sys.exit(1)\n\n    command = sys.argv[1]\n    project = PoeticMasonryProject(\".\")\n    environment = MasonryEnvironment(project)\n\n    if command == \"sdist\":\n        environment.sdist()\n    elif command == \"bdist_wheel\":\n        environment.bdist_wheel()\n    elif command == \"build\":\n        environment.build()\n    else:\n        print(\"Unknown command\")\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nfrom pytz import timezone, UnknownTimeZoneError\nimport datetime\n\ndef convert_utc_to_local(utc_timestamp, local_tz):\n    \"\"\"\n    Converts a UTC timestamp to local time in a specific timezone.\n\n    Args:\n    - utc_timestamp (datetime.datetime): UTC timestamp to be converted.\n    - local_tz (str): Timezone string (e.g., 'America/New_York').\n\n    Returns:\n    - datetime.datetime: Local time corresponding to the given UTC timestamp.\n    \"\"\"\n    try:\n        utc = timezone('UTC')\n        local = timezone(local_tz)\n        local_timestamp = utc.fromutc(utc_timestamp)\n        return local_timestamp\n    except UnknownTimeZoneError:\n        print(f\"Unknown timezone: {local_tz}\")\n        return None\n\n# Example usage:\nutc_timestamp = datetime.datetime.utcnow()\nlocal_tz = 'America/New_York'\nlocal_time = convert_utc_to_local(utc_timestamp, local_tz)\nif local_time:\n    print(local_time)\n```"
"```python\nfrom azure.identity import DefaultAzureCredential\nfrom azure.mgmt.authorization import AuthorizationManagementClient\nfrom azure.core.exceptions import HttpResponseError\n\n# Create a default Azure credential\ncredential = DefaultAzureCredential()\n\n# Create an instance of the AuthorizationManagementClient class\nauth_client = AuthorizationManagementClient(credential, \"https://graph.microsoft.com/\")\n```"
"```python\nimport os\nimport pickle\nfrom google.oauth2 import service_account\nfrom googleapiclient.discovery import build\nfrom googleapiclient.errors import HttpError\n\n# Replace with your service account credentials\ncreds = service_account.Credentials.from_service_account_file(\n    'path_to_your_service_account_key.json',\n    scopes=['https://www.googleapis.com/auth/spreadsheets']\n)\n\n# Initialize the Sheets API client\nservice = build('sheets', 'v4', credentials=creds)\n\ndef get_service_account_credentials():\n    return creds\n\ndef list_sheets(service, spreadsheet_id):\n    \"\"\"List all sheets in a spreadsheet.\"\"\"\n    response = service.spreadsheets().values().list(spreadsheetId=spreadsheet_id).execute()\n    sheets = []\n    for item in response.get('values', []):\n        if item[0] != '':\n            sheets.append(item[0])\n    return sheets\n\ndef create_sheet(service, spreadsheet_id, sheet_name):\n    \"\"\"Create a new sheet in a spreadsheet.\"\"\"\n    body = {\n        'properties': {\n            'title': sheet_name\n        }\n    }\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"'{sheet_name}'!\",\n            body=body\n        ).execute()\n        print(f\"Sheet '{sheet_name}' created successfully.\")\n    except HttpError as error:\n        print(f\"Failed to create sheet '{sheet_name}': {error}\")\n\ndef delete_sheet(service, spreadsheet_id, sheet_name):\n    \"\"\"Delete a sheet from a spreadsheet.\"\"\"\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"'{sheet_name}'!\",\n            body={'properties': {'title': ''}}\n        ).execute()\n        print(f\"Sheet '{sheet_name}' deleted successfully.\")\n    except HttpError as error:\n        print(f\"Failed to delete sheet '{sheet_name}': {error}\")\n\ndef rename_sheet(service, spreadsheet_id, old_name, new_name):\n    \"\"\"Rename a sheet in a spreadsheet.\"\"\"\n    body = {\n        'properties': {\n            'title': new_name\n        }\n    }\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"'{old_name}'!\",\n            body=body\n        ).execute()\n        print(f\"Sheet '{old_name}' renamed to '{new_name}' successfully.\")\n    except HttpError as error:\n        print(f\"Failed to rename sheet '{old_name}': {error}\")\n\ndef format_cell(service, spreadsheet_id, sheet_name, row, col, value):\n    \"\"\"Format a cell with a value.\"\"\"\n    body = {\n        'values': [\n            {\n                'userEnteredValue': {\n                    'stringValue': value\n                }\n            }\n        ]\n    }\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"{sheet_name}!{row},{col}\",\n            valueInputOption='USER_ENTERED',\n            body=body\n        ).execute()\n        print(f\"Cell '{row},{col}' in sheet '{sheet_name}' formatted successfully.\")\n    except HttpError as error:\n        print(f\"Failed to format cell '{row},{col}': {error}\")\n\ndef format_sheet(service, spreadsheet_id, sheet_name, header):\n    \"\"\"Format a sheet with a header.\"\"\"\n    body = {\n        'properties': {\n            'title': header\n        }\n    }\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"'{sheet_name}'!\",\n            body=body\n        ).execute()\n        print(f\"Sheet '{sheet_name}' formatted successfully.\")\n    except HttpError as error:\n        print(f\"Failed to format sheet '{sheet_name}': {error}\")\n\ndef add_sheet(service, spreadsheet_id, sheet_name):\n    \"\"\"Add a new sheet to a spreadsheet.\"\"\"\n    body = {\n        'properties': {\n            'title': sheet_name\n        }\n    }\n    try:\n        service.spreadsheets().values().update(\n            spreadsheetId=spreadsheet_id,\n            range=f\"'{sheet_name}'!\",\n            body=body\n        ).execute()\n        print(f\"Sheet '{sheet_name}' added successfully.\")\n    except HttpError as error:\n        print(f\"Failed to add sheet '{sheet_name}': {error}\")\n\ndef main():\n    spreadsheet_id = 'your_spreadsheet_id'\n    sheet_name = 'your_sheet_name'\n\n    sheets = list_sheets(service, spreadsheet_id)\n    print(f\"Current sheets: {sheets}\")\n\n    create_sheet(service, spreadsheet_id, 'new_sheet')\n    print(f\"Created new sheet: {list_sheets(service, spreadsheet_id)}\")\n\n    delete_sheet(service, spreadsheet_id, 'old_sheet')\n    print(f\"Deleted old sheet: {list_sheets(service, spreadsheet_id)}\")\n\n    rename_sheet(service, spreadsheet_id, 'old_sheet', 'new_sheet')\n    print(f\"Renamed old sheet: {list_sheets(service, spreadsheet_id)}\")\n\n    format_cell(service, spreadsheet_id, 'new_sheet', 1, 1, 'Hello, World!')\n    format_sheet(service, spreadsheet_id, 'new_sheet', 'Hello, World!')\n\n    add_sheet(service, spreadsheet_id, 'another_sheet')\n    print(f\"Added new sheet: {list_sheets(service, spreadsheet_id)}\")\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nfrom google.oauth2 import service_account\nfrom googleapiclient.discovery import build\nfrom googleapiclient.errors import HttpError\n\n# Replace 'YOUR_PROJECT_ID' and 'YOUR_SECRET_MANAGER_SERVICE_ACCOUNT_FILE' with your actual project ID and secret manager service account file\nPROJECT_ID = 'YOUR_PROJECT_ID'\nSERVICE_ACCOUNT_FILE = 'YOUR_SECRET_MANAGER_SERVICE_ACCOUNT_FILE'\n\n# Create credentials for the Secret Manager API\ncreds = service_account.Credentials.from_service_account_file(\n    SERVICE_ACCOUNT_FILE, scopes=['https://www.googleapis.com/auth/cloud-platform']\n)\n\n# Create a client instance for the Secret Manager API\nsecret_manager_service = build('secretmanager', 'v1', credentials=creds)\n\ndef create_secret(secret_manager_service, secret_id, payload):\n    \"\"\"Create a new secret in Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().create(\n        project=PROJECT_ID,\n        parent='projects/' + PROJECT_ID,\n        secret_id=secret_id,\n        payload=payload\n    )\n    response = request.execute()\n    print(f\"Created secret {secret_id}\")\n\ndef read_secret(secret_manager_service, secret_id):\n    \"\"\"Read a secret from Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().get(\n        project=PROJECT_ID,\n        secretId=secret_id\n    )\n    response = request.execute()\n    print(f\"Read secret {secret_id}: {response['payload']['data']}\")\n\n\ndef update_secret(secret_manager_service, secret_id, payload):\n    \"\"\"Update a secret in Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().update(\n        project=PROJECT_ID,\n        secretId=secret_id,\n        payload=payload\n    )\n    response = request.execute()\n    print(f\"Updated secret {secret_id}\")\n\n\ndef delete_secret(secret_manager_service, secret_id):\n    \"\"\"Delete a secret from Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().delete(\n        project=PROJECT_ID,\n        secretId=secret_id\n    )\n    response = request.execute()\n    print(f\"Deleted secret {secret_id}\")\n\n\ndef list_secrets(secret_manager_service):\n    \"\"\"List all secrets in Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().list(\n        project=PROJECT_ID\n    )\n    response = request.execute()\n    print(\"Listing secrets:\")\n    for secret in response['secrets']:\n        print(secret['name'])\n\n\ndef get_secret_version(secret_manager_service, secret_id):\n    \"\"\"Fetch a secret version from Secret Manager.\"\"\"\n    request = secret_manager_service.projects().secrets().versions().get(\n        project=PROJECT_ID,\n        secretId=secret_id\n    )\n    response = request.execute()\n    print(f\"Got secret version for {secret_id}: {response['payload']['data']}\")\n\n\n# Example usage:\nif __name__ == \"__main__\":\n    # Create a new secret\n    payload = {\"payload\": {\"data\": \"This is a secret.\"}}\n    create_secret(secret_manager_service, \"my-secret\", payload)\n\n    # Read a secret\n    read_secret(secret_manager_service, \"my-secret\")\n\n    # Update a secret\n    payload = {\"payload\": {\"data\": \"This is an updated secret.\"}}\n    update_secret(secret_manager_service, \"my-secret\", payload)\n\n    # Delete a secret\n    delete_secret(secret_manager_service, \"my-secret\")\n\n    # List all secrets\n    list_secrets(secret_manager_service)\n\n    # Fetch a secret version\n    get_secret_version(secret_manager_service, \"my-secret\")\n```"
"```python\nimport pika\n\n# Define connection parameters\nhost = 'localhost'\nport = 5672\nusername = 'guest'\npassword = 'guest'\n\n# Create a connection to the AMQP server\nconnection = pika.BlockingConnection(\n    pika.ConnectionParameters(host=host, port=port, credentials=pika.PlainCredentials(username, password))\n)\n\n# Create a channel\nchannel = connection.channel()\n\n# Declare the exchange and queue\nchannel.exchange_declare(exchange='amqp_exchange', type='direct')\nchannel.queue_declare(queue='amqp_queue')\n\n# Bind the queue to the exchange\nchannel.queue_bind(exchange='amqp_exchange', queue='amqp_queue', routing_key='amqp_routing_key')\n\n# Close the connection when done\nconnection.close()\n```"
"```python\nimport sys\nimport time\n\ndef create_progress_bar(title, max_value, increment):\n    total_steps = max_value\n    current_step = 0\n    start_time = time.time()\n\n    while current_step < total_steps:\n        elapsed_time = time.time() - start_time\n        current_value = int((current_step / total_steps) * max_value)\n        bar_length = 50\n        filled_length = int((current_value / max_value) * bar_length)\n        bar = '#' * filled_length + '-' * (bar_length - filled_length)\n        \n        print(f\"\\r{title}: [{bar}] {current_value}/{max_value} ({(current_step / total_steps) * 100:.2f}%)\", end='')\n\n        sys.stdout.flush()\n        time.sleep(0.1)  # adjust this to change the speed of the progress bar\n\n        current_step += increment\n\n    print()\n```\n\nThis function will print a progress bar that updates in real-time as it runs. The progress bar is represented by a series of '#' characters, with '-' characters separating the filled portion from the empty portion. The length of the progress bar can be adjusted by changing the `bar_length` variable.\n\nTo use this function, simply call it with a title, a maximum value, and an incremental value. For example:\n\n```python\ncreate_progress_bar(\"Running a long operation\", 100, 5)\n```"
"```python\nimport pandas as pd\nfrom collections import OrderedDict\nfrom string import capwords\n\n# Function to read a CSV file and return a dictionary\ndef csv_to_dict(file_path):\n    try:\n        data = pd.read_csv(file_path)\n        return data.to_dict(orient='records')\n    except FileNotFoundError:\n        print(\"File not found.\")\n        return None\n\n# Function to remove duplicates from a list\ndef remove_duplicates(input_list):\n    return list(OrderedDict.fromkeys(input_list))\n\n# Function to convert a string to title case\ndef to_title_case(input_string):\n    return capwords(input_string)\n\n# Example usage:\nfile_path = 'example.csv'\nprint(csv_to_dict(file_path))\n\ninput_list = ['apple', 'banana', 'apple', 'orange']\nprint(remove_duplicates(input_list))\n\ninput_string = 'this is an example string'\nprint(to_title_case(input_string))\n```"
"```python\nimport os\n\ndef monotonic_time():\n    return os.clock_gettime(os.CLOCK_MONOTONIC) / 1e9\n\n# Example usage:\nprint(monotonic_time())\n```"
"```python\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport numpy as np\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score\nfrom tensorflow.keras.utils import to_categorical\nimport pickle\n\n# Assuming you have your dataset in numpy arrays\n# X_train, X_test, y_train, y_test = ...  # load your data\n\n# Create the model\nclass MyModel(keras.Model):\n    def __init__(self):\n        super(MyModel, self).__init__()\n        self.flatten = layers.Flatten()\n        self.dense1 = layers.Dense(64, activation='relu')\n        self.dense2 = layers.Dense(32, activation='relu')\n        self.dense3 = layers.Dense(10, activation='softmax')\n\n    def call(self, inputs):\n        x = self.flatten(inputs)\n        x = self.dense1(x)\n        x = self.dense2(x)\n        x = self.dense3(x)\n        return x\n\n# Compile the model\ndef compile_model(model, loss, optimizer):\n    model.compile(loss=loss, optimizer=optimizer)\n\n# Train the model\ndef train_model(model, X_train, y_train, X_test, y_test):\n    model.fit(X_train, y_train, epochs=10, validation_data=(X_test, y_test))\n\n# Evaluate the model\ndef evaluate_model(model, X_test, y_test):\n    y_pred = model.predict(X_test)\n    y_pred_class = np.argmax(y_pred, axis=1)\n    accuracy = accuracy_score(np.argmax(y_test, axis=1), y_pred_class)\n    return accuracy\n\n# Save the model\ndef save_model(model, file_path):\n    with open(file_path, 'wb') as f:\n        pickle.dump(model, f)\n\n# Main function\ndef main():\n    # Assuming you have your dataset in numpy arrays\n    X_train, X_test, y_train, y_test = ...  # load your data\n\n    # One-hot encode the labels\n    y_train = to_categorical(y_train)\n    y_test = to_categorical(y_test)\n\n    # Split the data into training and validation sets\n    X_train, X_val, y_train, y_val = train_test_split(X_train, y_train, test_size=0.2, random_state=42)\n\n    # Create the model\n    model = MyModel()\n\n    # Compile the model\n    loss = 'categorical_crossentropy'\n    optimizer = 'adam'\n    compile_model(model, loss, optimizer)\n\n    # Train the model\n    train_model(model, X_train, y_train, X_val, y_val)\n\n    # Evaluate the model\n    accuracy = evaluate_model(model, X_test, y_test)\n    print(f'Test accuracy: {accuracy:.3f}')\n\n    # Save the model\n    save_model(model, 'model.pkl')\n\nif __name__ == '__main__':\n    main()\n```"
"```python\nimport datetime\nimport re\n\ndef cron_iterator(format_string, dt=None):\n    if dt is None:\n        dt = datetime.datetime.now()\n    if isinstance(dt, str):\n        dt = datetime.datetime.strptime(dt, \"%Y-%m-%d %H:%M:%S\")\n\n    for i in range(1000):\n        year = dt.year\n        month = dt.month\n        day = dt.day\n        hour = dt.hour\n        minute = dt.minute\n        second = dt.second\n\n        if re.match(format_string, f\"{year}-{month:02}-{day:02} {hour:02}:{minute:02}:{second:02}\"):\n            yield dt\n        dt += datetime.timedelta(seconds=1)\n\n# Example usage:\nfor date in cron_iterator(\"2022-09-01 08:00:00\"):\n    print(date)\n```"
