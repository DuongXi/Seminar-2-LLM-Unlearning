"```python\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Sample data\ndata = {\n    'Name': ['John', 'Anna', 'Peter', 'Linda', 'Tom'],\n    'Age': [28, 24, 35, 32, 40],\n    'Score': [85, 90, 78, 92, 88]\n}\n\n# Create DataFrame\ndf = pd.DataFrame(data)\n\n# Print original DataFrame\nprint(\"Original DataFrame:\")\nprint(df)\n\n# Statistical Analysis using NumPy\nmean_age = np.mean(df['Age'])\nmedian_score = np.median(df['Score'])\nstd_dev = np.std(df['Score'])\n\nprint(\"\\nStatistical Analysis:\")\nprint(f\"Mean Age: {mean_age}\")\nprint(f\"Median Score: {median_score}\")\nprint(f\"Standard Deviation of Score: {std_dev}\")\n\n# Data Manipulation\ndf['AgeGroup'] = pd.cut(df['Age'], bins=[0, 25, 35, 45, np.inf], labels=['20-24', '25-34', '35-44', '45+'])\ndf['ScoreCategory'] = pd.cut(df['Score'], bins=[0, 80, 90, np.inf], labels=['Bad', 'Good', 'Excellent'])\n\n# Print manipulated DataFrame\nprint(\"\\nManipulated DataFrame:\")\nprint(df)\n\n# Visualization using Matplotlib\nplt.figure(figsize=(8, 6))\nplt.subplot(1, 2, 1)\nplt.bar(df['Name'], df['Score'])\nplt.title('Score Distribution')\nplt.xlabel('Name')\nplt.ylabel('Score')\n\nplt.subplot(1, 2, 2)\nplt.hist(df['Age'], bins=5, edgecolor='black')\nplt.title('Age Distribution')\nplt.xlabel('Age')\nplt.ylabel('Frequency')\n\nplt.tight_layout()\nplt.show()\n```"
