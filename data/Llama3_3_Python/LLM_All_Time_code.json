"```python\nimport sys\nimport os\n\ndef detect_shell():\n    if os.name == 'posix' and sys.platform == 'darwin':\n        return 'fish'\n    elif os.name == 'posix' and sys.platform in ['linux', 'freebsd']:\n        if '$PS1' in os.environ:\n            return 'zsh'\n        elif '$CSH' in os.environ:\n            return 'tcsh'\n        else:\n            return 'sh'\n    else:\n        return None\n\nprint(detect_shell())\n```"
"```python\nimport logging\nimport json\nfrom logging.handlers import MemoryHandler, RotatingFileHandler\nfrom datetime import datetime\n\nclass JSONFormatter(logging.Formatter):\n    def format(self, record):\n        if record.levelname == 'CRITICAL':\n            level_icon = '\\033[91m'  # Red color\n        elif record.levelname == 'ERROR':\n            level_icon = '\\033[93m'  # Yellow color\n        elif record.levelname == 'WARNING':\n            level_icon = '\\033[93m'  # Yellow color\n        elif record.levelname == 'INFO':\n            level_icon = '\\033[0m'  # Default color\n        else:\n            level_icon = '\\033[0m'  # Default color\n\n        formatted_message = {\n            'timestamp': datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S'),\n            'level': record.levelname,\n            'level_icon': level_icon,\n            'message': record.getMessage()\n        }\n\n        return json.dumps(formatted_message)\n\nclass CustomLogger:\n    def __init__(self, name, level=logging.INFO, timestamp_format='%Y-%m-%d %H:%M:%S', log_level_icon=None):\n        self.logger = logging.getLogger(name)\n        self.logger.setLevel(level)\n        self.timestamp_format = timestamp_format\n        self.log_level_icon = log_level_icon\n\n        self.handler = MemoryHandler(maxBytes=1000000, backupCount=5)\n        self.handler.setFormatter(JSONFormatter('%(message)s'))\n\n        self.logger.addHandler(self.handler)\n\n    def debug(self, message):\n        self.logger.debug(message)\n\n    def info(self, message):\n        self.logger.info(message)\n\n    def warning(self, message):\n        self.logger.warning(message)\n\n    def error(self, message):\n        self.logger.error(message)\n\n    def critical(self, message):\n        self.logger.critical(message)\n\n# Usage\nlogger = CustomLogger('my_logger')\nlogger.debug('This is a debug message')\nlogger.info('This is an info message')\nlogger.warning('This is a warning message')\nlogger.error('This is an error message')\nlogger.critical('This is a critical message')\n```"
"```python\nimport requests\nimport xmltodict\n\ndef get_geographic_data(address, api_key):\n    # OpenStreetMap API\n    url = f\"https://nominatim.openstreetmap.org/search?q={address}&format=json&limit=1\"\n    response = requests.get(url)\n    data = response.json()\n    \n    if data:\n        lat = data[0]['lat']\n        lon = data[0]['lon']\n        \n        # Google Maps API\n        google_url = f\"https://maps.googleapis.com/maps/api/geocode/json?address={address}&key={api_key}\"\n        google_response = requests.get(google_url)\n        google_data = google_response.json()\n        \n        if google_data['status'] == 'OK':\n            lat = google_data['results'][0]['geometry']['location']['lat']\n            lon = google_data['results'][0]['geometry']['location']['lng']\n        \n        return {\n            'osm': {\n                'lat': lat,\n                'lon': lon\n            },\n            'google': {\n                'lat': lat,\n                'lon': lon\n            }\n        }\n    \n    return None\n\ndef parse_geographic_data(data, format):\n    if format == 'xml':\n        return xmltodict.parse(data)\n\n    return data\n\ndef main():\n    address = input(\"Enter an address: \")\n    api_key = input(\"Enter your Google Maps API key: \")\n    \n    data = get_geographic_data(address, api_key)\n    \n    if data:\n        print(\"Geographic Data:\")\n        print(parse_geographic_data(data['osm'], 'xml'))\n        print(parse_geographic_data(data['google'], 'json'))\n    else:\n        print(\"No geographic data found.\")\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nfrom azure.identity import DefaultAzureCredential\nfrom azure.keyvault.secrets import SecretClient\nfrom azure.keyvault.certificates import CertificateClient\n\n# Create a DefaultAzureCredential instance\ncredential = DefaultAzureCredential()\n\n# Create a SecretClient instance\nsecret_client = SecretClient(\n    vault_url=\"https://your-vault-name.vault.azure.net\", \n    credential=credential\n)\n\n# Create a CertificateClient instance\ncertificate_client = CertificateClient(\n    vault_url=\"https://your-vault-name.vault.azure.net\", \n    credential=credential\n)\n```"
"```python\nimport requests\n\ndef parse_url(url, private_domains=None):\n    \"\"\"\n    Parse a URL and separate its subdomain, domain, and public suffix.\n    \n    Args:\n    url (str): The URL to parse.\n    private_domains (list): A list of private domain names to include in the output.\n    \n    Returns:\n    dict: A dictionary containing the subdomain, domain, and public suffix.\n    \"\"\"\n    \n    # Get the Public Suffix List from the PSL API\n    psl_api_url = f\"https://publicsuffix.org/list/{url}.txt\"\n    response = requests.get(psl_api_url)\n    psl_list = response.text.splitlines()\n\n    # Find the URL in the PSL list\n    for line in psl_list:\n        if line.startswith(url):\n            # Parse the line to extract the subdomain, domain, and public suffix\n            line_parts = line.split()\n            if len(line_parts) > 2:\n                subdomain, domain, public_suffix = line_parts[1], line_parts[2], line_parts[3]\n            elif len(line_parts) == 2:\n                subdomain, domain = '', line_parts[1]\n                public_suffix = ''\n            else:\n                subdomain, domain, public_suffix = '', '', ''\n            break\n    else:\n        # If the URL is not found in the PSL list, return a default value\n        subdomain, domain, public_suffix = '', '', ''\n\n    # If private domains are specified, check if the URL is private\n    if private_domains:\n        is_private = False\n        for private_domain in private_domains:\n            if domain.endswith(private_domain):\n                is_private = True\n                break\n        if is_private:\n            subdomain, domain, public_suffix = '', '', ''\n\n    return {\n        'subdomain': subdomain,\n        'domain': domain,\n        'public_suffix': public_suffix\n    }\n\n# Example usage\nurl = \"https://subdomain.example.com\"\nprivate_domains = ['example.com']\nresult = parse_url(url, private_domains)\nprint(result)\n```"
"```python\nimport difflib\n\nclass Diffable:\n    def __init__(self, data):\n        self.data = data\n\n    def __eq__(self, other):\n        return self.data == other.data\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __lt__(self, other):\n        return self.data < other.data\n\n    def __le__(self, other):\n        return self.data <= other.data\n\n    def __gt__(self, other):\n        return self.data > other.data\n\n    def __ge__(self, other):\n        return self.data >= other.data\n\n    def diff(self, other):\n        if isinstance(other, Diffable):\n            return self.diff_recursive(other)\n        else:\n            return difflib.SequenceMatcher(None, self.data, other).get_opcodes()\n\n    def diff_recursive(self, other):\n        if type(self.data) != type(other.data):\n            return \"Types mismatch\"\n\n        if isinstance(self.data, list):\n            diff = []\n            for i in range(max(len(self.data), len(other.data))):\n                diff.append(self.diff_recursive(self.data[i] if i < len(self.data) else None, other.data[i] if i < len(other.data) else None))\n            return diff\n\n        if isinstance(self.data, dict):\n            diff = []\n            for key in set(list(self.data.keys()) + list(other.data.keys())):\n                diff.append((key, self.diff_recursive(self.data.get(key), other.data.get(key))))\n            return diff\n\n        return difflib.SequenceMatcher(None, self.data, other.data).get_opcodes()\n\n\ndef recreate(data1, data2):\n    diff = data1.diff(data2)\n    if isinstance(diff, list):\n        return [recreate(x[0], x[1]) for x in diff if x[0] != '+ ' and x[0] != '- ']\n    else:\n        return {x[0]: recreate(x[1][0], x[1][1]) for x in diff if x[0] != '+ ' and x[0] != '- '}\n\n\n# Example usage\ndata1 = Diffable([1, 2, 3])\ndata2 = Diffable([1, 2, 4])\n\nrecreated_data = recreate(data1.data, data2.data)\nprint(recreated_data)  # Output: {3: Diffable([3])}\n```"
"```python\nclass EventBus:\n    def __init__(self):\n        self.subscribers = {}\n\n    def subscribe(self, event_type, subscriber):\n        if event_type not in self.subscribers:\n            self.subscribers[event_type] = []\n        self.subscribers[event_type].append(subscriber)\n\n    def unsubscribe(self, event_type, subscriber):\n        if event_type in self.subscribers:\n            self.subscribers[event_type].remove(subscriber)\n\n    def publish(self, event_type, *args, **kwargs):\n        if event_type in self.subscribers:\n            for subscriber in self.subscribers[event_type]:\n                subscriber(*args, **kwargs)\n\n\nclass Subscriber:\n    def __init__(self, name):\n        self.name = name\n\n    def __call__(self, *args, **kwargs):\n        print(f\"{self.name} received event: {args}, {kwargs}\")\n\n\ndef main():\n    event_bus = EventBus()\n\n    subscriber1 = Subscriber(\"Subscriber 1\")\n    subscriber2 = Subscriber(\"Subscriber 2\")\n\n    event_bus.subscribe(\"event_type_1\", subscriber1)\n    event_bus.subscribe(\"event_type_1\", subscriber2)\n\n    event_bus.publish(\"event_type_1\", \"Hello, world!\")\n    event_bus.publish(\"event_type_2\", \"Goodbye, world!\")\n\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport subprocess\n\ndef setup_dev_workflow():\n    # Install necessary packages\n    subprocess.run(['pip', 'install', 'pytest', 'flake8', 'black', 'pre-commit'])\n\n    # Create a virtual environment\n    subprocess.run(['python', '-m', 'venv', 'dev'])\n\n    # Activate the virtual environment\n    subprocess.run(['source', 'dev/bin/activate'])\n\n    # Install pre-commit hooks\n    subprocess.run(['python', '-m', 'pre-commit', 'install'])\n\n    # Run tests\n    subprocess.run(['pytest'])\n\n    # Run flake8 and black checks\n    subprocess.run(['flake8', '.'])\n    subprocess.run(['black', '--diff', '.'])\n\nsetup_dev_workflow()\n```"
"```python\nfrom twilio.rest import Client\nfrom twilio import exceptions\n\n# Set up your account credentials\naccount_sid = 'your_account_sid'\nauth_token = 'your_auth_token'\nfrom_number = 'your_twilio_phone_number'\nto_number = 'recipient_phone_number'\nsubject = 'Test Email'\nbody = 'This is a test email sent using Twilio SendGrid API'\n\n# Create a Twilio client\nclient = Client(account_sid, auth_token)\n\ntry:\n    # Create a message\n    message = client.messages.create(\n        body=body,\n        from_=from_number,\n        to=to_number\n    )\n    print(f\"Message sent: {message.sid}\")\nexcept exceptions.TwilioRestException as e:\n    print(f\"Error sending message: {e}\")\n```"
"```python\nfrom docker import DockerClient\n\ndef create_docker_client():\n    try:\n        client = DockerClient(base_url='unix:///var/run/docker.sock')\n        return client\n    except Exception as e:\n        print(f\"Failed to create Docker client: {e}\")\n        return None\n\n# Usage\nclient = create_docker_client()\nif client:\n    # Use the client to interact with the Docker credentials store API\n    # For example:\n    # credentials = client.credentials_create(['username', 'password'])\n```"
"```python\nimport weakref\nimport sys\n\nclass WeakRef:\n    \"\"\"\n    A weak reference implementation for Python.\n    \"\"\"\n    def __init__(self, obj, delta=0):\n        self.obj = obj\n        self.delta = delta\n        self.ref_count = 0\n        self.cache = None\n\n    def __get__(self, instance, owner):\n        if instance is None:\n            return self\n        try:\n            return instance.__dict__[self.delta]\n        except KeyError:\n            raise AttributeError(f\"Attribute '{self.delta}' not found\")\n\n    def __set__(self, instance, value):\n        instance.__dict__[self.delta] = value\n\n    def __del__(self):\n        pass\n\n    def __repr__(self):\n        return f\"WeakRef({self.obj.__class__.__name__}, {self.delta})\"\n\nclass WeakKeyDict(dict):\n    \"\"\"\n    A dictionary with weak keys.\n    \"\"\"\n    def __init__(self, delta=0):\n        self.delta = delta\n        self.ref_count = 0\n        self.cache = {}\n\n    def __setitem__(self, key, value):\n        if key not in self.cache:\n            self.cache[key] = WeakRef(value, delta=self.delta)\n        self.ref_count += 1\n\n    def __delitem__(self, key):\n        if key in self.cache:\n            self.ref_count -= 1\n            if self.ref_count == 0:\n                del self.cache[key]\n\n    def __getitem__(self, key):\n        if key in self.cache:\n            return self.cache[key].obj\n        else:\n            raise KeyError(key)\n\n    def __contains__(self, key):\n        return key in self.cache\n\n    def __repr__(self):\n        return f\"WeakKeyDict({self.delta})\"\n\nclass WeakDict(dict):\n    \"\"\"\n    A dictionary with weak values.\n    \"\"\"\n    def __init__(self, delta=0):\n        self.delta = delta\n        self.ref_count = 0\n        self.cache = {}\n\n    def __setitem__(self, key, value):\n        if value not in self.cache:\n            self.cache[value] = WeakRef(key, delta=self.delta)\n        self.ref_count += 1\n\n    def __delitem__(self, value):\n        if value in self.cache:\n            self.ref_count -= 1\n            if self.ref_count == 0:\n                del self.cache[value]\n\n    def __getitem__(self, value):\n        if value in self.cache:\n            return self.cache[value].obj\n        else:\n            raise KeyError(value)\n\n    def __contains__(self, value):\n        return value in self.cache\n\n    def __repr__(self):\n        return f\"WeakDict({self.delta})\"\n\ndef weakref_new(obj, delta=0, weaklist=None):\n    \"\"\"\n    A weak reference implementation for objects that are not hashable.\n    \"\"\"\n    if weaklist is None:\n        weaklist = []\n    weaklist.append(WeakRef(obj, delta=delta))\n    return weaklist\n\ndef weakref_new_key(obj, delta=0, weaklist=None):\n    \"\"\"\n    A weak reference implementation for objects that are not hashable with weak keys.\n    \"\"\"\n    if weaklist is None:\n        weaklist = []\n    weaklist.append(WeakRef(obj, delta=delta))\n    weaklist.append(WeakKeyDict(delta=delta))\n    return weaklist\n\ndef weakref_new_dict(obj, delta=0, weaklist=None):\n    \"\"\"\n    A weak reference implementation for objects that are not hashable with weak values.\n    \"\"\"\n    if weaklist is None:\n        weaklist = []\n    weaklist.append(WeakRef(obj, delta=delta))\n    weaklist.append(WeakDict(delta=delta))\n    return weaklist\n\ndef weakref_new_list(obj, delta=0, weaklist=None):\n    \"\"\"\n    A weak reference implementation for objects that are not hashable with weak keys and weak values.\n    \"\"\"\n    if weaklist is None:\n        weaklist = []\n    weaklist.append(WeakRef(obj, delta=delta))\n    weaklist.append(WeakKeyDict(delta=delta))\n    weaklist.append(WeakDict(delta=delta))\n    return weaklist\n\n# PyPy JIT compatibility\nif sys.version_info[0] == 3 and sys.version_info[1] >= 7:\n    from weakref import WeakKeyDictionary as WeakKeyDict\n    from weakref import WeakValueDictionary as WeakDict\n    from weakref import WeakReference as WeakRef\nelse:\n    from weakref import WeakKeyDict\n    from weakref import WeakDict\n    from weakref import WeakRef\n```"
"```python\nimport flatbuffers\n\nclass Person:\n    def __init__(self, id, name):\n        self.id = id\n        self.name = name\n\ndef create_person(id, name):\n    person = Person(id, name)\n    return person\n\ndef main():\n    person1 = create_person(1, \"John\")\n    person2 = create_person(2, \"Alice\")\n\n    root_table = flatbuffers.Builder(1024)\n    table = root_table.CreateTable(2)\n    table.AddInt32(0, person1.id)\n    table.AddString(1, person1.name)\n    table.AddInt32(2, person2.id)\n    table.AddString(3, person2.name)\n    table.EndTable()\n\n    table = root_table.CreateTable(1)\n    table.AddInt32(0, 0)\n    table.AddInt32(1, 0)\n    table.AddInt32(2, 0)\n    table.AddInt32(3, 0)\n    table.EndTable()\n\n    root_table.EndTable()\n\n    flatbuffer = root_table.Finish()\n    print(flatbuffer)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nfrom google.cloud import bigtable\n\n# Create a client instance\nclient = bigtable.Client()\n\n# Get the instance\ninstance = client.instance('your-project-id')\n\n# Get the table\ntable = instance.table('your-table-id')\n\n# Get the row\nrow = table.row('row-key')\n\n# Create a row\nrow = table.row('new-row-key')\n\n# Insert a row\nrow.insert(['column-family', 'column-quality', 'column-value'])\n\n# Get all rows\nrows = table.rows()\n\n# Get a single row\nrow = table.row('row-key')\n\n# Update a row\nrow.update(['column-family', 'column-quality', 'column-value'])\n\n# Delete a row\nrow.delete()\n```"
"```python\nfrom aiohttp import web\nfrom aiohttp_jinja2 import template\nfrom lighthouse import db\n\n# Initialize Lighthouse database\ndb.init()\n\n# Define a Note model\nclass Note(db.Model):\n    id = db.Column(db.Integer, primary_key=True)\n    title = db.Column(db.String(100), nullable=False)\n    content = db.Column(db.Text, nullable=False)\n\n# Define a NoteService class for handling note operations\nclass NoteService:\n    async def get_notes(self):\n        return await Note.all()\n\n    async def get_note(self, note_id):\n        return await Note.get(note_id)\n\n    async def create_note(self, title, content):\n        note = Note(title=title, content=content)\n        await note.save()\n        return note\n\n    async def update_note(self, note_id, title, content):\n        note = await Note.get(note_id)\n        if note:\n            note.title = title\n            note.content = content\n            await note.save()\n            return note\n        return None\n\n    async def delete_note(self, note_id):\n        await Note.delete(note_id)\n        return None\n\n# Create an instance of the NoteService class\nnote_service = NoteService()\n\n# Define an ASGI application\nasync def application(request):\n    if request.path == '/notes':\n        return await template('notes.html', notes=await note_service.get_notes())\n    elif request.path == '/notes/new':\n        return template('new_note.html')\n    elif request.path == '/notes/create':\n        return web.Response(text='Creating note...')\n    elif request.path == '/notes/' + str(note_id):\n        note = await note_service.get_note(note_id)\n        return template('note.html', note=note)\n    elif request.path == '/notes/' + str(note_id) + '/edit':\n        note = await note_service.get_note(note_id)\n        return template('edit_note.html', note=note)\n    elif request.path == '/notes/' + str(note_id) + '/delete':\n        await note_service.delete_note(note_id)\n        return web.Response(text='Deleted note...')\n    else:\n        return web.Response(text='Not Found')\n\n# Define a route for handling POST requests\nasync def handle_post(request):\n    if request.method == 'POST':\n        data = await request.json()\n        if 'title' in data and 'content' in data:\n            note = await note_service.create_note(data['title'], data['content'])\n            return web.Response(text='Note created successfully')\n        else:\n            return web.Response(text='Invalid request data')\n\n# Define a route for handling PUT requests\nasync def handle_put(request):\n    if request.method == 'PUT':\n        data = await request.json()\n        if 'title' in data and 'content' in data:\n            note_id = data['id']\n            note = await note_service.update_note(note_id, data['title'], data['content'])\n            return web.Response(text='Note updated successfully')\n        else:\n            return web.Response(text='Invalid request data')\n\n# Define a route for handling DELETE requests\nasync def handle_delete(request):\n    if request.method == 'DELETE':\n        data = await request.json()\n        if 'id' in data:\n            note_id = data['id']\n            await note_service.delete_note(note_id)\n            return web.Response(text='Note deleted successfully')\n        else:\n            return web.Response(text='Invalid request data')\n\n# Create a new instance of the ASGI application\napp = web.Application()\n\n# Register the routes\napp.router.add_get('/notes', application)\napp.router.add_post('/notes/new', handle_post)\napp.router.add_get('/notes/create', application)\napp.router.add_get('/notes/{note_id}', application)\napp.router.add_get('/notes/{note_id}/edit', application)\napp.router.add_post('/notes/{note_id}/delete', handle_delete)\napp.router.add_get('/notes/{note_id}/edit', application)\napp.router.add_put('/notes/{note_id}', handle_put)\n\n# Run the ASGI application\nweb.run_app(app)\n```"
