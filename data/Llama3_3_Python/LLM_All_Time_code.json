"```python\nimport pyparsing as pp\n\n# Define grammar for package description\nname = pp.Word(pp.alphas + \"_\")\nversion = pp.Word(pp.nums)\nauthor = pp.Word(pp.alphas)\n\n# Define package description grammar\ndescription = pp.OneOf([\n    f\"{name}=={version}\",\n    f\"{name}=={version}-{author}\",\n    f\"{name}=={version} ({author})\"\n])\n\n# Parse the package description\nparser = pp.Forward()\nparser << description\n\n# Parse a sample package description\npackage_description = \"my_package==1.0.0 - John Doe\"\nresult = parser.parseString(package_description, parseAll=True)\n\n# Extract the extracted values\nif result:\n    name_value = result.name\n    version_value = result.version\n    author_value = result.author\n    print(f\"Name: {name_value}, Version: {version_value}, Author: {author_value}\")\nelse:\n    print(\"Invalid package description\")\n```"
"```python\nimport ctypes\nfrom ctypes import wintypes\n\n# Load the Google CRC32C library\ncrc32c_lib = ctypes.CDLL(None)\n\n# Define the structure for the CRC32C context\nclass CRC32CContext(ctypes.Structure):\n    _fields_ = [\n        ('context', ctypes.c_uint64),\n    ]\n\n# Define the function to calculate the CRC-32 checksum\ndef crc32c(text):\n    # Convert the text to bytes\n    text_bytes = text.encode('utf-8')\n\n    # Initialize the CRC-32 context\n    context = CRC32CContext()\n    crc32c_lib.CRC32C_Init(context.context)\n\n    # Calculate the CRC-32 checksum\n    crc32c_lib.CRC32C_Update(context.context, text_bytes)\n    crc32c_lib.CRC32C_Final(context.context, ctypes.byref(wintypes.DWORD()))\n\n    # Return the CRC-32 checksum\n    return context.context.value\n\n# Define the function to calculate the CRC-32 checksum for a string\ndef crc32c_str(s):\n    return crc32c(s)\n\n# Define the function to calculate the CRC-32 checksum for bytes\ndef crc32c_bytes(b):\n    return crc32c(b)\n\n# Example usage\nprint(crc32c_str(\"Hello, World!\"))\nprint(crc32c_bytes(b'Hello, World!'))\n```"
"```python\nimport pep8\nimport pyflakes\n\ndef check_pep8(file_path):\n    \"\"\"Check PEP 8 style conventions in a file.\"\"\"\n    errors = pep8.checkFile(file_path, options={'ignore': ['E402']})\n    if errors:\n        print(f\"PEP 8 errors found in {file_path}:\")\n        for line, message in errors:\n            print(f\"{line}: {message}\")\n\ndef check_pyflakes(file_path):\n    \"\"\"Check for potential issues in modular source code.\"\"\"\n    errors = pyflakes.check(file_path)\n    if errors:\n        print(f\"Pyflakes errors found in {file_path}:\")\n        for line, message in errors:\n            print(f\"{line}: {message}\")\n\n# Example usage\ncheck_pep8('path_to_your_file.py')\ncheck_pyflakes('path_to_your_file.py')\n```"
