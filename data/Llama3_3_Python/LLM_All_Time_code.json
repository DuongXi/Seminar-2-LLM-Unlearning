"```python\nimport brotli\nimport io\n\n# Compress data\ndef compress_data(data):\n    compressed = brotli.compress(data)\n    return compressed\n\n# Decompress data\ndef decompress_data(compressed):\n    decompressed = brotli.decompress(compressed)\n    return decompressed\n\n# Test the functions\ndata = b'Hello, World!'\ncompressed = compress_data(data)\ndecompressed = decompress_data(compressed)\n\nprint(f\"Original data: {data}\")\nprint(f\"Compressed data: {compressed}\")\nprint(f\"Decompressed data: {decompressed}\")\n```"
"```python\nimport requests\nimport json\n\nclass FortniteAPI:\n    def __init__(self, username, password):\n        self.base_url = \"https://api.epicgames.com\"\n        self.username = username\n        self.password = password\n        self.access_token = None\n\n    def login(self):\n        # Epic Games API Login\n        data = {\n            \"username\": self.username,\n            \"password\": self.password\n        }\n        response = requests.post(f\"{self.base_url}/user/login\", json=data)\n        if response.status_code == 200:\n            self.access_token = response.json()[\"access_token\"]\n            return True\n        return False\n\n    def logout(self):\n        # Epic Games API Logout\n        if self.access_token:\n            response = requests.post(f\"{self.base_url}/user/logout\", headers={\"Authorization\": f\"Bearer {self.access_token}\"})\n            if response.status_code == 200:\n                self.access_token = None\n                return True\n        return False\n\n    def get_user_info(self):\n        # Epic Games API Get User Info\n        if self.access_token:\n            response = requests.get(f\"{self.base_url}/user/me\", headers={\"Authorization\": f\"Bearer {self.access_token}\"})\n            if response.status_code == 200:\n                return response.json()\n        return None\n\n    def get_access_token(self):\n        # Epic Games API Get Access Token\n        response = requests.get(f\"{self.base_url}/user/me\", headers={\"Authorization\": \"Bearer \"})\n        if response.status_code == 200:\n            return response.json()[\"access_token\"]\n        return None\n```"
