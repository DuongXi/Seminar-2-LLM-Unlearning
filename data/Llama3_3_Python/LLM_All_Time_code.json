"```python\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\ndef read_excel_file(file_path):\n    # Load the Excel file\n    wb = load_workbook(filename=file_path)\n    \n    # Get the active sheet\n    sheet = wb.active\n    \n    # Get the number of rows and columns\n    for row in sheet.rows:\n        print(row)\n        \n    # Extract data from specific cells\n    for cell in sheet['A1:D1']:\n        print(cell.value)\n        \n    # Extract data from specific rows\n    for row in sheet.iter_rows(values_only=True):\n        print(row)\n        \n    # Extract data from specific columns\n    for col in sheet['A:A']:\n        print([cell.value for cell in col])\n        \n    # Extract data from specific sheet\n    ws = wb['Sheet2']\n    for row in ws.iter_rows(values_only=True):\n        print(row)\n        \n    # Close the workbook\n    wb.close()\n\n# Usage\nread_excel_file('example.xlsx')\n```"
"```python\nfrom elasticsearch import Elasticsearch, ElasticsearchException\n\n# Initialize Elasticsearch client\nes = Elasticsearch([{'host': 'localhost', 'port': 9200}])\n\n# Create index\ndef create_index(index_name):\n    try:\n        es.indices.create(index=index_name)\n        print(f\"Index {index_name} created successfully.\")\n    except ElasticsearchException as e:\n        print(f\"Error creating index {index_name}: {e}\")\n\n# Delete index\ndef delete_index(index_name):\n    try:\n        es.indices.delete(index=index_name)\n        print(f\"Index {index_name} deleted successfully.\")\n    except ElasticsearchException as e:\n        print(f\"Error deleting index {index_name}: {e}\")\n\n# Index document\ndef index_document(index_name, doc_id, data):\n    try:\n        es.index(index=index_name, id=doc_id, body=data)\n        print(f\"Document with id {doc_id} indexed successfully.\")\n    except ElasticsearchException as e:\n        print(f\"Error indexing document with id {doc_id}: {e}\")\n\n# Update document\ndef update_document(index_name, doc_id, data):\n    try:\n        es.update(index=index_name, id=doc_id, body=data)\n        print(f\"Document with id {doc_id} updated successfully.\")\n    except ElasticsearchException as e:\n        print(f\"Error updating document with id {doc_id}: {e}\")\n\n# Delete document\ndef delete_document(index_name, doc_id):\n    try:\n        es.delete(index=index_name, id=doc_id)\n        print(f\"Document with id {doc_id} deleted successfully.\")\n    except ElasticsearchException as e:\n        print(f\"Error deleting document with id {doc_id}: {e}\")\n\n# Search for documents\ndef search_documents(index_name, query):\n    try:\n        response = es.search(index=index_name, body=query)\n        return response['hits']['hits']\n    except ElasticsearchException as e:\n        print(f\"Error searching documents: {e}\")\n        return []\n\n# Example usage\nif __name__ == \"__main__\":\n    # Create index\n    create_index(\"my_index\")\n\n    # Index document\n    index_document(\"my_index\", \"1\", {\"name\": \"John\", \"age\": 30})\n\n    # Update document\n    update_document(\"my_index\", \"1\", {\"name\": \"Jane\", \"age\": 31})\n\n    # Search for documents\n    query = {\"query\": {\"match\": {\"name\": \"John\"}}}\n    results = search_documents(\"my_index\", query)\n    for result in results:\n        print(result[\"_source\"])\n\n    # Delete document\n    delete_document(\"my_index\", \"1\")\n\n    # Delete index\n    delete_index(\"my_index\")\n```"
