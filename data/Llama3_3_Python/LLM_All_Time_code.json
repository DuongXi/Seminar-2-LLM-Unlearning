"```python\nimport json\nfrom pydantic import BaseModel\n\nclass JsonPatch(BaseModel):\n    op: str\n    path: list\n    value: any\n\ndef apply_json_patch(document: dict, patch: list) -> dict:\n    \"\"\"\n    Applies a JSON patch to a given JSON document.\n\n    Args:\n        document (dict): The JSON document to apply the patch to.\n        patch (list): The JSON patch to apply.\n\n    Returns:\n        dict: The updated JSON document.\n    \"\"\"\n    for operation in patch:\n        if operation['op'] == 'replace':\n            document[operation['path'][0]] = operation['value']\n        elif operation['op'] == 'add':\n            if operation['path'][0] not in document:\n                document[operation['path'][0]] = operation['value']\n            else:\n                document[operation['path'][0]] = json.dumps(document[operation['path'][0]]) + json.dumps(operation['value'])\n        elif operation['op'] == 'remove':\n            if len(operation['path']) == 1:\n                del document[operation['path'][0]]\n            else:\n                new_path = operation['path'][1:]\n                if operation['path'][0] not in document:\n                    document[operation['path'][0]] = {}\n                document[operation['path'][0]][operation['path'][0]] = json.dumps(document[operation['path'][0]][operation['path'][0]]) + json.dumps(document[operation['path'][0]][operation['path'][0]]) \n                del document[operation['path'][0]][operation['path'][0]]\n                del document[operation['path'][0]][operation['path'][0]]\n                for k, v in document[operation['path'][0]].items():\n                    if isinstance(v, dict):\n                        document[operation['path'][0]][k] = apply_json_patch(document[operation['path'][0]][k], [operation])[operation['path'][0]][k]\n                    else:\n                        document[operation['path'][0]][k] = json.dumps(document[operation['path'][0]][k]) + json.dumps(operation)\n    return document\n```"
"```python\nfrom functools import wraps\n\ndef lru_cache(maxsize=None):\n    cache = {}\n    def decorator(func):\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            key = (args, frozenset(kwargs.items()))\n            if key in cache:\n                return cache[key][1]\n            result = func(*args, **kwargs)\n            if maxsize is not None:\n                if len(cache) > maxsize:\n                    cache.pop(next(iter(cache)))\n            cache[key] = (result, None)\n            return result\n        return wrapper\n    return decorator\n```"
"```python\nfrom azure.devtools import cli\nfrom azure.devtools.core import credential\nfrom azure.devtools.core.auth import service principal, client secret\nfrom azure.devtools.core.exceptions import AzureError\n\nfrom azure.devops.v2 import (\n    Projects,\n    WorkItems,\n    Git,\n    Build,\n    BuildConfiguration\n)\n\n# Import the Azure DevOps library for Python\nfrom azure.devops.v2 import Client\n\n# Define a function to get the Azure DevOps API client\ndef get_client():\n    # Define the credentials\n    sp = service_principal(\n        client_id='your_client_id',\n        client_secret='your_client_secret',\n        tenant_id='your_tenant_id'\n    )\n    cred = credential(sp)\n\n    # Create the Azure DevOps API client\n    client = Client(cred)\n\n    return client\n```"
"```python\nimport inflect\n\nclass Inflector:\n    def __init__(self):\n        self.p = inflect.engine()\n\n    def pluralize(self, word):\n        return self.p.plural(word)\n\n    def singularize(self, word):\n        return self.p.singular_noun(word)\n\n    def camelcase(self, string):\n        words = string.split()\n        return words[0].lower() + ''.join(word.capitalize() for word in words[1:])\n\n# Example usage:\ninflector = Inflector()\nprint(inflector.pluralize(\"cat\"))  # Output: cats\nprint(inflector.singularize(\"cats\"))  # Output: cat\nprint(inflector.camelcase(\"hello world\"))  # Output: helloWorld\n```"
"```python\nimport socket\n\ndef create_socks4_proxy_server(target_server_ip, target_server_port, proxy_ip, proxy_port):\n    # Create a new SOCKS4 proxy server\n    proxy_server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n\n    # Bind the proxy server to the specified port\n    proxy_server_socket.bind((\"\", proxy_port))\n\n    # Listen for incoming connections\n    proxy_server_socket.listen(5)\n\n    while True:\n        # Wait for a client connection\n        client_socket, address = proxy_server_socket.accept()\n\n        # Receive the client's request\n        request = client_socket.recv(1024)\n\n        # Extract the client's IP address and port number from the request\n        client_ip, client_port = request.split(b\" \")[:2]\n\n        # Connect to the target server using the SOCKS4 protocol\n        target_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        target_socket.connect((target_server_ip, target_server_port))\n\n        # Forward the client's request to the target server\n        target_socket.send(request)\n\n        # Receive the target server's response\n        response = target_socket.recv(1024)\n\n        # Send the response back to the client\n        client_socket.send(response)\n\n        # Close the target server socket\n        target_socket.close()\n\n        # Close the client socket\n        client_socket.close()\n\n# Example usage\nif __name__ == \"__main__\":\n    target_server_ip = \"127.0.0.1\"\n    target_server_port = 80\n    proxy_ip = \"0.0.0.0\"\n    proxy_port = 8080\n\n    create_socks4_proxy_server(target_server_ip, target_server_port, proxy_ip, proxy_port)\n```"
"```python\nfrom azure.identity import DefaultAzureCredential\nfrom azure.keyvault.secrets import SecretClient\nfrom azure.keyvault.certificates import CertificateClient\nfrom azure.keyvault.keyvault import KeyVaultClient\nfrom azure.keyvault.keys import KeyClient\n\n# Initialize the Azure Identity client\ncredential = DefaultAzureCredential()\n\n# Create a SecretClient\nsecret_client = SecretClient(\n    vault_url=\"https://<your_vault_name>.vault.azure.net\",\n    credential=credential\n)\n\n# Create a CertificateClient\ncertificate_client = CertificateClient(\n    vault_url=\"https://<your_vault_name>.vault.azure.net\",\n    credential=credential\n)\n\n# Create a KeyVaultClient\nkey_vault_client = KeyVaultClient(\n    credential=credential\n)\n\n# Create a KeyClient\nkey_client = KeyClient(\n    vault_url=\"https://<your_vault_name>.vault.azure.net\",\n    credential=credential\n)\n```"
"```python\nimport json\n\nclass JSONParser:\n    def __init__(self, json_str):\n        self.json_str = json_str\n        self.index = 0\n        self.stack = []\n\n    def __iter__(self):\n        return self\n\n    def __next__(self):\n        while self.index < len(self.json_str):\n            if self.json_str[self.index] == '{':\n                self.stack.append(self.json_str[self.index])\n                self.index += 1\n                while self.index < len(self.json_str) and self.json_str[self.index] != '}':\n                    self.index += 1\n                if self.json_str[self.index] != '}':\n                    raise ValueError(\"Invalid JSON string\")\n                self.index += 1\n                self.stack.pop()\n            elif self.json_str[self.index] == '[':\n                self.index += 1\n                while self.index < len(self.json_str) and self.json_str[self.index] != ']':\n                    self.index += 1\n                if self.json_str[self.index] != ']':\n                    raise ValueError(\"Invalid JSON string\")\n                self.index += 1\n            elif self.json_str[self.index] == ',':\n                self.index += 1\n            else:\n                self.index += 1\n                if self.json_str[self.index].isspace():\n                    continue\n                yield self.json_str[self.index]\n                while self.index < len(self.json_str) and not self.json_str[self.index].isspace():\n                    self.index += 1\n        raise StopIteration\n\ndef parse_json(json_str):\n    parser = JSONParser(json_str)\n    for item in parser:\n        yield json.loads(item)\n\n# Example usage:\njson_str = '{\"name\": \"John\", \"age\": 30, \"city\": \"New York\"}'\nfor item in parse_json(json_str):\n    print(item)\n```"
"```python\nfrom fuzzywuzzy import fuzz\nfrom fuzzywuzzy import process\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport numpy as np\n\ndef levenshtein_distance(s1, s2):\n    if len(s1) < len(s2):\n        return levenshtein_distance(s2, s1)\n\n    if len(s2) == 0:\n        return len(s1)\n\n    previous_row = range(len(s2) + 1)\n    for i, c1 in enumerate(s1):\n        current_row = [i + 1]\n        for j, c2 in enumerate(s2):\n            insertions = previous_row[j + 1] + 1 \n            deletions = current_row[j] + 1 \n            substitutions = previous_row[j] + (c1 != c2)\n            current_row.append(min(insertions, deletions, substitutions))\n        previous_row = current_row\n    \n    return previous_row[-1]\n\ndef jaccard_similarity(s1, s2):\n    set1 = set(s1)\n    set2 = set(s2)\n    intersection = set1.intersection(set2)\n    union = set1.union(set2)\n    return len(intersection) / len(union)\n\ndef cosine_similarity_matrix(texts):\n    return cosine_similarity(texts)\n\ndef fuzzy_match(text1, text2, threshold=80, ignore_duplicates=False):\n    score = fuzz.partial_ratio(text1, text2)\n    if score >= threshold:\n        return score\n    else:\n        return None\n\ndef advanced_fuzzy_match(text1, text2, threshold=80, ignore_duplicates=False):\n    scores = process.extractOne(text1, [text2], scorer=fuzz.token_sort_ratio)\n    if ignore_duplicates and scores[0][1] == 100:\n        return None\n    else:\n        return scores[0][1]\n\ndef advanced_fuzzy_match_matrix(texts, threshold=80, ignore_duplicates=False):\n    scores = []\n    for text in texts:\n        scores_text = process.extract(text, texts, scorer=fuzz.token_sort_ratio)\n        if ignore_duplicates:\n            filtered_scores = [(text, score) for text, score in scores_text if score != 100]\n        else:\n            filtered_scores = scores_text\n        scores.extend(filtered_scores)\n    return scores\n```"
"```python\nimport os\nfrom cryptography.hazmat.primitives import serialization\nfrom cryptography.hazmat.primitives.asymmetric import rsa\nfrom cryptography.hazmat.primitives import hashes\nfrom cryptography.hazmat.primitives.asymmetric import padding\nimport base64\nimport requests\n\ndef generate_keypair():\n    key = rsa.generate_private_key(\n        public_exponent=65537,\n        key_size=2048,\n    )\n    private_pem = key.private_bytes(\n        encoding=serialization.Encoding.PEM,\n        format=serialization.PrivateFormat.TraditionalOpenSSL,\n        encryption_algorithm=serialization.NoEncryption()\n    )\n    public_pem = key.public_key().public_bytes(\n        encoding=serialization.Encoding.PEM,\n        format=serialization.PublicFormat.SubjectPublicKeyInfo\n    )\n    return private_pem, public_pem\n\ndef sign_data(private_key, data):\n    signature = private_key.sign(\n        data,\n        padding.PSS(\n            mgf=padding.MGF1(hashes.SHA256()),\n            salt_length=padding.PSS.MAX_LENGTH\n        ),\n        hashes.SHA256()\n    )\n    return signature\n\ndef verify_signature(public_key, signature, data):\n    try:\n        public_key.verify(\n            signature,\n            data,\n            padding.PSS(\n                mgf=padding.MGF1(hashes.SHA256()),\n                salt_length=padding.PSS.MAX_LENGTH\n            ),\n            hashes.SHA256()\n        )\n        return True\n    except:\n        return False\n\ndef encrypt_data(public_key, data):\n    encrypted_data = public_key.encrypt(\n        data,\n        padding.OAEP(\n            mgf=padding.MGF1(algorithm=hashes.SHA256()),\n            algorithm=hashes.SHA256(),\n            label=None\n        )\n    )\n    return encrypted_data\n\ndef decrypt_data(private_key, encrypted_data):\n    decrypted_data = private_key.decrypt(\n        encrypted_data,\n        padding.OAEP(\n            mgf=padding.MGF1(algorithm=hashes.SHA256()),\n            algorithm=hashes.SHA256(),\n            label=None\n        )\n    )\n    return decrypted_data\n\ndef send_signed_and_encrypted_data(private_key, public_key, data):\n    signature = sign_data(private_key, data.encode())\n    encrypted_data = encrypt_data(public_key, data.encode())\n    payload = {\n        'signature': base64.b64encode(signature).decode(),\n        'encrypted_data': base64.b64encode(encrypted_data).decode()\n    }\n    response = requests.post('http://example.com/endpoint', json=payload)\n    return response.text\n\ndef main():\n    private_key, public_key = generate_keypair()\n    data = b'Hello, World!'\n    response = send_signed_and_encrypted_data(private_key, public_key, data)\n    print(response)\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport requests\nfrom requests.adapters import HTTPAdapter\nfrom requests.packages.urllib3.util.ssl_ import create_default_context\nfrom urllib3.util import Retry\n\ndef set_ssl_context(retries=3, timeout=5):\n    # Create a new SSL context with verification options\n    context = create_default_context()\n\n    # Set the SSL context for the HTTP adapter\n    adapter = HTTPAdapter(max_retries=Retry(retries=retries, total=retries, backoff_factor=1, status_forcelist=[500, 502, 503, 504]))\n    adapter.mount('https://', context)\n    adapter.mount('http://', context)\n\n    return adapter\n\n# Usage\nadapter = set_ssl_context()\nsession = requests.Session()\nsession.mount('https://', adapter)\nsession.mount('http://', adapter)\n```"
"```python\nimport requests\n\ndef send_get_request(url):\n    try:\n        response = requests.get(url)\n        print(f\"GET Request to {url} returned status code {response.status_code}\")\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f\"Error: {e}\")\n        return None\n\ndef send_post_request(url, data):\n    try:\n        response = requests.post(url, json=data)\n        print(f\"POST Request to {url} returned status code {response.status_code}\")\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f\"Error: {e}\")\n        return None\n\ndef send_put_request(url, data):\n    try:\n        response = requests.put(url, json=data)\n        print(f\"PUT Request to {url} returned status code {response.status_code}\")\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f\"Error: {e}\")\n        return None\n\ndef send_delete_request(url):\n    try:\n        response = requests.delete(url)\n        print(f\"DELETE Request to {url} returned status code {response.status_code}\")\n        return response.json()\n    except requests.exceptions.RequestException as e:\n        print(f\"Error: {e}\")\n        return None\n\n# Example usage\nurl = \"http://httpbin.org\"\ndata = {\"key\": \"value\"}\n\nprint(\"GET Request:\")\nget_response = send_get_request(url)\nprint(get_response)\n\nprint(\"\\nPOST Request:\")\npost_response = send_post_request(url, data)\nprint(post_response)\n\nprint(\"\\nPUT Request:\")\nput_response = send_put_request(url, data)\nprint(put_response)\n\nprint(\"\\nDELETE Request:\")\ndelete_response = send_delete_request(url)\nprint(delete_response)\n```"
"```python\nimport os\nimport mkdir_if_not_exists\n\ndef create_sphinx_theme():\n    # Create the 'sphinx_themes' directory if it doesn't exist\n    sphinx_themes_dir = 'sphinx_themes'\n    mkdir_if_not_exists.mkdir_if_not_exists(sphinx_themes_dir)\n\n    # Create the 'templates' folder within the 'sphinx_themes' directory\n    templates_folder = os.path.join(sphinx_themes_dir, 'templates')\n    mkdir_if_not_exists.mkdir_if_not_exists(templates_folder)\n\n    # Create the 'conf.py' configuration file\n    conf_file = os.path.join(sphinx_themes_dir, 'conf.py')\n    with open(conf_file, 'w') as f:\n        f.write('# Basic Sphinx theme configuration\\n')\n        f.write('import os\\n')\n        f.write('import sys\\n')\n        f.write('\\n')\n        f.write('# Set the source directory for the theme\\n')\n        f.write('source_dir = \"docs\"\\n')\n        f.write('\\n')\n        f.write('# Set the output directory for the theme\\n')\n        f.write('output_dir = \"build\"\\n')\n        f.write('\\n')\n        f.write('# Set the theme directory\\n')\n        f.write('theme_dir = \"sphinx_themes\"\\n')\n        f.write('\\n')\n        f.write('# Set the theme to use\\n')\n        f.write('theme = \"default\"\\n')\n        f.write('\\n')\n        f.write('# Set the theme's title\\n')\n        f.write('title = \"My Sphinx Theme\"\\n')\n\n    # Create the 'index.html' template file\n    index_file = os.path.join(templates_folder, 'index.html')\n    with open(index_file, 'w') as f:\n        f.write('<html>\\n')\n        f.write('<body>\\n')\n        f.write('<h1>My Sphinx Theme</h1>\\n')\n        f.write('</body>\\n')\n        f.write('</html>\\n')\n\n# Call the function to create the Sphinx theme directory structure\ncreate_sphinx_theme()\n```"
"```python\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Define a simple neural network model\nmodel = keras.Sequential([\n    layers.Dense(64, activation='relu', input_shape=(784,)),\n    layers.Dense(32, activation='relu'),\n    layers.Dense(10, activation='softmax')\n])\n\n# Compile the model\nmodel.compile(optimizer='adam',\n              loss='sparse_categorical_crossentropy',\n              metrics=['accuracy'])\n\n# Generate some random data for training\nX_train = np.random.rand(100, 784)\ny_train = np.random.randint(0, 10, 100)\n\n# Train the model\nmodel.fit(X_train, y_train, epochs=10, verbose=0)\n\n# Create a TensorBoard writer\nwriter = tf.summary.create_file_writer('model_logs')\n\n# Record some metrics\nwith writer.as_default():\n    tf.summary.scalar('accuracy', model.metrics['accuracy'][-1])\n    tf.summary.image('input', X_train[:10], max_outputs=1)\n\n# Create a TensorBoard session\nsess = tf.Session()\n\n# Create a TensorBoard plotter\nplotter = keras.callbacks.TensorBoard(sess=sess, log_dir='model_logs', histogram_freq=1)\n\n# Train the model with TensorBoard logging\nmodel.fit(X_train, y_train, epochs=10, callbacks=[plotter], verbose=0)\n\n# Close the TensorBoard writer\nwriter.close()\n```"
"```python\nimport logging\n\n# Set the logging level to DEBUG\nlogging.basicConfig(level=logging.DEBUG)\n\n# Define a function to log messages with colored text\ndef log_message(level, message):\n    # Create a dictionary to map logging levels to colors\n    colors = {\n        logging.DEBUG: \"\\033[94m\",  # Cyan\n        logging.INFO: \"\\033[92m\",  # Green\n        logging.WARNING: \"\\033[93m\",  # Yellow\n        logging.ERROR: \"\\033[91m\",  # Red\n        logging.CRITICAL: \"\\033[91m\"  # Red\n    }\n\n    # Get the color for the current logging level\n    color = colors.get(level)\n\n    # Log the message with the color\n    print(f\"{color}{message}\\033[0m\")\n\n# Test the log_message function\nlog_message(logging.DEBUG, \"This is a debug message\")\nlog_message(logging.INFO, \"This is an info message\")\nlog_message(logging.WARNING, \"This is a warning message\")\nlog_message(logging.ERROR, \"This is an error message\")\nlog_message(logging.CRITICAL, \"This is a critical message\")\n```"
"```python\nimport numpy as np\nimport tensorflow as tf\n\nclass Tensor:\n    def __init__(self, data):\n        self.data = np.array(data)\n\n    def __add__(self, other):\n        if isinstance(other, Tensor):\n            return Tensor(self.data + other.data)\n        else:\n            return Tensor(self.data + other)\n\n    def __sub__(self, other):\n        if isinstance(other, Tensor):\n            return Tensor(self.data - other.data)\n        else:\n            return Tensor(self.data - other)\n\n    def __mul__(self, other):\n        if isinstance(other, Tensor):\n            return Tensor(self.data * other.data)\n        else:\n            return Tensor(self.data * other)\n\nclass DynamicNN:\n    def __init__(self, input_shape, output_shape):\n        self.input_shape = input_shape\n        self.output_shape = output_shape\n        self.layers = []\n\n    def add_layer(self, layer):\n        self.layers.append(layer)\n\n    def forward(self, x):\n        for layer in self.layers:\n            x = layer.forward(x)\n        return x\n\nclass DenseLayer:\n    def __init__(self, num_inputs, num_outputs, activation=None):\n        self.num_inputs = num_inputs\n        self.num_outputs = num_outputs\n        self.activation = activation\n        self.weights = tf.Variable(tf.random.normal([num_inputs, num_outputs]))\n        self.bias = tf.Variable(tf.random.normal([num_outputs]))\n\n    def forward(self, x):\n        output = tf.matmul(x, self.weights) + self.bias\n        if self.activation:\n            output = self.activation(output)\n        return output\n\nclass Conv2DLayer:\n    def __init__(self, num_filters, kernel_size, activation=None):\n        self.num_filters = num_filters\n        self.kernel_size = kernel_size\n        self.activation = activation\n        self.weights = tf.Variable(tf.random.normal([num_filters, kernel_size, kernel_size, 1]))\n        self.bias = tf.Variable(tf.random.normal([num_filters]))\n\n    def forward(self, x):\n        output = tf.nn.conv2d(x, self.weights, strides=[1, 1, 1, 1], padding='SAME')\n        output = tf.nn.bias_add(output, self.bias)\n        if self.activation:\n            output = self.activation(output)\n        return output\n\n# Example usage\ninput_shape = (28, 28, 1)\noutput_shape = (10,)\nhidden_layers = [DenseLayer(784, 128, activation=tf.nn.relu), DenseLayer(128, 64, activation=tf.nn.relu)]\noutput_layer = DenseLayer(64, 10, activation=tf.nn.softmax)\nmodel = DynamicNN(input_shape, output_shape)\nfor layer in hidden_layers:\n    model.add_layer(layer)\nmodel.add_layer(output_layer)\n\nx = Tensor(np.random.rand(1, 28, 28, 1))\ny_pred = model.forward(x)\nprint(y_pred)\n```"
"```python\nimport pandoc\nimport os\n\ndef convert_to_html(content, input_format='md', output_format='html'):\n    \"\"\"\n    Convert content from one format to HTML.\n\n    Args:\n        content (str): The content to convert.\n        input_format (str, optional): The input format. Defaults to 'md'.\n        output_format (str, optional): The output format. Defaults to 'html'.\n\n    Returns:\n        str: The converted HTML content.\n    \"\"\"\n    return pandoc.convert(input_format, output_format, content)\n\ndef convert_to_markdown(content, input_format='html', output_format='md'):\n    \"\"\"\n    Convert content from one format to Markdown.\n\n    Args:\n        content (str): The content to convert.\n        input_format (str, optional): The input format. Defaults to 'html'.\n        output_format (str, optional): The output format. Defaults to 'md'.\n\n    Returns:\n        str: The converted Markdown content.\n    \"\"\"\n    return pandoc.convert(input_format, output_format, content)\n\ndef convert_from_markdown(content, output_format='html'):\n    \"\"\"\n    Convert Markdown content to another format.\n\n    Args:\n        content (str): The Markdown content to convert.\n        output_format (str, optional): The output format. Defaults to 'html'.\n\n    Returns:\n        str: The converted content.\n    \"\"\"\n    return pandoc.convert('markdown', output_format, content)\n\ndef convert_from_html(content, output_format='markdown'):\n    \"\"\"\n    Convert HTML content to another format.\n\n    Args:\n        content (str): The HTML content to convert.\n        output_format (str, optional): The output format. Defaults to 'markdown'.\n\n    Returns:\n        str: The converted content.\n    \"\"\"\n    return pandoc.convert('html', output_format, content)\n\ndef get_pandoc_command(input_format, output_format):\n    \"\"\"\n    Get the command to use with pandoc.\n\n    Args:\n        input_format (str): The input format.\n        output_format (str): The output format.\n\n    Returns:\n        str: The command to use with pandoc.\n    \"\"\"\n    return f'pandoc -f {input_format} -t {output_format}'\n\ndef main():\n    if not os.path.exists('input.md'):\n        print('Input file not found.')\n        return\n\n    content = open('input.md', 'r').read()\n    print(convert_to_html(content))\n    print(convert_to_markdown(content))\n    print(convert_from_markdown(content))\n    print(convert_from_html(content))\n\nif __name__ == '__main__':\n    main()\n```"
