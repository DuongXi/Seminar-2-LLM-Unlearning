"```python\nimport websocket\n\ndef create_websocket_client(url, header, callback):\n    ws = websocket.create_connection(url, header=header)\n    ws.on_message = callback\n    return ws\n\n# Example usage:\nurl = \"ws://example.com\"\nheader = {\"Authorization\": \"Bearer YOUR_TOKEN\"}\ndef message_callback(ws, message):\n    print(f\"Received message: {message}\")\n\nws_client = create_websocket_client(url, header, message_callback)\n```"
"```python\nfrom pygments import highlight\nfrom pygments.lexers import get_lexer_by_name\nfrom pygments.formatters import HtmlFormatter\n\ndef syntax_highlighting(source_code, language, theme='default'):\n    \"\"\"\n    Perform syntax highlighting on source code files using Pygments library.\n\n    Args:\n    - source_code (str): The source code to be highlighted.\n    - language (str): The programming language of the source code.\n    - theme (str): The custom theme to use for highlighting (default is 'default').\n\n    Returns:\n    - str: The HTML-formatted highlighted source code.\n    \"\"\"\n    lexer = get_lexer_by_name(language)\n    formatter = HtmlFormatter(lineno=True, theme=theme)\n    return highlight(source_code, lexer, formatter)\n\n# Example usage:\nsource_code = \"\"\"\n# This is a Python code snippet\nprint('Hello, World!')\n\"\"\"\nlanguage = 'python'\ntheme = 'monokai'\n\nhighlighted_code = syntax_highlighting(source_code, language, theme)\nprint(highlighted_code)\n```"
"```python\nimport ssl\nimport socket\n\ndef create_ssl_context(verify=False, ca_certs=None):\n    \"\"\"\n    Creates an SSL/TLS context with the specified verification settings.\n\n    Args:\n        verify (bool): Whether to verify the server's certificate. Defaults to False.\n        ca_certs (str): Path to the CA certificates file. Defaults to None.\n\n    Returns:\n        ssl.SSLContext: The created SSL/TLS context.\n    \"\"\"\n    context = ssl.create_default_context(ssl.Purpose.CLIENT_AUTH)\n    if verify:\n        context.check_hostname = True\n    if ca_certs:\n        context.load_verify_locations(ca_certs)\n    return context\n\ndef connect_to_server(host, port, context):\n    \"\"\"\n    Establishes an SSL/TLS connection to the specified server.\n\n    Args:\n        host (str): The server's hostname or IP address.\n        port (int): The server's port number.\n        context (ssl.SSLContext): The SSL/TLS context.\n\n    Returns:\n        socket.socket: The established socket object.\n    \"\"\"\n    return context.wrap_socket(socket.create_connection((host, port)), server_hostname=host)\n\ndef encrypt_data(data, context):\n    \"\"\"\n    Encrypts the specified data using the SSL/TLS context.\n\n    Args:\n        data (bytes): The data to encrypt.\n        context (ssl.SSLContext): The SSL/TLS context.\n\n    Returns:\n        bytes: The encrypted data.\n    \"\"\"\n    return context.wrap_socket(socket.create_connection((\"localhost\", 443)), server_hostname=\"localhost\").sendall(data)\n\ndef verify_certificate(context, data):\n    \"\"\"\n    Verifies the server's certificate using the SSL/TLS context.\n\n    Args:\n        context (ssl.SSLContext): The SSL/TLS context.\n        data (bytes): The server's certificate data.\n\n    Returns:\n        bool: Whether the certificate is valid.\n    \"\"\"\n    return context.check_hostname(data)\n```"
"```python\nimport asyncio\nfrom asyncio import TimeoutError\n\nasync def async_timeout_context_manager(time_limit, func):\n    try:\n        await asyncio.wait_for(func(), timeout=time_limit)\n    except asyncio.TimeoutError:\n        raise TimeoutError(f\"Function '{func.__name__}' timed out after {time_limit} seconds\")\n\ndef timeout_context_manager(time_limit, func):\n    loop = asyncio.get_event_loop()\n    return loop.create_task(async_timeout_context_manager(time_limit, func))\n```"
"```python\nimport os\nimport json\nfrom swagger_client import SwaggerClient\n\n# Load the OpenAPI specification from a file\ndef load_swagger_spec(file_path):\n    with open(file_path, 'r') as f:\n        return json.load(f)\n\n# Create a client runtime for interacting with a RESTful API\ndef create_client_runtime(spec):\n    return SwaggerClient(spec)\n\n# Example usage:\nspec_file = 'path/to/openapi.yaml'\nspec = load_swagger_spec(spec_file)\nclient = create_client_runtime(spec)\n```"
"```python\nfrom immutablecollections import ImmutableSet\nfrom toolz import identity, compose\nfrom pyds import PersistentStack\n\ndef create_immutable_set():\n    \"\"\"Creates an immutable set.\"\"\"\n    return ImmutableSet([1, 2, 3])\n\ndef create_persistent_stack():\n    \"\"\"Creates a persistent stack.\"\"\"\n    return PersistentStack([1, 2, 3])\n\ndef compose_functions(f1, f2):\n    \"\"\"Composes two functions.\"\"\"\n    return identity(f2(f1(x)))\n\ndef create_persistent_stack_with_composition():\n    \"\"\"Creates a persistent stack using composition.\"\"\"\n    return compose_functions(PersistentStack, identity)\n\n# Example usage\nimmutable_set = create_immutable_set()\nprint(immutable_set)  # Output: ImmutableSet([1, 2, 3])\n\npersistent_stack = create_persistent_stack()\nprint(persistent_stack)  # Output: PersistentStack([1, 2, 3])\n\npersistent_stack_composed = create_persistent_stack_with_composition()\nprint(persistent_stack_composed)  # Output: PersistentStack([1, 2, 3])\n```"
"```python\ndef check_vowels(input_str):\n    vowels = 'aeiouAEIOU'\n    for char in input_str:\n        if char in vowels:\n            return \"Yes\"\n    return \"No\"\n\n# Test the function\nprint(check_vowels('Hello World'))  # Should print \"Yes\"\nprint(check_vowels('bcd'))  # Should print \"No\"\n```"
"```python\nfrom azure.core import (\n    Authentication,\n    Client,\n    ClientConfiguration,\n    ResourceManagementClient,\n    ServiceClient,\n)\nfrom azure.core.exceptions import (\n    HttpResponseError,\n    ServiceRequestError,\n)\nfrom azure.core.util import deserialize_json\nfrom azure.identity import (\n    DefaultAzureCredential,\n    ClientSecretCredential,\n    EnvironmentVariableCredential,\n    ManagedIdentityCredential,\n)\nfrom azure.servicebus import ServiceBusClient\nfrom azure.storage import (\n    BlobServiceClient,\n    FileServiceClient,\n    QueueServiceClient,\n    BlobServiceClient,\n    DataLakeGen2Client,\n)\nfrom azure.eventhub import EventHubClient\n```"
"```python\nfrom __future__ import print_function\nfrom googleapiclient.discovery import build\nfrom google_auth_oauthlib.flow import InstalledAppFlow\nfrom google.auth.transport.requests import Request\nimport pickle\nimport os.path\nfrom googleapiclient.http import MediaFileUpload\nfrom googleapiclient.http import MediaFileDownload\n\n# If modifying these scopes, delete the file token.pickle.\nSCOPES = ['https://www.googleapis.com/auth/drive']\n\ndef download_file(service, file_id):\n    file = service.files().get(fileId=file_id).execute()\n    file_content = file['body']\n    file_name = file['name']\n    file_path = os.path.join('/path/to/download', file_name)\n\n    with open(file_path, 'wb') as f:\n        f.write(file_content)\n\ndef upload_file(service, file_path, file_name):\n    file_metadata = {'name': file_name}\n    media = MediaFileUpload(file_path, mimetype='application/octet-stream')\n    file = service.files().create(body=file_metadata, media_body=media, fields='id').execute()\n    return file['id']\n\ndef download_media(service, file_id, file_path):\n    request = service.files().get_media(fileId=file_id)\n    fh = open(file_path, 'wb')\n    downloader = MediaIOBaseDownload(fh, request)\n    done = False\n    while done is False:\n        status, done = downloader.next_chunk()\n        print(\"Download %d%%.\" % int(status.progress() * 100))\n    fh.close()\n\ndef main():\n    \"\"\"Shows basic usage of the Drive v3 API.\n    Prints the names and ids of the first 10 files the user has access to.\n    \"\"\"\n    creds = None\n    # The file token.pickle stores the user's access and refresh tokens, and is\n    # created automatically when the authorization flow completes for the first\n    # time.\n    if os.path.exists('token.pickle'):\n        with open('token.pickle', 'rb') as token:\n            creds = pickle.load(token)\n    # If there are no (valid) credentials available, let the user log in.\n    if not creds or not creds.valid:\n        if creds and creds.expired and creds.refresh_token:\n            creds.refresh(Request())\n        else:\n            flow = InstalledAppFlow.from_client_secrets_file(\n                'credentials.json', SCOPES)\n            creds = flow.run_local_server(port=0)\n        # Save the credentials for the next run\n        with open('token.pickle', 'wb') as token:\n            pickle.dump(creds, token)\n\n    service = build('drive', 'v3', credentials=creds)\n\n    # Call the Drive v3 API\n    file_id = 'your_file_id'\n    download_file(service, file_id)\n    download_media(service, file_id, '/path/to/download/' + file_id)\n\n    file_path = '/path/to/upload'\n    file_name = 'uploaded_file.txt'\n    uploaded_file_id = upload_file(service, file_path, file_name)\n\nif __name__ == '__main__':\n    main()\n```"
"```python\nimport time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom tqdm import tqdm\n\nclass ProgressBar:\n    def __init__(self, total, template='{l_bar}{bar}| {n_fmt}/{total_fmt} [{percentage:.0f}%] - {msg}',\n                 desc='Progress', unit='', miniters=0):\n        self.template = template\n        self.total = total\n        self.desc = desc\n        self.unit = unit\n        self.miniters = miniters\n\n    def update(self, n, msg):\n        percentage = (n / self.total) * 100\n        time.sleep(self.miniters)\n        bar = tqdm(total=self.total, desc=self.desc, unit=self.unit, bar_format=self.template,\n                   write_kwargs={'percentage': percentage}, ncols=80)\n        bar.update(n)\n        bar.close()\n\ndef main():\n    with ThreadPoolExecutor(max_workers=5) as executor:\n        futures = []\n        for i in range(10):\n            futures.append(executor.submit(task, i))\n        for future in tqdm(futures, total=10, desc='Jobs', unit='job'):\n            future.result()\n\ndef task(i):\n    time.sleep(1)\n    print(f'Task {i} finished')\n\nif __name__ == \"__main__\":\n    main()\n```"
"```python\nimport requests\nfrom bs4 import BeautifulSoup\n\ndef scrape_website(url):\n    try:\n        response = requests.get(url)\n        soup = BeautifulSoup(response.text, 'html.parser')\n\n        # Find all HTML elements with class 'class_name'\n        elements = soup.find_all(class_='class_name')\n\n        # Print the text of each element\n        for element in elements:\n            print(element.text.strip())\n\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n\n# Example usage\nurl = \"http://example.com\"\nscrape_website(url)\n```"
