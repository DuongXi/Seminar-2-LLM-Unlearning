"```python\nimport subprocess\n\ndef compile_source(source_code, target_triple):\n    # Compile the source code using llvm\n    command = f\"llvmcc -triple {target_triple} -o output {source_code}\"\n    subprocess.run(command, shell=True)\n\ndef create_executable(output_file, input_files):\n    # Create an executable from the compiled output\n    command = f\"llvm-objcat -o {output_file} {input_files}\"\n    subprocess.run(command, shell=True)\n\ndef run_executable(output_file):\n    # Run the executable\n    command = f\"llvm-objcat -o /dev/null {output_file}\"\n    subprocess.run(command, shell=True)\n\n# Example usage:\nsource_code = \"\"\"\nint add(int a, int b) {\n    return a + b;\n}\n\"\"\"\n\ntarget_triple = \"x86_64-unknown-linux-gnu\"\n\ncompile_source(source_code, target_triple)\n\ninput_files = [\"output.o\"]\noutput_file = \"output\"\ncreate_executable(output_file, input_files)\n\nrun_executable(output_file)\n```"
