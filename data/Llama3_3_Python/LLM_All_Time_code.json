"```python\nimport sys\nimport functools\n\ndef singledispatch(type_):\n    def decorator(func):\n        dispatch_table = {}\n        def wrapper(*args, **kwargs):\n            key = args[0]\n            if key not in dispatch_table:\n                raise TypeError(f\"no such type: {type_.__name__}\")\n            return dispatch_table[key](func, *args[1:], **kwargs)\n        wrapper.dispatch_table = dispatch_table\n        return wrapper\n    def dispatch(self, key, func):\n        if key not in self.dispatch_table:\n            raise TypeError(f\"no such type: {type_.__name__}\")\n        return self.dispatch_table[key](func)\n    return decorator, dispatch\n\nif sys.version_info < (3, 5):\n    from functools import singledispatch as _singledispatch\n    from functools import wraps\n\n    def len_(func):\n        @singledispatch\n        def _len_(self, key):\n            return 0\n        return _len_\n\n    len = len_\nelse:\n    len = None\n```"
